@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
@import "tailwindcss";

@theme {
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "JetBrains Mono", "Fira Code", monospace;

  /* Vylant Single-Color System - Navy + Vylant Blue + Neutrals */
  --color-vylant-navy: #171e33;
  --color-vylant-blue: #00d2ff;
  --color-vylant-blue-dark: #009ecb;
  --color-vylant-blue-50: #e0f7ff;
  --color-vylant-blue-100: #b3e8ff;
  --color-vylant-blue-200: #7adfff;
  --color-vylant-blue-300: #33bfff;
  --color-vylant-blue-400: #009ac0;
  --color-vylant-blue-500: #0088b3;
  --color-vylant-blue-600: #007799;
  --color-vylant-blue-700: #006688;
  --color-vylant-blue-800: #005577;
  --color-vylant-blue-900: #004466;

  /* Neutrals - Dark Theme */
  --color-navy-50: #f8f9fb;
  --color-navy-100: #edf0f5;
  --color-navy-200: #d8dce6;
  --color-navy-300: #b0b6c8;
  --color-navy-400: #8a92a4;
  --color-navy-500: #707888;
  --color-navy-600: #5a6270;
  --color-navy-700: #484e5c;
  --color-navy-800: #383f4c;
  --color-navy-900: #282f3c;
  --color-navy-950: #171e33;

  /* Brand glow */
  --color-glow-blue: rgba(0, 210, 255, 0.15);
  --color-glow-blue-strong: rgba(0, 210, 255, 0.3);
  --color-glow-blue-dim: rgba(0, 210, 255, 0.08);
}

@layer base {
  :root {
    /* Vylant unified palette */
    --bg-primary: #171e33;
    --bg-gradient: radial-gradient(circle at top center, #1b1c31 0%, #171e33 100%);
    --bg-card: #1f2638;
    --bg-card-hover: #262f45;
    --bg-input: #2a3348;
    --bg-button: #0a1a30;
    --bg-button-hover: #122844;
    --bg-button-active: #0e1626;
    --bg-sidebar: #101828;
    --bg-sidebar-hover: #1a243c;
    --bg-tooltip: #0a1a30;

    /* Text */
    --text-primary: #e8ecf5;
    --text-secondary: #9aa7bd;
    --text-tertiary: #6b768a;
    --text-muted: #4d5a70;
    --text-inverse: #0a0f1d;

    /* Borders */
    --border-primary: #2c3750;
    --border-hover: #3b4868;
    --border-input: #35425c;

    /* Accent - Vylant Blue only */
    --accent-primary: #00d2ff;
    --accent-primary-dim: rgba(0, 210, 255, 0.12);
    --accent-glow: rgba(0, 210, 255, 0.25);
    --accent-glow-strong: rgba(0, 210, 255, 0.4);
    --accent-glow-strongest: rgba(0, 210, 255, 0.6);
    --accent-success: #00e676;
    --accent-success-dim: rgba(0, 230, 118, 0.12);
    --accent-warning: #ffb300;
    --accent-warning-dim: rgba(255, 179, 0, 0.12);
    --accent-danger: #ff5252;
    --accent-danger-dim: rgba(255, 82, 82, 0.12);

    /* Spacing */
    --base-font-size: 16px;
    --nav-height: 4rem;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
    --radius-xl: 20px;
    --radius-2xl: 28px;
    --radius-full: 9999px;

    /* Shadows */
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.5);
    --shadow-xl: 0 12px 40px rgba(0, 0, 0, 0.6);
    --shadow-2xl: 0 16px 60px rgba(0, 0, 0, 0.7);
    --shadow-glow: 0 0 20px rgba(0, 210, 255, 0.3);
    --shadow-glow-strong: 0 0 40px rgba(0, 210, 255, 0.5);
    --shadow-glow-x: 6px 0 20px rgba(0, 210, 255, 0.2);
    --shadow-glow-y: 0 6px 20px rgba(0, 210, 255, 0.2);

    /* Transitions */
    --transition-fast: 100ms ease-out;
    --transition-normal: 150ms ease-out;
    --transition-slow: 250ms ease-out;
    --transition-collapse: 200ms ease-out;
  }

  html {
    font-size: var(--base-font-size);
    scroll-behavior: smooth;
  }

  * {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  *::-webkit-scrollbar {
    display: none;
  }

  html, body, #root {
    height: 100vh;
    height: 100svh;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    overflow-y: auto;
    width: 100%;
  }

  body {
    @apply antialiased;
    background-color: var(--bg-primary);
    background-image: var(--bg-gradient);
    color: var(--text-primary);
    width: 100%;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
  }

  /* Light mode overrides */
  :root[class~="light"], .light {
    --bg-primary: #f6f8fc;
    --bg-gradient: radial-gradient(circle at top center, #eef2f9 0%, #f6f8fc 100%);
    --bg-card: #ffffff;
    --bg-card-hover: #f1f4fa;
    --bg-input: #eef1f6;
    --bg-button: #e8ecf5;
    --bg-button-hover: #dce2ef;
    --bg-button-active: #d2d9e5;
    --bg-sidebar: #edf0f5;
    --bg-sidebar-hover: #dfe4ea;
    --bg-tooltip: #e8ecf5;

    --text-primary: #1a2234;
    --text-secondary: #4a5a72;
    --text-tertiary: #6b768a;
    --text-muted: #8a92a4;
    --text-inverse: #ffffff;

    --border-primary: #c8d2e0;
    --border-hover: #b0bccf;
    --border-input: #c0c8d6;

    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.08);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.15);
    --shadow-xl: 0 12px 40px rgba(0, 0, 0, 0.2);
    --shadow-2xl: 0 16px 60px rgba(0, 0, 0, 0.3);
    --shadow-glow: 0 0 20px rgba(0, 210, 255, 0.15);
    --shadow-glow-strong: 0 0 40px rgba(0, 210, 255, 0.25);
    --shadow-glow-x: 6px 0 20px rgba(0, 210, 255, 0.12);
    --shadow-glow-y: 0 6px 20px rgba(0, 210, 255, 0.12);
  }

  /* Typography scales */
  h1, .text-4xl, .text-5xl, .text-6xl {
    font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  }

  /* Clear disabled state */
  .disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  /* Uniform button reset */
  .btn {
    @apply font-semibold rounded-xl transition-all duration-150 active:scale-[0.97] shadow-md;
  }

  .btn-primary {
    @apply bg-vylant-blue text-white hover:bg-vylant-blue-600 active:bg-vylant-blue-700 disabled:opacity-50 disabled:hover:opacity-50;
  }

  .btn-secondary {
    @apply bg-vylant-navy text-white border border-vylant-navy hover:bg-vylant-navy-600 active:bg-vylant-navy-700;
  }

  .btn-ghost {
    @apply bg-transparent text-vylant-blue hover:bg-vylant-blue/10 border border-transparent hover:border-vylant-blue/30;
  }

  .btn-danger {
    @apply bg-vylant-red text-white hover:bg-vylant-red-600 active:bg-vylant-red-700;
  }

  .btn-success {
    @apply bg-vylant-green text-white hover:bg-vylant-green-600 active:bg-vylant-green-700;
  }

  /* Input fields */
  .input {
    @apply w-full px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-150 outline-none border;
  }

  .input:focus {
    @apply border-vylant-blue ring-2 ring-vylant-blue/30;
  }

  .input-light {
    @apply bg-vylant-navy border-vylant-navy text-white placeholder-vylant-blue/40 hover:border-vylant-navy-400;
  }

  .input-light:focus {
    @apply border-vylant-blue ring-2 ring-vylant-blue/30;
  }

  .input-dark {
    @apply bg-vylant-navy border-vylant-navy text-white placeholder-vylant-blue/40 hover:border-vylant-navy-400;
  }

  .input-dark:focus {
    @apply border-vylant-blue ring-2 ring-vylant-blue/30;
  }

  /* Cards */
  .card {
    @apply rounded-xl border border-vylant-navy/50 bg-vylant-card text-white transition-all duration-150 hover:bg-vylant-card-hover;
  }

  .card-hover {
    @apply rounded-xl border border-vylant-navy/50 bg-vylant-card text-white transition-all duration-150 hover:bg-vylant-card-hover hover:border-vylant-navy-400;
  }

  .card-glow {
    @apply rounded-xl border border-vylant-navy/50 bg-vylant-card text-white transition-all duration-150 hover:bg-vylant-card-hover hover:border-vylant-blue/30 hover:shadow-glow;
  }

  /* Pills */
  .pill {
    @apply inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold transition-all duration-150;
  }

  .pill-default {
    @apply bg-vylant-navy/80 text-vylant-blue/70 border border-vylant-navy/50;
  }

  .pill-primary {
    @apply bg-vylant-blue/15 text-vylant-blue border border-vylant-blue/30;
  }

  .pill-success {
    @apply bg-vylant-green/15 text-vylant-green border border-vylant-green/30;
  }

  .pill-ghost {
    @apply bg-transparent text-vylant-blue/60 border border-transparent hover:border-vylant-blue/30 hover:text-vylant-blue;
  }

  /* Badges */
  .badge {
    @apply inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide;
  }

  .badge-vylant {
    @apply bg-vylant-blue/15 text-vylant-blue border border-vylant-blue/20;
  }

  .badge-green {
    @apply bg-vylant-green/15 text-vylant-green border border-vylant-green/20;
  }

  .badge-red {
    @apply bg-vylant-red/15 text-vylant-red border border-vylant-red/20;
  }

  .badge-amber {
    @apply bg-vylant-amber/15 text-vylant-amber border border-vylant-amber/20;
  }

  .badge-slate {
    @apply bg-vylant-navy/15 text-vylant-blue/60 border border-vylant-navy/20;
  }

  /* Tabs */
  .tabs {
    @apply flex flex-wrap gap-1 rounded-xl border border-vylant-navy/50 bg-vylant-navy/30 p-1;
  }

  .tab {
    @apply px-4 py-2 rounded-lg text-sm font-medium transition-all duration-150;
  }

  .tab-active {
    @apply bg-vylant-blue text-white shadow-glow;
  }

  .tab-inactive {
    @apply text-vylant-blue/50 hover:text-vylant-blue hover:bg-vylant-blue/5;
  }

  /* Select dropdown (replaces native select) */
  .select {
    @apply w-full px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-150 outline-none border cursor-pointer appearance-none bg-vylant-navy text-white hover:border-vylant-navy-400;
  }

  .select:focus {
    @apply border-vylant-blue ring-2 ring-vylant-blue/30;
  }

  .select-light {
    @apply bg-vylant-navy border-vylant-navy text-white placeholder-vylant-blue/40 hover:border-vylant-navy-400;
  }

  .select-light:focus {
    @apply border-vylant-blue ring-2 ring-vylant-blue/30;
  }

  /* Tooltip */
  .tooltip {
    @apply absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-vylant-navy backdrop-blur-md shadow-xl;
  }

  .tooltip::before {
    content: "";
    @apply absolute bottom-full left-1/2 -translate-x-1/2 w-2 h-2 bg-vylant-navy rotate-45;
  }

  .scrollable {
    @apply overflow-y-auto overflow-x-hidden overscroll-contain scrollbar-hide;
  }
}

  .safe-area-bottom {
    padding-bottom: env(safe-area-inset-bottom);
  }
  
  .safe-area-pt {
    padding-top: env(safe-area-inset-top);
  }

  .nav-pb {
    padding-bottom: calc(4rem + env(safe-area-inset-bottom));
  }
  
  .nav-h {
    height: calc(4rem + env(safe-area-inset-bottom));
  }

  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  .auto-expand-chat-input::-webkit-scrollbar {
    display: block;
    width: 6px;
  }
  .auto-expand-chat-input::-webkit-scrollbar-track {
    background: transparent;
  }
  .auto-expand-chat-input::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.3);
    border-radius: 9999px;
  }
  .auto-expand-chat-input {
    scrollbar-width: thin;
    scrollbar-color: rgba(148, 163, 184, 0.3) transparent;
  }
}
