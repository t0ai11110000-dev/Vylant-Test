  storyPrivacy: 'everyone' | 'friends' | 'custom',
  setStoryPrivacy: (v: 'everyone' | 'friends' | 'custom') => void,
  // New Settings Types
  twoFactorEnabled: boolean, setTwoFactorEnabled: (v: boolean) => void,
