  const [isCameraOn, setIsCameraOn] = useState(false);
  const [isRemoteCameraOn, setIsRemoteCameraOn] = useState(false);
  const [focusedVideo, setFocusedVideo] = useState<'local' | 'remote' | null>(null);
  const [isPipMinimized, setIsPipMinimized] = useState(false);
  const [isCallCameraDropdownOpen, setIsCallCameraDropdownOpen] = useState(false);
  const [isScreenShareSettingsOpen, setIsScreenShareSettingsOpen] = useState(false);

  useEffect(() => {
    const handleClickOutside = () => {
      setIsCallCameraDropdownOpen(false);
      setIsScreenShareSettingsOpen(false);
    };
    window.addEventListener('click', handleClickOutside);
    return () => window.removeEventListener('click', handleClickOutside);
  }, []);
 
  const handleCameraDropdownToggle = async (e: React.MouseEvent) => {
    e.stopPropagation();
    if (!isCallCameraDropdownOpen) {
      // If expanding, attempt to fetch labels if they are empty or we have no devices
      if (videoInputs.length === 0 || (videoInputs.length > 0 && videoInputs[0].label === "")) {
        try {
          const stream = await navigator.mediaDevices.getUserMedia({ video: true });
          stream.getTracks().forEach(track => track.stop());
          await refreshDevices();
        } catch (err) {
          console.warn("Could not request camera permission to fetch labels", err);
        }
      }
    }
    setIsCallCameraDropdownOpen(!isCallCameraDropdownOpen);
  };


  const createPeerConnection = (targetName: string) => {
    // If we're starting a new private call and it's not the same person, close existing ones
    if (activeCall?.type === 'private' || !activeCall) {
      if (!peerConnectionsRef.current.has(targetName)) {
        peerConnectionsRef.current.forEach((pc, name) => {
          if (name !== targetName) {
            pc.close();
            peerConnectionsRef.current.delete(name);
          }
        });
        setRemoteAudioStreams(prev => {
          const next = new Map(prev);
          Array.from(next.keys()).forEach((key: any) => {
            if (key !== targetName) next.delete(key);
          });
          return next;
        });
        setRemoteVideoStreams(prev => {
          const next = new Map(prev);
          Array.from(next.keys()).forEach((key: any) => {
            if (typeof key === 'string' && !key.startsWith(`${targetName}:-:`)) next.delete(key);
          });
          return next;
        });
      }
    } else if (peerConnectionsRef.current.has(targetName)) {
      // If we already have a connection to this person (maybe stale), close it first
      peerConnectionsRef.current.get(targetName)?.close();
    }

    const pc = new RTCPeerConnection({
      iceServers: iceServers
    });

    pc.onicecandidate = (event) => {
      if (event.candidate && socketRef.current) {
        socketRef.current.emit('ice-candidate', {
          targetName,
          candidate: event.candidate,
          senderName: userName
        });
      }
    };

    pc.ontrack = (event) => {
      if (event.track.kind === 'audio') {
        const stream = event.streams[0] || new MediaStream([event.track]);
        setRemoteAudioStreams(prev => {
          const next = new Map(prev);
          next.set(targetName, stream);
          return next;
        });
      } else if (event.track.kind === 'video') {
        // Use a dedicated stream for this video track to ensure clean rendering
        const videoStream = new MediaStream([event.track]);
        const isScreen = (event.track.label || '').toLowerCase().includes('screen') || 
                        (event.track as any).contentHint === 'detail' ||
                        (event.track.label || '').toLowerCase().includes('monitor') ||
                        (event.track.label || '').toLowerCase().includes('window');
        
        if (isScreen) setIsRemoteScreenSharing(true);
        else setIsRemoteCameraOn(true);

        const streamKey = `${targetName}:-:${isScreen ? 'screen' : 'camera'}:-:${event.track.id}`;

        setRemoteVideoStreams(prev => {
          const next = new Map(prev);
          next.set(streamKey, videoStream);
          return next;
        });
        
        event.track.onended = () => {
          setRemoteVideoStreams(prev => {
            const next = new Map(prev);
            if (next.has(streamKey)) {
              next.delete(streamKey);
            }
            
            // Re-evaluate boolean flags based on remaining streams
            const remaining = Array.from(next.keys()) as string[];
            setIsRemoteScreenSharing(remaining.some(k => k.includes(':-:screen:-:')));
            setIsRemoteCameraOn(remaining.some(k => k.includes(':-:camera:-:')));
            
            return next;
          });
        };
      }
    };

    peerConnectionsRef.current.set(targetName, pc);
    return pc;
  };

  const handleToggleFullScreen = (videoElement: HTMLVideoElement | null) => {
    if (!videoElement) return;
    try {
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else {
        if (videoElement.requestFullscreen) {
          videoElement.requestFullscreen();
        } else if ((videoElement as any).webkitRequestFullscreen) {
          (videoElement as any).webkitRequestFullscreen();
        } else if ((videoElement as any).mozRequestFullScreen) {
          (videoElement as any).mozRequestFullScreen();
        } else if ((videoElement as any).msRequestFullscreen) {
          (videoElement as any).msRequestFullscreen();
        }
      }
    } catch (error) {
      console.error('Fullscreen request failed:', error);
    }
  };

  const handleTransferCallHere = () => {
    const callToTransfer = otherDeviceCalls[0];
    if (!callToTransfer) return;

    // 1. Send transfer request to server to disconnect the other socket
    if (socketRef.current) {
      socketRef.current.emit("transfer-call-request", { targetSocketId: callToTransfer.socketId });
    }

    // 2. End any call active locally
    endCall();

    // 3. Initiate call on current device
    setTimeout(() => {
      if (callToTransfer.type === 'server') {
        const serverId = callToTransfer.serverId;
        const channelId = callToTransfer.channelId || callToTransfer.targetId;
        
        setActiveServer(serverId);
        setActiveChannel(channelId);
        setActiveView('server');

        setActiveCall({
          type: 'server',
          targetId: channelId,
          targetName: channelId,
          serverId: serverId,
          status: 'connected'
        });

        if (socketRef.current) {
          socketRef.current.emit('join-voice-channel', { serverId, channelId });
        }
      } else {
        const isGroup = callToTransfer.type === 'group';
        const targetName = callToTransfer.targetName;
        const type = callToTransfer.type;

        setActiveCall({
          type: type,
          targetId: targetName,
          targetName: targetName,
          status: 'calling'
        });

        if (socketRef.current) {
          socketRef.current.emit('call-user', {
            targetName,
            callerName: userName,
            type: type,
            isGroup: isGroup
          });
        }
      }
    }, 100);
  };

  const endCall = () => {
    const currentActiveCall = activeCallRef.current || activeCall;
    
    if (socketRef.current) {
      if (currentActiveCall) {
        socketRef.current.emit('speaking-status', {
          isSpeaking: false,
          targetName: currentActiveCall.targetName,
          isServer: currentActiveCall.type === 'server',
          serverId: currentActiveCall.serverId,
          channelId: currentActiveCall.type === 'server' ? currentActiveCall.targetName : null
        });
      }

      if (currentActiveCall?.type === 'server' && currentActiveCall.serverId) {
        socketRef.current.emit('leave-voice-channel', { 
          serverId: currentActiveCall.serverId, 
          channelId: currentActiveCall.targetName 
        });
      } else if (currentActiveCall) {
        socketRef.current.emit('end-call', {
          targetName: currentActiveCall.targetName,
          senderName: userName,
          isGroup: groupChatsRef.current?.some(gc => gc.name === currentActiveCall.targetName),
          groupName: currentActiveCall.targetName
        });
      }
    }

    if (localStreamRef.current) {
      localStreamRef.current.getTracks().forEach(track => track.stop());
      localStreamRef.current = null;
    }
    if (screenStreamRef.current) {
      screenStreamRef.current.getTracks().forEach(track => track.stop());
      screenStreamRef.current = null;
    }
    peerConnectionsRef.current.forEach(pc => pc.close());
    peerConnectionsRef.current.clear();
    setRemoteAudioStreams(new Map());
    setRemoteVideoStreams(new Map());

    if (remoteAudioRef.current) {
      remoteAudioRef.current.srcObject = null;
    }
    if (remoteVideoRef.current) {
      remoteVideoRef.current.srcObject = null;
    }
    if (localCameraVideoRef.current) {
      localCameraVideoRef.current.srcObject = null;
    }
    if (localScreenVideoRef.current) {
      localScreenVideoRef.current.srcObject = null;
    }
    
    setIsScreenSharing(false);
    setIsRemoteScreenSharing(false);
    setIsSpeaking(false);
    setIsRemoteSpeaking(false);
    setSpeakingUsers(new Set());
    
    setActiveCall(null);
    setIsCallExpanded(false);
  };

  useEffect(() => {
    if (localStreamRef.current) {
      localStreamRef.current.getAudioTracks().forEach(track => {
        track.enabled = !isMuted;
      });
    }
    // Also update all peer connections
    peerConnectionsRef.current.forEach(pc => {
      pc.getSenders().forEach(sender => {
        if (sender.track && sender.track.kind === 'audio') {
          sender.track.enabled = !isMuted;
        }
      });
    });
  }, [isMuted, remoteAudioStreams]);

  useEffect(() => {
    // The RemoteAudio components handle isDeafened via props
  }, [isDeafened]);

  useEffect(() => {
    const audio = remoteAudioRef.current;
    if (audio && (audio as any).setSinkId && selectedOutputDevice && selectedOutputDevice !== 'default') {
      (audio as any).setSinkId(selectedOutputDevice)
        .catch((err: any) => {
          // This is a known browser restriction, often requiring user gesture or specific permission
          // In iframes, this may fail with SecurityError or NotAllowedError
          if (err.name !== 'NotAllowedError' && err.name !== 'NotFoundError' && err.name !== 'SecurityError') {
            console.warn('Failed to set sink ID:', err);
          }
        });
    } else if (audio && (audio as any).setSinkId && selectedOutputDevice === 'default') {
      (audio as any).setSinkId('').catch(() => {});
    }
  }, [selectedOutputDevice]);

  useEffect(() => {
    if (activeCall?.status === 'calling' && !activeCall.isIncoming) {
      callTimeoutRef.current = setTimeout(() => {
        setCallStatusMessage(`${activeCall.targetName} is not available right now.`);
        endCall();
        // Auto clear message after 5 seconds
        setTimeout(() => setCallStatusMessage(null), 5000);
      }, 30000);
    } else {
      if (callTimeoutRef.current) {
        clearTimeout(callTimeoutRef.current);
        callTimeoutRef.current = null;
      }
    }
    return () => {
      if (callTimeoutRef.current) {
        clearTimeout(callTimeoutRef.current);
      }
    };
  }, [activeCall]);
  const [input, setInput] = useState('');
  const [selectionRange, setSelectionRange] = useState<{ start: number; end: number; inputId: string } | null>(null);

  const applyTextFormat = (type: 'bold' | 'strike' | 'spoiler') => {
    if (!selectionRange) return;
    const { start, end, inputId } = selectionRange;
    if (start === end) return;

    const before = input.substring(0, start);
    const selected = input.substring(start, end);
    const after = input.substring(end);

    let wrapped = selected;
    if (type === 'bold') {
      wrapped = `**${selected}**`;
    } else if (type === 'strike') {
      wrapped = `~~${selected}~~`;
    } else if (type === 'spoiler') {
      wrapped = `||${selected}||`;
    }

    const newValue = before + wrapped + after;
    setInput(newValue);

    // Refocus and place highlight around the wrapped formatted text
    setTimeout(() => {
      const el = document.getElementById(inputId) as (HTMLInputElement | HTMLTextAreaElement | null);
      if (el) {
        el.focus();
        const newStart = start;
        const newEnd = start + wrapped.length;
        el.setSelectionRange(newStart, newEnd);
        setSelectionRange({ start: newStart, end: newEnd, inputId });
      }
    }, 10);
  };

  const handleInputSelect = (e: React.SyntheticEvent<HTMLInputElement | HTMLTextAreaElement>) => {
    const target = e.currentTarget;
    const start = target.selectionStart;
    const end = target.selectionEnd;
    const inputId = target.id;
    if (start !== null && end !== null && start !== end) {
      setSelectionRange({ start, end, inputId });
    } else {
      setSelectionRange(null);
    }
  };

  const autoResizeChatInputs = useCallback(() => {
    const textareas = document.querySelectorAll<HTMLTextAreaElement>('.auto-expand-chat-input');
    textareas.forEach(el => {
      el.style.height = 'auto';
      const minH = parseInt(el.dataset.minHeight || '48', 10);
      const maxH = 200;
      const scrollH = el.scrollHeight;
      const targetH = Math.min(Math.max(scrollH, minH), maxH);
      el.style.height = `${targetH}px`;
      el.style.overflowY = scrollH > maxH ? 'auto' : 'hidden';
    });
  }, []);

  useEffect(() => {
    const handleScreenShare = async () => {
      if (isScreenSharing) {
        if (screenStreamRef.current) {
          screenStreamRef.current.getTracks().forEach(track => track.stop());
        }
        try {
          let constraints: any = {
            video: true,
            audio: {
              echoCancellation,
              noiseSuppression,
              autoGainControl: automaticGainControl
            }
          };

          if (screenShareQuality !== 'source') {
            const resMap = {
              '480p': { w: 854, h: 480 },
              '720p': { w: 1280, h: 720 },
              '1080p': { w: 1920, h: 1080 },
              '1440p': { w: 2560, h: 1440 }
            };
            const res = resMap[screenShareQuality as keyof typeof resMap];
            constraints.video = {
              width: { ideal: res.w },
              height: { ideal: res.h },
              frameRate: { ideal: screenShareFPS, max: screenShareFPS }
            };
          } else {
            constraints.video = {
              frameRate: { ideal: screenShareFPS, max: screenShareFPS }
            };
          }

          const stream = await navigator.mediaDevices.getDisplayMedia(constraints);
          
          // Optimize for detail/text (standard for screen sharing)
          const videoTrack = stream.getVideoTracks()[0];
          if (videoTrack && 'contentHint' in videoTrack) {
            (videoTrack as any).contentHint = 'detail';
          }
          
          screenStreamRef.current = stream;
          
          if (localScreenVideoRef.current) {
            localScreenVideoRef.current.srcObject = stream;
          }

          stream.getVideoTracks()[0].onended = () => {
            setIsScreenSharing(false);
          };

          if (peerConnectionsRef.current.size > 0) {
            peerConnectionsRef.current.forEach(async (pc, targetName) => {
              stream.getTracks().forEach(track => {
                const senders = pc.getSenders();
                const alreadyHasTrack = senders.some(s => s.track === track);
                if (!alreadyHasTrack) {
                  pc.addTrack(track, stream);
                }
              });
              
              const offer = await pc.createOffer();
              await pc.setLocalDescription(offer);
              socketRef.current.emit('sdp-offer', {
                targetName, 
                offer,
                senderName: userName
              });
            });
          }

          // Notify server
          if (socketRef.current && activeCall) {
            socketRef.current.emit('screen-share-state-changed', {
              targetName: activeCall.targetName,
              senderName: userName,
              isOn: true,
              isServer: activeCall.type === 'server',
              serverId: activeCall.serverId,
              channelId: activeCall.targetName
            });
          }
        } catch (err: any) {
          const errorName = err?.name || 'UnknownError';
          const errorMessage = err?.message || 'Permission denied or cancelled.';
          console.error(`Error starting screen share: ${errorName} - ${errorMessage}`, err);
          
          if (errorName !== 'NotAllowedError' && errorName !== 'AbortError') {
             alert(`Could not start screen share: ${errorMessage}`);
          }
          setIsScreenSharing(false);
        }
      } else {
        if (screenStreamRef.current) {
          screenStreamRef.current.getTracks().forEach(track => track.stop());
          screenStreamRef.current = null;
        }
        
        peerConnectionsRef.current.forEach(async (pc, targetName) => {
          const senders = pc.getSenders();
          // Find tracks associated with the screen stream or that have contentHint 'detail'
          const screenTracks = senders.filter(s => s.track && (s.track.label.toLowerCase().includes('screen') || (s.track as any).contentHint === 'detail'));
          
          screenTracks.forEach(s => {
            pc.removeTrack(s);
          });
          
          if (screenTracks.length > 0) {
            const offer = await pc.createOffer().catch(() => null);
            if (offer) {
              await pc.setLocalDescription(offer);
              socketRef.current.emit('sdp-offer', {
                targetName,
                offer,
                senderName: userName
              });
            }
          }
        });

        if (localScreenVideoRef.current) {
          localScreenVideoRef.current.srcObject = null;
        }

        // Notify server
        if (socketRef.current && activeCall) {
          socketRef.current.emit('screen-share-state-changed', {
            targetName: activeCall.targetName,
            senderName: userName,
            isOn: false,
            isServer: activeCall.type === 'server',
            serverId: activeCall.serverId,
            channelId: activeCall.targetName
          });
        }
      }
    };

    handleScreenShare();
  }, [isScreenSharing, screenShareQuality, screenShareFPS]);

  useEffect(() => {
    const handleCamera = async () => {
      if (isCameraOn) {
        if (cameraStreamRef.current) {
          cameraStreamRef.current.getTracks().forEach(track => track.stop());
        }
        try {
          const stream = await navigator.mediaDevices.getUserMedia({
            video: {
              width: { ideal: 1280 },
              height: { ideal: 720 },
              facingMode: 'user',
              deviceId: selectedVideoDevice !== 'default' ? { ideal: selectedVideoDevice } : undefined
            },
            audio: false
          });
          
          const videoTrack = stream.getVideoTracks()[0];
          
          cameraStreamRef.current = stream;

          if (localCameraVideoRef.current) {
            localCameraVideoRef.current.srcObject = stream;
          }

          if (peerConnectionsRef.current.size > 0) {
            peerConnectionsRef.current.forEach(async (pc, targetName) => {
              const senders = pc.getSenders();
              const videoSender = senders.find(s => s.track && s.track.kind === 'video' && !s.track.label.toLowerCase().includes('screen') && (s.track as any).contentHint !== 'detail');
              
              if (videoSender) {
                videoSender.replaceTrack(videoTrack);
              } else {
                pc.addTrack(videoTrack, stream);
              }
              
              const offer = await pc.createOffer();
              await pc.setLocalDescription(offer);
              socketRef.current.emit('sdp-offer', {
                targetName,
                offer,
                senderName: userName
              });
            });
          }
          
          // Notify peer
          if (socketRef.current && activeCall) {
            socketRef.current.emit('camera-state-changed', {
              targetName: activeCall.targetName,
              senderName: userName,
              isOn: true,
              isServer: activeCall.type === 'server',
              serverId: activeCall.serverId,
              channelId: activeCall.targetName
            });
          }
        } catch (err: any) {
          const errorName = err?.name || 'DeviceError';
          let errorMessage = err?.message || 'Could not access camera.';
          if (!errorMessage && err?.toString) errorMessage = err.toString();
          if (errorMessage === '[object Object]') errorMessage = 'Unknown camera error occurred.';
          
          console.error(`Error starting camera: ${errorName} - ${errorMessage}`, err);
          
          if (errorName === 'NotAllowedError' || errorName === 'PermissionDeniedError') {
            alert('Camera access was denied. Please check your browser permissions.');
          } else if (errorName === 'NotFoundError' || errorName === 'DevicesNotFoundError') {
            alert('No camera device found.');
          } else if (errorName === 'NotReadableError' || errorName === 'TrackStartError') {
            alert('Camera is already in use by another application.');
          } else if (errorName === 'OverconstrainedError') {
            alert('Camera does not support the requested resolution.');
          } else if (errorName !== 'AbortError') {
            alert(`Could not start camera: ${errorMessage}`);
          }
          
          setIsCameraOn(false);
        }
      } else {
        if (cameraStreamRef.current) {
          cameraStreamRef.current.getTracks().forEach(track => track.stop());
          cameraStreamRef.current = null;
        }

        peerConnectionsRef.current.forEach(async (pc, targetName) => {
          const senders = pc.getSenders();
          const videoSender = senders.find(s => s.track && s.track.kind === 'video' && !s.track.label.toLowerCase().includes('screen') && (s.track as any).contentHint !== 'detail');
          if (videoSender) {
            if (videoSender.track) videoSender.track.stop();
            pc.removeTrack(videoSender);
            
            const offer = await pc.createOffer().catch(() => null);
            if (offer) {
              await pc.setLocalDescription(offer);
              socketRef.current.emit('sdp-offer', {
                targetName,
                offer,
                senderName: userName
              });
            }
          }
        });
        
        if (localCameraVideoRef.current) {
          localCameraVideoRef.current.srcObject = null;
        }

        // Notify peer
        if (socketRef.current && activeCall) {
          socketRef.current.emit('camera-state-changed', {
            targetName: activeCall.targetName,
            senderName: userName,
            isOn: false,
            isServer: activeCall.type === 'server',
            serverId: activeCall.serverId,
            channelId: activeCall.targetName
          });
        }
      }
    };

    handleCamera();
  }, [isCameraOn, selectedVideoDevice]);
  useEffect(() => {
    if (!activeCall) {
      setFocusedVideo(null);
    }
  }, [activeCall]);

  const [showEmojiPicker, setShowEmojiPicker] = useState(false);
  const [showGifPicker, setShowGifPicker] = useState(false);

  const handleSendGif = (gif: GifItem | { url: string; title?: string }) => {
    const gifUrl = gif.url;
    const caption = input.trim();
    const groupChat = groupChats.find(gc => gc.name === activeDM);
    const isGroupChat = !!groupChat;
    const isVanishActive = activeView === 'messages' && activeDM && !isGroupChat && (vanishModeByDM[activeDM] || false);

    const userMessage: Message = {
      id: generateId(),
      sender: userName,
      text: caption,
      image: gifUrl,
      attachments: [{
        url: gifUrl,
        type: 'image',
        name: (gif as any).title || 'GIF'
      }],
      isBot: false,
      timestamp: Date.now(),
      isVanish: isVanishActive,
      expiresAt: isVanishActive ? Date.now() + 60000 : undefined,
      replyTo: replyingTo?.id
    };

    setReplyingTo(null);

    if (activeView === 'messages') {
      if (isGroupChat && groupChat && socketRef.current) {
        socketRef.current.emit('send-group-chat-message', { groupId: groupChat.id, message: userMessage });
        setDmMessages(prev => ({
          ...prev,
          [activeDM]: [...(prev[activeDM] || []), { ...userMessage, isVanish: false, expiresAt: undefined }]
        }));
        setInput('');
        setShowGifPicker(false);
        return;
      }

      setDmMessages(prev => ({
        ...prev,
        [activeDM]: [...(prev[activeDM] || []), userMessage]
      }));

      apiFetch('/api/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: userMessage, receiver: activeDM })
      }).catch(err => console.error('Failed to send GIF message:', err));

      setRecentDMs(prev => {
        const index = prev.findIndex(dm => dm.name === activeDM);
        if (index > -1) {
          const newDMs = [...prev];
          const [dm] = newDMs.splice(index, 1);
          newDMs.unshift(dm);
          return newDMs;
        }
        return prev;
      });

      setInput('');
      setShowGifPicker(false);
      return;
    }

    if (activeView === 'server' && activeServer) {
      if (socketRef.current) {
        socketRef.current.emit('send-server-message', {
          serverId: activeServer,
          channelId: activeChannel,
          message: userMessage
        });
      }

      setServerMessages(prev => {
        const serverData = prev[activeServer] || {};
        const channelMessages = serverData[activeChannel] || [];
        return {
          ...prev,
          [activeServer]: {
            ...serverData,
            [activeChannel]: [...channelMessages, userMessage]
          }
        };
      });

      setInput('');
      setShowGifPicker(false);
      return;
    }

    setMessages(prev => [...prev, userMessage]);
    setInput('');
    setShowGifPicker(false);
  };
  const emojiPickerRef = useRef<HTMLDivElement>(null);

  const onEmojiClick = (emojiData: any) => {
    if (emojiData.isCustom) {
      const name = emojiData.names && emojiData.names[0] ? emojiData.names[0] : 'emoji';
      const id = emojiData.unified || emojiData.id;
      setInput(prev => prev + `<:${name}:${id}> `);
    } else {
      setInput(prev => prev + emojiData.emoji);
    }
  };
  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (emojiPickerRef.current && !emojiPickerRef.current.contains(event.target as Node)) {
        setShowEmojiPicker(false);
      }
    };
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  const isInitialLoadRef = useRef(false);
  const prevUserNameRef = useRef("");

  useEffect(() => {
    if (userName && userName !== prevUserNameRef.current) {
      isInitialLoadRef.current = false;
      
      // Load all user-specific state
      const loadState = (key: string, setter: (val: any) => void, defaultValue: any) => {
        const stored = localStorage.getItem(`vylant_${key}_${userName}`);
        if (stored) {
          try {
            setter(JSON.parse(stored));
          } catch (e) {
            setter(defaultValue);
          }
        } else {
          setter(defaultValue);
        }
      };

      loadState('messages', setMessages, [{
        id: '1',
        sender: 'System',
        text: "Welcome to Vylant! This is the beginning of your chat history.",
        type: 'system',
        timestamp: Date.now()
      }]);
      loadState('friends', setFriends, DEFAULT_FRIENDS);
      loadState('serverMessages', setServerMessages, {});
      loadState('dmMessages', setDmMessages, {});
      loadState('blockedUsers', setBlockedUsers, []);
      loadState('friendRequests', setFriendRequests, []);
      loadState('sentFriendRequests', setSentFriendRequests, []);
      loadState('friendFolders', setFriendFolders, []);
      loadState('collapsedFolders', setCollapsedFolders, []);
      loadState('recentDMs', setRecentDMs, []);
      loadState('groupChats', setGroupChats, []);
      loadState('servers', setServers, INITIAL_SERVERS);
      loadState('allowDirectMessages', setAllowDirectMessages, true);
      loadState('allowIncomingFriendRequests', setAllowIncomingFriendRequests, true);
      loadState('allowDataCollection', setAllowDataCollection, true);
      
      const storedImage = localStorage.getItem(`vylant_user_image_${userName}`);
      setUserImage(storedImage || getRandomAvatar(userName));
      
      const storedStatus = localStorage.getItem(`vylant_userStatus_${userName}`);
      if (storedStatus) setUserStatus(storedStatus as UserStatus);
      
      const storedCustomStatus = localStorage.getItem(`vylant_customStatus_${userName}`);
      setCustomStatus(storedCustomStatus || '');
      
      const storedActiveDM = localStorage.getItem(`vylant_activeDM_${userName}`);
      if (storedActiveDM) setActiveDM(storedActiveDM);
      
      const storedTransEnabled = localStorage.getItem(`vylant_isTranslationEnabled_${userName}`);
      if (storedTransEnabled) setIsTranslationEnabled(JSON.parse(storedTransEnabled));
      
      const storedShowOrig = localStorage.getItem(`vylant_showOriginalMessage_${userName}`);
      if (storedShowOrig) setShowOriginalMessage(JSON.parse(storedShowOrig));
      
      const storedTargetLang = localStorage.getItem(`vylant_targetLanguage_${userName}`);
      if (storedTargetLang) setTargetLanguage(storedTargetLang);

      prevUserNameRef.current = userName;
      isInitialLoadRef.current = true;
    } else if (userName && !isInitialLoadRef.current) {
      isInitialLoadRef.current = true;
    }
  }, [userName]);

  const [messages, setMessages] = useState<Message[]>(() => {
    const stored = localStorage.getItem(`vylant_messages_${userName}`);
    return stored ? JSON.parse(stored) : [{
      id: '1',
      sender: 'System',
      text: "Welcome to Vylant! This is the beginning of your chat history.",
      type: 'system',
      timestamp: Date.now()
    }];
  });
  useEffect(() => {
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_messages_${userName}`, JSON.stringify(messages));
    }
  }, [messages, userName]);
  const [friends, setFriends] = useState(() => {
    const stored = localStorage.getItem(`vylant_friends_${userName}`);
    return stored ? JSON.parse(stored) : DEFAULT_FRIENDS;
  });

  const [isCreatePollModalOpen, setIsCreatePollModalOpen] = useState(false);
  const [scheduledMessages, setScheduledMessages] = useState<ScheduledMessageItem[]>([]);
  const [isScheduleModalOpen, setIsScheduleModalOpen] = useState(false);
  const [isScheduledManagerOpen, setIsScheduledManagerOpen] = useState(false);
  const [showAttachMenu, setShowAttachMenu] = useState(false);

  const handleVotePoll = (messageId: string, optionId: string) => {
    if (socketRef.current) {
      socketRef.current.emit('vote-poll', {
        serverId: activeServer || undefined,
        channelId: activeChannel || undefined,
        messageId,
        optionId,
        userName
      });
    }
    
    // Update local messages state
    setMessages(prev => prev.map(msg => {
      if (msg.id === messageId && msg.poll) {
        const poll = { ...msg.poll };
        const option = poll.options.find(o => o.id === optionId);
        if (option && !poll.closed) {
          if (!option.votes) option.votes = [];
          const hasVoted = option.votes.includes(userName);
          if (poll.allowMultiple) {
            if (hasVoted) {
              option.votes = option.votes.filter(v => v !== userName);
            } else {
              option.votes.push(userName);
            }
          } else {
            poll.options.forEach(opt => {
              if (opt.votes) {
                opt.votes = opt.votes.filter(v => v !== userName);
              }
            });
            if (!hasVoted) {
              option.votes.push(userName);
            }
          }
        }
        return { ...msg, poll };
      }
      return msg;
    }));

    // Update local dmMessages state
    if (activeDM) {
      setDmMessages(prev => {
        const personMessages = prev[activeDM] || [];
        return {
          ...prev,
          [activeDM]: personMessages.map(msg => {
            if (msg.id === messageId && msg.poll) {
              const poll = { ...msg.poll };
              const option = poll.options.find(o => o.id === optionId);
              if (option && !poll.closed) {
                if (!option.votes) option.votes = [];
                const hasVoted = option.votes.includes(userName);
                if (poll.allowMultiple) {
                  if (hasVoted) {
                    option.votes = option.votes.filter(v => v !== userName);
                  } else {
                    option.votes.push(userName);
                  }
                } else {
                  poll.options.forEach(opt => {
                    if (opt.votes) {
                      opt.votes = opt.votes.filter(v => v !== userName);
                    }
                  });
                  if (!hasVoted) {
                    option.votes.push(userName);
                  }
                }
              }
              return { ...msg, poll };
            }
            return msg;
          })
        };
      });
    }
  };

  const handleClosePoll = (messageId: string) => {
    if (socketRef.current) {
      socketRef.current.emit('close-poll', {
        serverId: activeServer || undefined,
        channelId: activeChannel || undefined,
        messageId
      });
    }
    
    setMessages(prev => prev.map(msg => {
      if (msg.id === messageId && msg.poll) {
        return { ...msg, poll: { ...msg.poll, closed: true } };
      }
      return msg;
    }));

    if (activeDM) {
      setDmMessages(prev => {
        const personMessages = prev[activeDM] || [];
        return {
          ...prev,
          [activeDM]: personMessages.map(msg => {
            if (msg.id === messageId && msg.poll) {
              return { ...msg, poll: { ...msg.poll, closed: true } };
            }
            return msg;
          })
        };
      });
    }
  };

  const handleCreatePoll = (poll: Poll) => {
    const newMsg: Message = {
      id: `msg-${Date.now()}-${Math.random().toString(36).substring(2, 7)}`,
      sender: userName,
      senderImage: userImage,
      text: `📊 Created a poll: "${poll.question}"`,
      poll,
      timestamp: Date.now(),
      type: 'user'
    };

    const groupChat = groupChats.find(gc => gc.name === activeDM);
    if (activeServer && activeChannel && socketRef.current) {
      socketRef.current.emit('send-server-message', {
        serverId: activeServer,
        channelId: activeChannel,
        message: newMsg
      });
    } else if (groupChat && socketRef.current) {
      socketRef.current.emit('send-group-chat-message', {
        groupId: groupChat.id,
        message: newMsg
      });
      setDmMessages(prev => ({
        ...prev,
        [activeDM]: [...(prev[activeDM] || []), newMsg]
      }));
    } else if (activeDM && socketRef.current) {
      socketRef.current.emit('send-dm-message', {
        receiver: activeDM,
        message: newMsg
      });
      setDmMessages(prev => ({
        ...prev,
        [activeDM]: [...(prev[activeDM] || []), newMsg]
      }));
    } else {
      setMessages(prev => [...prev, newMsg]);
    }
  };

  const friendsRef = useRef(friends);
  useEffect(() => { friendsRef.current = friends; }, [friends]);

  const allowDirectMessagesRef = useRef(allowDirectMessages);
  useEffect(() => { allowDirectMessagesRef.current = allowDirectMessages; }, [allowDirectMessages]);
  useEffect(() => {
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_friends_${userName}`, JSON.stringify(friends));
    }
  }, [friends, userName]);

  const [blockedUsers, setBlockedUsers] = useState<{id: string, name: string, image: string}[]>(() => {
    const stored = localStorage.getItem(`vylant_blockedUsers_${userName}`);
    return stored ? JSON.parse(stored) : [];
  });
  const blockedUsersRef = useRef(blockedUsers);
  const deletedMessageIdsRef = useRef<Set<string>>(new Set());

  const handleBlockUser = async (user: {id: string, name: string, image: string}) => {
    if (!user || !user.name) {
      alert("Cannot block: User information is missing.");
      return;
    }
    try {
      const res = await apiFetch('/api/block', {
        method: 'POST',
        body: JSON.stringify({ targetName: user.name })
      });
      if (res.ok) {
        setBlockedUsers(prev => {
          if (prev.some(u => u.name === user.name)) return prev;
          return [...prev, { id: user.id, name: user.name, image: user.image }];
        });
        // Also remove them from friends if they are a friend
        setFriends(prev => prev.filter(f => f.name !== user.name));
        // Remove from friend requests if they sent one
        setFriendRequests(prev => prev.filter(req => req.name !== user.name));
        // Remove from recent DMs
        setRecentDMs(prev => prev.filter(dm => dm.name !== user.name));
        setBlockUserConfirm(null);
        setSelectedProfile(null);
      } else {
        const data = await res.json();
        alert(data.error || "Failed to block user");
      }
    } catch (e) {
      console.error("Error blocking user:", e);
    }
  };

  useEffect(() => {
    blockedUsersRef.current = blockedUsers;
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_blockedUsers_${userName}`, JSON.stringify(blockedUsers));
    }
  }, [blockedUsers, userName]);

  useEffect(() => {
    const token = localStorage.getItem('vylant_token') || sessionStorage.getItem('vylant_token');
    if (userName && userName !== 'T0AI User' && isInitialLoadRef.current && token) {
      apiFetch('/api/blocks')
        .then(res => {
          if (!res.ok) throw new Error(`Status ${res.status}`);
          return res.json();
        })
        .then(names => {
          if (Array.isArray(names)) {
            setBlockedUsers(prev => {
              const updated = [...prev];
              let changed = false;
              names.forEach(name => {
                if (!updated.some(u => u.name === name)) {
                  updated.push({ id: name, name: name, image: getRandomAvatar(name) });
                  changed = true;
                }
              });
              return changed ? updated : prev;
            });
          }
        })
        .catch(err => {
          if (userName !== 'T0AI User' && (localStorage.getItem('vylant_token') || sessionStorage.getItem('vylant_token'))) {
            console.warn(`Failed to fetch blocks from server (${err.message}):`, err);
          }
        });

      apiFetch('/api/blocking-me')
        .then(res => {
          if (!res.ok) throw new Error(`Status ${res.status}`);
          return res.json();
        })
        .then(names => {
          if (Array.isArray(names)) {
            setUsersBlockingMe(names);
          }
        })
        .catch(err => {
          if (userName !== 'T0AI User' && (localStorage.getItem('vylant_token') || sessionStorage.getItem('vylant_token'))) {
            console.warn(`Failed to fetch blocking-me from server (${err.message}):`, err);
          }
        });
    }
  }, [userName, isInitialLoadRef.current]);

  const [blockUserConfirm, setBlockUserConfirm] = useState<any>(null);
  const [usersBlockingMe, setUsersBlockingMe] = useState<string[]>([]);
  const usersBlockingMeRef = useRef<string[]>([]);
  useEffect(() => { usersBlockingMeRef.current = usersBlockingMe; }, [usersBlockingMe]);
  const [friendFilter, setFriendFilter] = useState<'all' | 'online' | 'offline' | 'idle' | 'dnd'>('all');
  const [friendSearch, setFriendSearch] = useState('');
  const [isFriendFilterOpen, setIsFriendFilterOpen] = useState(false);

  const [friendRequests, setFriendRequests] = useState<any[]>(() => {
    const stored = localStorage.getItem(`vylant_friendRequests_${userName}`);
    return stored ? JSON.parse(stored) : [];
  });
  const [vylantUsers, setVylantUsers] = useState<User[]>([]);
  const vylantUsersRef = useRef<User[]>([]);
  useEffect(() => { vylantUsersRef.current = vylantUsers; }, [vylantUsers]);

  const isPremium = useMemo(() => {
    return vylantUsers.find(u => u.name === userName)?.isPremium || false;
  }, [vylantUsers, userName]);

  // Sync friend requests when username changes or storage event occurs
  useEffect(() => {
    const syncRequests = () => {
      const stored = localStorage.getItem(`vylant_friendRequests_${userName}`);
      if (stored) {
        setFriendRequests(JSON.parse(stored));
      } else {
        setFriendRequests([]);
      }
    };

    syncRequests();

    const handleStorageChange = (e: StorageEvent) => {
      if (e.key === `vylant_friendRequests_${userName}`) {
        syncRequests();
      }
    };

    window.addEventListener('storage', handleStorageChange);
    // Also poll every few seconds as a fallback for same-tab changes if needed
    const interval = setInterval(syncRequests, 5000);

    return () => {
      window.removeEventListener('storage', handleStorageChange);
      clearInterval(interval);
    };
  }, [userName]);

  useEffect(() => {
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_friendRequests_${userName}`, JSON.stringify(friendRequests));
    }
  }, [friendRequests, userName]);

  const [openFriendMenuId, setOpenFriendMenuId] = useState<string | null>(null);

  const [sentFriendRequests, setSentFriendRequests] = useState<string[]>(() => {
    const stored = localStorage.getItem(`vylant_sentFriendRequests_${userName}`);
    return stored ? JSON.parse(stored) : [];
  });
  useEffect(() => {
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_sentFriendRequests_${userName}`, JSON.stringify(sentFriendRequests));
    }
