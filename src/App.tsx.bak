  // Automatically sync current active user into Saved Accounts list
  useEffect(() => {
    if (showApp && userName && userName !== 'T0AI User') {
      const token = localStorage.getItem('vylant_token') || sessionStorage.getItem('vylant_token') || '';
      const email = userEmail || localStorage.getItem('vylant_current_email') || '';
      const currentAccountsStr = localStorage.getItem('vylant_saved_accounts');
      let accounts: any[] = [];
      if (currentAccountsStr) {
        try {
          accounts = JSON.parse(currentAccountsStr);
          if (!Array.isArray(accounts)) accounts = [];
        } catch (e) {
          accounts = [];
        }
      }
      
      const existingIndex = accounts.findIndex(acc => acc.username.toLowerCase() === userName.toLowerCase());
      const accountData = {
        username: userName,
        email: email,
        token: token,
        image: userImage,
        sessionId: localStorage.getItem('vylant_session_id') || sessionStorage.getItem('vylant_session_id') || '',
        age: userAge,
        birthDate: userBirthDate,
        createdAt: accountCreatedAt?.toISOString() || ''
      };
      
      if (existingIndex > -1) {
        accounts[existingIndex] = { ...accounts[existingIndex], ...accountData };
      } else {
        accounts.push(accountData);
      }
      localStorage.setItem('vylant_saved_accounts', JSON.stringify(accounts));
      setSavedAccounts(accounts);
    }
  }, [showApp, userName, userEmail, userImage, userAge, userBirthDate, accountCreatedAt]);

  const handleSwitchAccount = (targetAcc: any) => {
    localStorage.setItem('vylant_current_username', targetAcc.username);
    if (targetAcc.email) localStorage.setItem('vylant_current_email', targetAcc.email);
    if (targetAcc.token) localStorage.setItem('vylant_token', targetAcc.token);
    if (targetAcc.sessionId) localStorage.setItem('vylant_session_id', targetAcc.sessionId);
    if (targetAcc.image) localStorage.setItem(`vylant_user_image_${targetAcc.username}`, targetAcc.image);
    if (targetAcc.age) localStorage.setItem('vylant_user_age', targetAcc.age.toString());
    if (targetAcc.birthDate) localStorage.setItem('vylant_user_birthdate', targetAcc.birthDate);
    if (targetAcc.createdAt) localStorage.setItem('vylant_account_created_at', targetAcc.createdAt);
    
    sessionStorage.removeItem('vylant_token');
    sessionStorage.removeItem('vylant_current_username');
    
    window.location.reload();
  };

