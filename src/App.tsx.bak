const RateLimitModal = ({ isOpen, onClose, isDarkMode }: { isOpen: boolean, onClose: () => void, isDarkMode: boolean }) => {
  if (!isOpen) return null;

  return createPortal(
    <AnimatePresence>
      <div className="fixed inset-0 z-[10000] flex items-center justify-center p-4">
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          onClick={onClose}
          className="absolute inset-0 bg-black/60 backdrop-blur-sm"
        />
        <motion.div
          initial={{ scale: 0.9, opacity: 0, y: 20 }}
          animate={{ scale: 1, opacity: 1, y: 0 }}
          exit={{ scale: 0.9, opacity: 0, y: 20 }}
          className={`relative w-full max-w-sm overflow-hidden rounded-[32px] shadow-3xl border ${
            isDarkMode ? 'bg-[#1e1f22] border-white/10 text-white' : 'bg-white border-slate-200 text-slate-900'
          }`}
        >
          <div className="p-8 text-center">
            <div className={`w-16 h-16 rounded-2xl mx-auto mb-6 flex items-center justify-center ${isDarkMode ? 'bg-red-500/10 text-red-500' : 'bg-red-50 text-red-500'}`}>
              <AlertTriangle size={32} />
            </div>
            <h2 className="text-2xl font-bold mb-2">You are being rate limited</h2>
            <p className={`text-sm mb-8 px-4 ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
              You are sending messages too fast. Please wait a few seconds before trying again.
            </p>
            <button
              onClick={onClose}
              className="w-full py-4 rounded-2xl font-bold text-sm bg-vylant-blue text-white hover:bg-vylant-blue/80 shadow-lg shadow-vylant-blue/20 active:scale-95 transition-all"
            >
              Got it
            </button>
          </div>
          <div className="h-1.5 w-full bg-red-500" />
        </motion.div>
      </div>
    </AnimatePresence>,
    document.body
  );
};

const FileTooLargeModal = ({ 
  isOpen, 
  onClose, 
  isDarkMode, 
  maxSize,
  pendingFile,
  onCompress
}: { 
  isOpen: boolean, 
  onClose: () => void, 
  isDarkMode: boolean, 
  maxSize: number,
  pendingFile: File | null,
  onCompress: (file: File) => void
}) => {
  const [isCompressing, setIsCompressing] = useState(false);
  const [compressionProgress, setCompressionProgress] = useState(0);
  const cancelRef = useRef(false);

  if (!isOpen) return null;

  const isVideo = pendingFile?.type.startsWith('video/');
  const isImage = pendingFile?.type.startsWith('image/');

  const handleCancel = () => {
    cancelRef.current = true;
    setIsCompressing(false);
    setCompressionProgress(0);
    onClose();
  };

  const handleCompress = async () => {
    if (!pendingFile) return;
    cancelRef.current = false;
    setIsCompressing(true);
    setCompressionProgress(10);

    try {
      if (isVideo) {
        const compressed = await compressVideo(pendingFile, maxSize);
        if (!cancelRef.current) {
          onCompress(compressed);
        }
      } else if (isImage) {
        const compressed = await compressImage(pendingFile, maxSize);
        if (!cancelRef.current) {
          onCompress(compressed);
        }
      } else {
        if (!cancelRef.current) {
          onCompress(pendingFile);
        }
      }
    } catch (error) {
      console.warn("Compression fallback:", error);
      if (!cancelRef.current) {
        onCompress(pendingFile);
      }
    } finally {
      setIsCompressing(false);
      setCompressionProgress(0);
      onClose();
    }
  };

  const compressImage = async (file: File, targetMB: number): Promise<File> => {
    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          let width = img.width;
          let height = img.height;
          
          const maxDim = 1920;
          if (width > maxDim || height > maxDim) {
            if (width > height) {
              height = (height / width) * maxDim;
              width = maxDim;
            } else {
              width = (width / height) * maxDim;
              height = maxDim;
            }
          }

          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx?.drawImage(img, 0, 0, width, height);
          
          let quality = 0.8;
          const attempt = () => {
            canvas.toBlob((blob) => {
              if (blob && blob.size < targetMB * 1024 * 1024) {
                resolve(new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".jpg", { type: 'image/jpeg' }));
              } else if (quality > 0.1) {
                quality -= 0.1;
                attempt();
              } else {
                resolve(new File([blob!], file.name, { type: 'image/jpeg' }));
              }
            }, 'image/jpeg', quality);
          };
          attempt();
        };
        img.src = e.target?.result as string;
      };
      reader.readAsDataURL(file);
    });
  };

  const compressVideo = async (file: File, targetMB: number): Promise<File> => {
    return new Promise((resolve) => {
      let progress = 10;
      const interval = setInterval(() => {
        if (cancelRef.current) {
          clearInterval(interval);
          return;
        }
        progress += 15;
        if (progress >= 95) progress = 95;
        setCompressionProgress(progress);
      }, 300);

      const timeout = setTimeout(() => {
        clearInterval(interval);
        setCompressionProgress(100);
        resolve(file);
      }, 3000);

      try {
        const video = document.createElement('video');
        video.src = URL.createObjectURL(file);
        video.muted = true;
        video.playsInline = true;
        
        video.onloadedmetadata = () => {
          const stream = (video as any).captureStream ? (video as any).captureStream() : (video as any).mozCaptureStream ? (video as any).mozCaptureStream() : null;
          if (!stream) {
            clearTimeout(timeout);
            clearInterval(interval);
            resolve(file);
            return;
          }

          try {
            const mediaRecorder = new MediaRecorder(stream, { videoBitsPerSecond: 1500000 });
            const chunks: Blob[] = [];
            mediaRecorder.ondataavailable = (e) => { if (e.data.size > 0) chunks.push(e.data); };
            mediaRecorder.onstop = () => {
              clearTimeout(timeout);
              clearInterval(interval);
              const blob = new Blob(chunks, { type: 'video/webm' });
              resolve(blob.size > 0 ? new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".webm", { type: 'video/webm' }) : file);
            };
            video.onended = () => mediaRecorder.stop();
            mediaRecorder.start();
            video.play().catch(() => {
              clearTimeout(timeout);
              clearInterval(interval);
              resolve(file);
            });
          } catch (e) {
            clearTimeout(timeout);
            clearInterval(interval);
            resolve(file);
          }
        };
        video.onerror = () => {
          clearTimeout(timeout);
          clearInterval(interval);
          resolve(file);
        };
      } catch (e) {
        clearTimeout(timeout);
        clearInterval(interval);
        resolve(file);
      }
    });
  };

  return createPortal(
    <AnimatePresence>
      <div className="fixed inset-0 z-[10000] flex items-center justify-center p-4">
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          onClick={handleCancel}
          className="absolute inset-0 bg-black/80 backdrop-blur-md"
        />
        <motion.div
          initial={{ scale: 0.9, opacity: 0, y: 20 }}
          animate={{ scale: 1, opacity: 1, y: 0 }}
          exit={{ scale: 0.9, opacity: 0, y: 20 }}
          className={`relative w-full max-w-sm overflow-hidden rounded-[32px] shadow-3xl border ${
            isDarkMode ? 'bg-[#1e1f22] border-white/10 text-white' : 'bg-white border-slate-200 text-slate-900'
          }`}
        >
          <button
            onClick={handleCancel}
            className="absolute top-4 right-4 p-2 rounded-full text-slate-400 hover:text-white hover:bg-white/10 transition-all z-10 cursor-pointer"
            title="Close"
          >
            <X size={18} />
          </button>

          <div className="p-8 text-center">
            <div className={`w-16 h-16 rounded-2xl mx-auto mb-6 flex items-center justify-center ${isDarkMode ? 'bg-red-500/10 text-red-500' : 'bg-red-50 text-red-500'}`}>
              {isCompressing ? <Zap size={32} className="animate-pulse text-vylant-blue" /> : <AlertTriangle size={32} />}
            </div>
            
            <h2 className="text-2xl font-bold mb-2">
              {isCompressing ? 'Compressing File...' : 'File is large'}
            </h2>
            
            <p className={`text-sm mb-8 px-4 ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
              {isCompressing 
                ? `Compressing your ${isVideo ? 'video' : 'image'} to fit under ${maxSize}MB...`
                : `Max file size is ${maxSize}MB. Your file is ${(pendingFile!.size / (1024 * 1024)).toFixed(1)}MB.`
              }
            </p>

            {isCompressing && (
              <div className="mb-8 px-4">
                <div className="h-2 w-full bg-black/20 rounded-full overflow-hidden">
                  <motion.div 
                    className="h-full bg-vylant-blue" 
                    initial={{ width: 0 }}
                    animate={{ width: `${compressionProgress}%` }}
                  />
                </div>
                <p className="text-[10px] mt-2 font-mono uppercase tracking-widest opacity-40">{compressionProgress}% Complete</p>
              </div>
            )}

            <div className="flex flex-col gap-3">
              {(isVideo || isImage) && !isCompressing && (
                <button
                  onClick={handleCompress}
                  className="w-full py-4 bg-vylant-blue text-white rounded-2xl font-bold hover:brightness-110 active:scale-95 transition-all text-sm uppercase tracking-widest shadow-lg shadow-vylant-blue/20 flex items-center justify-center gap-2"
                >
                  <Zap size={16} />
                  Compress & Upload
                </button>
              )}
              
              <button
                onClick={handleCancel}
                className={`w-full py-4 rounded-2xl font-bold active:scale-95 transition-all text-sm uppercase tracking-widest ${
                  isDarkMode ? 'bg-white/5 text-white/60 hover:bg-white/10' : 'bg-slate-100 text-slate-500 hover:bg-slate-200'
                }`}
              >
                {isCompressing ? 'Cancel Compression' : 'Cancel'}
              </button>
            </div>
          </div>
        </motion.div>
      </div>
    </AnimatePresence>,
    document.body
  );
};

const MessageAttachment: React.FC<{ att: any; isDarkMode: boolean; onImageClick?: (url: string) => void }> = ({ att, isDarkMode, onImageClick }) => {
  const [isRevealed, setIsRevealed] = useState(false);
  const isSpoiler = att.isSpoiler;

  const handleClick = () => {
    if (isSpoiler && !isRevealed) {
      setIsRevealed(true);
      return;
    }
    if ((att.type === 'image' || att.type === 'video') && onImageClick) {
      onImageClick(att.url);
    }
  };

  return (
    <motion.div 
      whileHover={{ scale: 1.02 }}
      className="relative group/media overflow-hidden rounded-xl border border-white/10 shadow-xl bg-black/20"
      onClick={handleClick}
    >
      <div className={`transition-all duration-500 ${isSpoiler && !isRevealed ? 'blur-2xl scale-110' : ''}`}>
        {att.type === 'image' ? (
          <div className="relative group/attmedia">
            <img 
              src={att.url} 
              alt="Attachment" 
              className="w-full h-auto object-cover max-h-60"
              referrerPolicy="no-referrer"
            />
            {(!isSpoiler || isRevealed) && (
              <div className="absolute top-2 right-2 flex items-center gap-1.5 opacity-0 group-hover/media:opacity-100 transition-opacity z-10">
                <button
                  onClick={(e) => {
                    e.stopPropagation();
                    handleDownloadMedia(att.url, att.name || 'vylant-image');
                  }}
                  className="p-1.5 bg-black/75 hover:bg-black backdrop-blur-md text-white rounded-lg border border-white/20 transition-all shadow-md active:scale-95 flex items-center gap-1 text-[10px] font-bold"
                  title="Download Image"
                >
                  <Download size={14} className="text-emerald-400" />
                </button>
              </div>
            )}
          </div>
        ) : att.type === 'video' ? (
          <div className="relative group/attmedia">
            <video 
              src={att.url} 
              className="w-full h-auto max-h-60" 
              controls={!isSpoiler || isRevealed} 
              playsInline
              referrerPolicy="no-referrer"
            />
            {(!isSpoiler || isRevealed) && (
              <div className="absolute top-2 right-2 flex items-center gap-1.5 opacity-0 group-hover/media:opacity-100 transition-opacity z-10">
                <button
                  onClick={(e) => {
                    e.stopPropagation();
                    handleDownloadMedia(att.url, att.name || 'vylant-video');
                  }}
                  className="p-1.5 bg-black/75 hover:bg-black backdrop-blur-md text-white rounded-lg border border-white/20 transition-all shadow-md active:scale-95 flex items-center gap-1 text-[10px] font-bold"
                  title="Download Video"
                >
                  <Download size={14} className="text-emerald-400" />
                </button>
              </div>
            )}
          </div>
        ) : att.type === 'audio' ? (
          <div className="p-4 bg-vylant-blue/10 flex items-center justify-between gap-3">
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded-full bg-vylant-blue/20 flex items-center justify-center text-vylant-blue">
                <Play size={20} fill="currentColor" />
              </div>
              <span className="text-[10px] font-mono uppercase tracking-widest text-vylant-blue">Audio Track</span>
            </div>
            <button
              onClick={(e) => {
                e.stopPropagation();
                handleDownloadMedia(att.url, att.name || 'vylant-audio');
              }}
              className="p-2 rounded-lg bg-black/20 text-white/60 hover:text-white transition-all"
              title="Download Audio"
            >
              <Download size={16} className="text-emerald-400" />
            </button>
          </div>
        ) : (
          <div className="p-4 flex items-center gap-4 group/file hover:bg-white/5 transition-colors">
            <div className="p-3 rounded-xl bg-vylant-blue/10 text-vylant-blue">
              <FileIcon size={24} />
            </div>
            <div className="flex-1 min-w-0">
              <p className="font-bold text-[10px] truncate uppercase tracking-widest">{att.name || 'File Attachment'}</p>
              {att.size && <p className="text-[8px] opacity-50 font-mono">{(att.size / (1024 * 1024)).toFixed(2)} MB</p>}
            </div>
            <button 
              onClick={(e) => {
                e.stopPropagation();
                handleDownloadMedia(att.url, att.name || 'vylant-file');
              }} 
              className="p-2 rounded-lg bg-black/20 text-white/40 hover:text-white transition-all"
              title="Download File"
            >
              <Download size={16} />
            </button>
          </div>
        )}
      </div>

      {isSpoiler && !isRevealed && (
        <div className="absolute inset-0 z-20 flex items-center justify-center cursor-pointer bg-black/40 backdrop-blur-sm group-hover/media:bg-black/20 transition-all">
          <div className="px-4 py-2 rounded-full bg-black/60 border border-white/20 text-white text-[10px] font-black uppercase tracking-[0.2em] shadow-2xl flex items-center gap-2">
            <EyeOff size={14} className="text-vylant-blue" />
            Spoiler
          </div>
        </div>
      )}

      {att.type === 'image' && (!isSpoiler || isRevealed) && (
        <div className="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover/media:opacity-100 transition-opacity flex items-end p-2 pointer-events-none">
           <span className="text-[8px] font-mono font-bold text-white/70 uppercase tracking-widest">{att.name || 'Image'}</span>
        </div>
      )}
    </motion.div>
  );
};

const FileUploadPreview = ({ 
  attachments,
  onRemove,
  onToggleSpoiler,
  isDarkMode 
}: { 
  attachments: Array<{
    id: string;
    preview: string;
    type: 'image' | 'video' | 'file' | 'audio';
    url: string | null;
    isUploading: boolean;
    file?: File;
    isSpoiler: boolean;
  }>,
  onRemove: (id: string) => void,
  onToggleSpoiler: (id: string) => void,
  isDarkMode: boolean
}) => {
  if (attachments.length === 0) return null;

  return (
    <div className="flex flex-wrap gap-3 p-2">
      <AnimatePresence>
        {attachments.map((attachment) => {
          const extension = attachment.file?.name?.split('.').pop()?.toUpperCase() || 'DATA';
          
          return (
            <motion.div 
              key={attachment.id}
              initial={{ opacity: 0, scale: 0.9, y: 10 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.9, y: 10 }}
              className="relative group p-1"
            >
              <div className={`relative overflow-hidden rounded-2xl border-2 transition-all duration-300 shadow-2xl ${
                attachment.isUploading ? 'border-vylant-blue animate-pulse shadow-vylant-blue/20' : 'border-vylant-blue/40 group-hover:border-vylant-blue'
              } ${isDarkMode ? 'bg-black/60' : 'bg-white'}`}>
                
                {/* Content Area */}
                <div className={`relative w-24 h-24 md:w-28 md:h-28 flex items-center justify-center ${attachment.isSpoiler ? 'grayscale-[0.5] contrast-[0.8]' : ''}`}>
                  {attachment.type === 'file' || attachment.preview === 'FILE_ATTACHMENT' ? (
                    <div className="flex flex-col items-center gap-1 p-2">
                      <div className={`p-2 rounded-lg ${isDarkMode ? 'bg-vylant-blue/20 text-vylant-blue' : 'bg-vylant-blue/10 text-vylant-blue'}`}>
                        <FileIcon size={24} />
                      </div>
                      <span className="text-[8px] font-black uppercase tracking-tighter opacity-50 truncate max-w-[80px]">
                        {attachment.file?.name || extension}
                      </span>
                    </div>
                  ) : attachment.type === 'video' ? (
                    <div className="relative w-full h-full flex items-center justify-center bg-black/40">
                      <video src={attachment.preview} className="h-full w-full object-cover" muted playsInline />
                      <div className="absolute inset-0 flex items-center justify-center bg-black/20 backdrop-blur-[1px]">
                        <div className="w-8 h-8 rounded-full bg-vylant-blue/20 border border-vylant-blue/40 flex items-center justify-center text-vylant-blue shadow-lg">
                          <Play size={16} fill="currentColor" />
                        </div>
                      </div>
                    </div>
                  ) : (
                    <img 
                      src={attachment.preview} 
                      alt="Preview" 
                      className="h-full w-full object-cover rounded-xl" 
                      referrerPolicy="no-referrer"
                    />
                  )}

                  {/* Spoiler Tag Overlay */}
                  {attachment.isSpoiler && (
                    <div className="absolute inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center">
                      <span className="text-[10px] font-black text-white uppercase tracking-widest border border-white/20 px-2 py-1 rounded bg-black/40">Spoiler</span>
                    </div>
                  )}

                  {/* Attachment Type Badge */}
                  <div className="absolute top-1 right-1 opacity-60">
                    <span className="text-[6px] font-mono font-bold uppercase tracking-widest px-1 py-0.5 rounded border border-white/10 bg-black/40 text-white/80">
                      {attachment.type}
                    </span>
                  </div>

                  {/* Upload Status Overlay */}
                  {attachment.isUploading && (
                    <div className="absolute inset-0 bg-black/70 backdrop-blur-[2px] flex flex-col items-center justify-center gap-1.5 z-20">
                      <div className="relative">
                        <Loader2 size={22} className="text-vylant-blue animate-spin" />
                      </div>
                      <span className="text-[9px] font-black text-vylant-blue uppercase tracking-wider px-1 py-0.5 rounded bg-black/60 border border-vylant-blue/30">
                        {attachment.type === 'video' ? 'Loading Video' : 'Uploading'}
                      </span>
                    </div>
                  )}

                  {attachment.url && !attachment.isUploading && (
                    <div className="absolute top-1 left-1">
                      <div className="bg-emerald-500 text-white p-0.5 rounded-full shadow-lg border border-white/20">
                        <Check size={8} strokeWidth={4} />
                      </div>
                    </div>
                  )}
                </div>
              </div>

              {/* Action Buttons Container */}
              <div className="absolute -top-2 -right-2 flex flex-col gap-1 z-30 opacity-0 group-hover:opacity-100 transition-opacity">
                {/* Delete Button */}
                <button 
                  onClick={() => onRemove(attachment.id)}
                  className="p-1.5 bg-red-500 text-white rounded-lg hover:scale-110 active:scale-95 transition-all shadow-xl border border-white/20 hover:rotate-12"
                  title="Remove"
                >
                  <X size={10} strokeWidth={3} />
                </button>
                {/* Spoiler Toggle Button */}
                {(attachment.type === 'image' || attachment.type === 'video') && (
                  <button 
                    onClick={() => onToggleSpoiler(attachment.id)}
                    className={`p-1.5 rounded-lg hover:scale-110 active:scale-95 transition-all shadow-xl border border-white/20 ${attachment.isSpoiler ? 'bg-vylant-blue text-white' : 'bg-slate-700 text-slate-300'}`}
                    title="Mark as Spoiler"
                  >
                    <EyeOff size={10} strokeWidth={3} />
                  </button>
                )}
              </div>
            </motion.div>
          );
        })}
      </AnimatePresence>



    </div>
  );
};

interface FormattingBubbleProps {
  inputId: string;
  isDarkMode: boolean;
  onFormat: (type: 'bold' | 'strike' | 'spoiler') => void;
  onClear: () => void;
}

const SelectionFormattingBubble: React.FC<FormattingBubbleProps> = ({ inputId, isDarkMode, onFormat, onClear }) => {
  return (
    <motion.div
      initial={{ opacity: 0, scale: 0.9, y: 5 }}
      animate={{ opacity: 1, scale: 1, y: 0 }}
      exit={{ opacity: 0, scale: 0.9, y: 5 }}
      className={`absolute bottom-full left-1/2 -translate-x-1/2 mb-3 z-[110] flex items-center gap-1 p-1 rounded-xl shadow-2xl border ${
        isDarkMode
          ? 'bg-slate-900/95 border-white/10 text-white backdrop-blur-md shadow-black/80'
          : 'bg-white/95 border-slate-200 text-slate-800 backdrop-blur-md shadow-slate-300'
      }`}
    >
      <button
        type="button"
        onMouseDown={(e) => {
          e.preventDefault();
          onFormat('bold');
        }}
        className={`p-1.5 md:p-2 rounded-lg flex items-center justify-center transition-colors hover:scale-105 active:scale-95 text-xs font-semibold gap-1 ${
          isDarkMode
            ? 'hover:bg-white/10 text-white/80 hover:text-white'
            : 'hover:bg-slate-100 text-slate-700 hover:text-slate-900'
        }`}
        title="Bold (**text**)"
      >
        <Bold size={14} className="stroke-[2.5]" />
        <span className="hidden sm:inline text-[10px]">Bold</span>
      </button>

      <div className={`w-[1px] h-4 ${isDarkMode ? 'bg-white/10' : 'bg-slate-200'}`} />

      <button
        type="button"
        onMouseDown={(e) => {
          e.preventDefault();
          onFormat('strike');
        }}
        className={`p-1.5 md:p-2 rounded-lg flex items-center justify-center transition-colors hover:scale-105 active:scale-95 text-xs font-semibold gap-1 ${
          isDarkMode
            ? 'hover:bg-white/10 text-white/80 hover:text-white'
            : 'hover:bg-slate-100 text-slate-700 hover:text-slate-900'
        }`}
        title="Strikeout (~~text~~)"
      >
        <Strikethrough size={14} className="stroke-[2.5]" />
        <span className="hidden sm:inline text-[10px]">Strike</span>
      </button>

      <div className={`w-[1px] h-4 ${isDarkMode ? 'bg-white/10' : 'bg-slate-200'}`} />

      <button
        type="button"
        onMouseDown={(e) => {
          e.preventDefault();
          onFormat('spoiler');
        }}
        className={`p-1.5 md:p-2 rounded-lg flex items-center justify-center transition-colors hover:scale-105 active:scale-95 text-xs font-semibold gap-1 ${
          isDarkMode
            ? 'hover:bg-white/10 text-white/80 hover:text-white'
            : 'hover:bg-slate-100 text-slate-700 hover:text-slate-900'
        }`}
        title="Spoiler (||text||)"
      >
        <EyeOff size={14} className="stroke-[2.5]" />
        <span className="hidden sm:inline text-[10px]">Spoiler</span>
      </button>

      <div className={`w-[1px] h-4 ${isDarkMode ? 'bg-white/10' : 'bg-slate-200'}`} />

      <button
        type="button"
        onMouseDown={(e) => {
          e.preventDefault();
          onClear();
        }}
        className={`p-1.5 md:p-2 rounded-lg flex items-center justify-center transition-colors hover:scale-105 active:scale-95 text-xs font-semibold text-red-500 hover:text-red-400 ${
          isDarkMode ? 'hover:bg-white/10' : 'hover:bg-slate-100'
        }`}
        title="Dismiss toolbar"
      >
        <X size={14} />
      </button>

      <div className={`w-2 h-2 rotate-45 border-r border-b absolute top-full -translate-y-1 left-1/2 -translate-x-1/2 ${
        isDarkMode
          ? 'bg-slate-900/95 border-white/10'
          : 'bg-white/95 border-slate-200'
      }`} />
    </motion.div>
  );
};

const pruneServerMessagesForStorage = (messages: Record<string, Record<string, Message[]>>): Record<string, Record<string, Message[]>> => {
  const pruned: Record<string, Record<string, Message[]>> = {};
  Object.entries(messages).forEach(([serverId, channels]) => {
    pruned[serverId] = {};
    Object.entries(channels).forEach(([channelId, msgs]) => {
      pruned[serverId][channelId] = msgs.slice(-100);
    });
  });
  return pruned;
};

const pruneDmMessagesForStorage = (messages: Record<string, Message[]>): Record<string, Message[]> => {
  const pruned: Record<string, Message[]> = {};
  Object.entries(messages).forEach(([dmUser, msgs]) => {
    pruned[dmUser] = msgs.slice(-100);
  });
  return pruned;
};

const renderPaginatedMessages = (
  msgs: Message[],
  _chatPageIndex: number,
  _setChatPageIndex: React.Dispatch<React.SetStateAction<number>>,
  renderMessage: (msg: Message, index: number) => React.ReactNode
) => {
  if (msgs.length === 0) return null;

  return (
    <>
      {msgs.map((msg, idx) => renderMessage(msg, idx))}
    </>
  );
};

export default function App() {
  const [audioInputs, setAudioInputs] = useState<MediaDeviceInfo[]>([]);
  const [audioOutputs, setAudioOutputs] = useState<MediaDeviceInfo[]>([]);
  const [videoInputs, setVideoInputs] = useState<MediaDeviceInfo[]>([]);
  const [speakingUsers, setSpeakingUsers] = useState<Set<string>>(new Set());
  const [showJumpToBottom, setShowJumpToBottom] = useState(false);
  const [iceServers, setIceServers] = useState<any[]>([{ urls: 'stun:stun.l.google.com:19302' }]);
  const [replyingTo, setReplyingTo] = useState<Message | null>(null);

  // Fetch ICE servers on mount
  useEffect(() => {
    const fetchIceServers = async () => {
      try {
        const res = await apiFetch('/api/config/ice-servers');
        if (res.ok) {
          const data = await res.json();
          if (data.iceServers) setIceServers(data.iceServers);
        }
      } catch (err) {
        console.warn("Failed to fetch ICE servers from server, using default STUN.");
      }
    };
    fetchIceServers();
  }, []);
  const [selectedInputDevice, setSelectedInputDevice] = useState<string>(() => {
    if (typeof window !== 'undefined') {
      return localStorage.getItem('vylant_selectedInputDevice') || 'default';
    }
    return 'default';
  });
  const [selectedOutputDevice, setSelectedOutputDevice] = useState<string>(() => {
    if (typeof window !== 'undefined') {
      return localStorage.getItem('vylant_selectedOutputDevice') || 'default';
    }
    return 'default';
  });
  const [selectedVideoDevice, setSelectedVideoDevice] = useState<string>(() => {
    if (typeof window !== 'undefined') {
      return localStorage.getItem('vylant_selectedVideoDevice') || 'default';
    }
    return 'default';
  });

  const [screenShareQuality, setScreenShareQuality] = useState<'480p' | '720p' | '1080p' | '1440p' | 'source'>(() => {
    if (typeof window !== 'undefined') {
      return (localStorage.getItem('vylant_screenShareQuality') as any) || '1080p';
    }
    return '1080p';
  });

  const [screenShareFPS, setScreenShareFPS] = useState<15 | 30 | 60>(() => {
    if (typeof window !== 'undefined') {
      const stored = localStorage.getItem('vylant_screenShareFPS');
      return stored ? (parseInt(stored) as 15 | 30 | 60) : 30;
    }
    return 30;
  });

  useEffect(() => {
    localStorage.setItem('vylant_screenShareQuality', screenShareQuality);
  }, [screenShareQuality]);

  useEffect(() => {
    localStorage.setItem('vylant_screenShareFPS', screenShareFPS.toString());
  }, [screenShareFPS]);

  useEffect(() => {
    if (selectedInputDevice && selectedInputDevice !== 'default') {
      localStorage.setItem('vylant_selectedInputDevice', selectedInputDevice);
    }
  }, [selectedInputDevice]);

  useEffect(() => {
    if (selectedOutputDevice && selectedOutputDevice !== 'default') {
      localStorage.setItem('vylant_selectedOutputDevice', selectedOutputDevice);
    }
  }, [selectedOutputDevice]);

  useEffect(() => {
    if (selectedVideoDevice && selectedVideoDevice !== 'default') {
      localStorage.setItem('vylant_selectedVideoDevice', selectedVideoDevice);
    }
  }, [selectedVideoDevice]);

  const refreshDevices = useCallback(async () => {
    try {
      const devices = await navigator.mediaDevices.enumerateDevices();
      const serializeDevice = (d: MediaDeviceInfo) => ({
        deviceId: d.deviceId,
        label: d.label || (d.kind === 'audioinput' ? 'Microphone' : d.kind === 'audiooutput' ? 'Speaker' : 'Camera'),
        kind: d.kind,
        groupId: d.groupId,
        toJSON: () => ({ deviceId: d.deviceId, label: d.label, kind: d.kind, groupId: d.groupId })
      } as unknown as MediaDeviceInfo);

      const inputs = devices.filter(device => device.kind === 'audioinput').map(serializeDevice);
      const outputs = devices.filter(device => device.kind === 'audiooutput').map(serializeDevice);
      const videos = devices.filter(device => device.kind === 'videoinput').map(serializeDevice);
      setAudioInputs(inputs);
      setAudioOutputs(outputs);
      setVideoInputs(videos);
      
      // Set defaults if not set
      if (selectedInputDevice === 'default' && inputs.length > 0) {
        const def = inputs.find(i => i.deviceId === 'default') || inputs[0];
        setSelectedInputDevice(def.deviceId);
      }
      if (selectedOutputDevice === 'default' && outputs.length > 0) {
        const def = outputs.find(o => o.deviceId === 'default') || outputs[0];
        setSelectedOutputDevice(def.deviceId);
      }
      if (selectedVideoDevice === 'default' && videos.length > 0) {
        const def = videos.find(v => v.deviceId === 'default') || videos[0];
        setSelectedVideoDevice(def.deviceId);
      }
    } catch (err) {
      console.error('Error refreshing media devices:', err);
    }
  }, [selectedInputDevice, selectedOutputDevice, selectedVideoDevice]);

  useEffect(() => {
    if (typeof window !== 'undefined' && navigator.mediaDevices) {
      refreshDevices();
      navigator.mediaDevices.addEventListener('devicechange', refreshDevices);
      return () => {
        navigator.mediaDevices.removeEventListener('devicechange', refreshDevices);
      };
    }
  }, []);

  const [userName, setUserName] = useState(() => localStorage.getItem('vylant_current_username') || sessionStorage.getItem('vylant_current_username') || 'T0AI User');
  const [userEmail, setUserEmail] = useState(() => localStorage.getItem('vylant_current_email') || sessionStorage.getItem('vylant_current_email') || "You haven't added a email yet");
  const [userAge, setUserAge] = useState<number>(() => {
    const stored = localStorage.getItem('vylant_user_age') || sessionStorage.getItem('vylant_user_age');
    return stored ? parseInt(stored) : 18;
  });
  const [userBirthDate, setUserBirthDate] = useState<string | null>(() => {
    return localStorage.getItem('vylant_user_birthdate') || sessionStorage.getItem('vylant_user_birthdate');
  });
  const [userPhone, setUserPhone] = useState('');
  const [userImage, setUserImage] = useState(() => {
    const saved = localStorage.getItem(`vylant_user_image_${userName}`);
    if (saved) return saved;
    return getRandomAvatar(userName);
  });

  useEffect(() => {
    if (userName && userName !== 'T0AI User') {
      localStorage.setItem(`vylant_user_image_${userName}`, userImage);
    }
  }, [userImage]);

  const [isStripeLoading, setIsStripeLoading] = useState(false);
  const [isSimulatedStripeModalOpen, setIsSimulatedStripeModalOpen] = useState(false);

  // Stripe & simulated payment check
  useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    const paymentStatus = params.get('payment');
    const sessionId = params.get('session_id');
    
    if (paymentStatus === 'status_success' && sessionId) {
      apiFetch(`/api/stripe/verify-payment?session_id=${sessionId}`)
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            setSuccessModalData({
              title: "Payment Approved!",
              message: "Vylant Premium has been unlocked successfully. Enjoy exclusive badges & custom server themes!",
              iconType: 'success'
            });
            window.history.replaceState({}, document.title, window.location.pathname);
            // Request users sync to get the premium badge instantly
            if (socketRef.current) {
              socketRef.current.emit("sync-users");
            }
          } else {
            alert(data.error || "Failed to verify the Stripe payment.");
          }
        })
        .catch(err => {
          console.error("Payment verification failed", err);
        });
    } else if (paymentStatus === 'status_cancel') {
      alert("Payment was cancelled.");
      window.history.replaceState({}, document.title, window.location.pathname);
    }

    const addFriendParam = params.get('addFriend');
    if (addFriendParam) {
      setAddFriendInput(addFriendParam);
      setIsAddFriendModalOpen(true);
      const cleanParams = new URLSearchParams(window.location.search);
      cleanParams.delete('addFriend');
      const newPath = cleanParams.toString() ? `${window.location.pathname}?${cleanParams.toString()}` : window.location.pathname;
      window.history.replaceState({}, document.title, newPath);
    }

    const marketplaceItemParam = params.get('marketplaceItem');
    const serverParam = params.get('server');
    if (marketplaceItemParam && serverParam) {
      setActiveServer(serverParam);
      setActiveView('server');
      const cleanParams = new URLSearchParams(window.location.search);
      cleanParams.delete('marketplaceItem');
      cleanParams.delete('server');
      const newPath = cleanParams.toString() ? `${window.location.pathname}?${cleanParams.toString()}` : window.location.pathname;
      window.history.replaceState({}, document.title, newPath);
    }
  }, [userName]);

  // Migrate accounts on load
  useEffect(() => {
    const migrateAccounts = async () => {
      const storedAccounts = localStorage.getItem('vylant_accounts');
      if (storedAccounts) {
        try {
          const parsedAccounts = JSON.parse(storedAccounts);
          await apiFetch('/api/migrate-accounts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ accounts: parsedAccounts })
          });
        } catch (e) {
          console.error('Failed to migrate accounts', e);
        }
      }
    };
    migrateAccounts();
  }, []);

  const [userStatus, setUserStatus] = useState<UserStatus>(() => {
    const stored = localStorage.getItem(`vylant_userStatus_${userName}`);
    return (stored as UserStatus) || 'online';
  });

  useEffect(() => {
    if (userName) {
      localStorage.setItem(`vylant_userStatus_${userName}`, userStatus);
    }
  }, [userStatus, userName]);
  const [showApp, setShowApp] = useState(() => !!(localStorage.getItem('vylant_current_username') || sessionStorage.getItem('vylant_current_username')));
  const [showRateLimitModal, setShowRateLimitModal] = useState(false);
  const messageTimestampsRef = useRef<number[]>([]);
  const [isDarkMode, setIsDarkMode] = useState(() => {
    const stored = localStorage.getItem('vylant_theme');
    if (stored !== null) return stored === 'dark';
    return true;
  });

  useEffect(() => {
    localStorage.setItem('vylant_theme', isDarkMode ? 'dark' : 'light');
    if (isDarkMode) {
      document.documentElement.classList.add('dark');
      document.documentElement.classList.remove('light');
    } else {
      document.documentElement.classList.remove('dark');
      document.documentElement.classList.add('light');
    }
  }, [isDarkMode]);
  const [accountCreatedAt, setAccountCreatedAt] = useState(() => {
    const stored = localStorage.getItem('vylant_account_created_at') || sessionStorage.getItem('vylant_account_created_at');
    if (stored) return new Date(stored);
    const now = new Date();
    return now;
  });
  const [activeView, setActiveView] = useState<'landing' | 'login' | 'signup' | 'home' | 'messages' | 'friends' | 'server' | 'support' | 'privacy' | 'terms' | 'discover'>(() => {
    const isLoggedIn = !!(localStorage.getItem('vylant_current_username') || sessionStorage.getItem('vylant_current_username'));
    return isLoggedIn ? 'home' : 'landing';
  });

  const [tabOrder, setTabOrder] = useState<string[]>(() => {
    if (typeof window !== 'undefined') {
      const saved = localStorage.getItem('vylant-tab-order');
      if (saved) {
        try {
          return JSON.parse(saved);
        } catch(e) {}
      }
    }
    return ['home', 'discover', 'friends', 'messages'];
  });
  const [draggedTab, setDraggedTab] = useState<string | null>(null);
  const [dragOverTab, setDragOverTab] = useState<string | null>(null);

  useEffect(() => {
    localStorage.setItem('vylant-tab-order', JSON.stringify(tabOrder));
  }, [tabOrder]);

  const handleStorageChange = () => {
      const isLoggedIn = !!(localStorage.getItem('vylant_current_username') || sessionStorage.getItem('vylant_current_username'));
      setShowApp(isLoggedIn);
      setActiveView(prev => isLoggedIn ? (prev === 'landing' || prev === 'login' || prev === 'signup' ? 'home' : prev) : 'landing');
    };

  useEffect(() => {
    window.addEventListener('storage', handleStorageChange);
    return () => {
      window.removeEventListener('storage', handleStorageChange);
    };
  }, []);

  const handleTabDragStart = (e: React.DragEvent, id: string) => {
    setDraggedTab(id);
    e.dataTransfer.effectAllowed = 'move';
  };

  const handleTabDragOver = (e: React.DragEvent, id: string) => {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    if (id !== dragOverTab) setDragOverTab(id);
  };

  const handleTabDragLeave = (e: React.DragEvent) => {
    setDragOverTab(null);
  };

  const handleTabDrop = (e: React.DragEvent, targetId: string) => {
    e.preventDefault();
    setDragOverTab(null);
    if (!draggedTab || draggedTab === targetId) return;

    setTabOrder(prev => {
      const newOrder = [...prev];
      const sourceIdx = newOrder.indexOf(draggedTab);
      const targetIdx = newOrder.indexOf(targetId);
      if (sourceIdx !== -1 && targetIdx !== -1) {
        newOrder.splice(sourceIdx, 1);
        newOrder.splice(targetIdx, 0, draggedTab);
      }
      return newOrder;
    });
    setDraggedTab(null);
  };

  const [sidebarTouchDragTab, setSidebarTouchDragTab] = useState<string | null>(null);
  const sidebarHoldTimerRef = useRef<NodeJS.Timeout | null>(null);
  const sidebarTouchStartPosRef = useRef<{ x: number; y: number } | null>(null);
  const isSidebarTouchDraggingRef = useRef<boolean>(false);
  const hasSidebarTouchDraggedRef = useRef<boolean>(false);
  const sidebarActiveTabRef = useRef<string | null>(null);
  const sidebarTabOrderRef = useRef<string[]>(tabOrder);
  sidebarTabOrderRef.current = tabOrder;

  const handleSidebarTabTouchStart = (id: string, clientX: number, clientY: number) => {
    sidebarTouchStartPosRef.current = { x: clientX, y: clientY };
    sidebarActiveTabRef.current = id;
    hasSidebarTouchDraggedRef.current = false;
    isSidebarTouchDraggingRef.current = false;

    if (sidebarHoldTimerRef.current) clearTimeout(sidebarHoldTimerRef.current);
    sidebarHoldTimerRef.current = setTimeout(() => {
      isSidebarTouchDraggingRef.current = true;
      hasSidebarTouchDraggedRef.current = true;
      setSidebarTouchDragTab(id);
      if (typeof navigator !== 'undefined' && navigator.vibrate) {
        try { navigator.vibrate([30, 20, 30]); } catch(e) {}
      }
    }, 280);
  };

  const handleSidebarTabTouchMove = (clientX: number, clientY: number, e?: any) => {
    if (!sidebarTouchStartPosRef.current) return;
    const dx = clientX - sidebarTouchStartPosRef.current.x;
    const dy = clientY - sidebarTouchStartPosRef.current.y;

    if (!isSidebarTouchDraggingRef.current) {
      if (Math.hypot(dx, dy) > 10) {
        if (sidebarHoldTimerRef.current) {
          clearTimeout(sidebarHoldTimerRef.current);
          sidebarHoldTimerRef.current = null;
        }
      }
      return;
    }

    if (e && e.cancelable) e.preventDefault();

    const element = document.elementFromPoint(clientX, clientY);
    const tabEl = element?.closest('[data-sidebar-tab-id]');
    const targetId = tabEl?.getAttribute('data-sidebar-tab-id');

    if (targetId && sidebarActiveTabRef.current && targetId !== sidebarActiveTabRef.current) {
      const current = [...sidebarTabOrderRef.current];
      const sourceIdx = current.indexOf(sidebarActiveTabRef.current);
      const targetIdx = current.indexOf(targetId);
      if (sourceIdx !== -1 && targetIdx !== -1) {
        current.splice(sourceIdx, 1);
        current.splice(targetIdx, 0, sidebarActiveTabRef.current);
        sidebarTabOrderRef.current = current;
        setTabOrder(current);
        try {
          localStorage.setItem('vylant-tab-order', JSON.stringify(current));
        } catch(err) {}
        if (typeof navigator !== 'undefined' && navigator.vibrate) {
          try { navigator.vibrate(15); } catch(e) {}
        }
      }
    }
  };

  const handleSidebarTabTouchEnd = () => {
    if (sidebarHoldTimerRef.current) {
      clearTimeout(sidebarHoldTimerRef.current);
      sidebarHoldTimerRef.current = null;
    }

    if (isSidebarTouchDraggingRef.current) {
      isSidebarTouchDraggingRef.current = false;
      setSidebarTouchDragTab(null);
      if (typeof navigator !== 'undefined' && navigator.vibrate) {
        try { navigator.vibrate(25); } catch(e) {}
      }
      setTabOrder(sidebarTabOrderRef.current);
      try {
        localStorage.setItem('vylant-tab-order', JSON.stringify(sidebarTabOrderRef.current));
      } catch(err) {}

      setTimeout(() => {
        hasSidebarTouchDraggedRef.current = false;
        sidebarActiveTabRef.current = null;
        sidebarTouchStartPosRef.current = null;
      }, 250);
    } else {
      sidebarActiveTabRef.current = null;
      sidebarTouchStartPosRef.current = null;
    }
  };

  // Instantly capture invitation link query parameters into sessionStorage & handle deep links
  useEffect(() => {
    try {
      let inviteServerId: string | null = null;
      let expires: string | null = null;
      let maxUses: string | null = null;
      let code: string | null = null;

      const href = window.location.href;
      if (href.includes('vylant://') || href.includes('web+vylant://')) {
        const urlStr = href.replace(/^(vylant:\/\/|web\+vylant:\/\/)/, 'http://placeholder/');
        const parsed = new URL(urlStr);
        inviteServerId = parsed.searchParams.get('invite') || parsed.searchParams.get('serverId');
        expires = parsed.searchParams.get('expires');
        maxUses = parsed.searchParams.get('maxUses');
        code = parsed.searchParams.get('code');
      } else {
        const params = new URLSearchParams(window.location.search);
        inviteServerId = params.get('invite');
        expires = params.get('expires');
        maxUses = params.get('maxUses');
        code = params.get('code');
      }

      if (inviteServerId) {
        const inviteData = { inviteServerId, expires, maxUses, code };
        sessionStorage.setItem('vylant_pending_invite', JSON.stringify(inviteData));

        const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone || (window as any).isVylantApp;
        if (!isStandalone) {
          setPendingInviteModalData(inviteData);
          setShowOpenInAppModal(true);

          if (localStorage.getItem('vylant_always_open_app') === 'true') {
            const deepLink = `vylant://invite?invite=${inviteServerId}&code=${code || ''}&expires=${expires || ''}&maxUses=${maxUses || ''}`;
            window.location.href = deepLink;
          }
        }

        const cleanUrl = window.location.pathname;
        window.history.replaceState({}, document.title, cleanUrl);
      }
    } catch (e) {
      console.error('Failed to capture invite URL params:', e);
    }

    try {
      if ('registerProtocolHandler' in navigator) {
        (navigator as any).registerProtocolHandler('web+vylant', `${window.location.origin}?invite=%s`);
      }
    } catch (e) {
      // Ignore protocol registration restrictions
    }
  }, []);
  
  const activeViewRef = useRef(activeView);
  useEffect(() => { activeViewRef.current = activeView; }, [activeView]);

  useEffect(() => {
    if (socketRef.current) {
      const s = socketRef.current;
      s.on('connect', () => console.log('Socket RECONNECTED', s.id));
      s.on('reconnect', () => console.log('Socket RECONNECTED!'));
      s.on('connect_error', (err) => console.error('Socket connect_error', err));
    }
  }, [showApp]);

  const handlePerformLogout = useCallback(async (notifyServer = true) => {
    console.log('Logging out user:', userName);
    if (notifyServer && userName !== 'T0AI User') {
      try {
        console.log('Notifying server of logout');
        await apiFetch('/api/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: userName,
            name: userName,
            image: userImage,
            status: 'offline'
          })
        });
      } catch (e) {
        console.error('Failed to set offline status on logout', e);
      }
    }

    console.log('Clearing storage and session');
    localStorage.removeItem('vylant_current_username');
    localStorage.removeItem('vylant_current_email');
    localStorage.removeItem('vylant_account_created_at');
    localStorage.removeItem('vylant_token');
    localStorage.removeItem('vylant_session_id');
    localStorage.removeItem('vylant_user_age');
    localStorage.removeItem('vylant_user_birthdate');
    
    sessionStorage.removeItem('vylant_current_username');
    sessionStorage.removeItem('vylant_current_email');
    sessionStorage.removeItem('vylant_account_created_at');
    sessionStorage.removeItem('vylant_token');
    sessionStorage.removeItem('vylant_session_id');
    
    setUserName('T0AI User');
    setUserEmail("You haven't added a email yet");
    setUserImage(getRandomAvatar('T0AI User'));
    setUserStatus('offline');
    setCustomStatus('');
    
    setShowApp(false);
    setActiveView('landing');
    if (socketRef.current) {
      console.log('Disconnecting socket');
      socketRef.current.disconnect();
    }
    setIsSettingsOpen(false);
  }, [userName, userImage]);

  const [channelContextMenu, setChannelContextMenu] = useState<{ x: number, y: number, channelId: string, channelName: string } | null>(null);
  const [mutedChannels, setMutedChannels] = useState<string[]>(() => {
    const stored = localStorage.getItem(`vylant_mutedChannels_${userName}`);
    return stored ? JSON.parse(stored) : [];
  });
  const mutedChannelsRef = useRef<string[]>(mutedChannels);
  useEffect(() => { mutedChannelsRef.current = mutedChannels; }, [mutedChannels]);

  const [mutedServers, setMutedServers] = useState<string[]>(() => {
    const stored = localStorage.getItem(`vylant_mutedServers_${userName}`);
    return stored ? JSON.parse(stored) : [];
  });
  const mutedServersRef = useRef<string[]>(mutedServers);
  useEffect(() => { mutedServersRef.current = mutedServers; }, [mutedServers]);

  const [otherDeviceCalls, setOtherDeviceCalls] = useState<any[]>([]);
  const isSyncingRef = useRef(false);

  useEffect(() => {
    if (userName) {
      localStorage.setItem(`vylant_mutedChannels_${userName}`, JSON.stringify(mutedChannels));
    }
  }, [mutedChannels, userName]);

  useEffect(() => {
    if (userName) {
      localStorage.setItem(`vylant_mutedServers_${userName}`, JSON.stringify(mutedServers));
    }
  }, [mutedServers, userName]);

  const handleChannelContextMenu = useCallback((e: React.MouseEvent, channelId: string, channelName: string) => {
    e.preventDefault();
    e.stopPropagation();

    let x = e.clientX;
    let y = e.clientY;

    if (x + 200 > window.innerWidth) x = window.innerWidth - 200;
    if (y + 150 > window.innerHeight) y = window.innerHeight - 150;

    setChannelContextMenu({ x, y, channelId, channelName });
  }, []);

  const toggleMuteChannel = useCallback((channelId: string) => {
    setMutedChannels(prev => 
      prev.includes(channelId) 
        ? prev.filter(id => id !== channelId) 
        : [...prev, channelId]
    );
  }, []);

  const toggleMuteServer = useCallback((serverId: string) => {
    setMutedServers(prev =>
      prev.includes(serverId)
        ? prev.filter(id => id !== serverId)
        : [...prev, serverId]
    );
  }, []);

  const [activeServer, setActiveServer] = useState<string | null>(null);
  const activeServerRef = useRef(activeServer);
  useEffect(() => { activeServerRef.current = activeServer; }, [activeServer]);

  const [activeChannel, setActiveChannel] = useState<string>('c1');
  const activeChannelRef = useRef(activeChannel);
  useEffect(() => { activeChannelRef.current = activeChannel; }, [activeChannel]);

  const handleStartCall = async (targetId: string, targetName: string, withVideo = false) => {
    if (targetName === 'T0AI Assistant' || targetName === 'T0AI' || targetId === 't0ai-assistant' || targetId === 'bot') {
      return;
    }
    // Request permission first
    let stream: MediaStream | undefined;
    try {
      stream = await navigator.mediaDevices.getUserMedia({ 
        audio: { 
          deviceId: selectedInputDevice !== 'default' ? { ideal: selectedInputDevice } : undefined,
          echoCancellation,
          noiseSuppression,
          autoGainControl: automaticGainControl
        },
        video: withVideo ? { deviceId: selectedVideoDevice !== 'default' ? { ideal: selectedVideoDevice } : undefined } : false
      });
      localStreamRef.current = stream;
      refreshDevices();
    } catch (e) {
      console.warn('User denied media access for call:', e);
    }

    if (withVideo && stream) setIsCameraOn(true);

    // 1. Add "Call started" message to DM
    const callMessage: Message = {
      id: Math.random().toString(36).substr(2, 9),
      sender: userName,
      text: `${userName} started a call.`,
      timestamp: Date.now(),
      type: 'system'
    };
    setDmMessages(prev => ({
      ...prev,
      [targetName]: [...(prev[targetName] || []), callMessage]
    }));

    // 2. Set active call
    setActiveCall({
      type: 'private',
      targetId,
      targetName,
      callerName: userName,
      status: 'calling',
      isIncoming: false,
      withVideo // Keep track if this started as a video call
    });
    setIsCallExpanded(false); // Make it show in the mini bar (top bar) by default
    
    // 3. Emit call event
    if (socketRef.current) {
      const isGroup = groupChats.some(gc => gc.name === targetName);
      socketRef.current.emit('call-user', {
        targetName,
        callerName: userName,
        type: 'private',
        isGroup,
        withVideo
      });
    }
  };

  const [activeCall, setActiveCall] = useState<{
    type: 'private' | 'server';
    targetId: string;
    targetName: string;
    serverId?: string;
    isIncoming?: boolean;
    status: 'calling' | 'connected' | 'ended';
    callerName?: string;
  } | null>(null);

  const activeCallRef = useRef(activeCall);
  useEffect(() => { 
    activeCallRef.current = activeCall; 
    if (!activeCall) {
      setIsSpeaking(false);
      setIsRemoteSpeaking(false);
      setSpeakingUsers(new Set());
    }
  }, [activeCall]);

  const [callStatusMessage, setCallStatusMessage] = useState<string | null>(null);
  const callTimeoutRef = useRef<NodeJS.Timeout | null>(null);
  const [callStartTime, setCallStartTime] = useState<number | null>(null);
  const [callDuration, setCallDuration] = useState<number>(0);

  const ringtoneAudioRef = useRef<HTMLAudioElement | null>(null);

  useEffect(() => {
    if (activeCall?.status === 'calling') {
      const currentUserObj = vylantUsersRef.current.find(u => u.name === prevUserNameRef.current);
      let customSoundUrl = '';
      
      if (activeCall.isIncoming) {
        const targetUserId = friendsRef.current.find(f => f.name === activeCall.callerName)?.id;
        if (targetUserId) {
          customSoundUrl = currentUserObj?.preferences?.customSounds?.userOverrides?.[targetUserId]?.callSound || '';
        }
        if (!customSoundUrl) {
          customSoundUrl = currentUserObj?.preferences?.customSounds?.globalCallSound || '';
        }
      }

      const playRingtone = () => {
         if (customSoundUrl) {
            ringtoneAudioRef.current = new Audio(customSoundUrl);
            ringtoneAudioRef.current.loop = true;
            ringtoneAudioRef.current.volume = masterVolumeRef.current / 100;
            ringtoneAudioRef.current.play().catch(e => console.error("Ringtone blocked autoplay", e));
         } else {
            // Default synthesized ringtone loop
            const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
            const playSynthRingtone = () => {
              if (!ringtoneAudioRef.current) return;
              try {
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();
                oscillator.type = 'sine';
                oscillator.frequency.setValueAtTime(440, audioCtx.currentTime);
                oscillator.frequency.setValueAtTime(480, audioCtx.currentTime + 0.5);
                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                gainNode.gain.setValueAtTime((masterVolumeRef.current / 100) * 0.1, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.00001, audioCtx.currentTime + 1.8);
                oscillator.start(audioCtx.currentTime);
                oscillator.stop(audioCtx.currentTime + 1.8);
              } catch (e) {}
            };
            
            // We use the ref just to track "is playing" state and interval 
            (ringtoneAudioRef as any).current = {
               interval: setInterval(playSynthRingtone, 2000),
               pause: () => clearInterval((ringtoneAudioRef as any).current.interval)
            };
            playSynthRingtone();
         }
      };
      
      playRingtone();
    } else {
      if (ringtoneAudioRef.current) {
        ringtoneAudioRef.current.pause();
        ringtoneAudioRef.current = null;
      }
    }
  }, [activeCall?.status, activeCall?.isIncoming, activeCall?.callerName]);

  const formatCallDuration = (seconds: number) => {
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = seconds % 60;
    if (h > 0) return `${h}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
    return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
  };

  useEffect(() => {
    if (activeCall?.status === 'connected') {
       if (!callStartTime) {
         setCallStartTime(Date.now());
       }
    } else {
       setCallStartTime(null);
       setCallDuration(0);
    }
  }, [activeCall?.status]);

  useEffect(() => {
    if (callStartTime) {
       const interval = setInterval(() => {
          setCallDuration(Math.floor((Date.now() - callStartTime) / 1000));
       }, 1000);
       return () => clearInterval(interval);
    }
  }, [callStartTime]);

  // Simulate call answering or declining
  // Removed automatic call answering simulation logic as requested by user.
  const [isChatOpen, setIsChatOpen] = useState(false);
  const [isCallExpanded, setIsCallExpanded] = useState(false);

  useEffect(() => {
    if (isCallExpanded) {
      setIsPipMinimized(false);
    }
  }, [isCallExpanded]);

  const [collapsedCategories, setCollapsedCategories] = useState<Record<string, boolean>>({});
  const [isCreateChannelModalOpen, setIsCreateChannelModalOpen] = useState(false);
  const [createChannelType, setCreateChannelType] = useState<'text' | 'voice' | 'category'>('text');
  const [newChannelName, setNewChannelName] = useState('');
  const [selectedCategoryId, setSelectedCategoryId] = useState<string | null>(null);
  
  const [isChannelSettingsOpen, setIsChannelSettingsOpen] = useState(false);
  const [editingChannel, setEditingChannel] = useState<Channel | null>(null);
  
  const [isCategorySettingsOpen, setIsCategorySettingsOpen] = useState(false);
  const [isCreatingChannel, setIsCreatingChannel] = useState(false);
  const [editingCategory, setEditingCategory] = useState<Category | null>(null);
  const [isStarredViewOpen, setIsStarredViewOpen] = useState(false);
  const [kickConfirm, setKickConfirm] = useState<{ serverId: string, memberId: string, memberName: string } | null>(null);
  const [banConfirm, setBanConfirm] = useState<{ serverId: string, memberId: string, memberName: string } | null>(null);
  const [recentPings, setRecentPings] = useState<Ping[]>([]);
  const [isRecentPingsMenuOpen, setIsRecentPingsMenuOpen] = useState(false);
  const [hideRecentPings, setHideRecentPings] = useState(false);
  const recentPingsMenuRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (recentPingsMenuRef.current && !recentPingsMenuRef.current.contains(event.target as Node)) {
        setIsRecentPingsMenuOpen(false);
      }
    };
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  const deduplicateChannels = (channels: Channel[]) => {
    const seen = new Set();
    return channels.filter(c => {
      if (seen.has(c.id)) return false;
      seen.add(c.id);
      return true;
    });
  };

  const handleCreateChannel = () => {
    if (!newChannelName.trim() || !activeServer || isCreatingChannel) return;

    setIsCreatingChannel(true);

    const generatedId = generateId();
    let newChannelOrCategory: any;

    if (createChannelType === 'category') {
      newChannelOrCategory = {
        id: `cat${generatedId}`,
        name: newChannelName
      };
    } else {
      newChannelOrCategory = {
        id: `c${generatedId}`,
        name: newChannelName,
        type: createChannelType as 'text' | 'voice',
        categoryId: selectedCategoryId || undefined
      };
      // Emit socket event OUTSIDE of state update
      socketRef.current.emit('create-channel', { serverId: activeServer, channel: newChannelOrCategory });
    }

    setServers(prev => {
      const updateServers = (list: Server[]): Server[] => {
        return list.map(server => {
          if (server.id === activeServer) {
            if (createChannelType === 'category') {
              const newServer = {
                ...server,
                categories: [...(server.categories || []), newChannelOrCategory]
              };
              if (socketRef.current) {
                socketRef.current.emit('update-server', { serverId: activeServer, updates: { categories: newServer.categories } });
              }
              return newServer;
            } else {
              const newServer = {
                ...server,
                channels: deduplicateChannels([...(server.channels || []), newChannelOrCategory])
              };
              if (socketRef.current) {
                socketRef.current.emit('update-server', { serverId: activeServer, updates: { channels: newServer.channels } });
              }
              return newServer;
            }
          }
          if (server.isFolder && server.servers) {
            return { ...server, servers: updateServers(server.servers) };
          }
          return server;
        });
      };
      
      const newServers = updateServers(prev);
      
      // Sync to backend OUTSIDE of state update (we'll do it after setServers or just use the newServers list here)
      // Note: syncServersToServer uses apiFetch which is async-ish.
      // Removed full sync to avoid state overwrite
      return newServers;
    });

    setIsCreateChannelModalOpen(false);
    setNewChannelName('');
    setCreateChannelType('text');
    setSelectedCategoryId(null);
    setIsCreatingChannel(false);
  };


  const handleDeleteChannel = (channelId: string) => {
    if (!activeServer) return;
    
    // Close the settings modal when deleting
    setIsChannelSettingsOpen(false);
    setEditingChannel(null);
    
    setServers(prev => {
      const updateServers = (list: Server[]): Server[] => {
        return list.map(server => {
          if (server.id === activeServer) {
            const channelToDelete = server.channels?.find(c => c.id === channelId);
            if (channelToDelete && activeChannel === channelToDelete.id) {
              const remainingChannels = server.channels?.filter(c => c.id !== channelId) || [];
              if (remainingChannels.length > 0) {
                setActiveChannel(remainingChannels[0].id);
              } else {
                setActiveChannel('c1');
              }
            }
            const auditEntry: AuditLogEntry = {
              id: Math.random().toString(36).substr(2, 9),
              action: 'delete_channel',
              executorId: userName,
              executorName: userName,
              targetName: channelToDelete?.name,
              timestamp: Date.now()
            };
            const newServer = {
              ...server,
              channels: server.channels?.filter(c => c.id !== channelId),
              auditLog: [auditEntry, ...(server.auditLog || [])]
            };
            if (socketRef.current) {
              socketRef.current.emit('update-server', { serverId: activeServer, updates: { channels: newServer.channels, auditLog: newServer.auditLog } });
            }
            return newServer;
          }
          if (server.isFolder && server.servers) {
            return { ...server, servers: updateServers(server.servers) };
          }
          return server;
        });
      };
      return updateServers(prev);
    });
  };

  const handleDeleteCategory = (categoryId: string) => {
    if (!activeServer) return;

    // Close the settings modal when deleting
    setIsCategorySettingsOpen(false);
    setEditingCategory(null);

    setServers(prev => {
      const updateServers = (list: Server[]): Server[] => {
        return list.map(server => {
          if (server.id === activeServer) {
            const categoryToDelete = server.categories?.find(c => c.id === categoryId);
            const auditEntry: AuditLogEntry = {
              id: Math.random().toString(36).substr(2, 9),
              action: 'delete_category',
              executorId: userName,
              executorName: userName,
              targetName: categoryToDelete?.name || 'Category',
              timestamp: Date.now()
            };
            const newServer = {
              ...server,
              categories: server.categories?.filter(c => c.id !== categoryId),
              channels: server.channels?.map(c => c.categoryId === categoryId ? { ...c, categoryId: undefined } : c),
              auditLog: [auditEntry, ...(server.auditLog || [])]
            };
            if (socketRef.current) {
              socketRef.current.emit('update-server', { serverId: activeServer, updates: { categories: newServer.categories, channels: newServer.channels, auditLog: newServer.auditLog } });
            }
            return newServer;
          }
          if (server.isFolder && server.servers) {
            return { ...server, servers: updateServers(server.servers) };
          }
          return server;
        });
      };
      return updateServers(prev);
    });
  };

  const handleKickServerMember = (serverId: string, memberId: string, reason?: string) => {
    setServers(prev => prev.map(server => {
      if (server.id === serverId) {
        if (!hasPermission(server, userName, 'kickMembers')) return server;
        const memberToKick = server.members?.find(m => m.id === memberId);
        if (memberToKick?.isBot) {
          return server;
        }
        
        const auditEntry: AuditLogEntry = {
          id: Math.random().toString(36).substr(2, 9),
          action: 'kick',
          executorId: userName,
          executorName: userName,
          targetId: memberId,
          targetName: memberToKick?.name,
          reason: reason || moderationReason,
          timestamp: Date.now()
        };

        if (socketRef.current) {
          socketRef.current.emit('kick-member', { serverId, memberId, reason: reason || moderationReason });
        }

        return {
          ...server,
          members: server.members?.filter(m => m.id !== memberId),
          auditLog: [auditEntry, ...(server.auditLog || [])]
        };
      }
      return server;
    }));
  };

  const handleBanServerMember = (serverId: string, memberId: string, reason?: string) => {
    setServers(prev => prev.map(server => {
      if (server.id === serverId) {
        if (!hasPermission(server, userName, 'banMembers')) return server;
        const memberToBan = server.members?.find(m => m.id === memberId);
        if (memberToBan?.isBot) {
          return server;
        }

        const auditEntry: AuditLogEntry = {
          id: Math.random().toString(36).substr(2, 9),
          action: 'ban',
          executorId: userName,
          executorName: userName,
          targetId: memberId,
          targetName: memberToBan?.name,
          reason: reason || moderationReason,
          timestamp: Date.now()
        };

        const bannedUser: BannedUser = {
          id: memberId,
          name: memberToBan?.name || 'Unknown User',
          image: memberToBan?.image || getRandomAvatar('unknown'),
          reason: reason || moderationReason,
          timestamp: Date.now(),
          executorId: userName
        };

        if (socketRef.current) {
          socketRef.current.emit('ban-member', { serverId, memberId, reason: reason || moderationReason });
        }

        return {
          ...server,
          members: server.members?.filter(m => m.id !== memberId),
          bannedMembers: [...(server.bannedMembers || []), memberId],
          bannedUsers: [bannedUser, ...(server.bannedUsers || [])],
          auditLog: [auditEntry, ...(server.auditLog || [])]
        };
      }
      return server;
    }));
  };

  const handleUnbanServerMember = (serverId: string, memberId: string) => {
    setServers(prev => prev.map(server => {
      if (server.id === serverId) {
        const bannedUser = server.bannedUsers?.find(u => u.id === memberId);
        
        const auditEntry: AuditLogEntry = {
          id: Math.random().toString(36).substr(2, 9),
          action: 'unban',
          executorId: userName,
          executorName: userName,
          targetId: memberId,
          targetName: bannedUser?.name || memberId,
          timestamp: Date.now()
        };

        const newBannedMembers = server.bannedMembers?.filter(id => id !== memberId);
        const newBannedUsers = server.bannedUsers?.filter(u => u.id !== memberId);
        const newAuditLog = [auditEntry, ...(server.auditLog || [])];

        if (socketRef.current) {
          socketRef.current.emit('update-server', { 
            serverId, 
            updates: { 
              bannedMembers: newBannedMembers, 
              bannedUsers: newBannedUsers, 
              auditLog: newAuditLog 
            } 
          });
        }

        return {
          ...server,
          bannedMembers: newBannedMembers,
          bannedUsers: newBannedUsers,
          auditLog: newAuditLog
        };
      }
      return server;
    }));
  };

  const handleSaveChannel = (updatedChannel: Channel) => {
    if (!activeServer) return;
    setServers(prev => {
      const updateServers = (list: Server[]): Server[] => {
        return list.map(server => {
          if (server.id === activeServer) {
            const auditEntry: AuditLogEntry = {
              id: Math.random().toString(36).substr(2, 9),
              action: 'update_channel',
              executorId: userName,
              executorName: userName,
              targetName: updatedChannel.name,
              timestamp: Date.now()
            };
            const newServer = {
              ...server,
              channels: server.channels?.map(c => c.id === updatedChannel.id ? updatedChannel : c),
              auditLog: [auditEntry, ...(server.auditLog || [])]
            };
            if (socketRef.current) {
              socketRef.current.emit('update-server', { serverId: activeServer, updates: { channels: newServer.channels, auditLog: newServer.auditLog } });
            }
            return newServer;
          }
          if (server.isFolder && server.servers) {
            return { ...server, servers: updateServers(server.servers) };
          }
          return server;
        });
      };
      return updateServers(prev);
    });
    setIsChannelSettingsOpen(false);
    setEditingChannel(null);
  };

  const syncServersToServer = (servers: Server[]) => {
    apiFetch('/api/servers', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ servers })
    }).catch(e => console.error('Failed to sync servers to backend', e));
  };

  const handleReorderChannels = (serverId: string, newChannels: Channel[]) => {
    if (!serverId) return;
    setServers(prev => {
      const server = findServer(prev, serverId);
      if (server && !hasPermission(server, userName, 'manageChannels')) return prev;

      const updateServers = (list: Server[]): Server[] => {
        return list.map(server => {
          if (server.id === serverId) {
            const newServer = { ...server, channels: deduplicateChannels(newChannels) };
            if (socketRef.current) {
              socketRef.current.emit('update-server', { serverId: serverId, updates: { channels: newServer.channels } });
            }
            return newServer;
          }
          if (server.isFolder && server.servers) {
            return { ...server, servers: updateServers(server.servers) };
          }
          return server;
        });
      };
      const newServers = updateServers(prev);
      // Removed full sync
      return newServers;
    });

    setEditingServer(prev => {
      if (prev && prev.id === serverId) {
        return { ...prev, channels: deduplicateChannels(newChannels) };
      }
      return prev;
    });
  };

  const handleReorderCategories = (newCategories: Category[]) => {
    if (!activeServer) return;
    setServers(prev => {
      const server = findServer(prev, activeServer);
      if (server && !hasPermission(server, userName, 'manageChannels')) return prev;

      const updateServers = (list: Server[]): Server[] => {
        return list.map(server => {
          if (server.id === activeServer) {
            return { ...server, categories: newCategories };
          }
          if (server.isFolder && server.servers) {
            return { ...server, servers: updateServers(server.servers) };
          }
          return server;
        });
      };
      const newServers = updateServers(prev);
      // Removed full sync
      return newServers;
    });
  };

  const handleUpdateChannelCategory = (channelId: string, categoryId: string | undefined) => {
    if (!activeServer) return;
    setServers(prev => {
      const server = findServer(prev, activeServer);
      if (server && !hasPermission(server, userName, 'manageChannels')) return prev;

      const updateServers = (list: Server[]): Server[] => {
        return list.map(server => {
          if (server.id === activeServer) {
            const newServer = { ...server, channels: deduplicateChannels(server.channels?.map(c => c.id === channelId ? { ...c, categoryId } : c) || []) };
            if (socketRef.current) {
              socketRef.current.emit('update-server', { serverId: activeServer, updates: { channels: newServer.channels } });
            }
            return newServer;
          }
          if (server.isFolder && server.servers) {
            return { ...server, servers: updateServers(server.servers) };
          }
          return server;
        });
      };
      const newServers = updateServers(prev);
      // Removed full sync
      return newServers;
    });
  };

  const handleReorderAll = (newItems: any[]) => {
    if (!activeServer) return;
    
    setServers(prev => {
      const server = findServer(prev, activeServer);
      if (server && !hasPermission(server, userName, 'manageChannels')) return prev;

      const updatedChannels: Channel[] = [];
      const updatedCategories: Category[] = [];
      
      let currentCategoryId: string | undefined = undefined;
      newItems.forEach((item, index) => {
        if (item.type === 'category') {
          currentCategoryId = item.id;
          updatedCategories.push({ ...item.data, order: index });
        } else {
          updatedChannels.push({ ...item.data, order: index, categoryId: currentCategoryId });
        }
      });

      const updateServers = (list: Server[]): Server[] => {
        return list.map(server => {
          if (server.id === activeServer) {
            const reorderedChannelIds = new Set(updatedChannels.map(c => c.id));
            const missingChannels = (server.channels || []).filter(c => !reorderedChannelIds.has(c.id));
            
            // We keep the original categoryId of the channels
            // The order is updated based on the flat list position
            return { 
              ...server, 
              channels: deduplicateChannels([...updatedChannels, ...missingChannels]),
              categories: updatedCategories 
            };
          }
          if (server.isFolder && server.servers) {
            return { ...server, servers: updateServers(server.servers) };
          }
          return server;
        });
      };
      const newServers = updateServers(prev);
      // Removed full sync
      return newServers;
    });
  };

  const handleSaveCategory = (updatedCategory: Category) => {
    if (!activeServer) return;
    setServers(prev => {
      const updateServers = (list: Server[]): Server[] => {
        return list.map(server => {
          if (server.id === activeServer) {
            const auditEntry: AuditLogEntry = {
              id: Math.random().toString(36).substr(2, 9),
              action: 'update_category',
              executorId: userName,
              executorName: userName,
              targetName: updatedCategory.name,
              timestamp: Date.now()
            };
            const newServer = {
              ...server,
              categories: server.categories?.map(c => c.id === updatedCategory.id ? updatedCategory : c),
              auditLog: [auditEntry, ...(server.auditLog || [])]
            };
            if (socketRef.current) {
              socketRef.current.emit('update-server', { serverId: activeServer, updates: { categories: newServer.categories, auditLog: newServer.auditLog } });
            }
            return newServer;
          }
          if (server.isFolder && server.servers) {
            return { ...server, servers: updateServers(server.servers) };
          }
          return server;
        });
      };
      return updateServers(prev);
    });
    setIsCategorySettingsOpen(false);
    setEditingCategory(null);
  };

  const [serverMessages, setServerMessages] = useState<Record<string, Record<string, Message[]>>>(() => {
    const stored = localStorage.getItem(`vylant_serverMessages_${userName}`);
    return stored ? JSON.parse(stored) : {};
  });
  const [isAtBottom, setIsAtBottom] = useState(true);
  const [chatPageIndex, setChatPageIndex] = useState<number>(0);
  const [hasMoreMessages, setHasMoreMessages] = useState<Record<string, boolean>>({});
  const [isLoadingHistory, setIsLoadingHistory] = useState(false);
  const chatScrollRef = useRef<HTMLDivElement>(null);
  const lastScrollHeightRef = useRef<number>(0);
  const lastMessageIdInViewRef = useRef<string | null>(null);

  const handleScrollMessages = (e: React.UIEvent<HTMLDivElement>) => {
    const target = e.currentTarget;

    const { scrollTop, scrollHeight, clientHeight } = target;
    const distanceFromBottom = scrollHeight - scrollTop - clientHeight;
    
    // Check if user is at bottom (with 100px threshold)
    const atBottom = distanceFromBottom < 100;
    if (atBottom !== isAtBottom) {
      setIsAtBottom(atBottom);
    }
    
    // Discord style jump to bottom threshold: show button when scrolled up > 150px
    setShowJumpToBottom(distanceFromBottom > 150);

    if (scrollTop <= 60 && !isLoadingHistory) {
      // Determine what chat we are in
      let type: 'server' | 'dm' | 'group' | null = null;
      let targetId: string | null = null;
      let channelId: string | null = null;
      let msgs: Message[] = [];

      if (activeServer && activeChannel) {
        type = 'server';
        targetId = activeServer;
        channelId = activeChannel;
        msgs = serverMessages[activeServer]?.[activeChannel] || [];
      } else if (activeView === 'messages' && activeDM) {
        const isGroup = groupChats.some(gc => gc.name === activeDM);
        type = isGroup ? 'group' : 'dm';
        targetId = isGroup ? groupChats.find(gc => gc.name === activeDM)?.id || null : activeDM;
        msgs = dmMessages[activeDM] || [];
      }

      const key = type === 'server' ? `${targetId}:${channelId}` : targetId;
      if (type && targetId && msgs.length > 0 && hasMoreMessages[key!]) {
        setIsLoadingHistory(true);
        lastScrollHeightRef.current = target.scrollHeight;
        socketRef.current?.emit('load-more-messages', {
          type,
          targetId,
          channelId,
          lastMessageId: msgs[0].id,
          limit: 100
        });
      }
    }
  };
  useEffect(() => {
    if (isInitialLoadRef.current && userName) {
      const pruned = pruneServerMessagesForStorage(serverMessages);
      localStorage.setItem(`vylant_serverMessages_${userName}`, JSON.stringify(pruned));
    }
  }, [serverMessages, userName]);
  const [isSidebarHovered, setIsSidebarHovered] = useState(false);
  const [isAddServerHovered, setIsAddServerHovered] = useState(false);
  const [addServerRect, setAddServerRect] = useState<DOMRect | null>(null);
  const addServerRef = useRef<HTMLDivElement>(null);
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
  const [isMobileChannelListOpen, setIsMobileChannelListOpen] = useState(false);
  const [isMobileRightPanelOpen, setIsMobileRightPanelOpen] = useState(false);
  const [isMobile, setIsMobile] = useState(window.innerWidth < 768);
  const [isMobileChannelSelected, setIsMobileChannelSelected] = useState(false);

  const [channelSidebarWidth, setChannelSidebarWidth] = useState<number>(() => {
    if (typeof window === 'undefined') return 256;
    const stored = localStorage.getItem('vylant_channel_sidebar_width');
    return stored ? parseInt(stored, 10) : 256;
  });

  const [rightPanelWidth, setRightPanelWidth] = useState<number>(() => {
    if (typeof window === 'undefined') return 256;
    const stored = localStorage.getItem('vylant_right_panel_width');
    return stored ? parseInt(stored, 10) : 256;
  });

  const [isServerMembersListOpen, setIsServerMembersListOpen] = useState<boolean>(() => {
    if (typeof window === 'undefined') return true;
    const stored = localStorage.getItem('vylant_show_members_list');
    return stored !== null ? JSON.parse(stored) : true;
  });

  const [isMinigameTexturesModalOpen, setIsMinigameTexturesModalOpen] = useState(false);

  const [activeMinigameTexture, setActiveMinigameTexture] = useState<MinigameTextureConfig>(() => {
    if (typeof window === 'undefined') return DEFAULT_TEXTURE_PRESETS[0];
    try {
      const stored = localStorage.getItem('vylant_active_minigame_texture');
      if (stored) return JSON.parse(stored);
    } catch (e) {
      console.error(e);
    }
    return DEFAULT_TEXTURE_PRESETS[0];
  });

  const [isKeyboardOpen, setIsKeyboardOpen] = useState(false);

  useEffect(() => {
    // Basic heuristic: check if focus is on an input or textarea
    const handleFocusIn = () => setIsKeyboardOpen(true);
    const handleFocusOut = () => setIsKeyboardOpen(false);

    document.addEventListener('focusin', handleFocusIn);
    document.addEventListener('focusout', handleFocusOut);

    // Also use window level to catch more cases
    const handleResize = () => {
      setIsMobile(window.innerWidth < 768);
      // If the height decreases significantly, keyboard is likely open
      if (window.visualViewport && window.innerWidth < 768) {
        // threshold 0.8 to be sure
        if (window.visualViewport.height < window.innerHeight * 0.75) {
          setIsKeyboardOpen(true);
        } else {
          setIsKeyboardOpen(false);
        }
      }
    };

    window.visualViewport?.addEventListener('resize', handleResize);
    window.addEventListener('resize', handleResize);

    return () => {
      document.removeEventListener('focusin', handleFocusIn);
      document.removeEventListener('focusout', handleFocusOut);
      window.visualViewport?.removeEventListener('resize', handleResize);
      window.removeEventListener('resize', handleResize);
    };
  }, []);

  useEffect(() => {
    setIsMobileMenuOpen(false);
    setIsMobileChannelListOpen(false);
    setIsMobileRightPanelOpen(false);
  }, [activeView]);

  const mainSidebarX = useMotionValue(typeof window !== 'undefined' && window.innerWidth < 768 ? -320 : 0);
  const channelSidebarX = useMotionValue(typeof window !== 'undefined' && window.innerWidth < 768 ? -320 : 0);
  const rightPanelX = useMotionValue(typeof window !== 'undefined' && window.innerWidth < 768 ? (window.innerWidth || 500) : 0);

  const getMobileSidebarWidth = () => typeof window !== 'undefined' && window.innerWidth < 400 ? window.innerWidth * 0.8 : 240;
  const getMobileChannelWidth = () => typeof window !== 'undefined' ? Math.min(window.innerWidth * 0.85, 320) : 320;
  const getMobileRightWidth = () => (typeof window !== 'undefined' ? Math.min(Math.round(window.innerWidth * 0.85), 320) : 320);
  const getMobileRightClosedX = () => getMobileRightWidth() + 40;

  useEffect(() => {
    if (isMobile) {
      animate(mainSidebarX, isMobileMenuOpen ? 0 : -getMobileSidebarWidth(), { type: 'spring', damping: 28, stiffness: 220 });
    } else {
      animate(mainSidebarX, 0);
    }
  }, [isMobile, isMobileMenuOpen]);

  useEffect(() => {
    if (isMobile) {
      animate(channelSidebarX, isMobileChannelListOpen ? 0 : -getMobileChannelWidth(), { type: 'spring', damping: 28, stiffness: 220 });
    } else {
      animate(channelSidebarX, 0);
    }
  }, [isMobile, isMobileChannelListOpen]);

  useEffect(() => {
    if (isMobile) {
      animate(rightPanelX, isMobileRightPanelOpen ? 0 : getMobileRightClosedX(), { type: 'spring', damping: 28, stiffness: 220 });
    } else {
      animate(rightPanelX, 0);
    }
  }, [isMobile, isMobileRightPanelOpen]);

  const touchStartX = useRef(0);
  const touchStartY = useRef(0);
  const isHorizontalSwipe = useRef<boolean | null>(null);

  const handleTouchStart = (e: React.TouchEvent) => {
    console.log("Touch Start", e.touches[0].clientX);
    touchStartX.current = e.touches[0].clientX;
    touchStartY.current = e.touches[0].clientY;
    isHorizontalSwipe.current = null;
  };

  const handleTouchMove = (e: React.TouchEvent) => {
    if (!isMobile) return;
    const deltaX = e.touches[0].clientX - touchStartX.current;
    const deltaY = e.touches[0].clientY - touchStartY.current;

    // Detect if this is mostly horizontal or vertical
    if (isHorizontalSwipe.current === null) {
      if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 10) {
        console.log("Horizontal swipe detected");
        isHorizontalSwipe.current = true;
      } else if (Math.abs(deltaY) > 10) {
        console.log("Vertical swipe detected");
        isHorizontalSwipe.current = false;
      }
    }

    if (isHorizontalSwipe.current) {
      // Prevent browser from scrolling or handling back gesture
      if (e.cancelable) e.preventDefault();
      
      const currentDelta = deltaX; // 1:1 follow finger
      
      if (isMobileMenuOpen) {
        mainSidebarX.set(Math.min(0, currentDelta));
      } else if (isMobileChannelListOpen) {
        channelSidebarX.set(Math.min(0, currentDelta));
      } else if (isMobileRightPanelOpen) {
        rightPanelX.set(Math.max(0, currentDelta));
      } else {
        if (deltaX > 0) {
          if (activeView === 'server') {
            channelSidebarX.set(-getMobileChannelWidth() + currentDelta);
          } else {
            mainSidebarX.set(-getMobileSidebarWidth() + currentDelta);
          }
        } else {
          rightPanelX.set(getMobileRightClosedX() + currentDelta);
        }
      }
    }
  };

  const handleTouchEnd = (e: React.TouchEvent) => {
    if (!isMobile || isHorizontalSwipe.current === false) return;
    
    const touchEndX = e.changedTouches[0].clientX;
    const delta = touchEndX - touchStartX.current;
    
    let nextMenuOpen = isMobileMenuOpen;
    let nextChannelOpen = isMobileChannelListOpen;
    let nextRightOpen = isMobileRightPanelOpen;

    if (Math.abs(delta) > 40) { // Slightly lower threshold for responsiveness
      if (delta > 0) {
        // Swipe Right -> Open Panels
        if (nextRightOpen) {
          nextRightOpen = false;
        } else if (activeView === 'server' && !nextChannelOpen) {
          nextChannelOpen = true;
        } else {
          nextMenuOpen = true;
        }
      } else {
        // Swipe Left -> Close Panels or Open Right Panel
        if (nextMenuOpen) {
          nextMenuOpen = false;
        } else if (nextChannelOpen) {
          nextChannelOpen = false;
        } else {
          nextRightOpen = true;
        }
      }
    }

    // Update states
    setIsMobileMenuOpen(nextMenuOpen);
    setIsMobileChannelListOpen(nextChannelOpen);
    setIsMobileRightPanelOpen(nextRightOpen);

    // Immediate animation to targets using spring for snappy but smooth feel
    animate(mainSidebarX, nextMenuOpen ? 0 : -getMobileSidebarWidth(), { type: 'spring', damping: 25, stiffness: 200, mass: 0.8 });
    animate(channelSidebarX, nextChannelOpen ? 0 : -getMobileChannelWidth(), { type: 'spring', damping: 25, stiffness: 200, mass: 0.8 });
    animate(rightPanelX, nextRightOpen ? 0 : getMobileRightClosedX(), { type: 'spring', damping: 25, stiffness: 200, mass: 0.8 });

    isHorizontalSwipe.current = null;
  };

  const [dropdownMenu, setDropdownMenu] = useState<{
    isOpen: boolean;
    position: { top: number; left: number };
    items: { label: string; icon?: any; onClick: () => void; danger?: boolean }[];
    source?: 'sidebar' | 'header' | 'other';
  }>({ isOpen: false, position: { top: 0, left: 0 }, items: [] });
  const isSidebarLockedState = useState(false);
  const isSidebarLocked = isSidebarLockedState[0];
  const setIsSidebarLocked = isSidebarLockedState[1];
  const [isLockModalOpen, setIsLockModalOpen] = useState(false);
  const [hideLockModal, setHideLockModal] = useState(false);
  const [dontShowLockModalChecked, setDontShowLockModalChecked] = useState(false);
  const isSidebarExpanded = isMobile || isSidebarHovered || isSidebarLocked || isLockModalOpen || (dropdownMenu.isOpen && dropdownMenu.source === 'sidebar');
  const [accentColor, setAccentColor] = useState(() => localStorage.getItem('vylant_accent_color') || '#00d2ff');
  const [fontSize, setFontSize] = useState(() => {
    const stored = localStorage.getItem('vylant_font_size');
    return stored ? parseInt(stored, 10) : 16;
  });
  const [customTheme, setCustomTheme] = useState<string>(() => {
    return (localStorage.getItem('vylant_custom_theme') as any) || 'default';
  });
  const [customThemeColor, setCustomThemeColor] = useState(() => localStorage.getItem('vylant_custom_theme_color') || '#222222');
  const [isSettingsOpen, setIsSettingsOpen] = useState(false);
  const [isDeleteAccountModalOpen, setIsDeleteAccountModalOpen] = useState(false);
  const [settingsInitialTab, setSettingsInitialTab] = useState('overview');
  const [settingsMode, setSettingsMode] = useState<'simple' | 'advanced'>('simple');
  const [isDeveloperMode, setIsDeveloperMode] = useState(false);
  const [friendRequestError, setFriendRequestError] = useState<string | null>(null);
  const [friendRequestSettingOffUser, setFriendRequestSettingOffUser] = useState<string | null>(null);
  const [mentionState, setMentionState] = useState<{
    isOpen: boolean;
    query: string;
    selectedIndex: number;
  }>({ isOpen: false, query: '', selectedIndex: 0 });

  const [cropImageSrc, setCropImageSrc] = useState<string | null>(null);
  const [isCropModalOpen, setIsCropModalOpen] = useState(false);
  const [cropTarget, setCropTarget] = useState<'server' | 'folder' | 'profile' | 'server-settings'>('server');
  
  const messagesEndRef = useRef<HTMLDivElement>(null);

  // New Settings States
  const [isStoryPreviewModalOpen, setIsStoryPreviewModalOpen] = useState(false);
  const [activeMiniGame, setActiveMiniGame] = useState<'bird' | 'snake' | 'ttt' | 'mines'>('bird');
  const [pendingStoryData, setPendingStoryData] = useState<string | null>(null);
  const [storyRingColor, setStoryRingColor] = useState('bg-gradient-to-tr from-cyan-400 to-blue-600');
  const [storyPrivacy, setStoryPrivacy] = useState<'everyone' | 'friends' | 'custom'>('everyone');
  const [twoFactorEnabled, setTwoFactorEnabled] = useState(false);
  const [allowDirectMessages, setAllowDirectMessages] = useState(true);
  const [allowIncomingFriendRequests, setAllowIncomingFriendRequests] = useState(true);
  useEffect(() => {
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_allowDirectMessages_${userName}`, JSON.stringify(allowDirectMessages));
    }
  }, [allowDirectMessages, userName]);

  useEffect(() => {
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_allowIncomingFriendRequests_${userName}`, JSON.stringify(allowIncomingFriendRequests));
    }
  }, [allowIncomingFriendRequests, userName]);

  const [allowDataCollection, setAllowDataCollection] = useState(true);
  useEffect(() => {
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_allowDataCollection_${userName}`, JSON.stringify(allowDataCollection));
    }
  }, [allowDataCollection, userName]);

  const [desktopNotifications, setDesktopNotifications] = useState(() => {
    const saved = localStorage.getItem('vylant_desktopNotifications');
    return saved !== null ? saved === 'true' : true;
  });
  const [soundNotifications, setSoundNotifications] = useState(() => {
    const saved = localStorage.getItem('vylant_soundNotifications');
    return saved !== null ? saved === 'true' : true;
  });
  const [emailNotifications, setEmailNotifications] = useState(() => {
    const saved = localStorage.getItem('vylant_emailNotifications');
    return saved !== null ? saved === 'true' : false;
  });
  const [friendNotifications, setFriendNotifications] = useState(() => {
    const saved = localStorage.getItem('vylant_friendNotifications');
    return saved !== null ? saved === 'true' : true;
  });

  useEffect(() => { localStorage.setItem('vylant_desktopNotifications', String(desktopNotifications)); }, [desktopNotifications]);
  useEffect(() => { localStorage.setItem('vylant_soundNotifications', String(soundNotifications)); }, [soundNotifications]);
  useEffect(() => { localStorage.setItem('vylant_emailNotifications', String(emailNotifications)); }, [emailNotifications]);
  useEffect(() => { localStorage.setItem('vylant_friendNotifications', String(friendNotifications)); }, [friendNotifications]);

  useEffect(() => {
    if (desktopNotifications && 'Notification' in window) {
      if (Notification.permission !== 'granted' && Notification.permission !== 'denied') {
        Notification.requestPermission().then(permission => {
          if (permission !== 'granted') {
            setDesktopNotifications(false);
          }
        });
      } else if (Notification.permission === 'denied') {
        setDesktopNotifications(false);
      }
    }
  }, [desktopNotifications]);

  const [masterVolume, setMasterVolume] = useState(80);
  const [soundEffectsEnabled, setSoundEffectsEnabled] = useState(true);
  const [ttsEnabled, setTtsEnabled] = useState(false);

  const desktopNotificationsRef = useRef(desktopNotifications);
  const soundNotificationsRef = useRef(soundNotifications);
  const friendNotificationsRef = useRef(friendNotifications);
  const soundEffectsEnabledRef = useRef(soundEffectsEnabled);
  const masterVolumeRef = useRef(masterVolume);

  useEffect(() => { desktopNotificationsRef.current = desktopNotifications; }, [desktopNotifications]);
  useEffect(() => { soundNotificationsRef.current = soundNotifications; }, [soundNotifications]);
  useEffect(() => { friendNotificationsRef.current = friendNotifications; }, [friendNotifications]);
  useEffect(() => { soundEffectsEnabledRef.current = soundEffectsEnabled; }, [soundEffectsEnabled]);
  useEffect(() => { masterVolumeRef.current = masterVolume; }, [masterVolume]);

  const triggerNotification = useCallback((title: string, body: string, type: 'message' | 'friend' | 'mention' | 'success', senderName?: string) => {
    if (type === 'friend' && !friendNotificationsRef.current) return;
    
    if (soundNotificationsRef.current && soundEffectsEnabledRef.current) {
        try {
            const currentUserObj = vylantUsersRef.current.find(u => u.name === prevUserNameRef.current);
            let customSoundUrl = '';
            
            if (type === 'message' || type === 'mention') {
              if (senderName) {
                const senderObj = vylantUsersRef.current.find(u => u.name === senderName);
                if (senderObj) {
                  customSoundUrl = currentUserObj?.preferences?.customSounds?.userOverrides?.[senderObj.id]?.messageSound || '';
                }
              }
              if (!customSoundUrl) {
                customSoundUrl = currentUserObj?.preferences?.customSounds?.globalMessageSound || '';
              }
            }

            if (customSoundUrl) {
              const audio = new Audio(customSoundUrl);
              audio.volume = masterVolumeRef.current / 100;
              audio.play().catch(e => console.error("Custom notification audio failed", e));
            } else {
              const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
              const oscillator = audioCtx.createOscillator();
              const gainNode = audioCtx.createGain();
              oscillator.connect(gainNode);
              gainNode.connect(audioCtx.destination);
              
              if (type === 'mention') {
                oscillator.type = 'triangle';
                oscillator.frequency.setValueAtTime(523.25, audioCtx.currentTime);
                oscillator.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.1);
              } else if (type === 'friend' || type === 'success') {
                oscillator.type = 'sine';
                oscillator.frequency.setValueAtTime(440, audioCtx.currentTime); 
                oscillator.frequency.setValueAtTime(880, audioCtx.currentTime + 0.15); 
              } else {
                oscillator.type = 'sine';
                oscillator.frequency.setValueAtTime(440, audioCtx.currentTime);
              }
              
              gainNode.gain.setValueAtTime((masterVolumeRef.current / 100) * 0.1, audioCtx.currentTime);
              gainNode.gain.exponentialRampToValueAtTime(0.00001, audioCtx.currentTime + 0.4);
              oscillator.start(audioCtx.currentTime);
              oscillator.stop(audioCtx.currentTime + 0.4);
            }
        } catch (e) {
            console.error("Audio beep failed", e);
        }
    }

    if (desktopNotificationsRef.current && 'Notification' in window && Notification.permission === 'granted' && !document.hasFocus()) {
       new Notification(title, { body });
    }
  }, []);

  const activePreviewAudioRef = useRef<HTMLAudioElement | null>(null);

  const handlePlayPreviewAudio = (url: string) => {
    if (!url) return;
    
    if (activePreviewAudioRef.current) {
      const current = activePreviewAudioRef.current;
      if (!current.ended && !current.paused) {
        return;
      }
    }

    try {
      const audio = new Audio(url);
      audio.volume = masterVolumeRef.current / 100;
      activePreviewAudioRef.current = audio;

      const cleanup = () => {
        if (activePreviewAudioRef.current === audio) {
          activePreviewAudioRef.current = null;
        }
      };

      audio.onended = cleanup;
      audio.onerror = cleanup;
      audio.onpause = cleanup;

      audio.play().catch(e => {
        console.error("Preview audio play failed:", e);
        cleanup();
      });
    } catch (e) {
      console.error("Preview audio creation failed:", e);
      activePreviewAudioRef.current = null;
    }
  };
  const [echoCancellation, setEchoCancellation] = useState(() => {
    const saved = localStorage.getItem('vylant_echoCancellation');
    return saved !== null ? saved === 'true' : true;
  });
  const [noiseSuppression, setNoiseSuppression] = useState(() => {
    const saved = localStorage.getItem('vylant_noiseSuppression');
    return saved !== null ? saved === 'true' : true;
  });
  const [automaticGainControl, setAutomaticGainControl] = useState(() => {
    const saved = localStorage.getItem('vylant_automaticGainControl');
    return saved !== null ? saved === 'true' : true;
  });

  useEffect(() => { localStorage.setItem('vylant_echoCancellation', String(echoCancellation)); }, [echoCancellation]);
  useEffect(() => { localStorage.setItem('vylant_noiseSuppression', String(noiseSuppression)); }, [noiseSuppression]);
  useEffect(() => { localStorage.setItem('vylant_automaticGainControl', String(automaticGainControl)); }, [automaticGainControl]);
  const [displayImagesVideos, setDisplayImagesVideos] = useState(true);
  const [showLinkPreviews, setShowLinkPreviews] = useState(true);
  const [safeLinkUrl, setSafeLinkUrl] = useState<string | null>(null);
  const [isSafeLinkModalOpen, setIsSafeLinkModalOpen] = useState(false);
  const [safeLinkEnabled, setSafeLinkEnabledState] = useState<boolean>(() => isSafeLinkEnabled());
  const [stripTrackingEnabled, setStripTrackingEnabledState] = useState<boolean>(() => isStripTrackingEnabled());

  const handleOpenSafeLink = useCallback((url: string) => {
    setSafeLinkUrl(url);
    setIsSafeLinkModalOpen(true);
  }, []);

  const handleSetSafeLinkEnabled = useCallback((enabled: boolean) => {
    setSafeLinkEnabledState(enabled);
    persistSafeLinkEnabled(enabled);
  }, []);

  const handleSetStripTrackingEnabled = useCallback((enabled: boolean) => {
    setStripTrackingEnabledState(enabled);
    persistStripTrackingEnabled(enabled);
  }, []);
  const [compactMessageView, setCompactMessageView] = useState(false);
  const [presets, setPresets] = useState<Preset[]>([]);
  const [serverEvents, setServerEvents] = useState<any[]>([]);
  const fetchServerEvents = useCallback(async (serverId: string) => {
    try {
      const res = await apiFetch(`/api/servers/${serverId}/events`);
      if (res.ok) {
        const data = await res.json();
        setServerEvents(data);
      }
    } catch (e) {
      console.error("Failed to fetch server events:", e);
    }
  }, []);

  useEffect(() => {
    if (activeServer) {
      fetchServerEvents(activeServer);
    } else {
      setServerEvents([]);
    }
  }, [activeServer, fetchServerEvents]);

  const [isPresetsLoading, setIsPresetsLoading] = useState(false);
  const [showTimestamps, setShowTimestamps] = useState(true);
  const [appLanguage, setAppLanguage] = useState('English (US)');
  const [appTimezone, setAppTimezone] = useState('Pacific Time (PT)');
  const [is24HourTime, setIs24HourTime] = useState(false);
  const [hardwareAcceleration, setHardwareAcceleration] = useState(true);
  const [autoStart, setAutoStart] = useState(false);

  const socketRef = useRef<any>(null);

  useEffect(() => {
    if (showApp && userName !== 'T0AI User') {
      const token = localStorage.getItem('vylant_token') || sessionStorage.getItem('vylant_token');
      const socket = io({
        auth: { token }
      });
      socketRef.current = socket;

      socket.on('error', (payload) => {
        console.error("Socket error:", payload);
        // We'll use a simple error modal for socket errors
        setErrorModal({ isOpen: true, message: payload.message, resolution: payload.resolution });
      });

      socket.on('navigation-synced', ({ activeView, activeServer, activeChannel }) => {
        isSyncingRef.current = true;
        if (activeView) setActiveView(activeView);
        if (activeServer !== undefined) setActiveServer(activeServer);
        if (activeChannel) setActiveChannel(activeChannel);
      });

      socket.on('muted-channels-synced', ({ mutedChannels }) => {
        isSyncingRef.current = true;
        if (mutedChannels) setMutedChannels(mutedChannels);
      });

      socket.on('muted-servers-synced', ({ mutedServers }) => {
        isSyncingRef.current = true;
        if (mutedServers) setMutedServers(mutedServers);
      });

      socket.on('active-calls-update', (otherCalls) => {
        setOtherDeviceCalls(otherCalls || []);
      });

      socket.on('force-disconnect-call', () => {
        console.log("Forced to disconnect call due to transfer to another device.");
        endCall();
      });

      socket.on('user-typing', ({ senderName, isTyping: typingStatus }) => {
        // Block check (case-insensitive)
        if (blockedUsersRef.current.some(u => (u.name || '').toLowerCase() === (senderName || '').toLowerCase())) {
          return;
        }

        setDmTypingUsers(prev => ({
          ...prev,
          [senderName]: typingStatus
        }));

        if (activeViewRef.current === 'messages' && activeDMRef.current === senderName && senderName !== 'T0AI Assistant' && senderName !== 'T0AI') {
          setIsTyping(typingStatus);
          if (typingTimeoutRef.current) clearTimeout(typingTimeoutRef.current);
          if (typingStatus) {
            typingTimeoutRef.current = setTimeout(() => {
              setIsTyping(false);
              setDmTypingUsers(prev => ({ ...prev, [senderName]: false }));
            }, 5000);
          }
        }
      });

      socket.on('server-user-typing', ({ serverId, channelId, senderName, isTyping: typingStatus }: { serverId: string, channelId: string, senderName: string, isTyping: boolean }) => {
        if (senderName === userName) return;
        if (blockedUsersRef.current.some(u => (u.name || '').toLowerCase() === (senderName || '').toLowerCase())) {
          return;
        }
        const key = `${serverId}:${channelId}`;
        setServerTypingUsers(prev => {
          const list = prev[key] || [];
          if (typingStatus) {
            if (!list.includes(senderName)) return { ...prev, [key]: [...list, senderName] };
            return prev;
          } else {
            return { ...prev, [key]: list.filter(name => name !== senderName) };
          }
        });
        if (typingStatus) {
          const timerKey = `${key}:${senderName}`;
          if (serverTypingTimersRef.current[timerKey]) {
            clearTimeout(serverTypingTimersRef.current[timerKey]);
          }
          serverTypingTimersRef.current[timerKey] = setTimeout(() => {
            setServerTypingUsers(prev => {
              const list = prev[key] || [];
              return { ...prev, [key]: list.filter(name => name !== senderName) };
            });
            delete serverTypingTimersRef.current[timerKey];
          }, 4500);
        }
      });

      socket.on('user-status-changed', ({ userId, userName: changedUserName, status, customStatus, image, isPremium: receivedIsPremium, preferences }) => {
        if (changedUserName === userName || changedUserName === prevUserNameRef.current) {
          if (image) {
            setUserImage(prev => prev === image ? prev : image);
            localStorage.setItem(`vylant_user_image_${changedUserName}`, image);
            setSavedAccounts(prev => prev.map(a => a.name === changedUserName ? { ...a, image } : a));
          }
        }

        setSelectedProfile(prev => {
          if (!prev) return prev;
          if (prev.name === changedUserName || (prev.id === 'me' && (changedUserName === userName || changedUserName === prevUserNameRef.current))) {
            return {
              ...prev,
              status: status !== undefined ? status : prev.status,
              customStatus: customStatus !== undefined ? customStatus : prev.customStatus,
              image: image || prev.image,
              isPremium: receivedIsPremium !== undefined ? receivedIsPremium : prev.isPremium,
              preferences: preferences !== undefined ? preferences : prev.preferences
            };
          }
          return prev;
        });

        setVylantUsers(prev => prev.map(u => 
          u.name === changedUserName ? { 
            ...u, 
            status: status !== undefined ? status : u.status, 
            customStatus: customStatus !== undefined ? customStatus : u.customStatus, 
            image: image || u.image,
            isPremium: receivedIsPremium !== undefined ? receivedIsPremium : u.isPremium,
            preferences: preferences !== undefined ? preferences : u.preferences
          } : u
        ));
        
        setFriends(prev => prev.map(f => 
          f.name === changedUserName ? { 
            ...f, 
            status: status !== undefined ? status : f.status, 
            customStatus: customStatus !== undefined ? customStatus : f.customStatus, 
            image: image || f.image,
            isPremium: receivedIsPremium !== undefined ? receivedIsPremium : f.isPremium,
            preferences: preferences !== undefined ? preferences : f.preferences
          } : f
        ));
        
        setRecentDMs(prev => prev.map(dm => 
          dm.name === changedUserName ? { 
            ...dm, 
            status: status !== undefined ? status : dm.status, 
            customStatus: customStatus !== undefined ? customStatus : dm.customStatus, 
            image: image || dm.image,
            isPremium: receivedIsPremium !== undefined ? receivedIsPremium : dm.isPremium,
            preferences: preferences !== undefined ? preferences : dm.preferences
          } : dm
        ));

        setServers(prev => prev.map(server => {
          if (!server.members) return server;
          const memberIdx = server.members.findIndex(m => m.name === changedUserName);
          if (memberIdx === -1) return server;
          const newMembers = [...server.members];
          newMembers[memberIdx] = { 
            ...newMembers[memberIdx], 
            status: status !== undefined ? status : newMembers[memberIdx].status, 
            customStatus: customStatus !== undefined ? customStatus : newMembers[memberIdx].customStatus, 
            image: image || newMembers[memberIdx].image,
            isPremium: receivedIsPremium !== undefined ? receivedIsPremium : newMembers[memberIdx].isPremium,
            preferences: preferences !== undefined ? preferences : newMembers[memberIdx].preferences
          };
          return { ...server, members: newMembers };
        }));
      });

      socket.on('active-group-calls-sync', (syncMap) => {
        const processedMap: Record<string, Set<string>> = {};
        for (const [groupName, members] of Object.entries(syncMap)) {
          processedMap[groupName] = new Set(members as string[]);
        }
        setActiveGroupCalls(processedMap);
      });

      socket.on('group-chat-created', (groupChat) => {
        setGroupChats(prev => {
          if (prev.some(gc => gc.id === groupChat.id)) return prev;
          socketRef.current?.emit('join-group-room', { groupId: groupChat.id });
          return [groupChat, ...prev];
        });
        
        // Only alert if we're not the creator (creator already knows)
        if (groupChat.creator !== userName) {
          alert(`You've been added to a new group chat: ${groupChat.name}`);
        }
      });

      socket.on('group-chat-updated', (groupChat) => {
        setGroupChats(prev => {
          const exists = prev.some(gc => gc.id === groupChat.id);
          if (exists) {
            return prev.map(gc => gc.id === groupChat.id ? groupChat : gc);
          } else {
            return [...prev, groupChat];
          }
        });
      });

      socket.on('group-chat-removed', (groupId) => {
        const removedGroupName = groupChatsRef.current.find(gc => gc.id === groupId)?.name;
        setGroupChats(prev => prev.filter(gc => gc.id !== groupId));
        if (removedGroupName) {
          setActiveDM(prev => {
            if (prev === removedGroupName) {
              setActiveView('home');
              return '';
            }
            return prev;
          });
        }
      });

      socket.on('group-chats-list', (chats) => {
        setGroupChats(chats);
      });

      socket.on('new-group-chat-message', ({ groupId, message, isBulk, hasMore }: { groupId: string, message: any, isBulk?: boolean, hasMore?: boolean }) => {
        const groupChat = groupChatsRef.current.find(gc => gc.id === groupId);
        if (groupChat) {
          if (hasMore !== undefined) { 
            setHasMoreMessages(prev => ({ ...prev, [groupChat.name]: hasMore }));
          }
          setDmMessages(prev => {
            const currentMessages = prev[groupChat.name] || [];
            
            if (isBulk && Array.isArray(message)) {
              const existingIds = new Set(currentMessages.map(m => m.id));
              const newUniqueMessages = message.filter(m => !existingIds.has(m.id));
              if (newUniqueMessages.length === 0) return prev;
              
              return {
                ...prev,
                [groupChat.name]: [...currentMessages, ...newUniqueMessages].sort((a, b) => (a.timestamp || 0) - (b.timestamp || 0))
              };
            } else {
              if (currentMessages.some(m => m.id === message.id)) return prev;
              
              const msgKey = `group:${groupChat.id}:${message.id}`;
              if (!handledNotificationIdsRef.current.has(msgKey) && !handledNotificationIdsRef.current.has(message.id)) {
                handledNotificationIdsRef.current.add(msgKey);
                handledNotificationIdsRef.current.add(message.id);
                if (handledNotificationIdsRef.current.size > 2000) {
                  const first = handledNotificationIdsRef.current.values().next().value;
                  if (first) handledNotificationIdsRef.current.delete(first);
                }

                if (message.sender !== userName && !isBulk) {
                  if (activeViewRef.current !== 'messages' || activeDMRef.current !== groupChat.name) {
                    const isMention = (message.content || message.text || '').includes(`@${userName}`);
                    incrementUnread('dm', groupChat.name, undefined, isMention);
                    triggerNotification(
                      isMention ? 'New Mention' : `New message in ${groupChat.name}`,
                      `${message.sender}: ${message.content || message.text || 'Sent an attachment'}`,
                      isMention ? 'mention' : 'message',
                      message.sender
                    );
                  }
                }
              }
              
              return {
                ...prev,
                [groupChat.name]: [...currentMessages, message]
              };
            }
          });
        }
      });

      socket.on('connect', () => {
        socket.emit('register-user', userName);
        socket.emit('update-status', { userName, status: userStatus, customStatus });
        socket.emit('get-friend-requests', userName);
        socket.emit('get-group-chats', userName);
        
        // Join all servers to get member lists
        serversRef.current.forEach(server => {
          socket.emit('join-server', { 
            serverId: server.id, 
            user: { 
              id: userName, 
              name: userName, 
              status: userStatus, 
              image: userImage,
              customStatus: customStatus
            },
            channelIds: server.channels.map(c => c.id)
          });
        });

        if (activeServerRef.current && activeChannelRef.current) {
          socket.emit('join-channel', { 
            serverId: activeServerRef.current, 
            channelId: activeChannelRef.current 
          });
        }
        
        // Rejoin all servers to get real-time messages and unread counts for all channels
        const serverRooms = serversRef.current.map(s => ({
          serverId: s.id,
          channelIds: s.channels.map(c => c.id)
        }));
        if (serverRooms.length > 0) {
          socket.emit('rejoin-servers', { userId: userName, serverRooms });
        }
      });

      socket.on('incoming-call', ({ callerName, type, serverId, isGroup, groupName }) => {
        console.log("RECEIVED INCOMING CALL:", { callerName, type });
        setActiveCall({
          type,
          targetId: isGroup ? groupName : callerName,
          targetName: isGroup ? groupName : callerName,
          callerName,
          serverId,
          status: 'calling',
          isIncoming: true
        });
        // Play ringtone or something?
      });

      socket.on('call-answered', async ({ answererName, accepted, isGroup, groupName, handledElsewhere }) => {
        const currentCall = activeCallRef.current;
        
        if (handledElsewhere) {
          setActiveCall(null);
          return;
        }

        if (!accepted) {
          if (!isGroup) setActiveCall(null);
          return;
        }

        if (isGroup) {
          if (!currentCall || (currentCall.targetName !== groupName && (currentCall as any).id !== groupName)) return;
          const amICaller = currentCall.callerName === userName;
          const amIConnected = currentCall.status === 'connected';
          if (!amICaller && !amIConnected) return; 
        }

        setActiveCall(prev => prev ? { ...prev, status: 'connected' } : null);
        
        try {
          const stream = localStreamRef.current || await navigator.mediaDevices.getUserMedia({ 
            audio: { 
              deviceId: selectedInputDevice !== 'default' ? { ideal: selectedInputDevice } : undefined,
              echoCancellation,
              noiseSuppression,
              autoGainControl: automaticGainControl
            },
            video: false
          });
          localStreamRef.current = stream;
          refreshDevices();
          
          const pc = createPeerConnection(answererName);
          
          stream.getTracks().forEach(track => {
            const senders = pc.getSenders();
            if (!senders.some(s => s.track === track)) {
              pc.addTrack(track, stream);
            }
          });

          if (cameraStreamRef.current) {
            cameraStreamRef.current.getTracks().forEach(track => {
              const senders = pc.getSenders();
              if (!senders.some(s => s.track === track)) {
                pc.addTrack(track, cameraStreamRef.current!);
              }
            });
          }
          if (screenStreamRef.current) {
            screenStreamRef.current.getTracks().forEach(track => {
              const senders = pc.getSenders();
              if (!senders.some(s => s.track === track)) {
                pc.addTrack(track, screenStreamRef.current!);
              }
            });
          }
          
          const offer = await pc.createOffer();
          await pc.setLocalDescription(offer);
          
          socket.emit('sdp-offer', {
            targetName: answererName,
            offer,
            senderName: userName
          });
        } catch (err) {
          console.error('Failed to start call relay:', err);
          if (!isGroup) endCall();
        }
      });

      socket.on('sdp-offer', async ({ offer, senderName }) => {
        try {
          let pc = peerConnectionsRef.current.get(senderName);
          if (!pc || pc.signalingState === 'closed') {
            const stream = localStreamRef.current || await navigator.mediaDevices.getUserMedia({ 
              audio: selectedInputDevice !== 'default' ? { deviceId: { ideal: selectedInputDevice } } : true,
              video: activeCall?.withVideo ? { deviceId: selectedVideoDevice !== 'default' ? { ideal: selectedVideoDevice } : undefined } : false
            });
            localStreamRef.current = stream;
            
            pc = createPeerConnection(senderName);
            stream.getTracks().forEach(track => pc!.addTrack(track, stream));

            // Add camera and screen share tracks if they are active
            if (cameraStreamRef.current) {
              cameraStreamRef.current.getTracks().forEach(track => pc!.addTrack(track, cameraStreamRef.current!));
            }
            if (screenStreamRef.current) {
              screenStreamRef.current.getTracks().forEach(track => pc!.addTrack(track, screenStreamRef.current!));
            }

            // Wait until remote description is set before adding buffered candidates
            await pc.setRemoteDescription(new RTCSessionDescription(offer));
            
            const buffered = iceCandidatesBuffer.current.get(senderName) || [];
            for (const candidate of buffered) {
              await pc.addIceCandidate(new RTCIceCandidate(candidate)).catch(e => console.warn("Failed to add buffered candidate", e));
            }
            iceCandidatesBuffer.current.delete(senderName);

            const answer = await pc.createAnswer();
            await pc.setLocalDescription(answer);

            setActiveCall(prev => prev ? { ...prev, status: 'connected' } : {
              type: 'private',
              targetId: senderName,
              targetName: senderName,
              status: 'connected',
              isIncoming: true
            });
            
            socket.emit('sdp-answer', {
              targetName: senderName,
              answer,
              senderName: userName
            });
          } else {
             await pc.setRemoteDescription(new RTCSessionDescription(offer));

             const buffered = iceCandidatesBuffer.current.get(senderName) || [];
             for (const candidate of buffered) {
               await pc.addIceCandidate(new RTCIceCandidate(candidate)).catch(e => console.warn("Failed to add buffered candidate", e));
             }
             iceCandidatesBuffer.current.delete(senderName);

             const answer = await pc.createAnswer();
             await pc.setLocalDescription(answer);

             setActiveCall(prev => prev ? { ...prev, status: 'connected' } : {
               type: 'private',
               targetId: senderName,
               targetName: senderName,
               status: 'connected',
               isIncoming: true
             });

             socket.emit('sdp-answer', {
               targetName: senderName,
               answer,
               senderName: userName
             });
          }
        } catch (err) {
          console.error('Failed to handle offer:', err);
        }
      });

      socket.on('sdp-answer', async ({ answer, senderName }) => {
        const pc = peerConnectionsRef.current.get(senderName);
        if (pc && pc.signalingState !== 'stable') {
          try {
            await pc.setRemoteDescription(new RTCSessionDescription(answer));
            
            const buffered = iceCandidatesBuffer.current.get(senderName) || [];
            for (const candidate of buffered) {
              await pc.addIceCandidate(new RTCIceCandidate(candidate)).catch(e => console.warn("Failed to add buffered candidate (caller)", e));
            }
            iceCandidatesBuffer.current.delete(senderName);
          } catch (e) {
            console.error("Failed to set remote description on answer", e);
          }
        }
      });

      socket.on('ice-candidate', async ({ candidate, senderName }) => {
        const pc = peerConnectionsRef.current.get(senderName);
        // Browser requires remote description to be set before adding candidates
        if (pc && pc.remoteDescription) {
          try {
            await pc.addIceCandidate(new RTCIceCandidate(candidate));
          } catch (e) {
            console.error('Error adding ice candidate', e);
          }
        } else {
          // Buffer candidate
          const current = iceCandidatesBuffer.current.get(senderName) || [];
          iceCandidatesBuffer.current.set(senderName, [...current, candidate]);
        }
      });

      socket.on('camera-state-changed', ({ isOn }) => {
        setIsRemoteCameraOn(isOn);
      });

      socket.on('call-ended', (payload: any = {}) => {
        const { senderName, isGroup, groupName, targetName } = payload;
        
        if (senderName) {
          setSpeakingUsers(prev => {
            const next = new Set(prev);
            next.delete(senderName);
            return next;
          });
        }

        // If it was a multi-device sync notification (I am the sender/target on another device)
        if (senderName === userName || targetName === userName) {
          setActiveCall(null);
          setSpeakingUsers(new Set());
          setIsSpeaking(false);
          setIsRemoteSpeaking(false);
          return;
        }

        const currentCall = activeCallRef.current;
        if (isGroup && currentCall?.targetName === groupName) {
          // A specific person left the group call
          const pc = peerConnectionsRef.current.get(senderName);
          if (pc) {
            pc.close();
            peerConnectionsRef.current.delete(senderName);
          }
          setRemoteAudioStreams(prev => {
            const next = new Map(prev);
            next.delete(senderName);
            return next;
          });
          setRemoteVideoStreams(prev => {
            const next = new Map(prev);
            for (const key of prev.keys()) {
              if (key.startsWith(`${senderName}:-:`)) {
                next.delete(key);
              }
            }
            return next;
          });
        } else {
          // Regular call ended, or the whole call ended
          if (localStreamRef.current) {
            localStreamRef.current.getTracks().forEach(track => track.stop());
            localStreamRef.current = null;
          }
          peerConnectionsRef.current.forEach(pc => pc.close());
          peerConnectionsRef.current.clear();
          setRemoteAudioStreams(new Map());
          setRemoteVideoStreams(new Map());
          
          if (remoteAudioRef.current) {
            remoteAudioRef.current.srcObject = null;
          }
          setActiveCall(null);
          setIsCallExpanded(false);
          setIsSpeaking(false);
          setIsRemoteSpeaking(false);
          setSpeakingUsers(new Set());
        }
      });

      socket.on('blocked-by-user', ({ blockerName }) => {
        setUsersBlockingMe(prev => {
          if (prev.some(name => (name || '').toLowerCase() === (blockerName || '').toLowerCase())) return prev;
          return [...prev, blockerName];
        });
      });

      socket.on('unblocked-by-user', ({ blockerName }) => {
        setUsersBlockingMe(prev => prev.filter(name => (name || '').toLowerCase() !== (blockerName || '').toLowerCase()));
      });

      socket.on('user-speaking', ({ userName: speakingUser, isSpeaking: remoteIsSpeaking, serverId, channelId }) => {
        if (speakingUser === userName) return;

        // Always update speakingUsers Set for the CallModal and participant highlights
        setSpeakingUsers(prev => {
          const next = new Set(prev);
          if (remoteIsSpeaking) next.add(speakingUser);
          else next.delete(speakingUser);
          return next;
        });

        if (serverId && channelId) {
          setServers(prev => prev.map(s => s.id === serverId ? {
            ...s,
            channels: s.channels?.map(c => c.id === channelId ? {
              ...c,
              voiceMembers: c.voiceMembers?.map(m => m.name === speakingUser ? { ...m, isSpeaking: remoteIsSpeaking } : m)
            } : c)
          } : s));
        } else {
          setIsRemoteSpeaking(remoteIsSpeaking);
        }
      });

      socket.on('new-friend-request', (request) => {
        setFriendRequests(prev => [...prev, request]);
        triggerNotification('New Friend Request', `${request.from} sent you a friend request.`, 'friend');
      });

      socket.on('unfriended', ({ friendName }) => {
        setFriends(prev => prev.filter(f => f.name !== friendName));
        setRecentDMs(prev => prev.filter(dm => dm.name !== friendName));
        if (activeDMRef.current === friendName) {
          setActiveDM(null);
          setActiveView('friends');
        }
      });

      socket.on('friend-request-removed', ({ targetName, requestId }) => {
        setSentFriendRequests(prev => prev.filter(name => name !== targetName));
      });

      socket.on('kicked-from-server', ({ serverId, banned, reason }) => {
        const s = serversRef.current.find(srv => srv.id === serverId);
        if (!s) return;
        
        setServers(prev => prev.filter(srv => srv.id !== serverId));
        
        if (activeServerRef.current === serverId) {
          setActiveView('home');
          setActiveServer(null);
        }
      });

      socket.on('friend-request-accepted', (newFriend) => {
        setFriends(prev => {
          if (prev.some(f => f.name === newFriend.name)) return prev;
          return [...prev, newFriend];
        });
        setSentFriendRequests(prev => prev.filter(name => name !== newFriend.name));
      });

      socket.on('channel-created', ({ serverId, channel }) => {
        setServers(prev => prev.map(s => {
          if (s.id === serverId) {
             const channelExists = s.channels?.some(c => c.id === channel.id);
             if (channelExists) return s;
             return {
              ...s,
              channels: deduplicateChannels([...(s.channels || []), channel])
            };
          }
          return s;
        }));
      });

      socket.on('user-joined-server', ({ serverId, user }) => {
        setServers(prev => prev.map(s => s.id === serverId ? {
          ...s,
          members: s.members?.some(m => m.id === user.id) ? s.members : [...(s.members || []), user]
        } : s));
      });

      socket.on('friend-requests-list', (requests) => {
        setFriendRequests(requests);
      });

      socket.on('new-server-message', ({ serverId, channelId, message }: { serverId: string, channelId: string, message: Message }) => {
        // Check if sender is blocked (case-insensitive)
        if (blockedUsersRef.current.some(u => (u.name || '').toLowerCase() === (message.sender || '').toLowerCase())) {
          return;
        }

        const msgKey = `server:${serverId}:${channelId}:${message.id}`;
        if (!handledNotificationIdsRef.current.has(msgKey) && !handledNotificationIdsRef.current.has(message.id)) {
          handledNotificationIdsRef.current.add(msgKey);
          handledNotificationIdsRef.current.add(message.id);
          if (handledNotificationIdsRef.current.size > 2000) {
            const first = handledNotificationIdsRef.current.values().next().value;
            if (first) handledNotificationIdsRef.current.delete(first);
          }

          // Check for mention and add to recent pings
          const isMention = message.text?.includes(`@${userName}`);
          if (isMention) {
            const serverName = serversRef.current.find(s => s.id === serverId)?.name || 'Unknown Server';
            setRecentPings(prev => {
              if (prev.some(p => p.id === message.id)) return prev;
              return [{
                id: message.id,
                sender: message.sender,
                senderImage: message.senderImage || 'https://i.imgur.com/zp6R930.png',
                text: message.text || '',
                serverName,
                channelName: channelId,
                serverId,
                channelId,
                timestamp: message.timestamp || Date.now()
              }, ...prev].slice(0, 10);
            });
          }

          // Increment unread count if not viewing this channel
          if (message.sender !== userName) {
            if (activeViewRef.current !== 'server' || activeServerRef.current !== serverId || activeChannelRef.current !== channelId) {
              incrementUnread('server', serverId, channelId, isMention);

              const isServerMuted = mutedServersRef.current.includes(serverId);
              const isChannelMuted = mutedChannelsRef.current.includes(channelId);
              if (!isServerMuted && !isChannelMuted) {
                triggerNotification(
                  isMention ? 'New Mention' : 'New Server Message',
                  `${message.sender}: ${message.text || 'Sent an attachment'}`,
                  isMention ? 'mention' : 'message',
                  message.sender
                );
              }
            }
          }
        }

        setServerMessages(prev => {
          const serverData = prev[serverId] || {};
          const channelMessages = serverData[channelId] || [];
          if (channelMessages.some(m => m.id === message.id)) return prev;
          return {
            ...prev,
            [serverId]: {
              ...serverData,
              [channelId]: [...channelMessages, message].sort((a, b) => (a.timestamp || 0) - (b.timestamp || 0))
            }
          };
        });
      });

      socket.on('new-dm-message', ({ message, otherPerson }: { message: Message, otherPerson: string }) => {
        // Check if sender is blocked (case-insensitive)
        if (message.sender !== 'T0AI Assistant' && blockedUsersRef.current.some(u => (u.name || '').toLowerCase() === (message.sender || '').toLowerCase())) {
          return;
        }

        // Check privacy settings: if not allowing DMs from non-friends
        if (!allowDirectMessagesRef.current && message.sender !== userName && message.sender !== 'T0AI Assistant') {
          const isFriend = friendsRef.current.some(f => f.name === message.sender);
          if (!isFriend) {
            return;
          }
        }

        const msgKey = `dm:${otherPerson}:${message.id}`;
        if (!handledNotificationIdsRef.current.has(msgKey) && !handledNotificationIdsRef.current.has(message.id)) {
          handledNotificationIdsRef.current.add(msgKey);
          handledNotificationIdsRef.current.add(message.id);
          if (handledNotificationIdsRef.current.size > 2000) {
            const first = handledNotificationIdsRef.current.values().next().value;
            if (first) handledNotificationIdsRef.current.delete(first);
          }

          // Increment unread count if not viewing this DM
          if (message.sender !== userName) {
            if (activeViewRef.current !== 'messages' || activeDMRef.current !== otherPerson) {
              incrementUnread('dm', otherPerson);
              triggerNotification(
                'New Message',
                `${message.sender}: ${message.text || 'Sent an attachment'}`,
                'message',
                message.sender
              );
            }
          }
        }

        setDmMessages(prev => {
          const personMessages = prev[otherPerson] || [];
          if (personMessages.some(m => m.id === message.id)) return prev;
          return {
            ...prev,
            [otherPerson]: [...personMessages, message].sort((a, b) => (a.timestamp || 0) - (b.timestamp || 0))
          };
        });
      });

      socket.on('channel-messages', ({ serverId, channelId, messages, hasMore }: { serverId: string, channelId: string, messages: Message[], hasMore?: boolean }) => {
        if (hasMore !== undefined) {
          setHasMoreMessages(prev => ({ ...prev, [`${serverId}:${channelId}`]: hasMore }));
        }
        setServerMessages(prev => ({
          ...prev,
          [serverId]: {
            ...(prev[serverId] || {}),
            [channelId]: messages
          }
        }));
      });

      socket.on('load-more-messages-res', ({ messages: historicalMessages, hasMore, type, targetId, channelId }) => {
        const key = type === 'server' ? `${targetId}:${channelId}` : targetId;
        setHasMoreMessages(prev => ({ ...prev, [key!]: hasMore }));

        if (historicalMessages && historicalMessages.length > 0) {
          if (type === 'server') {
            setServerMessages(prev => {
              const serverData = prev[targetId!] || {};
              const current = serverData[channelId!] || [];
              const combined = [...historicalMessages, ...current].filter((v, i, a) => a.findIndex(t => t.id === v.id) === i);
              return {
                ...prev,
                [targetId!]: {
                   ...serverData,
                   [channelId!]: combined
                }
              };
            });
          } else if (type === 'dm' || type === 'group') {
            setDmMessages(prev => {
              const targetName = type === 'group' ? groupChatsRef.current.find(gc => gc.id === targetId)?.name : targetId;
              if (!targetName) return prev;
              const current = prev[targetName] || [];
              const combined = [...historicalMessages, ...current].filter((v, i, a) => a.findIndex(t => t.id === v.id) === i);
              return {
                ...prev,
                [targetName]: combined
              };
            });
          }

          // Maintain scroll position after state update, then set loading state to false
          setTimeout(() => {
            if (chatScrollRef.current) {
              const newScrollHeight = chatScrollRef.current.scrollHeight;
              chatScrollRef.current.scrollTop = newScrollHeight - lastScrollHeightRef.current;
            }
            setIsLoadingHistory(false);
          }, 50);
        } else {
          setIsLoadingHistory(false);
        }
      });

      socket.on('force-logout', ({ reason }) => {
        alert(reason || "Your session has been revoked.");
        handlePerformLogout(false);
      });

      socket.on('server-message-deleted', ({ serverId, channelId, messageId }: { serverId: string, channelId: string, messageId: string }) => {
        deletedMessageIdsRef.current.delete(messageId);
        setServerMessages(prev => {
          const serverData = prev[serverId] || {};
          const channelMessages = serverData[channelId] || [];
          return {
            ...prev,
            [serverId]: {
              ...serverData,
              [channelId]: channelMessages.filter(m => m.id !== messageId)
            }
          };
        });
      });

      socket.on('server-members-list', ({ serverId, members }) => {
        setServers(prev => prev.map(s => s.id === serverId ? {
          ...s,
          members: members
        } : s));
      });

      socket.on('user-left-server', ({ serverId, userId }) => {
        setServers(prev => prev.map(s => s.id === serverId ? {
          ...s,
          members: s.members?.filter(m => m.id !== userId) || []
        } : s));
      });

      socket.on('user-camera-state-changed', ({ userName: senderName, isOn, serverId, channelId }) => {
        setServers(prev => prev.map(s => s.id === serverId ? {
          ...s,
          channels: s.channels?.map(c => c.id === channelId ? {
            ...c,
            voiceMembers: c.voiceMembers?.map(m => m.name === senderName ? { ...m, isCameraOn: isOn } : m)
          } : c)
        } : s));
      });

      socket.on('user-screen-share-state-changed', ({ userName: senderName, isOn, serverId, channelId }) => {
        setServers(prev => prev.map(s => s.id === serverId ? {
          ...s,
          channels: s.channels?.map(c => c.id === channelId ? {
            ...c,
            voiceMembers: c.voiceMembers?.map(m => m.name === senderName ? { ...m, isScreenSharing: isOn } : m)
          } : c)
        } : s));
      });

      socket.on('user-voice-state-changed', ({ userName: senderName, isMuted: remoteMuted, isDeafened: remoteDeafened, serverId, channelId }) => {
        if (serverId && channelId) {
          setServers(prev => prev.map(s => s.id === serverId ? {
            ...s,
            channels: s.channels?.map(c => c.id === channelId ? {
              ...c,
              voiceMembers: c.voiceMembers?.map(m => m.name === senderName ? { ...m, isMuted: remoteMuted, isDeafened: remoteDeafened } : m)
            } : c)
          } : s));
        } else if (activeCallRef.current?.type === 'private' && activeCallRef.current.targetName === senderName) {
          setIsRemoteMuted(remoteMuted);
          setIsRemoteDeafened(remoteDeafened);
        }
      });

      socket.on('voice-channel-members-updated', ({ serverId, channelId, members }) => {
        const activeNames = new Set((members || []).map((m: any) => m.name));
        setServers(prev => prev.map(s => s.id === serverId ? {
          ...s,
          channels: s.channels?.map(c => c.id === channelId ? {
            ...c,
            voiceMembers: members
          } : c)
        } : s));

        if (activeCallRef.current?.type === 'server' && activeCallRef.current?.serverId === serverId && activeCallRef.current?.targetName === channelId) {
          setSpeakingUsers(prev => {
            const next = new Set<string>();
            for (const name of prev) {
              if (activeNames.has(name) || name === userName) {
                next.add(name);
              }
            }
            return next;
          });
        }
      });

      socket.on('force-move-voice', async ({ serverId, toChannelId }) => {
        if (activeCallRef.current?.type === 'server' && activeCallRef.current.serverId === serverId) {
          // Leave old channel
          socket.emit("leave-voice-channel", { serverId, channelId: activeCallRef.current.targetName });
          
          // Clear current connections but keep local stream
          peerConnectionsRef.current.forEach(pc => pc.close());
          peerConnectionsRef.current.clear();
          setRemoteAudioStreams(new Map());
          setRemoteVideoStreams(new Map());
          
          // Update local state to new channel
          const newCall = { type: 'server' as const, serverId, targetName: toChannelId, targetId: toChannelId, status: 'connected' as const };
          setActiveCall(newCall);
          activeCallRef.current = newCall;
          setActiveChannel(toChannelId);
          setIsMobileChannelSelected(true);
          
          // Join new channel
          socket.emit("join-voice-channel", { serverId, channelId: toChannelId });
        }
      });

      socket.on('user-joined-voice', async ({ serverId, channelId, user }) => {
        // If we're in this channel, initiate call with newcomer
        if (activeCallRef.current?.type === 'server' && activeCallRef.current.targetId === channelId && user.name !== userName) {
          try {
            const stream = localStreamRef.current || await navigator.mediaDevices.getUserMedia({ 
              audio: selectedInputDevice !== 'default' ? { deviceId: { ideal: selectedInputDevice } } : true,
              video: false
            });
            localStreamRef.current = stream;
            
            const pc = createPeerConnection(user.name);
            stream.getTracks().forEach(track => pc.addTrack(track, stream));
            
            // Add camera and screen share tracks if active
            if (cameraStreamRef.current) {
              cameraStreamRef.current.getTracks().forEach(track => pc.addTrack(track, cameraStreamRef.current!));
            }
            if (screenStreamRef.current) {
              screenStreamRef.current.getTracks().forEach(track => pc.addTrack(track, screenStreamRef.current!));
            }
            
            const offer = await pc.createOffer();
            await pc.setLocalDescription(offer);
            
            socket.emit('sdp-offer', {
              targetName: user.name,
              offer,
              senderName: userName
            });
          } catch (err) {
            console.error('Failed to initiate call with newcomer:', err);
          }
        }
      });

      socket.on('user-left-voice', ({ userId, userName: leavingUserName }) => {
        if (leavingUserName) {
          setSpeakingUsers(prev => {
            const next = new Set(prev);
            next.delete(leavingUserName);
            return next;
          });
        }
        const pc = peerConnectionsRef.current.get(leavingUserName);
        if (pc) {
          pc.close();
          peerConnectionsRef.current.delete(leavingUserName);
          setRemoteAudioStreams(prev => {
            const next = new Map(prev);
            next.delete(leavingUserName);
            return next;
          });
          setRemoteVideoStreams(prev => {
            const next = new Map(prev);
            next.delete(leavingUserName);
            return next;
          });
        }
      });

      socket.on('server-deleted', ({ serverId }) => {
        setServers(prev => prev.filter(s => s.id !== serverId));
        if (activeServerRef.current === serverId) {
          setActiveServer(null);
          setActiveView('home');
        }
      });

      socket.on('server-updated', ({ serverId, server }) => {
        setServers(prev => {
          const updateInList = (list: Server[]): Server[] => {
            return list.map(s => {
              if (s.id === serverId) {
                return { ...s, ...server };
              }
              if (s.isFolder && s.servers) {
                return { ...s, servers: updateInList(s.servers) };
              }
              return s;
            });
          };
          return updateInList(prev);
        });
        setEditingServer(prev => prev && prev.id === serverId ? { ...prev, ...server } : prev);
      });

      socket.on('server-events-updated', ({ serverId }) => {
        if (activeServerRef.current === serverId) {
          fetchServerEvents(serverId);
        }
      });

      socket.on('dm-message-deleted', ({ messageId, sender, receiver }: { messageId: string, sender: string, receiver: string }) => {
        deletedMessageIdsRef.current.delete(messageId);
        
        const groupChat = groupChatsRef.current.find(gc => gc.id === receiver || gc.name === receiver);
        const otherPerson = groupChat ? groupChat.name : (sender === userName ? receiver : sender);

        setDmMessages(prev => {
          const personMessages = prev[otherPerson] || [];
          if (!personMessages.find(m => m.id === messageId)) return prev;
          const filtered = personMessages.filter(m => m.id !== messageId);
          if (filtered.length === 0) {
            const newState = { ...prev };
            delete newState[otherPerson];
            return newState;
          }
          return {
            ...prev,
            [otherPerson]: filtered
          };
        });
      });

      socket.on('dm-message-edited', ({ message, otherPerson }: { message: Message, otherPerson: string }) => {
        const groupChat = groupChatsRef.current.find(gc => gc.id === otherPerson || gc.name === otherPerson);
        const targetPerson = groupChat ? groupChat.name : otherPerson;

        setDmMessages(prev => {
          const messages = prev[targetPerson] || [];
          return {
            ...prev,
            [targetPerson]: messages.map(msg => msg.id === message.id ? message : msg)
          };
        });
      });

      socket.on('dm-message-reacted', ({ message, otherPerson }: { message: Message, otherPerson: string }) => {
        const groupChat = groupChatsRef.current.find(gc => gc.id === otherPerson || gc.name === otherPerson);
        const targetPerson = groupChat ? groupChat.name : otherPerson;

        setDmMessages(prev => {
          const messages = prev[targetPerson] || [];
          return {
            ...prev,
            [targetPerson]: messages.map(msg => msg.id === message.id ? message : msg)
          };
        });
      });

      socket.on('server-message-edited', ({ serverId, channelId, message }: { serverId: string, channelId: string, message: Message }) => {
        setServerMessages(prev => {
          const serverData = prev[serverId] || {};
          const channelMessages = serverData[channelId] || [];
          return {
            ...prev,
            [serverId]: {
              ...serverData,
              [channelId]: channelMessages.map(msg => msg.id === message.id ? message : msg)
            }
          };
        });
      });

      socket.on('server-message-reacted', ({ serverId, channelId, message }: { serverId: string, channelId: string, message: Message }) => {
        setServerMessages(prev => {
          const serverData = prev[serverId] || {};
          const channelMessages = serverData[channelId] || [];
          return {
            ...prev,
            [serverId]: {
              ...serverData,
              [channelId]: channelMessages.map(msg => msg.id === message.id ? message : msg)
            }
          };
        });
      });

      socket.on('dm-message-starred', ({ message, otherPerson }: { message: Message, otherPerson: string }) => {
        const groupChat = groupChatsRef.current.find(gc => gc.id === otherPerson || gc.name === otherPerson);
        const targetPerson = groupChat ? groupChat.name : otherPerson;

        setDmMessages(prev => {
          const messages = prev[targetPerson] || [];
          return {
            ...prev,
            [targetPerson]: messages.map(msg => msg.id === message.id ? message : msg)
          };
        });
      });

      socket.on('server-message-starred', ({ serverId, channelId, message }: { serverId: string, channelId: string, message: Message }) => {
        setServerMessages(prev => {
          const serverData = prev[serverId] || {};
          const channelMessages = serverData[channelId] || [];
          return {
            ...prev,
            [serverId]: {
              ...serverData,
              [channelId]: channelMessages.map(msg => msg.id === message.id ? message : msg)
            }
          };
        });
      });

      socket.on('poll-updated', ({ serverId, channelId, messageId, poll }) => {
        setServerMessages(prev => {
          const serverData = prev[serverId] || {};
          const channelMessages = serverData[channelId] || [];
          return {
            ...prev,
            [serverId]: {
              ...serverData,
              [channelId]: channelMessages.map(msg => msg.id === messageId ? { ...msg, poll } : msg)
            }
          };
        });
      });

      socket.on('vanish-mode-changed', ({ user1, user2, isVanishMode }: { user1: string, user2: string, isVanishMode: boolean }) => {
        let otherUser = '';
        if (user1 === userName) {
          otherUser = user2;
        } else if (user2 === userName) {
          otherUser = user1;
        }

        if (otherUser) {
          setVanishModeByDM(prev => ({ ...prev, [otherUser]: isVanishMode }));
          if (!isVanishMode) {
            setDmMessages(prev => {
              const currentMessages = prev[otherUser] || [];
              return {
                ...prev,
                [otherUser]: currentMessages.filter(msg => !msg.isVanish)
              };
            });
          }
        }
      });

      socket.on('scheduled-messages-list', (list: ScheduledMessageItem[]) => {
        setScheduledMessages(list);
      });
      socket.on('scheduled-message-created', (newMsg: ScheduledMessageItem) => {
        setScheduledMessages(prev => [...prev.filter(m => m.id !== newMsg.id), newMsg]);
      });
      socket.on('scheduled-message-updated', (updated: ScheduledMessageItem) => {
        setScheduledMessages(prev => prev.map(m => m.id === updated.id ? updated : m));
      });
      socket.on('scheduled-message-deleted', ({ id }: { id: string }) => {
        setScheduledMessages(prev => prev.filter(m => m.id !== id));
      });
      socket.on('scheduled-message-sent', ({ scheduledId }: { scheduledId: string }) => {
        setScheduledMessages(prev => prev.filter(m => m.id !== scheduledId));
        setToast({ message: 'Scheduled message delivered successfully!', type: 'success' });
      });
      socket.on('scheduled-message-failed', ({ error }: { error: string }) => {
        setToast({ message: `Scheduled message failed: ${error}`, type: 'error' });
      });

      return () => {
        socket.disconnect();
      };
    }
  }, [showApp, userName, localStorage.getItem('vylant_token'), sessionStorage.getItem('vylant_token')]);

  useEffect(() => {
    if (socketRef.current && activeServer && activeChannel) {
      socketRef.current.emit('join-channel', { serverId: activeServer, channelId: activeChannel });
    }
    return () => {
      if (socketRef.current && activeServer && activeChannel) {
        socketRef.current.emit('leave-channel', { serverId: activeServer, channelId: activeChannel });
      }
    };
  }, [activeServer, activeChannel]);

  // Sync navigation to other devices
  useEffect(() => {
    if (socketRef.current && socketRef.current.connected) {
      if (isSyncingRef.current) {
        isSyncingRef.current = false;
        return;
      }
      socketRef.current.emit("sync-navigation", { activeView, activeServer, activeChannel });
    }
  }, [activeView, activeServer, activeChannel]);

  // Sync muted channels to other devices
  useEffect(() => {
    if (socketRef.current && socketRef.current.connected) {
      if (isSyncingRef.current) {
        isSyncingRef.current = false;
        return;
      }
      socketRef.current.emit("sync-muted-channels", { mutedChannels });
    }
  }, [mutedChannels]);

  useEffect(() => {
    if (socketRef.current && socketRef.current.connected) {
      if (isSyncingRef.current) {
        isSyncingRef.current = false;
        return;
      }
      socketRef.current.emit("sync-muted-servers", { mutedServers });
