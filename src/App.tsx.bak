                            {newFolderFriends.includes(friend.id) && <Check size={14} />}
                          </div>
                          <img src={friend.image} alt={friend.name} className="w-8 h-8 rounded-full" />
                          <span className={`font-medium ${isDarkMode ? 'text-white' : 'text-slate-900'}`}>{friend.name}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>

                <div className="flex items-center gap-3 mt-8">
                  <button 
                    onClick={() => {
                      setIsEditFolderModalOpen(false);
                      setEditingFolderId(null);
                      setNewFolderName('');
                      setNewFolderFriends([]);
                    }}
                    className={`flex-1 py-3 rounded-xl font-bold transition-colors ${
                      isDarkMode ? 'hover:bg-white/10 text-white/70 hover:text-white' : 'hover:bg-slate-100 text-slate-600 hover:text-slate-900'
                    }`}
                  >
                    Cancel
                  </button>
                  <button 
                    onClick={() => {
                      if (newFolderName.trim() && editingFolderId) {
                        setFriendFolders(prev => prev.map(f => f.id === editingFolderId ? {
                          ...f,
                          name: newFolderName.trim(),
                          friendIds: newFolderFriends
                        } : f));
                        setIsEditFolderModalOpen(false);
                        setEditingFolderId(null);
                        setNewFolderName('');
                        setNewFolderFriends([]);
                      }
                    }}
                    disabled={!newFolderName.trim()}
                    className={`flex-1 py-3 rounded-xl font-bold transition-all shadow-lg ${
                      !newFolderName.trim()
                        ? 'bg-slate-500/20 text-slate-500 cursor-not-allowed'
                        : 'bg-vylant-blue text-white shadow-vylant-blue/20 hover:scale-105 active:scale-95'
                    }`}
                  >
                    Save Changes
                  </button>
                </div>
              </div>
            </motion.div>
          </div>
        )}
      </AnimatePresence>

      {/* Delete Folder Modal */}
      <AnimatePresence>
        {folderToDelete && (
          <div className="fixed inset-0 z-[300] flex items-center justify-center p-4">
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              onClick={() => setFolderToDelete(null)}
              className="absolute inset-0 bg-black/60 backdrop-blur-sm"
            />
            <motion.div
              initial={{ opacity: 0, scale: 0.9, y: 20 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.9, y: 20 }}
              className={`relative w-full max-w-sm rounded-3xl shadow-2xl border overflow-hidden ${
                isDarkMode ? 'bg-slate-900 border-white/10 text-white' : 'bg-white border-slate-200 text-slate-900'
              }`}
            >
              <div className="p-4 md:p-6">
                <h2 className="text-xl font-bold mb-2">Delete Folder</h2>
                <p className={`text-sm mb-6 ${isDarkMode ? 'text-white/70' : 'text-slate-600'}`}>
                  Are you sure you want to delete the folder <strong>{folderToDelete.name}</strong>? This will not remove your friends.
                </p>
                <div className="flex items-center gap-3">
                  <button 
                    onClick={() => setFolderToDelete(null)}
                    className={`flex-1 py-3 rounded-xl font-bold transition-colors ${
                      isDarkMode ? 'hover:bg-white/10 text-white/70 hover:text-white' : 'hover:bg-slate-100 text-slate-600 hover:text-slate-900'
                    }`}
                  >
                    Cancel
                  </button>
                  <button 
                    onClick={() => {
                      setFriendFolders(prev => prev.filter(f => f.id !== folderToDelete.id));
                      setFolderToDelete(null);
                    }}
                    className="flex-1 py-3 rounded-xl font-bold transition-all shadow-lg bg-red-500 text-white shadow-red-500/20 hover:scale-105 active:scale-95"
                  >
                    Delete
                  </button>
                </div>
              </div>
            </motion.div>
          </div>
        )}
      </AnimatePresence>

      {/* Support Us Modal */}
      <AnimatePresence>
        {isSupportModalOpen && (
          <div className="fixed inset-0 z-[300] flex items-center justify-center p-4">
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              onClick={() => setIsSupportModalOpen(false)}
              className="absolute inset-0 bg-black/60 backdrop-blur-sm"
            />
            <motion.div
              initial={{ opacity: 0, scale: 0.9, y: 20 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.9, y: 20 }}
              className={`relative w-full max-w-md rounded-3xl shadow-2xl border overflow-hidden ${
                isDarkMode ? 'bg-slate-900 border-white/10 text-white' : 'bg-white border-slate-200 text-slate-900'
              }`}
            >
              <div className="p-4 md:p-6">
                <div className="flex items-center justify-between mb-6">
                  <h2 className="text-xl font-bold">Support Us!</h2>
                  <button 
                    onClick={() => setIsSupportModalOpen(false)}
                    className={`p-2 rounded-xl transition-colors ${isDarkMode ? 'hover:bg-white/10' : 'hover:bg-slate-100'}`}
                  >
                    <X size={20} />
                  </button>
                </div>

                <div className="space-y-6">
                  <div className="text-center">
                    <div className="text-3xl font-black text-vylant-blue mb-2">$2.99 USD<span className="text-sm text-slate-400 font-normal">/month</span></div>
                    <p className={`text-sm ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>Unlock premium features and support Vylant's development.</p>
                  </div>

                  <div className={`p-4 rounded-xl border ${isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'}`}>
                    <h3 className="text-sm font-bold uppercase tracking-widest mb-4 text-vylant-blue">Subscription Perks</h3>
                    <ul className="space-y-3">
                      <li className="flex items-start gap-3">
                        <Check size={18} className="text-emerald-500 shrink-0 mt-0.5" />
                        <span className="text-sm">Early access to beta/experimental features</span>
                      </li>
                      <li className="flex items-start gap-3">
                        <Check size={18} className="text-emerald-500 shrink-0 mt-0.5" />
                        <span className="text-sm">Custom server themes</span>
                      </li>
                      <li className="flex items-start gap-3">
                        <Check size={18} className="text-emerald-500 shrink-0 mt-0.5" />
                        <span className="text-sm">Allows you to upload custom emojis</span>
                      </li>
                      <li className="flex items-start gap-3">
                        <Check size={18} className="text-emerald-500 shrink-0 mt-0.5" />
                        <span className="text-sm">Exclusive profile badge</span>
                      </li>
                      <li className="flex items-start gap-3">
                        <Check size={18} className="text-emerald-500 shrink-0 mt-0.5" />
                        <span className="text-sm italic opacity-80">and more to come...</span>
                      </li>
                    </ul>
                  </div>

                  <button 
                    disabled={isStripeLoading}
                    onClick={async () => {
                      if (isStripeLoading) return;
                      setIsStripeLoading(true);
                      try {
                        const response = await apiFetch('/api/stripe/create-checkout-session', {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await response.json();
                        if (data.success) {
                          if (data.simulated) {
                            setIsSupportModalOpen(false);
                            setIsSimulatedStripeModalOpen(true);
                          } else if (data.url) {
                            window.location.href = data.url;
                          }
                        } else {
                          alert(data.error || "Failed to initialize subscription checkout.");
                        }
                      } catch (err) {
                        console.error("Subscription checkout failed:", err);
                        alert("An error occurred. Please try again.");
                      } finally {
                        setIsStripeLoading(false);
                      }
                    }}
                    className="w-full py-4 bg-vylant-blue text-white rounded-2xl font-bold shadow-lg shadow-vylant-blue/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2"
                  >
                    {isStripeLoading ? (
                      <>
                        <Loader2 size={18} className="animate-spin" />
                        Connecting to Stripe...
                      </>
                    ) : (
                      "Subscribe Now"
                    )}
                  </button>
                </div>
              </div>
            </motion.div>
          </div>
        )}
      </AnimatePresence>

      {/* Vylant Supporter Panel Modal */}
      <AnimatePresence>
        {isSupporterPanelOpen && (
          <div className="fixed inset-0 z-[300] flex items-center justify-center p-4 text-left">
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              onClick={() => setIsSupporterPanelOpen(false)}
              className="absolute inset-0 bg-black/60 backdrop-blur-sm"
            />
            <motion.div
              initial={{ opacity: 0, scale: 0.9, y: 20 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.9, y: 20 }}
              className={`relative w-full max-w-4xl rounded-3xl shadow-2xl border overflow-hidden flex flex-col md:flex-row h-[85vh] md:h-[600px] ${
                isDarkMode ? 'bg-slate-900 border-white/10 text-white' : 'bg-white border-slate-200 text-slate-900'
              }`}
            >
              {(() => {
                const currentUserObj = vylantUsers.find(u => u.name === userName);
                const currentBadge = currentUserObj?.preferences?.supporterBadge || 'crown';
                
                const handleToggleAutoRenew = async (currentAutoRenew: boolean) => {
                  setIsTogglingRenew(true);
                  try {
                    const res = await apiFetch('/api/stripe/toggle-autorenew', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ autoRenew: !currentAutoRenew })
                    });
                    if (res.ok) {
                      const data = await res.json();
                      setVylantUsers(prev => prev.map(u => 
                        u.name === userName 
                          ? { 
                              ...u, 
                              preferences: { 
                                ...u.preferences, 
                                subscriptionDetails: data.subscriptionDetails 
                              } 
                            } 
                          : u
                      ));
                    } else {
                      alert("Failed to update auto-renew preference. Please try again.");
                    }
                  } catch (err) {
                    console.error("Auto renew toggle error:", err);
                    alert("Connection error. Failed to update auto-renew preference.");
                  } finally {
                    setIsTogglingRenew(false);
                  }
                };

                const handleCancelSubscription = () => {
                  setIsCancelConfirmModalOpen(true);
                };
                
                // Server themes calculation
                const myManagedServers = servers.filter(server => {
                  if (server.isFolder) return false;
                  return hasPermission(server, userName, 'editSettings');
                });

                const badgeOptions = [
                  { id: 'crown', label: 'Vylant Crown', desc: 'The classic golden crown badge representing royalty and loyalty.', icon: <Crown size={12} className="text-amber-400 fill-amber-400/20" /> },
                  { id: 'sparkle', label: 'Supernova', desc: 'An energetic neon-cyan dynamic sparkle badge.', icon: <Sparkles size={12} className="text-cyan-400 fill-cyan-400/20" /> },
                  { id: 'diamond', label: 'Diamond', desc: 'A rich pink diamond representive of pure structural clarity.', icon: <Gem size={12} className="text-pink-400 fill-pink-400/20" /> },
                  { id: 'shield', label: 'Elite Aegis', desc: 'An emerald dynamic emblem protective shield.', icon: <Shield size={12} className="text-emerald-400 fill-emerald-400/20" /> },
                  { id: 'fire', label: 'Fired Up', desc: 'An orange flame dynamic badge representing burning passion.', icon: <Flame size={12} className="text-orange-400 fill-orange-400/20" /> },
                  { id: 'heart', label: 'Heart Supporter', desc: 'A warm pulsing pink-rose badge representing boundless love.', icon: <Heart size={12} className="text-rose-400 fill-rose-400/20 animate-pulse" /> },
                  { id: 'none', label: 'Hide Supporter Status', desc: 'Temporarily hide support badges from your avatar tags.', icon: <X size={10} className="text-slate-400" /> }
                ];

                const themePresets = [
                  { id: 'default', name: 'Sloth Glass', bg: 'bg-vylant-navy border-white/10', desc: 'Standard slate glass dark theme.' },
                  { id: 'cyberpunk', name: 'Cyberpunk Neon', bg: 'bg-[#0f041c] border-pink-500/30', desc: 'Cyber violet glass with glowing sunset edges.' },
                  { id: 'emerald', name: 'Emerald Forest', bg: 'bg-[#03140a] border-emerald-500/30', desc: 'Enchanted deep green moss style glass bounds.' },
                  { id: 'gold', name: 'Imperial Amber', bg: 'bg-[#120e03] border-amber-500/30', desc: 'Exclusive black & royal gold glowing themes.' },
                  { id: 'crimson', name: 'Sunset Crimson', bg: 'bg-[#1c0308] border-red-500/30', desc: 'Maroon velvet glass with neon scarlet edging.' },
                  { id: 'ocean', name: 'Deep Abyss', bg: 'bg-[#03091c] border-cyan-500/30', desc: 'Navy glass with dynamic cyan/ocean accents.' }
                ];

                return (
                  <>
                    <div className={`w-full md:w-64 shrink-0 flex flex-col border-b md:border-b-0 md:border-r relative z-10 ${isDarkMode ? 'border-white/10 bg-black/20' : 'border-slate-200 bg-slate-50'}`}>
                      <div className="p-6 border-b border-white/10 flex items-center justify-between">
                        <div>
                          <div className="flex items-center gap-2 mb-1">
                            <Sparkles size={20} className="text-amber-500 animate-pulse fill-amber-500/10" />
                            <h2 className="text-lg font-bold font-display uppercase tracking-wider">Supporter</h2>
                          </div>
                          <p className={`text-[10px] uppercase font-bold tracking-widest ${isPremium ? 'text-amber-500' : 'text-slate-400'}`}>
                            {isPremium ? 'Premium Active' : 'Not Subscribed'}
                          </p>
                        </div>
                        <button 
                          onClick={() => setIsSupporterPanelOpen(false)}
                          className={`md:hidden p-2 rounded-xl transition-colors ${isDarkMode ? 'hover:bg-white/10' : 'hover:bg-slate-100'}`}
                        >
                          <X size={20} />
                        </button>
                      </div>

                      <div className="flex-1 overflow-x-auto md:overflow-y-auto p-4 flex flex-row md:flex-col gap-2">
                        <button 
                          type="button"
                          onClick={() => setSupporterActiveTab('medals')}
                          className={`flex-none md:w-full px-4 py-3 text-left text-xs font-bold uppercase tracking-wider rounded-xl transition-all ${
                            supporterActiveTab === 'medals' ? 'bg-amber-500/10 text-amber-500 border border-amber-500/30' : (isDarkMode ? 'text-slate-400 hover:text-white hover:bg-white/5 border border-transparent' : 'text-slate-500 hover:text-slate-900 hover:bg-black/5 border border-transparent')
                          }`}
                        >
                          Medals
                        </button>
                        <button 
                          type="button"
                          onClick={() => setSupporterActiveTab('sounds')}
                          className={`flex-none md:w-full px-4 py-3 text-left text-xs font-bold uppercase tracking-wider rounded-xl transition-all ${
                            supporterActiveTab === 'sounds' ? 'bg-amber-500/10 text-amber-500 border border-amber-500/30' : (isDarkMode ? 'text-slate-400 hover:text-white hover:bg-white/5 border border-transparent' : 'text-slate-500 hover:text-slate-900 hover:bg-black/5 border border-transparent')
                          }`}
                        >
                          Custom Sounds
                        </button>
                        <button 
                          type="button"
                          onClick={() => setSupporterActiveTab('server_themes')}
                          className={`flex-none md:w-full px-4 py-3 text-left text-xs font-bold uppercase tracking-wider rounded-xl transition-all ${
                            supporterActiveTab === 'server_themes' ? 'bg-amber-500/10 text-amber-500 border border-amber-500/30' : (isDarkMode ? 'text-slate-400 hover:text-white hover:bg-white/5 border border-transparent' : 'text-slate-500 hover:text-slate-900 hover:bg-black/5 border border-transparent')
                          }`}
                        >
                          Themes
                        </button>
                        <button 
                          type="button"
                          onClick={() => setSupporterActiveTab('game_textures')}
                          className={`flex-none md:w-full px-4 py-3 text-left text-xs font-bold uppercase tracking-wider rounded-xl transition-all ${
                            supporterActiveTab === 'game_textures' ? 'bg-amber-500/10 text-amber-500 border border-amber-500/30' : (isDarkMode ? 'text-slate-400 hover:text-white hover:bg-white/5 border border-transparent' : 'text-slate-500 hover:text-slate-900 hover:bg-black/5 border border-transparent')
                          }`}
                        >
                          Game Textures
                        </button>
                        <button 
                          type="button"
                          onClick={() => setSupporterActiveTab('custom_emojis')}
                          className={`flex-none md:w-full px-4 py-3 text-left text-xs font-bold uppercase tracking-wider rounded-xl transition-all ${
                            supporterActiveTab === 'custom_emojis' ? 'bg-amber-500/10 text-amber-500 border border-amber-500/30' : (isDarkMode ? 'text-slate-400 hover:text-white hover:bg-white/5 border border-transparent' : 'text-slate-500 hover:text-slate-900 hover:bg-black/5 border border-transparent')
                          }`}
                        >
                          Custom Emojis
                        </button>
                        <button 
                          type="button"
                          onClick={() => setSupporterActiveTab('subscription')}
                          className={`flex-none md:w-full px-4 py-3 text-left text-xs font-bold uppercase tracking-wider rounded-xl transition-all ${
                            supporterActiveTab === 'subscription' ? 'bg-amber-500/10 text-amber-500 border border-amber-500/30' : (isDarkMode ? 'text-slate-400 hover:text-white hover:bg-white/5 border border-transparent' : 'text-slate-500 hover:text-slate-900 hover:bg-black/5 border border-transparent')
                          }`}
                        >
                          Subscription
                        </button>
                      </div>
                    </div>

                    <div className="flex-1 flex flex-col min-w-0 bg-transparent relative">
                      <button 
                        onClick={() => setIsSupporterPanelOpen(false)}
                        className={`hidden md:block absolute top-4 right-4 z-10 p-2 rounded-xl border transition-all ${isDarkMode ? 'bg-slate-900 border-white/10 hover:bg-white/10' : 'bg-white border-slate-200 hover:bg-slate-100'}`}
                      >
                        <X size={16} />
                      </button>
                      <div className="flex-1 overflow-y-auto p-6 md:p-8 space-y-6">
                      {supporterActiveTab === 'medals' && (
                        <div className="space-y-4">
                          <div className={`p-4 rounded-2xl border text-center ${isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'}`}>
                            <p className="text-xs uppercase tracking-widest text-slate-400 mb-2">Live Avatar Preview</p>
                            <div className="flex items-center justify-center gap-3">
                              <img src={userImage || getRandomAvatar(userName)} className="w-12 h-12 rounded-full object-cover border border-amber-500/30" />
                              <div className="text-left">
                                <div className="font-black text-sm flex items-center gap-1.5">
                                  <span>{userName}</span>
                                  {currentBadge !== 'none' && (
                                    <RenderSupporterBadge user={{ name: userName, isPremium: true, preferences: { supporterBadge: currentBadge } } as any} size={10} />
                                  )}
                                </div>
                                <p className="text-xs text-emerald-400">Status: Vylant Supporter Active</p>
                              </div>
                            </div>
                          </div>

                          <div className="grid grid-cols-1 gap-3">
                            {badgeOptions.map(opt => (
                              <button
                                key={opt.id}
                                type="button"
                                onClick={async () => {
                                  try {
                                    const updatedPrefs = { ...(currentUserObj?.preferences || {}), supporterBadge: opt.id };
                                    const res = await apiFetch('/api/profile/update', {
                                      method: 'POST',
                                      body: JSON.stringify({ preferences: updatedPrefs })
                                    });
                                    const data = await res.json();
                                    if (data.success) {
                                      setVylantUsers(prev => prev.map(u => u.name === userName ? { ...u, preferences: updatedPrefs } : u));
                                      if (socketRef.current) {
                                        socketRef.current.emit("update-status", {
                                          userName,
                                          status: userStatus,
                                          customStatus
                                        });
                                      }
                                    }
                                  } catch (err) {
                                    console.error('Error saving supporter badge preference:', err);
                                  }
                                }}
                                className={`p-4 rounded-2xl border text-left transition-all hover:scale-[1.01] active:scale-[0.99] flex items-start gap-4 ${
                                  currentBadge === opt.id
                                    ? 'bg-amber-500/10 border-amber-500/40 shadow-[0_0_15px_rgba(245,158,11,0.1)]'
                                    : (isDarkMode ? 'bg-white/5 border-white/5 hover:border-white/20' : 'bg-slate-50 border-slate-100 hover:border-slate-300')
                                }`}
                              >
                                <div className={`p-3 rounded-xl shrink-0 mt-0.5 ${
                                  currentBadge === opt.id ? 'bg-amber-500/20 text-amber-400' : 'bg-white/5 text-slate-400'
                                }`}>
                                  {opt.icon}
                                </div>
                                <div>
                                  <div className="font-extrabold text-sm flex items-center gap-2">
                                    <span>{opt.label}</span>
                                    {currentBadge === opt.id && <span className="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300">Active</span>}
                                  </div>
                                  <p className={`text-xs mt-1 ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>{opt.desc}</p>
                                </div>
                              </button>
                            ))}
                          </div>
                        </div>
                      )}

                      {supporterActiveTab === 'sounds' && (
                        <div className="space-y-6">
                          <div>
                            <h3 className="font-bold text-sm uppercase tracking-widest text-vylant-blue mb-1">Global Sounds</h3>
                            <p className={`text-xs ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>Customize your default incoming call and message notification sounds.</p>
                            <p className={`text-xs font-semibold mt-2.5 p-3 rounded-xl border flex items-center gap-2 ${isDarkMode ? 'bg-amber-500/10 border-amber-500/20 text-amber-300' : 'bg-amber-50 border-amber-200 text-amber-800'}`}>
                              <AlertTriangle size={16} className="shrink-0" />
                              <span>Note: If custom audio files are too long, notification sounds may overlap with subsequent incoming messages or calls.</span>
                            </p>
                          </div>

                          <div className="grid grid-cols-1 gap-4">
                            <div className={`p-4 rounded-2xl border ${isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'}`}>
                              <h4 className="text-xs font-bold uppercase tracking-wider mb-3">Incoming Call Sound</h4>
                              <div className="flex gap-2">
                                <input 
                                  type="text"
                                  placeholder="https://example.com/sound.mp3"
                                  value={currentUserObj?.preferences?.customSounds?.globalCallSound || ''}
                                  onChange={async (e) => {
                                    const updatedPrefs = {
                                      ...(currentUserObj?.preferences || {}),
                                      customSounds: {
                                        ...(currentUserObj?.preferences?.customSounds || {}),
                                        globalCallSound: e.target.value
                                      }
                                    };
                                    setVylantUsers(prev => prev.map(u => u.name === userName ? { ...u, preferences: updatedPrefs } : u));
                                    await apiFetch('/api/profile/update', { method: 'POST', body: JSON.stringify({ preferences: updatedPrefs }) });
                                  }}
                                  className={`flex-1 min-w-0 px-3 py-2 text-sm rounded-xl border focus:outline-none focus:ring-2 focus:ring-vylant-blue/40 transition-shadow ${isDarkMode ? 'bg-black/20 border-white/10 text-white placeholder:text-white/20' : 'bg-white border-slate-200 text-slate-800 placeholder:text-slate-400'}`}
                                />
                                <label className={`flex items-center justify-center px-4 rounded-xl font-bold text-xs uppercase tracking-wider cursor-pointer transition-all ${isDarkMode ? 'bg-white/10 hover:bg-white/20 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-900'}`}>
                                  <input 
                                    type="file" 
                                    accept="audio/*" 
                                    className="hidden" 
                                    onChange={async (e) => {
                                      const file = e.target.files?.[0];
                                      if (file) {
                                        const url = await uploadFile(file);
                                        if (url) {
                                          const updatedPrefs = {
                                            ...(currentUserObj?.preferences || {}),
                                            customSounds: {
                                              ...(currentUserObj?.preferences?.customSounds || {}),
                                              globalCallSound: url
                                            }
                                          };
                                          setVylantUsers(prev => prev.map(u => u.name === userName ? { ...u, preferences: updatedPrefs } : u));
                                          await apiFetch('/api/profile/update', { method: 'POST', body: JSON.stringify({ preferences: updatedPrefs }) });
                                        }
                                      }
                                      e.target.value = '';
                                    }}
                                  />
                                  Upload
                                </label>
                                <button
                                  type="button"
                                  onClick={() => {
                                    const url = currentUserObj?.preferences?.customSounds?.globalCallSound;
                                    if (url) {
                                      handlePlayPreviewAudio(url);
                                    }
                                  }}
                                  className={`p-2 rounded-xl flex items-center justify-center transition-all ${isDarkMode ? 'bg-white/10 hover:bg-white/20 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-900'}`}
                                  title="Preview Audio"
                                >
                                  <Play size={16} />
                                </button>
                              </div>
                            </div>
                            
                            <div className={`p-4 rounded-2xl border ${isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'}`}>
