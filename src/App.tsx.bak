            >
              <div className="flex flex-col items-center text-center gap-4">
                <div className={`w-16 h-16 rounded-2xl flex items-center justify-center shadow-inner ${
                  isDarkMode ? 'bg-red-500/10 text-red-500' : 'bg-red-50 text-red-500'
