                setAddServerStep('choice');
              }}
              className="absolute inset-0 bg-black/60 backdrop-blur-sm"
            />
            <motion.div
              initial={{ opacity: 0, scale: 0.9, y: 20 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.9, y: 20 }}
              className={`relative w-full max-w-md p-4 md:p-8 rounded-3xl shadow-2xl border ${
                isDarkMode 
                  ? 'bg-slate-900 border-white/10 text-white' 
                  : 'bg-white border-slate-200 text-slate-900'
              }`}
            >
              <button 
                onClick={() => {
                  setIsAddServerModalOpen(false);
                  setInviteCode('');
                  setJoinServerError(null);
                  setAddServerStep('choice');
                }}
                className={`absolute top-6 right-6 p-2 rounded-xl transition-colors ${isDarkMode ? 'hover:bg-white/10' : 'hover:bg-slate-100'}`}
              >
                <X size={20} />
              </button>

              {addServerStep === 'choice' && (
                <div className="text-center">
                  <h2 className="text-2xl font-bold mb-2">Create a server</h2>
                  <p className={`text-sm mb-8 ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
                    Your server is where you and your friends hang out. Make yours and start talking.
                  </p>
                  
                  <div className="flex flex-col gap-4">
                    <button
                      onClick={() => setAddServerStep('create')}
                      className={`flex items-center justify-between p-4 rounded-2xl border-2 transition-all group ${
                        isDarkMode 
                          ? 'border-white/5 bg-white/5 hover:border-vylant-blue hover:bg-vylant-blue/5' 
                          : 'border-slate-100 bg-slate-50 hover:border-vylant-blue hover:bg-vylant-blue/5'
                      }`}
                    >
                      <div className="flex items-center gap-4">
                        <div className="w-12 h-12 rounded-xl bg-vylant-blue/20 flex items-center justify-center text-vylant-blue">
                          <Plus size={24} />
                        </div>
                        <div className="text-left">
                          <div className="font-bold">Create My Own</div>
                          <div className={`text-xs ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>Start from scratch</div>
                        </div>
                      </div>
                      <ChevronRight size={20} className="opacity-0 group-hover:opacity-100 transition-opacity" />
                    </button>

                    <button
                      onClick={() => {
                        handleJoinServerFromInvite(VYLANT_OFFICIAL_SERVER);
                        setIsAddServerModalOpen(false);
                      }}
                      className={`flex items-center justify-between p-4 rounded-2xl border-2 transition-all group ${
                        isDarkMode 
                          ? 'border-white/5 bg-white/5 hover:border-vylant-blue hover:bg-vylant-blue/5' 
                          : 'border-slate-100 bg-slate-50 hover:border-vylant-blue hover:bg-vylant-blue/5'
                      }`}
                    >
                      <div className="flex items-center gap-4">
                        <div className="w-12 h-12 rounded-xl bg-vylant-blue/20 flex items-center justify-center text-vylant-blue overflow-hidden">
                          <img src="https://i.imgur.com/H3OS5zA.png" alt="Vylant" className="w-full h-full object-cover" />
                        </div>
                        <div className="text-left">
                          <div className="flex items-center gap-1.5 font-bold">
                            Join Vylant Official
                            <BadgeCheck size={16} className="text-vylant-blue fill-vylant-blue/10" />
                          </div>
                          <div className={`text-xs ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>The official community server</div>
                        </div>
                      </div>
                      <ChevronRight size={20} className="opacity-0 group-hover:opacity-100 transition-opacity" />
                    </button>

                    <div className="mt-4">
                      <p className={`text-xs font-bold uppercase tracking-widest mb-4 ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
                        Have an invite already?
                      </p>
                      <button
                        onClick={() => {
                          setAddServerStep('join');
                          setInviteCode('');
                          setJoinServerError(null);
                        }}
                        className={`w-full py-3 rounded-xl font-bold transition-all ${
                          isDarkMode 
                            ? 'bg-white/10 hover:bg-white/20 text-white' 
                            : 'bg-slate-100 hover:bg-slate-200 text-slate-900'
                        }`}
                      >
                        Join a Server
                      </button>
                    </div>
                  </div>
                </div>
              )}

              {addServerStep === 'join' && (
                <div className="text-center">
                  <h2 className="text-2xl font-bold mb-2">Join a Server</h2>
                  <p className={`text-sm mb-6 ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
                    Enter an invite link, code, or server name to join an existing community.
                  </p>

                  <div className="w-full text-left mb-6">
                    <div className="flex items-center justify-between mb-2">
                      <label className={`text-[10px] font-bold uppercase tracking-widest block ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
                        Invite Link or Code
                      </label>
                      <button
                        type="button"
                        onClick={async () => {
                          try {
                            const text = await navigator.clipboard.readText();
                            if (text) {
                              setInviteCode(text.trim());
                              setJoinServerError(null);
                            }
                          } catch (e) {
                            // clipboard read may be restricted
                          }
                        }}
                        className="text-[10px] font-semibold text-vylant-blue hover:underline cursor-pointer"
                      >
                        Paste from clipboard
                      </button>
                    </div>
                    <div className="relative">
                      <input 
                        type="text"
                        value={inviteCode}
                        onChange={(e) => {
                          setInviteCode(e.target.value);
                          if (joinServerError) setJoinServerError(null);
                        }}
                        onKeyDown={(e) => {
                          if (e.key === 'Enter' && inviteCode.trim() && !isResolvingInvite) {
                            e.preventDefault();
                            handleResolveAndJoinServer();
                          }
                        }}
                        placeholder="https://... or code (e.g. h98s9f)"
                        disabled={isResolvingInvite}
                        className={`w-full p-4 pr-10 rounded-2xl outline-none transition-all border ${
                          joinServerError 
                            ? 'border-rose-500/60 bg-rose-500/5 text-rose-500 focus:border-rose-500' 
                            : isDarkMode 
                              ? 'bg-white/5 border-white/5 text-white focus:border-vylant-blue/50 focus:bg-white/10' 
                              : 'bg-slate-50 border-slate-100 text-slate-900 focus:border-vylant-blue/50 focus:bg-white'
                        }`}
                      />
                      {inviteCode && (
                        <button
                          type="button"
                          onClick={() => {
                            setInviteCode('');
                            setJoinServerError(null);
                          }}
                          className={`absolute right-3 top-1/2 -translate-y-1/2 p-1 rounded-lg ${isDarkMode ? 'text-white/40 hover:text-white' : 'text-slate-400 hover:text-slate-700'}`}
                        >
                          <X size={16} />
                        </button>
                      )}
                    </div>

                    {joinServerError ? (
                      <div className="mt-2.5 p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-500 text-xs flex items-center gap-2 animate-in fade-in">
                        <AlertTriangle size={15} className="shrink-0 text-rose-500" />
                        <span className="leading-snug">{joinServerError}</span>
                      </div>
                    ) : (
                      <div className={`mt-2.5 flex flex-col gap-1 text-[11px] ${isDarkMode ? 'text-white/35' : 'text-slate-400'}`}>
                        <p>Invites should look like:</p>
                        <ul className="list-disc list-inside font-mono text-[10px] space-y-0.5 opacity-80">
                          <li>h98s9f (Invite Code)</li>
                          <li>https://.../?invite=... (Full Link)</li>
                          <li>VYLANT (Community Server)</li>
                        </ul>
                      </div>
                    )}
                  </div>

                  <div className="w-full flex items-center justify-between mt-4">
                    <button
                      onClick={() => {
                        setAddServerStep('choice');
                        setJoinServerError(null);
                      }}
                      disabled={isResolvingInvite}
                      className={`px-6 py-2 font-semibold transition-all ${isDarkMode ? 'text-white/60 hover:text-white' : 'text-slate-500 hover:text-slate-900'}`}
                    >
                      Back
                    </button>
                    <button
                      onClick={handleResolveAndJoinServer}
                      disabled={!inviteCode.trim() || isResolvingInvite}
                      className={`px-8 py-3 bg-vylant-blue text-white rounded-2xl font-bold shadow-lg shadow-vylant-blue/20 transition-all hover:scale-105 active:scale-95 disabled:opacity-50 disabled:scale-100 flex items-center gap-2`}
                    >
                      {isResolvingInvite ? (
                        <>
                          <Loader2 size={16} className="animate-spin" />
                          <span>Checking...</span>
                        </>
                      ) : (
                        <span>Join Server</span>
                      )}
                    </button>
                  </div>
                </div>
              )}
              {addServerStep === 'create' && (
                <div className="text-center">
                  <h2 className="text-2xl font-bold mb-2">Customize your server</h2>
                  <p className={`text-sm mb-8 ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
                    Give your new server a personality with a name and an icon. You can always change it later.
                  </p>

                  <div className="flex flex-col items-center gap-6">
                    <div 
                      onClick={() => serverImageInputRef.current?.click()}
                      className={`w-24 h-24 rounded-3xl border-2 border-dashed flex flex-col items-center justify-center cursor-pointer transition-all overflow-hidden relative group ${
                        newServerImage 
                          ? 'border-transparent' 
                          : isDarkMode ? 'border-white/10 hover:border-vylant-blue' : 'border-slate-200 hover:border-vylant-blue'
                      }`}
                    >
                      {newServerImage ? (
                        <>
                          <img src={newServerImage} alt="Server preview" className="w-full h-full object-cover" />
                          <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
                            <span className="text-[10px] font-bold uppercase text-white">Change</span>
                          </div>
                        </>
                      ) : (
                        <>
                          <ImageIcon size={32} className={isDarkMode ? 'text-white/20' : 'text-slate-300'} />
                          <span className={`text-[10px] font-bold uppercase mt-2 ${isDarkMode ? 'text-white/20' : 'text-slate-400'}`}>Upload</span>
                        </>
                      )}
                    </div>
                    <input 
                      type="file" 
                      ref={serverImageInputRef} 
                      onChange={handleServerImageUpload} 
                      className="hidden" 
                      accept="image/*"
                    />

                    <div className="w-full text-left">
                      <label className={`text-[10px] font-bold uppercase tracking-widest mb-2 block ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
                        Server Name
                      </label>
                      <input 
                        type="text"
                        value={newServerName}
                        onChange={(e) => setNewServerName(e.target.value)}
                        placeholder="Enter server name"
                        maxLength={100}
                        className={`w-full p-4 rounded-2xl outline-none transition-all border ${
                          isDarkMode 
                            ? 'bg-white/5 border-white/5 text-white focus:border-vylant-blue/50 focus:bg-white/10' 
                            : 'bg-slate-50 border-slate-100 text-slate-900 focus:border-vylant-blue/50 focus:bg-white'
                        }`}
                      />
                      <div className={`text-right text-[10px] mt-1 ${
                        newServerName.length >= 100 ? 'text-red-500' : isDarkMode ? 'text-white/30' : 'text-slate-400'
                      }`}>
                        {newServerName.length}/100
                      </div>
                    </div>

                    <div className="w-full text-left mt-2 flex items-center justify-between">
                      <div className="w-full">
                        <label className={`text-[10px] font-bold uppercase tracking-widest mb-2 block ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
                          Server Description
                        </label>
                        <textarea 
                          value={newServerDescription}
                          onChange={(e) => setNewServerDescription(e.target.value)}
                          placeholder="What is this server about?"
                          maxLength={300}
                          rows={3}
                          className={`w-full p-4 rounded-2xl outline-none transition-all border resize-none ${
                            isDarkMode 
                              ? 'bg-white/5 border-white/5 text-white focus:border-vylant-blue/50 focus:bg-white/10' 
                              : 'bg-slate-50 border-slate-100 text-slate-900 focus:border-vylant-blue/50 focus:bg-white'
                          }`}
                        />
                        <div className={`text-right text-[10px] mt-1 ${
                          newServerDescription.length >= 300 ? 'text-red-500' : isDarkMode ? 'text-white/30' : 'text-slate-400'
                        }`}>
                          {newServerDescription.length}/300
                        </div>
                      </div>
                    </div>

                    <div className="w-full text-left mt-2 flex items-center justify-between">
                      <div>
                        <label className={`text-sm font-bold block ${isDarkMode ? 'text-white' : 'text-slate-900'}`}>
                          18+ Server
                        </label>
                        <p className={`text-[10px] ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
                          Restrict access to users 18 and older.
                        </p>
                      </div>
                      <button 
                        onClick={() => setNewServerIs18Plus(!newServerIs18Plus)}
                        className={`w-12 h-6 rounded-full transition-colors relative ${
                          newServerIs18Plus ? 'bg-vylant-blue' : isDarkMode ? 'bg-white/10' : 'bg-slate-300'
                        }`}
                      >
                        <div className={`w-4 h-4 rounded-full bg-white absolute top-1 transition-transform ${
                          newServerIs18Plus ? 'translate-x-7' : 'translate-x-1'
                        }`} />
                      </button>
                    </div>

                    <div className="w-full text-left mt-2 flex items-center justify-between">
                      <div>
                        <label className={`text-sm font-bold block ${isDarkMode ? 'text-white' : 'text-slate-900'}`}>
                          Public Community
                        </label>
                        <p className={`text-[10px] ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
                          Anyone can discover and join this server.
                        </p>
                      </div>
                      <button 
                        onClick={() => setNewServerIsPublic(!newServerIsPublic)}
                        className={`w-12 h-6 rounded-full transition-colors relative ${
                          newServerIsPublic ? 'bg-vylant-blue' : isDarkMode ? 'bg-white/10' : 'bg-slate-300'
                        }`}
                      >
                        <div className={`w-4 h-4 rounded-full bg-white absolute top-1 transition-transform ${
                          newServerIsPublic ? 'translate-x-7' : 'translate-x-1'
                        }`} />
                      </button>
                    </div>

                    <div className="w-full flex items-center justify-between mt-4">
                      <button
                        onClick={() => setAddServerStep('choice')}
                        className={`px-6 py-2 font-semibold transition-all ${isDarkMode ? 'text-white/60 hover:text-white' : 'text-slate-500 hover:text-slate-900'}`}
                      >
                        Back
                      </button>
                      <button
                        onClick={handleCreateServer}
                        disabled={!newServerName.trim()}
                        className={`px-8 py-3 bg-vylant-blue text-white rounded-2xl font-bold shadow-lg shadow-vylant-blue/20 transition-all hover:scale-105 active:scale-95 disabled:opacity-50 disabled:scale-100`}
                      >
                        Create Server
                      </button>
                    </div>
                  </div>
                </div>
              )}
            </motion.div>
          </div>
        )}
      </AnimatePresence>

      {/* Full Status Modal */}
      <AnimatePresence>
        {isFullStatusOpen && (
          <div className="fixed inset-0 z-[100] flex items-center justify-center p-4">
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              onClick={() => setIsFullStatusOpen(false)}
              className="absolute inset-0 bg-black/60 backdrop-blur-sm"
            />
            <motion.div
              initial={{ opacity: 0, scale: 0.9, y: 20 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.9, y: 20 }}
              className={`relative w-full max-w-md p-6 rounded-2xl shadow-2xl border ${
                isDarkMode 
                  ? 'bg-slate-900 border-white/10 text-white' 
                  : 'bg-white border-slate-200 text-slate-900'
              }`}
            >
              <div className="flex justify-between items-center mb-4">
                <h3 className="text-sm font-bold uppercase tracking-widest opacity-50">Full Status</h3>
                <button 
                  onClick={() => setIsFullStatusOpen(false)}
                  className={`p-1 rounded-lg transition-colors ${isDarkMode ? 'hover:bg-white/10' : 'hover:bg-slate-100'}`}
                >
                  <X size={18} />
                </button>
              </div>
              <div className={`p-4 rounded-xl text-lg font-medium leading-relaxed break-words ${
                isDarkMode ? 'bg-white/5' : 'bg-slate-50'
              }`}>
                {customStatus}
              </div>
              <div className="mt-6 flex justify-end">
                <button
                  onClick={() => setIsFullStatusOpen(false)}
                  className="px-6 py-2 bg-vylant-blue text-white rounded-xl font-semibold hover:bg-vylant-blue/90 transition-all shadow-lg shadow-vylant-blue/20"
                >
                  Close
                </button>
              </div>
            </motion.div>
          </div>
        )}
      </AnimatePresence>

      {/* Global Search Modal */}
      <AnimatePresence>
        {isGlobalSearchOpen && (
          <div className="fixed inset-0 z-[250] flex items-start justify-center pt-24 px-4">
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              onClick={() => setIsGlobalSearchOpen(false)}
              className="absolute inset-0 bg-black/60 backdrop-blur-sm"
            />
            <motion.div
              initial={{ opacity: 0, scale: 0.95, y: -20 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.95, y: -20 }}
              className={`relative w-full max-w-2xl rounded-3xl shadow-2xl border overflow-hidden flex flex-col max-h-[80vh] ${
                isDarkMode 
                  ? 'bg-slate-900 border-white/10 text-white' 
                  : 'bg-white border-slate-200 text-slate-900'
              }`}
            >
              <div className={`p-4 border-b flex items-center gap-4 ${isDarkMode ? 'border-white/10' : 'border-slate-100'}`}>
                <Search size={24} className={isDarkMode ? 'text-white/40' : 'text-slate-400'} />
                <input 
                  autoFocus
                  type="text" 
                  placeholder="Search messages, friends, servers..." 
                  value={globalSearchQuery}
                  onChange={(e) => setGlobalSearchQuery(e.target.value)}
                  onKeyDown={(e) => {
                    if (e.key === 'Enter') {
                      addToGlobalSearchHistory(globalSearchQuery);
                    }
                  }}
                  className={`flex-1 bg-transparent border-none outline-none text-lg ${
                    isDarkMode ? 'text-white placeholder:text-white/20' : 'text-slate-900 placeholder:text-slate-400'
                  }`}
                />
                <button 
                  onClick={() => setIsGlobalSearchOpen(false)}
                  className={`p-2 rounded-xl transition-colors ${isDarkMode ? 'hover:bg-white/10 text-white/40' : 'hover:bg-slate-100 text-slate-400'}`}
                >
                  <X size={20} />
                </button>
              </div>
              
              <div className="flex-1 overflow-y-auto p-4">
                {!globalSearchQuery ? (
                  globalSearchHistory.length > 0 ? (
                    <div className="flex flex-col gap-1">
                      <div className={`flex items-center justify-between px-2 mb-2 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>
                        <h3 className="text-xs font-bold uppercase tracking-widest">Recent Searches</h3>
                        <button onClick={clearGlobalSearchHistory} className="text-[10px] uppercase font-bold hover:text-vylant-blue transition-colors">Clear</button>
                      </div>
                      {globalSearchHistory.map((term, idx) => (
                        <div key={`history-${idx}`} className={`group flex items-center justify-between p-2 rounded-xl transition-colors ${isDarkMode ? 'hover:bg-white/5' : 'hover:bg-slate-50'}`}>
                          <button
                            className="flex-1 flex items-center gap-3 text-left"
                            onClick={() => {
                              setGlobalSearchQuery(term);
                              addToGlobalSearchHistory(term);
                            }}
                          >
                            <History size={16} className={isDarkMode ? 'text-white/40' : 'text-slate-400'} />
                            <span className="font-medium">{term}</span>
                          </button>
                          <button 
                            onClick={(e) => {
                              e.stopPropagation();
                              removeFromGlobalSearchHistory(term);
                            }}
                            className={`p-1.5 rounded-lg opacity-0 group-hover:opacity-100 hover:bg-red-500/20 hover:text-red-500 transition-all ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}
                          >
                            <X size={14} />
                          </button>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div className="flex flex-col items-center justify-center py-12 text-center opacity-40">
                      <Search size={48} className="mb-4" />
                      <p>Type to search across Vylant</p>
                    </div>
                  )
                ) : (
                  <div className="flex flex-col gap-6">
                    {/* Friends Results */}
                    {friends.filter(f => !f.isBot && f.name.toLowerCase().includes(globalSearchQuery.toLowerCase())).length > 0 && (
                      <div>
                        <h3 className={`text-xs font-bold uppercase tracking-widest mb-3 px-2 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Friends</h3>
                        <div className="flex flex-col gap-1">
                          {friends.filter(f => !f.isBot && f.name.toLowerCase().includes(globalSearchQuery.toLowerCase())).map(friend => (
                            <button
                              key={friend.id}
                              onClick={() => {
                                addToGlobalSearchHistory(globalSearchQuery);
                                setSelectedProfile({ ...friend, customStatus: friend.status !== 'offline' ? friend.customStatus : undefined });
                                setIsGlobalSearchOpen(false);
                              }}
                              className={`flex items-center gap-3 p-2 rounded-xl transition-colors text-left ${
                                isDarkMode ? 'hover:bg-white/5' : 'hover:bg-slate-50'
                              }`}
                            >
                              <img src={friend.image} alt={friend.name} className="w-8 h-8 rounded-full" />
                              <span className="font-medium">{friend.name}</span>
                              <span className={`text-xs ml-auto capitalize ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>{friend.status === 'idle' ? 'Away' : (friend.status === 'dnd' ? 'Do Not Disturb' : friend.status)}</span>
                            </button>
                          ))}
                        </div>
                      </div>
                    )}

                    {/* Servers Results */}
                    {servers.filter(s => s.name.toLowerCase().includes(globalSearchQuery.toLowerCase())).length > 0 && (
                      <div>
                        <h3 className={`text-xs font-bold uppercase tracking-widest mb-3 px-2 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Servers</h3>
                        <div className="flex flex-col gap-1">
                          {servers.filter(s => s.name.toLowerCase().includes(globalSearchQuery.toLowerCase())).map(server => (
                            <button
                              key={server.id}
                              onClick={() => {
                                addToGlobalSearchHistory(globalSearchQuery);
                                setActiveView('server');
                                setActiveServer(server.id);
                                setIsGlobalSearchOpen(false);
                              }}
                              className={`flex items-center gap-3 p-2 rounded-xl transition-colors text-left ${
                                isDarkMode ? 'hover:bg-white/5' : 'hover:bg-slate-50'
                              }`}
                            >
                              <div className={`w-8 h-8 rounded-lg flex items-center justify-center text-xs font-bold text-white ${server.image ? '' : server.color}`}>
                                {server.image ? <img src={server.image} className="w-full h-full object-cover rounded-lg" /> : server.name.substring(0, 2)}
                              </div>
                              <span className="font-medium">{server.name}</span>
                            </button>
                          ))}
                        </div>
                      </div>
                    )}

                    {/* Messages Results */}
                    {(() => {
                      const allMessages: { 
                        type: 'server' | 'dm' | 'ai', 
                        id: string, 
                        text: string, 
                        sender: string, 
                        timestamp: number, 
                        locationName: string,
                        serverId?: string,
                        channelName?: string
                      }[] = [];

                      const highlightText = (text: string, query: string) => {
                        if (!query.trim()) return text;
                        try {
                          const escapedQuery = query.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
                          const regex = new RegExp(`(${escapedQuery})`, 'gi');
                          const parts = text.split(regex);
                          return (
                            <>
                              {parts.map((part, index) => 
                                part.toLowerCase() === query.toLowerCase() ? (
                                  <strong key={index} className="font-bold text-vylant-blue">{part}</strong>
                                ) : (
                                  part
                                )
                              )}
                            </>
                          );
                        } catch (e) {
                          return text;
                        }
                      };

                      // Search Server Messages
                      Object.entries(serverMessages).forEach(([serverId, channels]) => {
                        const server = findServer(servers, serverId);
                        if (server) {
                          Object.entries(channels).forEach(([channelName, msgs]) => {
                            msgs.forEach(msg => {
                              if ((msg.text || '').toLowerCase().includes(globalSearchQuery.toLowerCase())) {
                                allMessages.push({
                                  type: 'server',
                                  id: msg.id,
                                  text: msg.text,
                                  sender: msg.sender,
                                  timestamp: msg.timestamp || Date.now(),
                                  locationName: `${server.name} ${channelName}`,
                                  serverId,
                                  channelName
                                });
                              }
                            });
                          });
                        }
                      });

                      // Search DM Messages
                      Object.entries(dmMessages).forEach(([dmName, msgs]) => {
                        (msgs as Message[]).forEach(msg => {
                          if ((msg.text || '').toLowerCase().includes(globalSearchQuery.toLowerCase())) {
                            allMessages.push({
                              type: 'dm',
                              id: msg.id,
                              text: msg.text,
                              sender: msg.sender,
                              timestamp: msg.timestamp || Date.now(),
                              locationName: dmName
                            });
                          }
                        });
                      });
                      
                      // Search T0AI Messages
                      messages.forEach(msg => {
                         if ((msg.text || '').toLowerCase().includes(globalSearchQuery.toLowerCase())) {
                            allMessages.push({
                              type: 'ai',
                              id: msg.id,
                              text: msg.text,
                              sender: msg.sender,
                              timestamp: msg.timestamp || Date.now(),
                              locationName: 'T0AI Assistant'
                            });
                          }
                      });

                      if (globalSearchQuery.length > 2 && allMessages.length > 0) {
                        return (
                          <div>
                            <h3 className={`text-xs font-bold uppercase tracking-widest mb-3 px-2 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Messages</h3>
                            <div className="flex flex-col gap-1">
                              {allMessages.map((msg, idx) => (
                                <button
                                  key={`${msg.type}-${msg.id}-${idx}`}
                                  onClick={() => {
                                    addToGlobalSearchHistory(globalSearchQuery);
                                    if (msg.type === 'server' && msg.serverId && msg.channelName) {
                                      setActiveView('server');
                                      setActiveServer(msg.serverId);
                                      setActiveChannel(msg.channelName);
                                      setPendingJump({
                                        messageId: msg.id,
                                        serverId: msg.serverId,
                                        channelId: msg.channelName
                                      });
                                    } else if (msg.type === 'ai') {
                                      setActiveView('home');
                                      setPendingJump({
                                        messageId: msg.id,
                                        isAI: true
                                      });
                                    } else {
                                      handleStartDM(msg.locationName);
                                      setPendingJump({
                                        messageId: msg.id,
                                        dmName: msg.locationName
                                      });
                                    }
                                    setIsGlobalSearchOpen(false);
                                  }}
                                  className={`flex flex-col gap-1 p-3 rounded-xl transition-colors text-left ${
                                    isDarkMode ? 'hover:bg-white/5' : 'hover:bg-slate-50'
                                  }`}
                                >
                                  <div className="flex items-center justify-between w-full">
                                    <div className="flex items-center gap-2">
                                      <img src={msg.sender === userName ? userImage : getRandomAvatar(msg.sender)} className="w-4 h-4 rounded-full" />
                                      <span className="text-xs font-bold">{msg.sender}</span>
                                      <span className={`text-[10px] ${isDarkMode ? 'text-white/30' : 'text-slate-400'}`}>
                                        {new Date(msg.timestamp).toLocaleDateString()}
                                      </span>
                                    </div>
                                    <span className={`text-[10px] font-bold ${isDarkMode ? 'text-vylant-blue' : 'text-vylant-blue'}`}>
                                      {msg.locationName}
                                    </span>
                                  </div>
                                  <p className={`text-sm line-clamp-1 ${isDarkMode ? 'text-white/80' : 'text-slate-600'}`}>
                                    {highlightText(msg.text, globalSearchQuery)}
                                  </p>
                                </button>
                              ))}
                            </div>
                          </div>
                        );
                      }
                      return null;
                    })()}
                  </div>
                )}
              </div>
            </motion.div>
          </div>
        )}
      </AnimatePresence>

      {/* Story Viewer Modal */}
      <AnimatePresence>
        {viewingStoryUserId && stories[viewingStoryUserId] && (
          <div 
            className="fixed inset-0 z-[300] flex items-center justify-center bg-black/90 backdrop-blur-md"
            onClick={() => {
              setViewingStoryUserId(null);
              setIsStoryMenuOpen(false);
            }}
          >
            <button 
              onClick={() => {
                setViewingStoryUserId(null);
                setIsStoryMenuOpen(false);
              }}
              className="absolute top-6 right-6 p-3 rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors z-50"
            >
              <X size={24} />
            </button>
            
            <div 
              className="relative w-full max-w-md h-[80vh] flex flex-col items-center justify-center"
              onClick={(e) => {
                e.stopPropagation();
                setIsStoryMenuOpen(false);
              }}
            >
              {/* Progress Bars */}
              <div className="absolute top-4 left-4 right-4 flex gap-1 z-50">
                {stories[viewingStoryUserId].map((_, idx) => (
                  <div key={idx} className="h-1 flex-1 bg-white/30 rounded-full overflow-hidden">
                    <div 
                      className="h-full bg-white transition-all duration-300"
                      style={{ 
                        width: idx < storyIndex ? '100%' : idx === storyIndex ? '100%' : '0%',
                        transitionDuration: idx === storyIndex ? '5000ms' : '0ms',
                        transitionTimingFunction: 'linear'
                      }}
                    />
                  </div>
                ))}
              </div>

              {/* User Info */}
              <div className="absolute top-8 left-4 right-4 flex items-center justify-between z-50">
                <div className="flex items-center gap-3">
                  <img 
                    src={viewingStoryUserId === userName ? userImage : (friends.find(f => f.name === viewingStoryUserId) || vylantUsers.find(u => u.name === viewingStoryUserId))?.image || getRandomAvatar(viewingStoryUserId || 'user')} 
                    alt="Profile" 
                    className="w-10 h-10 rounded-full border-2 border-white"
                    referrerPolicy="no-referrer"
                  />
                  <span className="text-white font-bold text-shadow-sm">
                    {viewingStoryUserId === userName ? userName : (friends.find(f => f.name === viewingStoryUserId) || vylantUsers.find(u => u.name === viewingStoryUserId))?.name || 'User'}
                  </span>
                </div>
                {viewingStoryUserId === userName && (
                  <div className="relative">
                    <button 
                      onClick={(e) => {
                        e.stopPropagation();
                        setIsStoryMenuOpen(!isStoryMenuOpen);
                      }}
                      className="p-2 rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors"
                    >
                      <MoreVertical size={20} />
                    </button>
                    {isStoryMenuOpen && (
                      <div className="absolute top-full right-0 mt-2 w-48 rounded-xl bg-slate-900 border border-white/10 shadow-2xl overflow-hidden z-[100]">
                        <button 
                          onClick={(e) => {
                            e.stopPropagation();
                            handleDeleteStory(userName, storyIndex);
                            setIsStoryMenuOpen(false);
                          }}
                          className="w-full flex items-center gap-3 px-4 py-3 text-sm text-red-400 hover:bg-white/5 transition-colors"
                        >
                          <X size={16} />
                          Delete Story
                        </button>
                      </div>
                    )}
                  </div>
                )}
              </div>

              {/* Story Image */}
              <motion.img 
                key={storyIndex}
                initial={{ opacity: 0, scale: 0.95 }}
                animate={{ opacity: 1, scale: 1 }}
                exit={{ opacity: 0, scale: 1.05 }}
                src={typeof stories[viewingStoryUserId][storyIndex] === 'string' ? stories[viewingStoryUserId][storyIndex] : stories[viewingStoryUserId][storyIndex].content} 
                alt="Story" 
                className="w-full h-full object-cover rounded-2xl"
              />

              {/* Navigation Areas */}
              <div 
                className="absolute top-0 left-0 w-1/3 h-full cursor-pointer z-40"
                onClick={(e) => {
                  e.stopPropagation();
                  if (storyIndex > 0) {
                    setStoryIndex(storyIndex - 1);
                  } else {
                    setViewingStoryUserId(null);
                    setIsStoryMenuOpen(false);
                  }
                }}
              />
              <div 
                className="absolute top-0 right-0 w-2/3 h-full cursor-pointer z-40"
                onClick={(e) => {
                  e.stopPropagation();
                  if (storyIndex < stories[viewingStoryUserId].length - 1) {
                    setStoryIndex(storyIndex + 1);
                  } else {
                    setViewingStoryUserId(null);
                    setIsStoryMenuOpen(false);
                  }
                }}
              />
            </div>
          </div>
        )}
      </AnimatePresence>

      {/* Friend Profile Modal */}
      <AnimatePresence>
        {selectedProfile && (
          <div className="fixed inset-0 z-[200] flex items-center justify-center p-4">
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              onClick={() => {
                setSelectedProfile(null);
                setIsRoleManagementOpen(false);
              }}
              className="absolute inset-0 bg-black/60 backdrop-blur-sm"
            />
            <motion.div
              initial={{ opacity: 0, scale: 0.9, y: 20 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.9, y: 20 }}
              className={`relative w-full max-w-md max-h-[85vh] flex flex-col overflow-hidden rounded-3xl shadow-2xl border ${
                isDarkMode 
                  ? 'bg-slate-900 border-white/10 text-white' 
                  : 'bg-white border-slate-200 text-slate-900'
              }`}
            >
              <div className="flex-1 overflow-y-auto">
                <div className="p-4 md:p-8 relative">
                {/* Close Button */}
                <button 
                  onClick={() => {
                    setSelectedProfile(null);
                    setIsRoleManagementOpen(false);
                  }}
                  className={`absolute top-6 right-6 p-2 rounded-full transition-colors z-10 ${
                    isDarkMode ? 'bg-white/5 hover:bg-white/10 text-white/60' : 'bg-slate-100 hover:bg-slate-200 text-slate-500'
                  }`}
                >
                  <X size={18} />
                </button>

                {/* Profile Header (Avatar and Name) */}
                <div className="flex items-center gap-4 mb-6">
                  <div 
                    className={`shrink-0 rounded-full ${stories[selectedProfile.name]?.length ? `p-[3px] ${storyRingColor} cursor-pointer` : `p-1.5 ${isDarkMode ? 'bg-white/5' : 'bg-slate-50'}`}`}
                    onClick={() => {
                      const targetId = selectedProfile.name;
                      if (stories[targetId]?.length) {
                        setViewingStoryUserId(targetId);
                        setStoryIndex(0);
                      }
                    }}
                  >
                    <div className="relative">
                      <img 
                        src={selectedProfile.image} 
                        alt={selectedProfile.name} 
                        className={`w-20 h-20 rounded-full object-cover ${stories[selectedProfile.name]?.length ? `border-[4px] ${isDarkMode ? 'border-slate-900' : 'border-white'}` : ''}`}
                        referrerPolicy="no-referrer"
                      />
                      <div className="absolute bottom-0 right-0">
                        <StatusIndicator status={selectedProfile.status} size="md" />
                      </div>
                    </div>
                  </div>

                  <div className="flex-1 min-w-0">
                    <h2 className="text-2xl font-bold flex items-center justify-start gap-1.5">
                      <span className="truncate">{selectedProfile.name}</span>
                      <RenderSupporterBadge user={selectedProfile.id === 'me' ? (vylantUsers.find(u => u.name === userName) || { name: userName, isPremium }) : (vylantUsers.find(u => u.name === selectedProfile.name) || selectedProfile)} size={10} />
                    </h2>
                    {selectedProfile.status !== 'offline' && <p className={`text-sm truncate ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>{selectedProfile.customStatus}</p>}
                    {selectedProfile.id === 'me' && (
                      <div className="mt-2 flex gap-2">
                        <button 
                          onClick={() => storyInputRef.current?.click()}
                          className={`px-3 py-1.5 rounded-lg text-xs font-bold uppercase tracking-wider transition-all ${
                            isDarkMode 
                              ? 'bg-white/10 hover:bg-white/20 text-white' 
                              : 'bg-slate-200 hover:bg-slate-300 text-slate-800'
                          }`}
                        >
                          Add Story
                        </button>
                      </div>
                    )}
                  </div>
                </div>

                <div className="flex flex-col gap-4">
                  
                  <div className="flex flex-wrap gap-2 items-center">
                    {(selectedProfile.id === 'me' || selectedProfile.name === userName) && (
                      <button
                        onClick={() => {
                          setSelectedProfile(null);
                          setIsBotStudioOpen(true);
                        }}
                        className="px-3.5 py-2 rounded-xl text-xs font-bold bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 transition-all flex items-center gap-2 cursor-pointer shadow-sm"
                      >
                        <Bot size={15} />
                        Developer / Bot Studio
                      </button>
                    )}

                    {(selectedProfile.isBot || selectedProfile.botId) && (
                      <button
                        onClick={async () => {
                          try {
                            const res = await fetch('/api/bots');
                            if (res.ok) {
                              const d = await res.json();
                              const all = [...(d.myBots || []), ...(d.publicBots || [])];
                              const found = all.find((b: any) => b.id === (selectedProfile.botId || selectedProfile.id) || b.name === selectedProfile.name);
                              if (found) {
                                setSelectedProfile(null);
                                setSelectedBotProfile(found);
                              }
                            }
                          } catch (e) {
                            console.error(e);
                          }
                        }}
                        className="px-3.5 py-2 rounded-xl text-xs font-bold bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 transition-all flex items-center gap-2 cursor-pointer shadow-sm"
                      >
                        <Bot size={15} />
                        View Bot Commands & Info
                      </button>
                    )}

                    {/* Add/Remove Friend Button */}
                    {selectedProfile.id !== 'me' && !selectedProfile.isBot && (
                      <button
                        onClick={() => {
                          setReportTargetType('profile');
                          setReportTargetId(selectedProfile.id);
                          setIsReportModalOpen(true);
                        }}
                        className={`p-2 rounded-xl transition-colors ${
                          isDarkMode ? 'bg-white/5 hover:bg-white/10 text-red-400' : 'bg-slate-100 hover:bg-slate-200 text-red-500'
                        }`}
                        title="Report User"
                      >
                        <AlertTriangle size={20} />
                      </button>
                    )}

                    {/* Block/Unblock User Button */}
                    {selectedProfile.id !== 'me' && !selectedProfile.isBot && (() => {
                      const isBlocked = blockedUsers.some(u => u.name === selectedProfile.name);
                      return (
                        <button 
                          onClick={() => isBlocked ? handleUnblockUser(selectedProfile) : setBlockUserConfirm(selectedProfile)}
                          className={`p-2 rounded-xl transition-colors ${
                            isDarkMode 
                              ? (isBlocked ? 'bg-red-500/20 text-red-500 hover:bg-red-500/30' : 'bg-white/5 hover:bg-white/10 text-red-400') 
                              : (isBlocked ? 'bg-red-100 text-red-600 hover:bg-red-200' : 'bg-slate-100 hover:bg-slate-200 text-red-500')
                          }`}
                          title={isBlocked ? "Unblock User" : "Block User"}
                        >
                          <Ban size={20} />
                        </button>
                      );
                    })()}

                    {selectedProfile.id !== 'me' && !selectedProfile.isBot && (() => {
                      const isBlocked = blockedUsers.some(u => u.name === selectedProfile.name);
                      if (isBlocked) return null;

                      const isFriend = friends.some(f => f.name === selectedProfile.name);
                      const hasSentRequest = sentFriendRequests.includes(selectedProfile.name);
                      const hasReceivedRequest = friendRequests.some(r => r.name === selectedProfile.name);
                      
                      if (isFriend) {
                        return (
                          <button
                            onClick={() => setRemoveFriendConfirm(selectedProfile)}
                            className={`p-2 rounded-xl transition-colors ${
                              isDarkMode ? 'bg-white/5 hover:bg-white/10 text-red-400' : 'bg-slate-100 hover:bg-slate-200 text-red-500'
                            }`}
                            title="Remove Friend"
                          >
                            <UserMinus size={20} />
                          </button>
                        );
                      } else if (hasReceivedRequest) {
                        return (
                          <button
                            onClick={() => {
                              const request = friendRequests.find(r => r.name === selectedProfile.name);
                              if (request) {
                                setFriends(prev => [...prev, {
                                  id: generateId(),
                                  name: request.name,
                                  status: request.status || 'online',
                                  image: request.image,
                                  customStatus: undefined
                                }]);
                                setFriendRequests(prev => prev.filter(r => r.id !== request.id));
                                socketRef.current.emit('remove-friend-request', { userName, requestId: request.id });
                                socketRef.current.emit('accept-friend-request', {
                                  senderName: request.name,
                                  receiverName: userName,
                                  receiverImage: userImage,
                                  receiverStatus: userStatus,
                                  receiverCustomStatus: customStatus
                                });
                              }
                            }}
                            className={`p-2 rounded-xl transition-colors ${
                              isDarkMode ? 'bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-400' : 'bg-emerald-100 hover:bg-emerald-200 text-emerald-600'
                            }`}
                            title="Accept Friend Request"
                          >
                            <Check size={20} />
                          </button>
                        );
                      } else {
                        return (
                          <button
                            onClick={() => {
                              if (!hasSentRequest) {
                                sendFriendRequest(selectedProfile.name);
                              }
                            }}
                            disabled={hasSentRequest}
                            className={`p-2 rounded-xl transition-colors ${
                              hasSentRequest 
                                ? (isDarkMode ? 'bg-white/5 text-white/40 cursor-default' : 'bg-slate-100 text-slate-400 cursor-default')
                                : (isDarkMode ? 'bg-white/5 hover:bg-white/10 text-emerald-400' : 'bg-slate-100 hover:bg-slate-200 text-emerald-600')
                            }`}
                            title={hasSentRequest ? "Request Sent" : "Add Friend"}
                          >
                            {hasSentRequest ? <UserCheck size={20} /> : <UserPlus size={20} />}
                          </button>
                        );
                      }
                    })()}

                    {selectedProfile.id !== 'me' && !selectedProfile.isBot && selectedProfile.name !== 'T0AI Assistant' && selectedProfile.name !== 'T0AI' && !blockedUsers.some(u => u.name === selectedProfile.name) && (
                      <button 
                        onClick={() => {
                          handleStartDM(selectedProfile);
                          setSelectedProfile(null);
                        }}
                        style={{ backgroundColor: accentColor, color: (accentColor || '').toLowerCase() === '#ffffff' || (accentColor || '').toLowerCase() === 'white' ? 'black' : 'white' }}
                        className="px-4 py-2 rounded-xl text-sm font-bold shadow-lg transition-all flex-1 text-center hover:scale-105 active:scale-95"
                      >
                        Message
                      </button>
                    )}
                  </div>
                </div>

                {/* Roles Section */}
                {activeView === 'server' && activeServer && !selectedProfile.isBot && (
                  <div className="mt-6 relative">
                    <div className="flex items-center justify-between mb-3">
                      <h3 className={`text-xs font-bold uppercase tracking-widest ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Roles</h3>
                      {(() => {
                        const server = findServer(servers, activeServer);
                        if (server && hasPermission(server, userName, 'manageRoles') && selectedProfile.id !== 'me') {
                          return (
                            <button 
                              onClick={() => setIsRoleManagementOpen(!isRoleManagementOpen)}
                              className={`p-1 rounded hover:bg-white/10 transition-colors ${isDarkMode ? 'text-white/40' : 'text-slate-400'} ${isRoleManagementOpen ? 'bg-white/10 text-white' : ''}`}
                            >
                              <Plus size={14} />
                            </button>
                          );
                        }
                        return null;
                      })()}
                    </div>

                    {isRoleManagementOpen && (
                      <div className={`absolute right-0 top-8 w-64 p-3 rounded-2xl shadow-2xl z-50 border ${
                        isDarkMode ? 'bg-slate-800 border-white/10' : 'bg-white border-slate-200'
                      }`}>
                        <h4 className={`text-[10px] font-bold uppercase tracking-widest mb-3 ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>Assign Roles</h4>
                        <div className="flex flex-col gap-1 max-h-48 overflow-y-auto">
                          {(() => {
                            const server = findServer(servers, activeServer);
                            if (!server) return null;
                            const userId = selectedProfile.id === 'me' ? userName : selectedProfile.id;
                            const userRoleIds = server.memberRoles?.[userId] || [];
                            
                            return (server.roles || []).sort((a, b) => a.position - b.position).map(role => {
                              const isAssigned = userRoleIds.includes(role.id);
                              return (
                                <button
                                  key={role.id}
                                  onClick={() => {
                                    const updatedRoles = isAssigned 
                                      ? userRoleIds.filter(id => id !== role.id)
                                      : [...userRoleIds, role.id];
                                    
                                    const newMemberRoles = { ...server.memberRoles, [userId]: updatedRoles };
                                    handleUpdateServer(server.id, { memberRoles: newMemberRoles });
                                  }}
                                  className={`flex items-center justify-between p-2 rounded-lg transition-all ${
                                    isDarkMode ? 'hover:bg-white/5' : 'hover:bg-slate-50'
                                  }`}
                                >
                                  <div className="flex items-center gap-2">
                                    <div className="w-3 h-3 rounded-full" style={{ background: role.color }} />
                                    <span className={`text-sm font-medium ${isDarkMode ? 'text-white/80' : 'text-slate-700'}`}>{role.name}</span>
                                  </div>
                                  {isAssigned && <Check size={14} className="text-emerald-400" />}
                                </button>
                              );
                            });
                          })()}
                        </div>
                      </div>
                    )}

                    <div className="flex flex-wrap gap-2">
                      {(() => {
                        const server = findServer(servers, activeServer);
                        if (!server) return null;
                        const userId = selectedProfile.id === 'me' ? userName : selectedProfile.id;
                        const userRoleIds = server.memberRoles?.[userId] || [];
                        const userRoles = (server.roles || [])
                          .filter(r => userRoleIds.includes(r.id))
                          .sort((a, b) => a.position - b.position);
                        
                        return (
                          <>
                            {userRoles.map(role => (
                              <div 
                                key={role.id}
                                className={`flex items-center gap-1.5 px-2 py-1 rounded-lg border text-[11px] font-bold ${
                                  isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'
                                }`}
                              >
                                <div className="w-2.5 h-2.5 rounded-full" style={{ background: role.color }} />
                                <span style={{ color: (role.color === '#ffffff' || role.color.toLowerCase() === 'white') && !isDarkMode ? '#0f172a' : role.color }}>{role.name}</span>
                              </div>
                            ))}
                            {userRoles.length === 0 && (
                              <span className={`text-xs italic ${isDarkMode ? 'text-white/20' : 'text-slate-400'}`}>No roles assigned</span>
                            )}
                          </>
                        );
                      })()}
                    </div>
                  </div>
                )}

                {/* Server Moderation Tools */}
                {(() => {
                  if (activeView !== 'server' || !activeServer || selectedProfile.id === 'me' || selectedProfile.isBot) return null;
                  const server = findServer(servers, activeServer);
                  if (!server) return null;
                  const isMember = server.members?.some(m => m.id === selectedProfile.id || m.name === selectedProfile.name);
                  if (!isMember || selectedProfile.id === server.ownerId) return null;
                  
                  const canKick = hasPermission(server, userName, 'kickMembers');
                  const canBan = hasPermission(server, userName, 'banMembers');
                  
                  if (!canKick && !canBan) return null;

                  return (
                    <div className={`mt-6 p-4 rounded-2xl border-2 border-red-500/20 ${isDarkMode ? 'bg-red-500/5' : 'bg-red-50'}`}>
                      <h3 className="text-xs font-bold uppercase tracking-widest mb-3 text-red-500">Moderation Tools</h3>
                      <div className="space-y-3">
                        <input 
                          type="text"
                          placeholder="Reason for kick/ban..."
                          value={moderationReason}
                          onChange={(e) => setModerationReason(e.target.value)}
                          className={`w-full px-3 py-2 rounded-xl text-sm border transition-all ${
                            isDarkMode ? 'bg-black/20 border-white/10 focus:border-red-500/50 outline-none' : 'bg-white border-slate-200 focus:border-red-500/50 outline-none'
                          }`}
                        />
                        <div className="flex gap-2">
                          {canKick && (
                            <button 
                              onClick={() => {
                                setKickConfirm({ 
                                  serverId: activeServer!, 
                                  memberId: selectedProfile.id, 
                                  memberName: selectedProfile.name 
                                });
                              }}
                              className="flex-1 py-2 bg-amber-500 text-white rounded-xl text-xs font-bold hover:bg-amber-600 transition-colors flex items-center justify-center gap-2"
                            >
                              <UserMinus size={14} />
                              Kick Member
                            </button>
                          )}
                          {canBan && (
                            <button 
                              onClick={() => {
                                setBanConfirm({ 
                                  serverId: activeServer!, 
                                  memberId: selectedProfile.id, 
                                  memberName: selectedProfile.name 
                                });
                              }}
                              className="flex-1 py-2 bg-red-500 text-white rounded-xl text-xs font-bold hover:bg-red-600 transition-colors flex items-center justify-center gap-2"
                            >
                              <Hammer size={14} />
                              Ban Member
                            </button>
                          )}
                        </div>
                      </div>
                    </div>
                  );
                })()}

                <div className={`mt-6 p-4 rounded-2xl ${isDarkMode ? 'bg-white/5' : 'bg-slate-50'}`}>
                  <h3 className={`text-xs font-bold uppercase tracking-widest mb-3 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Recent Activity</h3>
                  {selectedProfile.activity ? (
                    <div className="flex items-center gap-3">
                      <div className={`w-10 h-10 rounded-lg flex items-center justify-center ${
                        selectedProfile.activity.type === 'gaming' ? 'bg-purple-500/20 text-purple-500' :
                        selectedProfile.activity.type === 'listening' ? 'bg-green-500/20 text-green-500' :
                        'bg-blue-500/20 text-blue-500'
                      }`}>
                        {selectedProfile.activity.type === 'gaming' ? <Gamepad2 size={20} /> :
                         selectedProfile.activity.type === 'listening' ? <Headphones size={20} /> :
                         <div className="w-5 h-5 rounded-lg overflow-hidden">
                           <img draggable="false" onDragStart={(e) => e.preventDefault()} src="https://i.imgur.com/pBnhSqE.png" alt="T0AI" className="w-full h-full object-cover" />
                         </div>}
                      </div>
                      <div>
                        <div className="font-bold text-sm">{selectedProfile.activity.name}</div>
                        <div className={`text-xs ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>{selectedProfile.activity.details}</div>
                      </div>
                    </div>
                  ) : (
                    <div className={`text-sm italic ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>
                      No recent activity to show.
                    </div>
                  )}
                </div>

                {selectedProfile.isBot && (
                  <div className={`mt-6 p-4 rounded-2xl ${isDarkMode ? 'bg-white/5' : 'bg-slate-50'}`}>
                    <h3 className={`text-xs font-bold uppercase tracking-widest mb-3 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>About Me</h3>
                    <p className={`text-sm leading-relaxed ${isDarkMode ? 'text-white/80' : 'text-slate-600'}`}>
                      I am T0AI, your personal AI assistant built directly into Vylant. I can help you write code, answer questions, brainstorm ideas, or just have a friendly chat. You can message me directly or mention me in any server using @T0AI!
                    </p>
                  </div>
                )}

                {selectedProfile.id !== 'me' && !selectedProfile.isBot && (() => {
                  const mutualServers = servers.filter(s => 
                    s.members?.some(m => m.id === selectedProfile.id || m.name === selectedProfile.name)
                  );
                  
                  const mutualFriends = friends.filter(f => 
                    !f.isBot && 
                    f.name !== selectedProfile.name && 
                    mutualServers.some(s => s.members?.some(m => m.id === f.id || m.name === f.name))
                  );

                  return (
                    <>
                      <div className="mt-6">
                        <h3 className={`text-xs font-bold uppercase tracking-widest mb-3 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Mutual Friends</h3>
                        <div className="flex -space-x-2 overflow-visible">
                          {mutualFriends.length > 0 ? (
                            <>
                              {mutualFriends
                                .slice(0, 3)
                                .map((friend) => (
                                  <div key={friend.id} className="relative group/avatar">
                                    <img 
                                      className={`inline-block h-8 w-8 rounded-full ring-2 cursor-pointer ${isDarkMode ? 'ring-slate-900' : 'ring-white'}`}
                                      src={friend.image}
                                      alt={friend.name}
                                      onClick={() => setSelectedProfile({ ...friend, customStatus: friend.status !== 'offline' ? friend.customStatus : undefined })}
                                    />
                                    {/* Tooltip */}
                                    <div className="absolute left-1/2 -translate-x-1/2 top-full mt-2 px-2 py-1 bg-black text-white text-xs rounded opacity-0 group-hover/avatar:opacity-100 transition-opacity whitespace-nowrap z-10 pointer-events-none">
                                      {friend.name}
                                      <div className="absolute -top-1 left-1/2 -translate-x-1/2 border-4 border-transparent border-b-black"></div>
                                    </div>
                                  </div>
                                ))}
                              {mutualFriends.length > 3 && (
                                <div className={`h-8 w-8 rounded-full ring-2 flex items-center justify-center text-xs font-bold ${
                                  isDarkMode ? 'ring-slate-900 bg-white/10 text-white' : 'ring-white bg-slate-100 text-slate-600'
                                }`}>
                                  +{mutualFriends.length - 3}
                                </div>
                              )}
                            </>
                          ) : (
                            <p className={`text-xs ${isDarkMode ? 'text-white/30' : 'text-slate-400'}`}>No mutual friends</p>
                          )}
                        </div>
                      </div>

                      <div className="mt-6">
                        <h3 className={`text-xs font-bold uppercase tracking-widest mb-3 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Mutual Servers</h3>
                        <div className="flex gap-2 overflow-x-auto pb-2">
                          {mutualServers.length > 0 ? (
                            mutualServers.slice(0, 3).map((server) => (
                              <div key={server.id} className="relative group/server flex-shrink-0">
                                <div 
                                  className="w-10 h-10 rounded-xl bg-vylant-blue/20 flex items-center justify-center text-vylant-blue hover:bg-vylant-blue hover:text-white transition-colors cursor-pointer"
                                  onClick={() => {
                                    setActiveServer(server.id);
                                    setActiveView('server');
                                    setSelectedProfile(null);
                                    if (isMobile) {
                                      setIsMobileChannelListOpen(true);
                                    }
                                  }}
                                >
                                  {server.icon ? (
                                    <img src={server.icon} alt={server.name} className="w-full h-full rounded-xl object-cover" />
                                  ) : (
                                    <span className="font-bold text-xs">{server.name.substring(0, 2).toUpperCase()}</span>
                                  )}
                                </div>
                                {/* Tooltip */}
                                <div className="absolute left-1/2 -translate-x-1/2 top-full mt-2 px-2 py-1 bg-black text-white text-xs rounded opacity-0 group-hover/server:opacity-100 transition-opacity whitespace-nowrap z-10 pointer-events-none">
                                  {server.name}
                                  <div className="absolute -top-1 left-1/2 -translate-x-1/2 border-4 border-transparent border-b-black"></div>
                                </div>
                              </div>
                            ))
                          ) : (
                            <p className={`text-xs ${isDarkMode ? 'text-white/30' : 'text-slate-400'}`}>No mutual servers</p>
                          )}
                        </div>
                      </div>
                    </>
                  );
                })()}
