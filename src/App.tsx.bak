  const [collapsedFolders, setCollapsedFolders] = useState<string[]>(() => {
    const stored = localStorage.getItem(`vylant_collapsedFolders_${userName}`);
    return stored ? JSON.parse(stored) : [];
  });
  useEffect(() => {
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_collapsedFolders_${userName}`, JSON.stringify(collapsedFolders));
    }
  }, [collapsedFolders, userName]);
  const [openFolderMenuId, setOpenFolderMenuId] = useState<string | null>(null);
  const [editingFolderId, setEditingFolderId] = useState<string | null>(null);
  const [isCreateFolderModalOpen, setIsCreateFolderModalOpen] = useState(false);
  const [isEditFolderModalOpen, setIsEditFolderModalOpen] = useState(false);
  const [folderToDelete, setFolderToDelete] = useState<{id: string, name: string} | null>(null);
  const [newFolderName, setNewFolderName] = useState('');
  const [newFolderFriends, setNewFolderFriends] = useState<string[]>([]);
  const [isChatFriendMenuOpen, setIsChatFriendMenuOpen] = useState(false);
  const [isGlobalSearchOpen, setIsGlobalSearchOpen] = useState(false);
  const [globalSearchQuery, setGlobalSearchQuery] = useState('');
  const [globalSearchHistory, setGlobalSearchHistory] = useState<string[]>(() => {
    try {
      const stored = localStorage.getItem('vylant_search_history');
      return stored ? JSON.parse(stored) : [];
    } catch (e) {
      return [];
    }
  });

  const addToGlobalSearchHistory = (term: string) => {
    if (!term.trim()) return;
    const trimmed = term.trim();
    setGlobalSearchHistory(prev => {
      const filtered = prev.filter(t => t.toLowerCase() !== trimmed.toLowerCase());
      const newHistory = [trimmed, ...filtered].slice(0, 10);
      localStorage.setItem('vylant_search_history', JSON.stringify(newHistory));
      return newHistory;
    });
  };

  const removeFromGlobalSearchHistory = (term: string) => {
    setGlobalSearchHistory(prev => {
      const newHistory = prev.filter(t => t !== term);
      localStorage.setItem('vylant_search_history', JSON.stringify(newHistory));
      return newHistory;
    });
  };

  const clearGlobalSearchHistory = () => {
    setGlobalSearchHistory([]);
    localStorage.removeItem('vylant_search_history');
  };
  const [pendingJump, setPendingJump] = useState<{ messageId: string; serverId?: string; channelId?: string; dmName?: string; isAI?: boolean } | null>(null);
  const [isTyping, setIsTyping] = useState(false);
  const [dmTypingUsers, setDmTypingUsers] = useState<Record<string, boolean>>({});
  const [serverTypingUsers, setServerTypingUsers] = useState<Record<string, string[]>>({});
  const isCurrentlyTypingServerRef = useRef(false);
  const myServerTypingTimeoutRef = useRef<NodeJS.Timeout | null>(null);
  const serverTypingTimersRef = useRef<Record<string, NodeJS.Timeout>>({});
  const handledNotificationIdsRef = useRef<Set<string>>(new Set());
  const [errorModal, setErrorModal] = useState({ isOpen: false, message: '', resolution: '' });
  const [isRecording, setIsRecording] = useState(false);
  const [isSpeaking, setIsSpeaking] = useState(false);
  const [isRemoteSpeaking, setIsRemoteSpeaking] = useState(false);
  const [isRemoteMuted, setIsRemoteMuted] = useState(false);
  const [isRemoteDeafened, setIsRemoteDeafened] = useState(false);
  const [isTestMicEnabled, setIsTestMicEnabled] = useState(false);
  
  useEffect(() => {
    let audioContext: AudioContext | null = null;
    let stream: MediaStream | null = null;
    let analyser: AnalyserNode | null = null;
    let source: MediaStreamAudioSourceNode | null = null;
    let animationId: number;

    const startMonitoring = async (s: MediaStream) => {
      try {
        const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
        if (!AudioContextClass) {
          console.error("AudioContext is not supported in this browser.");
          return;
        }
        audioContext = new AudioContextClass();
        analyser = audioContext.createAnalyser();
        source = audioContext.createMediaStreamSource(s);
        
        // If testing, connect to output so user can hear themselves
        if (isTestMicEnabled) {
          source.connect(audioContext.destination);
        }

        source.connect(analyser);
        analyser.fftSize = 256;
        const bufferLength = analyser.frequencyBinCount;
        const dataArray = new Uint8Array(bufferLength);

        let lastSpeakingState = false;
        let lastEmitTime = 0;
        const EMIT_COOLDOWN = 100; // ms

        const checkValue = () => {
          if (!analyser) return;
          analyser.getByteFrequencyData(dataArray);
          const average = dataArray.reduce((a, b) => a + b, 0) / bufferLength;
          let currentlySpeaking = average > 25;
          
          // Disable speaking indicator if muted or deafened
          if (isMuted || isDeafened) {
            currentlySpeaking = false;
          }
          
          if (currentlySpeaking !== lastSpeakingState) {
            const now = Date.now();
            // If turning true, emit immediately. If turning false, add a tiny bit of "grace" to avoid flickering
            // and respect the cooldown to prevent drowning the pipe.
            if (currentlySpeaking || (now - lastEmitTime > EMIT_COOLDOWN)) {
              lastSpeakingState = currentlySpeaking;
              setIsSpeaking(currentlySpeaking);
              lastEmitTime = now;
              
              // Emit to server if in a call
              if (socketRef.current && activeCallRef.current && (activeCallRef.current.status === 'connected' || activeCallRef.current.type === 'server')) {
                socketRef.current.emit('speaking-status', {
                  isSpeaking: currentlySpeaking,
                  targetName: activeCallRef.current.targetName,
                  isServer: activeCallRef.current.type === 'server',
                  serverId: activeCallRef.current.serverId,
                  channelId: activeCallRef.current.type === 'server' ? activeCallRef.current.targetName : null
                });
              }
            }
          }
          animationId = requestAnimationFrame(checkValue);
        };
        checkValue();
      } catch (err) {
        console.error("Audio monitoring error:", err);
      }
    };

    if (isTestMicEnabled) {
      navigator.mediaDevices.getUserMedia({ 
        audio: { 
          deviceId: selectedInputDevice !== 'default' ? { ideal: selectedInputDevice } : undefined,
          echoCancellation,
          noiseSuppression,
          autoGainControl: automaticGainControl
        } 
      }).then((s) => {
        stream = s;
        startMonitoring(s);
      }).catch(e => console.error("Test mic error:", e));
    } else if (activeCall?.status === 'connected' && localStreamRef.current) {
      startMonitoring(localStreamRef.current);
    }

    return () => {
      if (animationId) cancelAnimationFrame(animationId);
      if (stream && isTestMicEnabled) {
        stream.getTracks().forEach((track) => track.stop());
      }
      if (audioContext) {
        audioContext.close();
      }
      setIsSpeaking(false);
    };
  }, [isTestMicEnabled, activeCall?.status, isMuted, isDeafened]);
  
  const [recordingDuration, setRecordingDuration] = useState(0);
  const mediaRecorderRef = useRef<MediaRecorder | null>(null);
  const testMicAudioContextRef = useRef<AudioContext | null>(null);
  const isRecordingRef = useRef(false);
  const audioChunksRef = useRef<Blob[]>([]);
  const recordingIntervalRef = useRef<NodeJS.Timeout | null>(null);
  const typingTimeoutRef = useRef<NodeJS.Timeout | null>(null);
  const myTypingTimeoutRef = useRef<NodeJS.Timeout | null>(null);
  const isCurrentlyTypingRef = useRef(false);
  const friendFilterRef = useRef<HTMLDivElement>(null);

  const friendMenuRef = useRef<HTMLDivElement>(null);
  const folderMenuRef = useRef<HTMLDivElement>(null);

  const [isMicDropdownOpen, setIsMicDropdownOpen] = useState(false);
  const [isDeafenDropdownOpen, setIsDeafenDropdownOpen] = useState(false);
  const [isCallMicDropdownOpen, setIsCallMicDropdownOpen] = useState(false);
  const [isCallDeafenDropdownOpen, setIsCallDeafenDropdownOpen] = useState(false);
  const micDropdownRef = useRef<HTMLDivElement>(null);
  const deafenDropdownRef = useRef<HTMLDivElement>(null);
  const callMicDropdownRef = useRef<HTMLDivElement>(null);
  const callDeafenDropdownRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (friendMenuRef.current && !friendMenuRef.current.contains(event.target as Node)) {
        setOpenFriendMenuId(null);
      }
      if (folderMenuRef.current && !folderMenuRef.current.contains(event.target as Node)) {
        setOpenFolderMenuId(null);
      }
      setIsChatFriendMenuOpen(false);
      if (friendFilterRef.current && !friendFilterRef.current.contains(event.target as Node)) {
        setIsFriendFilterOpen(false);
      }
      if (micDropdownRef.current && !micDropdownRef.current.contains(event.target as Node)) {
        setIsMicDropdownOpen(false);
      }
      if (deafenDropdownRef.current && !deafenDropdownRef.current.contains(event.target as Node)) {
        setIsDeafenDropdownOpen(false);
      }
      if (callMicDropdownRef.current && !callMicDropdownRef.current.contains(event.target as Node)) {
        setIsCallMicDropdownOpen(false);
      }
      if (callDeafenDropdownRef.current && !callDeafenDropdownRef.current.contains(event.target as Node)) {
        setIsCallDeafenDropdownOpen(false);
      }
    };
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  const [activeDM, setActiveDM] = useState<string | null>(() => {
    const stored = localStorage.getItem(`vylant_activeDM_${userName}`);
    return (stored && stored !== 'undefined' && stored !== 'null') ? stored : null;
  });

  useEffect(() => {
    if (!pendingJump) {
      setChatPageIndex(0);
    }
  }, [activeServer, activeChannel, activeDM, activeView, pendingJump]);

  useEffect(() => {
    autoResizeChatInputs();
  }, [input, activeView, activeServer, activeChannel, activeDM, autoResizeChatInputs]);
  const startRecording = async () => {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ 
        audio: { 
          deviceId: selectedInputDevice !== 'default' ? { ideal: selectedInputDevice } : undefined,
          echoCancellation,
          noiseSuppression,
          autoGainControl: automaticGainControl
        } 
      });
      
      // Initialize Audio level detection
      const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioContextClass) {
        console.error("AudioContext is not supported in this browser.");
        return;
      }
      const audioContext = new AudioContextClass();
      const source = audioContext.createMediaStreamSource(stream);
      const analyzer = audioContext.createAnalyser();
      source.connect(analyzer);
      analyzer.fftSize = 256;
      const bufferLength = analyzer.frequencyBinCount;
      const dataArray = new Uint8Array(bufferLength);
      
      // Monitor audio levels
      const checkAudioLevel = () => {
        if (!isRecordingRef.current) return;
        analyzer.getByteFrequencyData(dataArray);
        let sum = 0;
        for (let i = 0; i < bufferLength; i++) {
          sum += dataArray[i];
        }
        const average = sum / bufferLength;
        setIsSpeaking(average > 30); // Threshold for green outline
        requestAnimationFrame(checkAudioLevel);
      };
      checkAudioLevel();

      if (typeof MediaRecorder === 'undefined') {
        console.error("MediaRecorder is not supported in this browser.");
        return;
      }
      const mediaRecorder = new MediaRecorder(stream);
      mediaRecorderRef.current = mediaRecorder;
      audioChunksRef.current = [];

      mediaRecorder.ondataavailable = (event) => {
        if (event.data.size > 0) {
          audioChunksRef.current.push(event.data);
        }
      };

      mediaRecorder.onstop = async () => {
        const audioBlob = new Blob(audioChunksRef.current, { type: 'audio/webm' });
        const reader = new FileReader();
        reader.readAsDataURL(audioBlob);
        reader.onloadend = () => {
          const base64Audio = reader.result as string;
          sendVoiceMessage(base64Audio, recordingDuration);
        };
        
        // Stop all tracks to release microphone
        stream.getTracks().forEach(track => track.stop());
        audioContext.close();
        setIsSpeaking(false);
      };

      mediaRecorder.start();
      setIsRecording(true);
      isRecordingRef.current = true;
      setRecordingDuration(0);
      recordingIntervalRef.current = setInterval(() => {
        setRecordingDuration(prev => prev + 1);
      }, 1000);
    } catch (err) {
      console.error("Error accessing microphone:", err);
      alert("Please allow microphone access to record voice messages.");
    }
  };

  const stopRecording = () => {
    if (mediaRecorderRef.current && isRecording) {
      mediaRecorderRef.current.stop();
      setIsRecording(false);
      if (recordingIntervalRef.current) {
        clearInterval(recordingIntervalRef.current);
      }
    }
  };

  const sendVoiceMessage = (audioBase64: string, duration: number) => {
    handleSendMessage(undefined, audioBase64, duration);
  };

  const activeDMRef = useRef(activeDM);
  useEffect(() => { 
    activeDMRef.current = activeDM;
    if (isInitialLoadRef.current && userName) {
      if (activeDM !== null) {
        localStorage.setItem(`vylant_activeDM_${userName}`, activeDM);
      } else {
        localStorage.removeItem(`vylant_activeDM_${userName}`);
      }
    }
  }, [activeDM, userName]);

  useEffect(() => {
    activeViewRef.current = activeView;
    if (activeView === 'home') {
      setActiveDM(null);
    }
    setIsTyping(false);
  }, [activeView, activeDM]);

  // Close mobile menus on navigation
  useEffect(() => {
    setIsMobileMenuOpen(false);
    setIsMobileChannelListOpen(false);
    setIsMobileRightPanelOpen(false);
  }, [activeView, activeServer, activeChannel, activeDM]);

  const [unreadCounts, setUnreadCounts] = useState<{
    dms: Record<string, number>,
    servers: Record<string, Record<string, number>>
  }>({
    dms: {},
    servers: {}
  });

  const [mentionCounts, setMentionCounts] = useState<{
    dms: Record<string, number>,
    servers: Record<string, Record<string, number>>
  }>({
    dms: {},
    servers: {}
  });
  const [newMessagesMarker, setNewMessagesMarker] = useState<{ id: string, messageId: string } | null>(null);

  const incrementUnread = (type: 'dm' | 'server', id: string, channel?: string, isMention: boolean = false) => {
    setUnreadCounts(prev => {
      if (type === 'dm') {
        console.log('incrementUnread: dm', id, isMention);
        return {
          ...prev,
          dms: {
            ...prev.dms,
            [id]: (prev.dms[id] || 0) + 1
          }
        };
      } else if (channel) {
        console.log('incrementUnread: server', id, channel, isMention);
        const serverUnreads = prev.servers[id] || {};
        return {
          ...prev,
          servers: {
            ...prev.servers,
            [id]: {
              ...serverUnreads,
              [channel]: (serverUnreads[channel] || 0) + 1
            }
          }
        };
      }
      return prev;
    });

    if (isMention) {
      setMentionCounts(prev => {
        if (type === 'dm') {
          return {
            ...prev,
            dms: {
              ...prev.dms,
              [id]: (prev.dms[id] || 0) + 1
            }
          };
        } else if (channel) {
          const serverMentions = prev.servers[id] || {};
          return {
            ...prev,
            servers: {
              ...prev.servers,
              [id]: {
                ...serverMentions,
                [channel]: (serverMentions[channel] || 0) + 1
              }
            }
          };
        }
        return prev;
      });
    }
  };

  const clearUnread = (type: 'dm' | 'server', id: string, channel?: string) => {
    setUnreadCounts(prev => {
      if (type === 'dm') {
        const newDms = { ...prev.dms };
        delete newDms[id];
        return { ...prev, dms: newDms };
      } else if (channel) {
        const serverUnreads = { ...(prev.servers[id] || {}) };
        delete serverUnreads[channel];
        return {
          ...prev,
          servers: {
            ...prev.servers,
            [id]: serverUnreads
          }
        };
      } else if (type === 'server') {
        const newServers = { ...prev.servers };
        delete newServers[id];
        return { ...prev, servers: newServers };
      }
      return prev;
    });
    setMentionCounts(prev => {
      if (type === 'dm') {
        const newDms = { ...prev.dms };
        delete newDms[id];
        return { ...prev, dms: newDms };
      } else if (channel) {
        const serverMentions = { ...(prev.servers[id] || {}) };
        delete serverMentions[channel];
        return {
          ...prev,
          servers: {
            ...prev.servers,
            [id]: serverMentions
          }
        };
      } else if (type === 'server') {
        const newServers = { ...prev.servers };
        delete newServers[id];
        return { ...prev, servers: newServers };
      }
      return prev;
    });
  };

  useEffect(() => {
    if (activeView === 'messages' && activeDM) {
      const count = unreadCounts.dms[activeDM] || 0;
      if (count > 0) {
        const msgs = dmMessagesRef.current[activeDM] || [];
        const firstNewMsg = msgs[msgs.length - count];
        if (firstNewMsg) {
          setNewMessagesMarker({ id: activeDM, messageId: firstNewMsg.id });
        }
      } else if (newMessagesMarker?.id !== activeDM) {
        setNewMessagesMarker(null);
      }
      clearUnread('dm', activeDM);
    } else if (activeView === 'server' && activeServer && activeChannel) {
      const count = unreadCounts.servers[activeServer]?.[activeChannel] || 0;
      if (count > 0) {
        const msgs = serverMessagesRef.current[activeServer]?.[activeChannel] || [];
        const firstNewMsg = msgs[msgs.length - count];
        if (firstNewMsg) {
          setNewMessagesMarker({ id: `${activeServer}-${activeChannel}`, messageId: firstNewMsg.id });
        }
      } else if (newMessagesMarker?.id !== `${activeServer}-${activeChannel}`) {
        setNewMessagesMarker(null);
      }
      clearUnread('server', activeServer, activeChannel);
    }
  }, [activeView, activeDM, activeServer, activeChannel]);

  const totalDMUnreads = (() => {
    let total = 0;
    Object.values(unreadCounts.dms).forEach((count: any) => {
      total += (count as number);
    });
    return total;
  })();

  useEffect(() => {
    if (socketRef.current && activeCallRef.current && activeCallRef.current.status === 'connected') {
      socketRef.current.emit('voice-state-update', {
        isMuted,
        isDeafened,
        isServer: activeCallRef.current.type === 'server',
        serverId: activeCallRef.current.serverId,
        channelId: activeCallRef.current.type === 'server' ? activeCallRef.current.targetName : null,
        targetName: activeCallRef.current.type === 'private' ? activeCallRef.current.targetName : null
      });
      
      // If we mute, stop speaking locally immediately
      if (isMuted || isDeafened) {
        setIsSpeaking(false);
      }
    }
  }, [isMuted, isDeafened, userName]);

  const getServerUnreadCount = (serverId: string): number => {
    const serverUnreads = unreadCounts.servers[serverId] || {};
    let total = 0;
    Object.values(serverUnreads).forEach((count: any) => {
      total += (count as number);
    });
    return total;
  };

  const getServerOnlineCount = (serverId: string): number => {
    const server = findServer(servers, serverId);
    if (!server || !server.members) return 0;
    return server.members.filter(m => m.status !== 'offline' && m.status !== 'invisible').length;
  };
  
  const handleDeleteDM = (id: string, name: string) => {
    setDmToDelete({ id, name });
  };

  const [dmMarketplaceContext, setDmMarketplaceContext] = useState<Record<string, MarketplaceItem>>(() => {
    try {
      const saved = localStorage.getItem(`vylant_dm_marketplace_${userName}`);
      return saved ? JSON.parse(saved) : {};
    } catch {
      return {};
    }
  });

  const [makeOfferItem, setMakeOfferItem] = useState<MarketplaceItem | null>(null);
  const [previewMarketplaceItem, setPreviewMarketplaceItem] = useState<MarketplaceItem | null>(null);
  const [dmCategoryFilter, setDmCategoryFilter] = useState<'all' | 'marketplace'>('all');

  const handleStartMarketplaceChat = (sellerName: string, item: MarketplaceItem, inquiryMessage?: string, directSend = true) => {
    setDmMarketplaceContext(prev => {
      const updated = { ...prev, [sellerName]: item };
      try {
        localStorage.setItem(`vylant_dm_marketplace_${userName}`, JSON.stringify(updated));
      } catch {}
      return updated;
    });

    handleStartDM({ name: sellerName, isMarketplace: true });

    const msgText = inquiryMessage || 'Hi, is this still available?';
    const initialMsg: Message = {
      id: generateId(),
      sender: userName,
      text: msgText,
      timestamp: Date.now(),
      isMarketplaceInquiry: true,
      marketplaceItem: item
    };

    setDmMessages(prev => {
      const existing = prev[sellerName] || [];
      if (existing.some(m => m.text === msgText && (Date.now() - (m.timestamp || 0) < 2000))) {
        return prev;
      }
      return {
        ...prev,
        [sellerName]: [...existing, initialMsg]
      };
    });

    apiFetch('/api/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: initialMsg, receiver: sellerName })
    }).catch(err => console.error('Failed to send marketplace inquiry message:', err));
  };

  const handleSendOfferMessage = (price: number, note: string) => {
    if (!makeOfferItem || !activeDM) return;
    const sellerName = activeDM;
    const offerMsg: Message = {
      id: generateId(),
      sender: userName,
      text: `Submitted a custom offer of $${price.toFixed(2)}${note ? `: "${note}"` : ''}`,
      timestamp: Date.now(),
      isMarketplaceOffer: true,
      offerPrice: price,
      offerNote: note,
      marketplaceItem: makeOfferItem
    };

    setDmMessages(prev => ({
      ...prev,
      [sellerName]: [...(prev[sellerName] || []), offerMsg]
    }));

    apiFetch('/api/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: offerMsg, receiver: sellerName })
    }).catch(err => console.error('Failed to send offer message:', err));
  };

  const handleStartDM = (friendOrName: any) => {
    const name = typeof friendOrName === 'string' ? friendOrName : friendOrName.name;
    
    if (name === 'T0AI Assistant' || name === 'T0AI') {
      setActiveView('home');
      setActiveDM(null);
      return;
    }

    const friend = typeof friendOrName === 'string' ? friends.find(f => f.name === name) : friendOrName;
    
    setActiveView('messages');
    setActiveDM(name);
    
    if (!recentDMs.some(dm => dm.name === name)) {
      setRecentDMs(prev => [{
        id: friend?.id || generateId(),
        name: name,
        image: friend?.image || getRandomAvatar(name),
        status: friend?.status || 'online',
        timestamp: Date.now()
      }, ...prev]);
    }
  };

  const confirmDeleteDM = () => {
    if (dmToDelete) {
      setRecentDMs(prev => {
        const remaining = prev.filter(dm => dm.id !== dmToDelete.id);
        return remaining;
      });
      
      if (activeDM === dmToDelete.name) {
        const remainingAfter = recentDMs.filter(dm => dm.id !== dmToDelete.id);
        if (remainingAfter.length > 0) {
          setActiveDM(remainingAfter[0].name);
        } else {
          setActiveDM(null);
        }
        setActiveView('messages');
      }
      setDmToDelete(null);
    }
  };

  const handleLeaveGroup = () => {
    if (leaveGroupConfirm) {
      if (socketRef.current) {
        socketRef.current.emit('leave-group-chat', { groupId: leaveGroupConfirm.id, userId: userName });
      }
      setGroupChats(prev => prev.filter(gc => gc.id !== leaveGroupConfirm.id));
      if (activeDM === leaveGroupConfirm.name) {
        setActiveDM(null);
        setActiveView('home');
      }
      setLeaveGroupConfirm(null);
    }
  };

  const handleCreateGroup = () => {
    if (!newGroupName.trim() || selectedFriendsForGroup.length < 2) return;
    
    if (selectedFriendsForGroup.length + 1 > 20) {
      alert("Group chat limit is 20 people.");
      return;
    }
    
    const newGroup = {
      id: `gc${generateId()}`,
      name: newGroupName,
      image: getRandomAvatar(newGroupName),
      lastMessage: 'Group created',
      creator: userName,
      members: [
        { name: userName, status: 'online', image: userImage },
        ...friends
          .filter(f => selectedFriendsForGroup.includes(f.id))
          .map(f => ({ name: f.name, status: f.status, image: f.image }))
      ]
    };
    
    if (socketRef.current) {
      socketRef.current.emit('create-group-chat', { groupChat: newGroup });
    }
    
    setGroupChats(prev => [newGroup, ...prev]);
    setIsCreateGroupModalOpen(false);
    setNewGroupName('');
    setSelectedFriendsForGroup([]);
    
    alert(`Group chat "${newGroupName}" created successfully!`);
    
    setActiveView('messages');
    setActiveDM(newGroup.name);
  };

  const handleUpdateGroup = () => {
    const currentGroup = groupChats.find(gc => gc.name === activeDM);
    if (!currentGroup || !editGroupName.trim()) return;

    setGroupChats(prev => prev.map(gc => 
      gc.id === currentGroup.id 
        ? { ...gc, name: editGroupName, image: editGroupImage || gc.image } 
        : gc
    ));
    
    // Update activeDM if name changed
    if (editGroupName !== activeDM) {
      setActiveDM(editGroupName);
      
      // Also update messages keys if they use the name
      setDmMessages(prev => {
        const newDmMessages = { ...prev };
        if (newDmMessages[activeDM]) {
          newDmMessages[editGroupName] = newDmMessages[activeDM];
          delete newDmMessages[activeDM];
        }
        return newDmMessages;
      });
    }
    
    setIsEditGroupModalOpen(false);
  };

  const handleAddMembers = () => {
    if (selectedFriendsToAdd.length === 0) return;
    
    const currentGroup = groupChats.find(gc => gc.name === activeDM);
    if (!currentGroup) return;

    const newMembers = friends
      .filter(f => selectedFriendsToAdd.includes(f.id) && !currentGroup.members.some(m => m.name === f.name))
      .map(f => ({ name: f.name, status: f.status, image: f.image }));

    if (currentGroup.members.length + newMembers.length > 20) {
      alert("Group chat limit is 20 people.");
      return;
    }

    if (socketRef.current) {
      socketRef.current.emit('add-group-chat-members', { groupId: currentGroup.id, newMembers });
    }
    
    setGroupChats(prev => prev.map(gc => gc.id === currentGroup.id ? { ...gc, members: [...gc.members, ...newMembers] } : gc));
    setIsAddMemberModalOpen(false);
    setSelectedFriendsToAdd([]);
  };

  const handleKickMember = (groupId: string, memberName: string) => {
    if (socketRef.current) {
       socketRef.current.emit('kick-group-chat-member', { groupId, memberName });
    }
    setGroupChats(prev => prev.map(gc => 
      gc.id === groupId 
        ? { ...gc, members: gc.members.filter((m: any) => m.name !== memberName) }
        : gc
    ));
  };

  const handleTransferGroupOwnership = (groupId: string, newOwnerName: string) => {
    if (socketRef.current) {
      socketRef.current.emit('transfer-group-ownership', { groupId, newOwnerName });
    }
    setGroupChats(prev => prev.map(gc => 
      gc.id === groupId 
        ? { ...gc, creator: newOwnerName }
        : gc
    ));
  };

  const handleSendBugReport = async () => {
    if (!bugTitle.trim() || !bugDescription.trim()) return;
    setIsSubmittingBug(true);
    
    // Simulate API call
    await new Promise(resolve => setTimeout(resolve, 1500));
    
    setIsSubmittingBug(false);
    setBugReportSent(true);
    setBugTitle('');
    setBugDescription('');
    setBugCategory('functional');
  };

  // Simulate user joining
  /*
  useEffect(() => {
    const timer = setTimeout(() => {
      // Removed simulated join message
    }, 5000);
    return () => clearTimeout(timer);
  }, []);
  */

  const [isAppInstalled, setIsAppInstalled] = useState<boolean>(() => {
    if (typeof window === 'undefined') return false;
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (window.navigator as any).standalone === true;
    const storedInstalled = localStorage.getItem('vylant_desktop_installed') === 'true';
    return isStandalone || storedInstalled;
  });

  const [appDownloaded, setAppDownloaded] = useState<boolean>(() => {
    return localStorage.getItem('vylant_app_downloaded') === 'true' || localStorage.getItem('vylant_desktop_installed') === 'true' || isAppInstalled;
  });

  const installPromptRef = useRef<any>(null);
  const [hasInstallPrompt, setHasInstallPrompt] = useState<boolean>(false);

  const handleTriggerNativePrompt = useCallback(async () => {
    if (installPromptRef.current) {
      try {
        installPromptRef.current.prompt();
        const { outcome } = await installPromptRef.current.userChoice;
        if (outcome === 'accepted') {
          setIsAppInstalled(true);
          setAppDownloaded(true);
          localStorage.setItem('vylant_desktop_installed', 'true');
          localStorage.setItem('vylant_app_downloaded', 'true');
          setIsInstallModalOpen(false);
        }
      } catch (err) {
        console.error('Native install error:', err);
      }
    }
  }, []);

  useEffect(() => {
    const handleBeforeInstall = (e: any) => {
      e.preventDefault();
      installPromptRef.current = e;
      setHasInstallPrompt(true);
    };
    const handleAppInstalled = () => {
      setIsAppInstalled(true);
      setAppDownloaded(true);
      localStorage.setItem('vylant_desktop_installed', 'true');
      localStorage.setItem('vylant_app_downloaded', 'true');
      installPromptRef.current = null;
      setHasInstallPrompt(false);
    };

    window.addEventListener('beforeinstallprompt', handleBeforeInstall);
    window.addEventListener('appinstalled', handleAppInstalled);

    const mediaQuery = window.matchMedia('(display-mode: standalone)');
    const handleMediaChange = (evt: MediaQueryListEvent) => {
      if (evt.matches) {
        setIsAppInstalled(true);
        setAppDownloaded(true);
        localStorage.setItem('vylant_desktop_installed', 'true');
        localStorage.setItem('vylant_app_downloaded', 'true');
      }
    };
    if (mediaQuery.addEventListener) {
      mediaQuery.addEventListener('change', handleMediaChange);
    }

    return () => {
      window.removeEventListener('beforeinstallprompt', handleBeforeInstall);
      window.removeEventListener('appinstalled', handleAppInstalled);
      if (mediaQuery.removeEventListener) {
        mediaQuery.removeEventListener('change', handleMediaChange);
      }
    };
  }, []);

  const [isInstallModalOpen, setIsInstallModalOpen] = useState<boolean>(false);
  const [installModalPlatform, setInstallModalPlatform] = useState<'mac' | 'ios' | 'android' | 'linux' | 'windows' | null>(null);

  const handleInstallPWA = (platform?: 'mac' | 'ios' | 'android' | 'linux' | 'windows') => {
    setInstallModalPlatform(platform || null);
    setIsInstallModalOpen(true);
  };

  const [recentDMs, setRecentDMs] = useState<any[]>(() => {
    const stored = localStorage.getItem(`vylant_recentDMs_${userName}`);
    return stored ? JSON.parse(stored) : [];
  });
  const recentDMsRef = useRef(recentDMs);
  useEffect(() => {
    recentDMsRef.current = recentDMs;
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_recentDMs_${userName}`, JSON.stringify(recentDMs));
    }
  }, [recentDMs, userName]);

  const [dmSortMode, setDmSortMode] = useState<'recent' | 'unread'>(() => {
    const stored = localStorage.getItem(`vylant_dmSortMode_${userName}`);
    return (stored === 'unread' || stored === 'recent') ? stored : 'recent';
  });
  useEffect(() => {
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_dmSortMode_${userName}`, dmSortMode);
    }
  }, [dmSortMode, userName]);

  const [groupChats, setGroupChats] = useState<any[]>(() => {
    const stored = localStorage.getItem(`vylant_groupChats_${userName}`);
    return stored ? JSON.parse(stored) : [];
  });
  const groupChatsRef = useRef(groupChats);
  
  // Track who is actively in a group call per group
  const [activeGroupCalls, setActiveGroupCalls] = useState<Record<string, Set<string>>>({});
  const activeGroupCallsRef = useRef(activeGroupCalls);
  
  useEffect(() => {
    groupChatsRef.current = groupChats;
  }, [groupChats]);

  useEffect(() => {
    activeGroupCallsRef.current = activeGroupCalls;
  }, [activeGroupCalls]);
  useEffect(() => {
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_groupChats_${userName}`, JSON.stringify(groupChats));
    }
  }, [groupChats, userName]);

  const getTargetImage = useCallback((name: string) => {
    if (!name) return getRandomAvatar('user');
    const friend = friends.find((f: any) => f.name === name);
    if (friend?.image) return friend.image;
    const dmItem = recentDMs.find((dm: any) => dm.name === name);
    if (dmItem?.image) return dmItem.image;
    const groupChat = groupChats.find((gc: any) => gc.name === name);
    if (groupChat?.image) return groupChat.image;
    return getRandomAvatar(name);
  }, [friends, recentDMs, groupChats]);

  const [dmMessages, setDmMessages] = useState<Record<string, Message[]>>(() => {
    const stored = localStorage.getItem(`vylant_dmMessages_${userName}`);
    return stored ? JSON.parse(stored) : {};
  });
  useEffect(() => {
    if (isInitialLoadRef.current && userName) {
      const pruned = pruneDmMessagesForStorage(dmMessages);
      localStorage.setItem(`vylant_dmMessages_${userName}`, JSON.stringify(pruned));
    }
  }, [dmMessages, userName]);

  useEffect(() => {
    if (!pendingJump) return;

    let msgs: Message[] = [];
    if (pendingJump.serverId && pendingJump.channelId) {
      if (activeServer === pendingJump.serverId && activeChannel === pendingJump.channelId) {
        msgs = serverMessages[pendingJump.serverId]?.[pendingJump.channelId] || [];
      }
    } else if (pendingJump.dmName) {
      if (activeDM === pendingJump.dmName) {
        msgs = dmMessages[pendingJump.dmName] || [];
      }
    } else if (pendingJump.isAI) {
      if (activeView === 'home') {
        msgs = messages || [];
      }
    }

    if (msgs.length > 0) {
      const msgIndex = msgs.findIndex(m => m.id === pendingJump.messageId);
      if (msgIndex !== -1) {
        const pageSize = 50;
        const totalMsgs = msgs.length;
        const targetPageIndex = Math.floor((totalMsgs - 1 - msgIndex) / pageSize);
        
        if (chatPageIndex !== targetPageIndex) {
          setChatPageIndex(targetPageIndex);
          return;
        }

        let attempts = 0;
        const intervalId = setInterval(() => {
          const element = document.getElementById(`msg-${pendingJump.messageId}`);
          if (element) {
            clearInterval(intervalId);
            element.scrollIntoView({ behavior: 'smooth', block: 'center' });
            
            // Set dynamic highlighting styles
            const originalTransition = element.style.transition;
            const originalShadow = element.style.boxShadow;
            const originalBg = element.style.backgroundColor;
            const originalPadding = element.style.padding;
            
            element.style.transition = 'all 0.5s ease-in-out';
            element.style.boxShadow = '0 0 20px rgba(0, 210, 255, 0.7)';
            element.style.borderRadius = '12px';
            element.style.backgroundColor = 'rgba(0, 210, 255, 0.2)';
            element.style.padding = '8px';
            
            setTimeout(() => {
              element.style.transition = originalTransition;
              element.style.boxShadow = originalShadow;
              element.style.backgroundColor = originalBg;
              element.style.padding = originalPadding;
            }, 3000);
            
            setPendingJump(null);
          } else {
            attempts++;
            if (attempts >= 20) {
              clearInterval(intervalId);
              setPendingJump(null);
            }
          }
        }, 100);

        return () => clearInterval(intervalId);
      } else {
        const safety = setTimeout(() => {
          setPendingJump(null);
        }, 2000);
        return () => clearTimeout(safety);
      }
    }
  }, [
    pendingJump,
    activeServer,
    activeChannel,
    activeDM,
    activeView,
    serverMessages,
    dmMessages,
    messages,
    chatPageIndex
  ]);

  const sortedRecentDMs = useMemo(() => {
    const getDMActivityTimestamp = (dm: any) => {
      const msgs = dmMessages[dm.name] || [];
      if (msgs.length > 0) {
        return msgs[msgs.length - 1].timestamp || 0;
      }
      return dm.timestamp || 0;
    };
    return [...recentDMs].sort((a, b) => {
      if (dmSortMode === 'unread') {
        const unreadA = unreadCounts.dms[a.name] || 0;
        const unreadB = unreadCounts.dms[b.name] || 0;
        if (unreadA !== unreadB) {
          return unreadB - unreadA; // Unread first
        }
      }
      const timeA = getDMActivityTimestamp(a);
      const timeB = getDMActivityTimestamp(b);
      return timeB - timeA;
    });
  }, [recentDMs, dmMessages, dmSortMode, unreadCounts.dms]);

  useEffect(() => {
    // When active targets change, prune excess messages to keep RAM and DOM lightweight
    if (userName) {
      setServerMessages(prev => {
        let changed = false;
        const newServerMessages: Record<string, Record<string, Message[]>> = { ...prev };
        Object.entries(newServerMessages).forEach(([serverId, channels]) => {
          const channelsCast = channels as Record<string, Message[]>;
          newServerMessages[serverId] = { ...channelsCast };
          Object.entries(channelsCast).forEach(([channelId, msgs]) => {
            const msgsCast = msgs as Message[];
            const limit = (serverId === activeServer && channelId === activeChannel) ? 200 : 100;
            if (msgsCast.length > limit) {
              newServerMessages[serverId][channelId] = msgsCast.slice(-limit);
              changed = true;
            }
          });
        });
        return changed ? newServerMessages : prev;
      });

      setDmMessages(prev => {
        let changed = false;
        const newDmMessages: Record<string, Message[]> = { ...prev };
        Object.entries(newDmMessages).forEach(([dmUser, msgs]) => {
          const msgsCast = msgs as Message[];
          const limit = (dmUser === activeDM) ? 200 : 100;
          if (msgsCast.length > limit) {
            newDmMessages[dmUser] = msgsCast.slice(-limit);
            changed = true;
          }
        });
        return changed ? newDmMessages : prev;
      });
    }
  }, [activeServer, activeChannel, activeDM, userName]);

  const [vanishModeByDM, setVanishModeByDM] = useState<Record<string, boolean>>({});

  useEffect(() => {
    const token = localStorage.getItem('vylant_token') || sessionStorage.getItem('vylant_token');
    if (userName && userName !== 'T0AI User' && token) {
      apiFetch('/api/vanish-mode')
        .then(async res => {
          if (!res.ok) throw new Error(`Status ${res.status}`);
          try {
            return await res.json();
          } catch (e) {
            console.error('Failed to parse vanish-mode JSON:', e);
            return {};
          }
        })
        .then(data => {
          const myVanishModes: Record<string, boolean> = {};
          if (data && typeof data === 'object') {
            Object.keys(data).forEach(key => {
              const [user1, user2] = key.split(':');
              if (user1 === userName) myVanishModes[user2] = data[key];
              if (user2 === userName) myVanishModes[user1] = data[key];
            });
          }
          setVanishModeByDM(myVanishModes);
        })
        .catch(e => {
          const token = localStorage.getItem('vylant_token') || sessionStorage.getItem('vylant_token');
          if (userName !== 'T0AI User' && token) {
            console.error(`Failed to fetch vanish modes from server (${e.message}):`, e);
          }
        });
    }
  }, [userName]);

  const vanishModeByDMRef = useRef(vanishModeByDM);
  useEffect(() => { vanishModeByDMRef.current = vanishModeByDM; }, [vanishModeByDM]);

  useEffect(() => {
    (window as any).setReportTargetType = setReportTargetType;
    (window as any).setReportTargetId = setReportTargetId;
    (window as any).setIsReportModalOpen = setIsReportModalOpen;
    (window as any).setIsInformIsraelModalOpen = setIsInformIsraelModalOpen;
  }, []);

  const dmMessagesRef = useRef(dmMessages);
  useEffect(() => { dmMessagesRef.current = dmMessages; }, [dmMessages]);

  useEffect(() => {
    const interval = setInterval(() => {
      const now = Date.now();
      const currentGroupNames = new Set(groupChatsRef.current.map(gc => gc.name));
      
      setDmMessages(prev => {
        let hasChanges = false;
        const next = { ...prev };

        Object.keys(next).forEach(chatKey => {
          const messages = next[chatKey];
          if (!messages) return;

          // NEVER expire group chat messages
          if (currentGroupNames.has(chatKey)) {
            // Optional: Cleanup any accidental expiration flags in group chats
            if (messages.some(m => m.expiresAt || m.isVanish)) {
              next[chatKey] = messages.map(m => ({
                ...m,
                expiresAt: undefined,
                isVanish: false
              }));
              hasChanges = true;
            }
            return;
          }

          const filteredMessages = messages.filter(msg => !msg.expiresAt || msg.expiresAt > now);
          if (filteredMessages.length !== messages.length) {
            next[chatKey] = filteredMessages;
            hasChanges = true;
          }
        });

        return hasChanges ? next : prev;
      });
    }, 1000);
    return () => clearInterval(interval);
  }, []);

  const serverMessagesRef = useRef(serverMessages);
  useEffect(() => { serverMessagesRef.current = serverMessages; }, [serverMessages]);
  const [isReportModalOpen, setIsReportModalOpen] = useState(false);
  const [isInformIsraelModalOpen, setIsInformIsraelModalOpen] = useState(false);
  const [reportTargetType, setReportTargetType] = useState<'profile' | 'message'>('profile');
  const [reportTargetId, setReportTargetId] = useState('');
  const [selectedProfile, setSelectedProfile] = useState<any>(null);
  const [isBotStudioOpen, setIsBotStudioOpen] = useState(false);
  const [selectedBotProfile, setSelectedBotProfile] = useState<any>(null);
  const [stories, setStories] = useState<Record<string, any[]>>({});

  useEffect(() => {
    const fetchStories = async () => {
      const token = localStorage.getItem('vylant_token') || sessionStorage.getItem('vylant_token');
      if (!token) return;

      try {
        const res = await apiFetch('/api/stories');
        if (res.ok) {
          const data = await res.json();
          setStories(data);
        } else if (res.status === 401 || res.status === 403) {
          // Silent fail for auth errors on background fetch
        } else {
          console.warn('Failed to fetch stories: Network response was not ok', res.status);
        }
      } catch (err: any) {
        if (err.message !== 'Failed to fetch' && err.name !== 'TypeError') {
          console.warn('Failed to fetch stories:', err);
        }
      }
    };

    fetchStories();
    const interval = setInterval(fetchStories, 30000);
    return () => clearInterval(interval);
  }, [userName]);

  const [viewingStoryUserId, setViewingStoryUserId] = useState<string | null>(null);
  const [storyIndex, setStoryIndex] = useState(0);
  const [isStoryMenuOpen, setIsStoryMenuOpen] = useState(false);
  const storyInputRef = useRef<HTMLInputElement>(null);
  const [removeFriendConfirm, setRemoveFriendConfirm] = useState<any>(null);
  const [dmToDelete, setDmToDelete] = useState<{id: string, name: string} | null>(null);
  const [messageMenu, setMessageMenu] = useState<{messageId: string, dmName: string} | null>(null);
  const [fullScreenImage, setFullScreenImage] = useState<string | null>(null);
  const [isDraggingFile, setIsDraggingFile] = useState(false);
  const dragCounterRef = useRef(0);
  const [selectedAttachments, setSelectedAttachments] = useState<Array<{
    file?: File;
    preview: string;
    url: string | null;
    isUploading: boolean;
    id: string;
    type: 'image' | 'video' | 'file' | 'audio';
    isSpoiler: boolean;
  }>>([]);
  const [isLoading, setIsLoading] = useState(false);
  const [isTranslationEnabled, setIsTranslationEnabled] = useState(() => {
    const stored = localStorage.getItem(`vylant_isTranslationEnabled_${userName}`);
    return stored ? JSON.parse(stored) : false;
  });
  useEffect(() => {
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_isTranslationEnabled_${userName}`, JSON.stringify(isTranslationEnabled));
    }
  }, [isTranslationEnabled, userName]);

  const [showOriginalMessage, setShowOriginalMessage] = useState(() => {
    const stored = localStorage.getItem(`vylant_showOriginalMessage_${userName}`);
    return stored ? JSON.parse(stored) : true;
  });
  useEffect(() => {
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_showOriginalMessage_${userName}`, JSON.stringify(showOriginalMessage));
    }
  }, [showOriginalMessage, userName]);

  const [targetLanguage, setTargetLanguage] = useState(() => {
    const stored = localStorage.getItem(`vylant_targetLanguage_${userName}`);
    return stored || 'English';
  });
  useEffect(() => {
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_targetLanguage_${userName}`, targetLanguage);
    }
  }, [targetLanguage, userName]);

  const [translatedMessages, setTranslatedMessages] = useState<Record<string, string>>({});
  const [messageToDelete, setMessageToDelete] = useState<{ id: string, type: 'server' | 'dm' | 'home', serverId?: string, channelId?: string, otherPerson?: string } | null>(null);

  const translateMessage = async (text: string) => {
    try {
      const response = await apiFetch("/api/gemini", {
        method: "POST",
        body: JSON.stringify({
          prompt: `Translate the following text to ${targetLanguage}: "${text}". Only return the translated text, nothing else.`,
        }),
      });
      if (response.ok) {
        const data = await response.json();
        return data.text || text;
      }
      return text;
    } catch (e) {
      console.error("Translation error:", e);
      return text;
    }
  };

  const [leaveGroupConfirm, setLeaveGroupConfirm] = useState<any>(null);
  const [isGroupMembersOpen, setIsGroupMembersOpen] = useState(false);
  const [servers, setServers] = useState<Server[]>(() => {
    const stored = localStorage.getItem(`vylant_servers_${userName}`);
    const parsed = stored ? JSON.parse(stored) : INITIAL_SERVERS;
    // Map existing stored server data so 'Vylant Official' has the correct official image
    return parsed.map((s: any) => s.id === '1' ? { ...s, image: 'https://i.imgur.com/H3OS5zA.png', verified: true } : s);
  });
  const [isFileTooLargeModalOpen, setIsFileTooLargeModalOpen] = useState(false);
  const [pendingLargeFile, setPendingLargeFile] = useState<File | null>(null);
  const MAX_FILE_SIZE_MB = 25;
  const serversRef = useRef(servers);
  useEffect(() => {
    serversRef.current = servers;
    if (isInitialLoadRef.current && userName) {
      localStorage.setItem(`vylant_servers_${userName}`, JSON.stringify(servers));
    }
  }, [servers, userName]);

  const processingInviteRef = useRef(false);

  // Auto-join server from stored URL invitation query parameters
  useEffect(() => {
    if (!showApp || !userName) return;

    const pendingInviteRaw = sessionStorage.getItem('vylant_pending_invite');
    if (!pendingInviteRaw || processingInviteRef.current) return;

    try {
      const pendingInvite = JSON.parse(pendingInviteRaw);
      const { inviteServerId, expires, maxUses, code } = pendingInvite;

      if (!inviteServerId) {
        sessionStorage.removeItem('vylant_pending_invite');
        return;
      }

      if (expires) {
        const expiryTimestamp = parseInt(expires, 10);
        if (!isNaN(expiryTimestamp) && Date.now() > expiryTimestamp) {
          alert('This invitation link has expired.');
          sessionStorage.removeItem('vylant_pending_invite');
          return;
        }
      }

      processingInviteRef.current = true;
      sessionStorage.removeItem('vylant_pending_invite');

      const processInvite = async () => {
        try {
          const queryParams: string[] = [];
          if (expires) queryParams.push(`expires=${expires}`);
          if (maxUses) queryParams.push(`maxUses=${maxUses}`);
          if (code) queryParams.push(`code=${code}`);
          const queryParamsStr = queryParams.join('&');

          const existingServer = serversRef.current.find(s => s.id === inviteServerId);
          if (existingServer) {
            setActiveServer(existingServer.id);
            setActiveView('server');
            processingInviteRef.current = false;
            return;
          }

          const fetchUrl = queryParamsStr ? `/api/servers/info/${inviteServerId}?${queryParamsStr}` : `/api/servers/info/${inviteServerId}`;
          const res = await apiFetch(fetchUrl);

          if (res.ok) {
            const liveServer = await res.json();
            await handleJoinServerFromInvite(liveServer, queryParamsStr, code);
          } else {
            const errData = await res.json().catch(() => ({}));
            alert(errData.error || 'Failed to resolve the invitation link. This link may have expired or reached its usage limit.');
          }
        } catch (err) {
          console.error('Error auto-joining server from pending invite:', err);
        } finally {
          processingInviteRef.current = false;
        }
      };

      processInvite();
    } catch (e) {
      console.error('Error parsing pending invite:', e);
      sessionStorage.removeItem('vylant_pending_invite');
    }
  }, [showApp, userName]);

  const availableCustomEmojis = useMemo(() => {
    return servers
      .filter(s => s.members?.some(m => m.name === userName) || s.ownerId === userName)
      .flatMap(s => s.emojis || [])
      .map(e => ({
        id: e.id,
        unified: e.id,
        names: [e.name],
        imgUrl: e.url
      }));
  }, [servers, userName]);

  const allRawEmojis = useMemo(() => {
    const serverEmojis = servers
      .filter(s => s.members?.some(m => m.name === userName) || s.ownerId === userName)
      .flatMap(s => s.emojis || []);
    const combined = [...serverEmojis];
    DEFAULT_CUSTOM_EMOJIS.forEach(def => {
      if (!combined.some(e => e.id === def.id || e.name === def.name)) {
        combined.push(def);
      }
    });
    return combined;
  }, [servers, userName]);

  const handleRequestData = useCallback(() => {
    const data = {
      userName,
      isDarkMode,
      friends,
      servers,
      blockedUsers,
      settings: {
        allowDirectMessages,
        allowIncomingFriendRequests,
        allowDataCollection,
        desktopNotifications,
        soundNotifications,
        emailNotifications,
        friendNotifications,
        masterVolume,
      }
    };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `vylant_data_${userName}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    triggerNotification('Data Requested', 'Your data file has been downloaded.', 'success');
  }, [userName, isDarkMode, friends, servers, blockedUsers, allowDirectMessages, allowIncomingFriendRequests, allowDataCollection, desktopNotifications, soundNotifications, emailNotifications, friendNotifications, masterVolume]);

  const handleUnblockUser = useCallback(async (user: {id: string, name: string, image: string}) => {
    if (!user || !user.name) {
      alert("Cannot unblock: User information is missing.");
      return;
    }
    try {
      const res = await apiFetch('/api/unblock', {
        method: 'POST',
        body: JSON.stringify({ targetName: user.name })
      });
      if (res.ok) {
        setBlockedUsers(prev => prev.filter(u => u.name !== user.name));
      } else {
        const data = await res.json();
        alert(data.error || "Failed to unblock user");
      }
    } catch (e) {
      console.error("Error unblocking user:", e);
    }
  }, []);

  useEffect(() => {
    if (!showApp || !userName) return;

    const refreshUserData = async () => {
      const token = localStorage.getItem('vylant_token') || sessionStorage.getItem('vylant_token');
      if (!token || !userName || userName === 'T0AI User') return;

      try {
        // 1. Sync local accounts to the server
        const storedAccounts = localStorage.getItem('vylant_accounts');
        if (storedAccounts) {
          const parsedAccounts = JSON.parse(storedAccounts);
          const usersToSync = Object.keys(parsedAccounts).map(username => ({
            id: username,
            name: username,
            image: localStorage.getItem(`vylant_user_image_${username}`) || 'https://i.imgur.com/zp6R930.png'
          }));
          try {
            await apiFetch('/api/sync-users', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ users: usersToSync })
            });
          } catch(e: any) { 
            if (e.name !== 'TypeError' && e.message !== 'Failed to fetch') {
              console.error('Failed to sync users:', e); 
            }
          }
        }

        // 2. Register/heartbeat this user
        try {
          await apiFetch('/api/users', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              id: userName,
              name: userName,
              image: userImage,
              status: userStatus,
              customStatus: customStatus,
              allowIncomingFriendRequests: allowIncomingFriendRequests,
              lastUpdated: Date.now()
            })
          });
        } catch(e: any) { 
          if (e.name !== 'TypeError' && e.message !== 'Failed to fetch') {
            console.error('Failed to heartbeat:', e); 
          }
        }

        // 3. Sync servers and 4. Fetch all users
        try {
          const [serversRes, usersRes] = await Promise.all([
            apiFetch(`/api/servers?userId=${encodeURIComponent(userName)}`),
            apiFetch(`/api/users?requestingUser=${encodeURIComponent(userName)}`)
          ]);

          if (serversRes.ok && usersRes.ok) {
            let remoteServers;
            let users;
            try {
              remoteServers = await serversRes.json();
              users = await usersRes.json();
            } catch (jsonErr) {
              console.error('Failed to parse sync JSON:', jsonErr);
              return;
            }
            
            setVylantUsers(prev => {
              if (prev.length !== users.length) return users;
              const hasChanges = users.some((u: any) => {
                const p = prev.find((pu: any) => pu.name === u.name);
                return !p || p.status !== u.status || p.image !== u.image || p.customStatus !== u.customStatus;
              });
              return hasChanges ? users : prev;
            });
            
            // Update friends statuses
            setFriends(prev => {
              let hasChanges = false;
              const newFriends = prev.map(friend => {
                const updatedUser = users.find((u: any) => u.name === friend.name);
                if (updatedUser && (friend.status !== updatedUser.status || friend.image !== updatedUser.image || friend.customStatus !== updatedUser.customStatus)) {
                  hasChanges = true;
                  return { ...friend, status: updatedUser.status, image: updatedUser.image, customStatus: updatedUser.customStatus };
                }
                return friend;
              });
              return hasChanges ? newFriends : prev;
            });

            // Update recent DMs statuses
            setRecentDMs(prev => {
              let hasChanges = false;
              const newDMs = prev.map(dm => {
                const updatedUser = users.find((u: any) => u.name === dm.name);
                if (updatedUser && (dm.status !== updatedUser.status || dm.image !== updatedUser.image || dm.customStatus !== updatedUser.customStatus)) {
                  hasChanges = true;
                  return { ...dm, status: updatedUser.status, image: updatedUser.image, customStatus: updatedUser.customStatus };
                }
                return dm;
              });
              return hasChanges ? newDMs : prev;
            });
            
            setServers(prev => {
              let hasChanges = false;
              let currentServers = [...prev];

              const flattenServers = (sLists: Server[]): Server[] => {
                let flat: Server[] = [];
                sLists.forEach(s => {
                  flat.push(s);
                  if (s.isFolder && s.servers) {
                    flat = flat.concat(flattenServers(s.servers));
                  }
                });
                return flat;
              };

              const allCurrentServers = flattenServers(currentServers);
              
              // 1. Add/Update servers from remote
              const remoteIds = new Set((remoteServers || []).map((s: any) => s.id));
              
              // 1.5. Sync local-only owned servers back to the backend if missing
              const orphanedOwnedServers = serversRef.current.filter(s => 
                s.ownerId === userName && !remoteIds.has(s.id) && !s.isFolder
              );
              if (orphanedOwnedServers.length > 0) {
                console.log('Restoring orphaned owned servers:', orphanedOwnedServers.map(s => s.name));
                apiFetch('/api/servers', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ servers: serversRef.current })
                }).catch(e => console.error('Failed to re-sync orphaned servers', e));
              }

              // Add missing servers/folders
              if (remoteServers && remoteServers.length > 0) {
                remoteServers.forEach((remote: any) => {
                  if (!allCurrentServers.find(s => s.id === remote.id)) {
                    currentServers.push(remote);
                    hasChanges = true;
                  }
                });
              }

              // Remove local servers that are no longer in remoteServers (user left them)
              // We go through top-level and children
              const filterRemote = (sList: Server[]): Server[] => {
                return sList.map(s => {
                  if (s.isFolder && s.servers) {
                    const filteredSub = filterRemote(s.servers);
                    if (filteredSub.length !== s.servers.length) {
                      hasChanges = true;
                      return filteredSub.length === 0 ? null : { ...s, servers: filteredSub };
                    }
                  } else if (!remoteIds.has(s.id)) {
                    // Safety check: Don't auto-remove verified, official, or OWNED servers during sync
                    // unless we are sure they were explicitly left (handled by leave-server emit)
                    if (s.ownerId === userName) {
                      return s;
                    }
                    hasChanges = true;
                    return null;
                  }
                  return s;
                }).filter(Boolean) as Server[];
              };

              const cleanedServers = filterRemote(currentServers);
              if (cleanedServers.length !== currentServers.length || hasChanges) {
                currentServers = cleanedServers;
                hasChanges = true;
              }

              // 2. Update members in all servers
              const updateServerMembers = (serversList: Server[]): Server[] => {
                return serversList.map(server => {
                  if (server.isFolder && server.servers) {
                    const updatedSubServers = updateServerMembers(server.servers);
                    if (updatedSubServers !== server.servers) {
                      return { ...server, servers: updatedSubServers };
                    }
                    return server;
                  }
                  
                  if (!server.members) return server;
                  
                  const newMembers = [...server.members];
                  let serverHasChanges = false;
                  
                  users.forEach((u: any) => {
                    const existingIdx = newMembers.findIndex(m => m.name === u.name);
                    if (existingIdx !== -1) {
                      const existing = newMembers[existingIdx];
                      // Optimize: only update if visible data changed (exclude lastUpdated to prevent flickering)
                      if (existing.image !== u.image || existing.status !== u.status || existing.customStatus !== u.customStatus) {
                        newMembers[existingIdx] = { ...existing, image: u.image, status: u.status, customStatus: u.customStatus || '' };
                        serverHasChanges = true;
                      }
                    }

                  });
                  
                  if (serverHasChanges) {
                    hasChanges = true;
                    return { ...server, members: newMembers };
                  }
                  return server;
                });
              };

              const updatedServers = updateServerMembers(currentServers);
              return hasChanges ? updatedServers : prev;
            });
          }
        } catch(e: any) { 
          if (e.name !== 'TypeError' && e.message !== 'Failed to fetch') {
            console.error('Failed to sync data:', e); 
          }
        }

      } catch (err: any) {
        if (err.message === 'Failed to fetch' || err.name === 'TypeError') {
          // Ignore network errors during server restarts or navigation
          return;
        }
        console.error('Failed to refresh user data:', err);
      }
    };

    refreshUserData();
    const interval = setInterval(refreshUserData, 5000); // Poll every 5 seconds

    // Fetch direct messages
    const fetchMessages = async () => {
      const token = localStorage.getItem('vylant_token') || sessionStorage.getItem('vylant_token');
      if (!token || !userName || userName === 'T0AI User') return;

      try {
        const res = await apiFetch(`/api/messages?user=${encodeURIComponent(userName)}`, {
          headers: { 'Accept': 'application/json' }
        });
        if (!res.ok) throw new Error('Failed to fetch messages');
        let messages;
        try {
          messages = await res.json();
        } catch (jsonErr) {
          console.error('Failed to parse messages JSON:', jsonErr);
          return;
        }
        
        // Filter messages based on privacy settings if needed
        let filteredMessages = messages;
        if (!allowDirectMessagesRef.current) {
          filteredMessages = messages.filter(m => {
            const otherPerson = m.sender === userName ? m.receiver : m.sender;
            const isFriend = friendsRef.current.some(f => f.name === otherPerson);
            return isFriend || m.sender === userName; // Always show my own messages
          });
        }
        
        let usersList: any[] = [];
        try {
          const usersRes = await apiFetch('/api/users');
          if (usersRes.ok) {
            try {
              usersList = await usersRes.json();
            } catch (jsonErr) {
              console.error('Failed to parse users (fetchMessages) JSON:', jsonErr);
            }
          }
        } catch (e) {}

        setDmMessages(prev => {
          const newDmMessages: Record<string, Message[]> = { ...prev };
          let changed = false;

          // Group messages by other person
          const incomingMessagesByPerson: Record<string, Message[]> = {};
          filteredMessages.forEach(m => {
            const otherPerson = m.sender === userName ? m.receiver : m.sender;
            if (!incomingMessagesByPerson[otherPerson]) {
              incomingMessagesByPerson[otherPerson] = [];
            }
            incomingMessagesByPerson[otherPerson].push(m);
          });

          // Sync recentDMs across devices: if we see messages with a new person, add them to our recent list
          const existingRecentNames = new Set(recentDMsRef.current.map(dm => dm.name));
          let recentDMsChanged = false;
          const updatedRecentDMs = [...recentDMsRef.current];

          Object.keys(incomingMessagesByPerson).forEach(personName => {
            if (!existingRecentNames.has(personName)) {
              if (personName === 'T0AI Assistant') {
                updatedRecentDMs.unshift({
                  id: BOT_PROFILE.id,
                  name: BOT_PROFILE.name,
                  image: BOT_PROFILE.image,
                  status: BOT_PROFILE.status as any,
                  lastMessage: incomingMessagesByPerson[personName][incomingMessagesByPerson[personName].length - 1].text,
                  timestamp: incomingMessagesByPerson[personName][incomingMessagesByPerson[personName].length - 1].timestamp
                });
                recentDMsChanged = true;
              } else {
                const personUser = usersList.find(u => u.name === personName);
                updatedRecentDMs.unshift({
                  id: personUser?.id || personName,
                  name: personName,
                  image: personUser?.avatar || personUser?.image || getRandomAvatar(personName),
                  status: personUser?.status || 'offline',
                  lastMessage: incomingMessagesByPerson[personName][incomingMessagesByPerson[personName].length - 1].text,
                  timestamp: incomingMessagesByPerson[personName][incomingMessagesByPerson[personName].length - 1].timestamp
                });
                recentDMsChanged = true;
              }
            }
          });

          if (recentDMsChanged) {
            setRecentDMs(updatedRecentDMs.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0)));
          }

          // Update existing DM conversations
          const allPeople = new Set([...Object.keys(incomingMessagesByPerson), ...Object.keys(prev)]);
          allPeople.forEach(otherPerson => {
            const incoming = incomingMessagesByPerson[otherPerson] || [];
            const existing = prev[otherPerson] || [];
            
            // Check if any messages were added or removed
            const existingMap = new Map<string, Message>(existing.map((m: any) => [m.id, m]));
            const existingIds = new Set(existingMap.keys());
            const incomingIds = new Set(incoming.map((m: any) => m.id));
            
            const added = incoming.some((m: any) => !existingIds.has(m.id));
            const removed = existing.some((m: any) => !incomingIds.has(m.id));
            
            // Also check for content changes (starred status or text edits)
            const contentChanged = incoming.some((m: any) => {
              const existingMsg = existingMap.get(m.id);
              if (!existingMsg) return false;
              return (existingMsg as any).isStarred !== m.isStarred || 
                     (existingMsg as any).isEdited !== m.isEdited || 
                     (existingMsg as any).text !== m.text ||
                     JSON.stringify((existingMsg as any).starredBy || []) !== JSON.stringify(m.starredBy || []);
            });
            
            if (added || contentChanged || (incoming.length > 0 && removed)) {
              if (incoming.length > 0) {
                // Merge with existing but prefer incoming for overlapping ones
                const mergedMap = new Map<string, Message>(existingMap);
                incoming.forEach((m: any) => mergedMap.set(m.id, m as Message));
                
                newDmMessages[otherPerson] = Array.from(mergedMap.values())
                  .filter((m: Message) => !deletedMessageIdsRef.current.has(m.id))
                  .sort((a, b) => ((a as any).timestamp || 0) - ((b as any).timestamp || 0));
                
                // If we got exactly 100 (or close to it) from server, there's likely more
                if (incoming.length >= 100) {
                  setHasMoreMessages(prev => ({ ...prev, [otherPerson]: true }));
                }
              }
              changed = true;
              
              // Handle unread counts and recent DMs for added messages
              incoming.forEach(m => {
                const msgKey = `dm:${otherPerson}:${m.id}`;
                if (!handledNotificationIdsRef.current.has(msgKey) && !handledNotificationIdsRef.current.has(m.id)) {
                  handledNotificationIdsRef.current.add(msgKey);
                  handledNotificationIdsRef.current.add(m.id);
                }
                if (!existingIds.has(m.id)) {
                  setRecentDMs(prevDMs => {
                    if (otherPerson !== 'System' && !prevDMs.find(dm => dm.name === otherPerson)) {
                      const userData = usersList.find(u => u.name === otherPerson);
                      return [{
                        id: userData?.id || `dm-${otherPerson}`,
                        name: otherPerson,
                        image: userData?.image || 'https://i.imgur.com/zp6R930.png',
                        status: userData?.status || 'offline',
                        customStatus: userData?.customStatus || '',
                        timestamp: m.timestamp || Date.now()
                      }, ...prevDMs];
                    }
                    return prevDMs;
                  });
                }
              });
            }
          });

          // Also check if any conversations were completely removed (all messages deleted)
          // But we probably want to keep the conversation header even if empty, so maybe skip this.

          return changed ? newDmMessages : prev;
        });
      } catch (err: any) {
        if (err.message === 'Failed to fetch' || err.name === 'TypeError' || err.message === 'Failed to fetch messages') {
          // Ignore network errors and expected failures during polling or restarts
          return;
        }
        console.error('Failed to fetch messages:', err);
      }
    };

    fetchMessages();
    const msgInterval = setInterval(fetchMessages, 3000); // Poll messages every 3 seconds

    return () => {
      clearInterval(interval);
      clearInterval(msgInterval);
    };
  }, [showApp, userName, userImage, userStatus, customStatus]);
  const [isAddServerModalOpen, setIsAddServerModalOpen] = useState(false);
  const [addServerStep, setAddServerStep] = useState<'choice' | 'create' | 'join'>('choice');
  const [inviteCode, setInviteCode] = useState('');
  const [isResolvingInvite, setIsResolvingInvite] = useState(false);
  const [joinServerError, setJoinServerError] = useState<string | null>(null);
  const [newServerName, setNewServerName] = useState('');
  const [newServerDescription, setNewServerDescription] = useState('');
  const [newServerImage, setNewServerImage] = useState<string | null>(null);
  const [newServerIs18Plus, setNewServerIs18Plus] = useState(false);
  const [newServerIsPublic, setNewServerIsPublic] = useState(false);
  const [isInviteModalOpen, setIsInviteModalOpen] = useState(false);
  const [inviteModalServerId, setInviteModalServerId] = useState<string | null>(null);
  const [sentInvites, setSentInvites] = useState<string[]>([]);
  const [copiedLink, setCopiedLink] = useState(false);
  const [inviteExpiry, setInviteExpiry] = useState<string>('never');
  const [inviteMaxUses, setInviteMaxUses] = useState<string>('unlimited');
  const [inviteCodeSuffix, setInviteCodeSuffix] = useState<string>('');

  useEffect(() => {
    if (inviteModalServerId) {
      const code = Math.random().toString(36).substring(2, 8).toUpperCase();
      setInviteCodeSuffix(code);

      let expiresAt: number | undefined;
      if (inviteExpiry !== 'never') {
        let durationMs = 0;
        if (inviteExpiry === '30m') durationMs = 30 * 60 * 1000;
        else if (inviteExpiry === '1h') durationMs = 60 * 60 * 1000;
        else if (inviteExpiry === '6h') durationMs = 6 * 60 * 60 * 1000;
        else if (inviteExpiry === '24h') durationMs = 24 * 60 * 60 * 1000;
        expiresAt = Math.floor(Date.now() / 10000) * 10000 + durationMs;
      }

      apiFetch(`/api/servers/${inviteModalServerId}/invites`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          code,
          expiresAt: expiresAt || -1,
          maxUses: inviteMaxUses !== 'unlimited' ? parseInt(inviteMaxUses, 10) : -1
        })
      }).catch(err => console.warn('Failed to register invite code with backend', err));
    }
  }, [inviteModalServerId, inviteExpiry, inviteMaxUses]);

  const modalInviteLink = useMemo(() => {
    if (!inviteModalServerId || !inviteCodeSuffix) return '';
    let url = `${window.location.origin}?invite=${inviteModalServerId}&code=${inviteCodeSuffix}`;
    if (inviteExpiry !== 'never') {
      let durationMs = 0;
      if (inviteExpiry === '30m') durationMs = 30 * 60 * 1000;
      else if (inviteExpiry === '1h') durationMs = 60 * 60 * 1000;
      else if (inviteExpiry === '6h') durationMs = 6 * 60 * 60 * 1000;
      else if (inviteExpiry === '24h') durationMs = 24 * 60 * 60 * 1000;
      
      const roundedNow = Math.floor(Date.now() / 10000) * 10000;
      url += `&expires=${roundedNow + durationMs}`;
    }
    if (inviteMaxUses !== 'unlimited') {
      url += `&maxUses=${inviteMaxUses}`;
    }
    return url;
  }, [inviteModalServerId, inviteExpiry, inviteMaxUses, inviteCodeSuffix]);

  const modalInviteAppLink = useMemo(() => {
    if (!modalInviteLink) return '';
    return modalInviteLink.replace(window.location.origin + '?', 'vylant://invite?');
  }, [modalInviteLink]);

  const [showOpenInAppModal, setShowOpenInAppModal] = useState(false);
  const [pendingInviteModalData, setPendingInviteModalData] = useState<{ inviteServerId: string; expires?: string | null; maxUses?: string | null; code?: string | null } | null>(null);
  const [alwaysOpenInApp, setAlwaysOpenInApp] = useState(() => localStorage.getItem('vylant_always_open_app') === 'true');
  const [copiedSettingsAppLink, setCopiedSettingsAppLink] = useState(false);
  const [copiedAppLink, setCopiedAppLink] = useState(false);
  const [serverToConfirmJoin, setServerToConfirmJoin] = useState<{ server: Server; queryParamsStr?: string; code?: string } | null>(null);
  const [isJoiningServerModal, setIsJoiningServerModal] = useState(false);
  
  const allUsersInServers = useMemo(() => {
    const users: User[] = [];
    const seen = new Set<string>();

    const traverseServers = (serverList: Server[]) => {
      serverList.forEach(s => {
        if (s.isFolder && s.servers) {
          traverseServers(s.servers);
        } else {
          s.members?.forEach(m => {
            if (m.name !== userName && !seen.has(m.name)) {
              users.push(m);
              seen.add(m.name);
            }
          });
        }
      });
    };
    traverseServers(servers);
    return users;
  }, [servers, userName]);
  
  const [contextMenu, setContextMenu] = useState<{ x: number, y: number, serverId: string } | null>(null);
  const [userContextMenu, setUserContextMenu] = useState<{ x: number, y: number, userName: string, userImage: string } | null>(null);
  const inputContextMenuTargetRef = useRef<HTMLInputElement | HTMLTextAreaElement | null>(null);
  const [inputContextMenu, setInputContextMenu] = useState<{ x: number, y: number, hasSelection: boolean, isPassword: boolean, hasText: boolean } | null>(null);
  const [toast, setToast] = useState<{ message: string; type: 'info' | 'error' | 'success' } | null>(null);

  const showToast = useCallback((message: string, type: 'info' | 'error' | 'success' = 'info') => {
    setToast({ message, type });
  }, []);

  useEffect(() => {
    if (toast) {
      const timer = setTimeout(() => {
        setToast(null);
      }, 5000);
      return () => clearTimeout(timer);
    }
  }, [toast]);

  const [forwardModalMessage, setForwardModalMessage] = useState<Message | null>(null);
  const [forwardSourceContext, setForwardSourceContext] = useState<string>('');

  const handleInitiateForward = (msg: Message, customContext?: string) => {
    let source = customContext;
    if (!source) {
      if (activeView === 'server' && activeServer) {
        const s = servers.find(srv => srv.id === activeServer);
        const c = s?.channels?.find((ch: any) => ch.id === activeChannel);
        source = c?.name ? `#${c.name} (${s?.name || 'Server'})` : (s?.name || 'Server Channel');
      } else if (activeDM) {
        const groupChat = groupChats.find(gc => gc.name === activeDM);
        if (groupChat) {
          source = groupChat.name;
        } else {
          source = `@${activeDM}`;
        }
      } else if (activeView === 'home') {
        source = 'Vylant Assistant';
      } else {
        source = msg.sender ? `@${msg.sender}` : 'Chat';
      }
    }
    setForwardSourceContext(source);
    setForwardModalMessage(msg);
  };

  const handleSendForward = (target: ForwardTarget, originalMsg: Message, commentText?: string) => {
    const sourceName = (originalMsg.isForwarded && originalMsg.forwardedFrom)
      ? originalMsg.forwardedFrom
      : (forwardSourceContext || (originalMsg.sender ? `@${originalMsg.sender}` : 'Chat'));

    const forwardedMsg: Message = {
      id: `msg-${Date.now()}-${Math.random().toString(36).substring(2, 7)}`,
      sender: userName,
      senderImage: userImage,
      text: originalMsg.text || '',
      image: originalMsg.image,
      audio: originalMsg.audio,
      video: originalMsg.video,
      file: originalMsg.file,
      fileName: originalMsg.fileName,
      fileSize: originalMsg.fileSize,
      attachments: originalMsg.attachments,
      audioDuration: originalMsg.audioDuration,
      poll: originalMsg.poll,
      timestamp: Date.now(),
      type: 'user',
      isForwarded: true,
      forwardedFrom: sourceName
    };

    if (target.type === 'server' && target.channelId && socketRef.current) {
      socketRef.current.emit('send-server-message', {
        serverId: target.targetId,
        channelId: target.channelId,
        message: forwardedMsg
      });
      setServerMessages(prev => {
        const sMap = prev[target.targetId] || {};
        const cMsgs = sMap[target.channelId!] || [];
        return {
          ...prev,
          [target.targetId]: {
            ...sMap,
            [target.channelId!]: [...cMsgs, forwardedMsg]
          }
        };
      });
      if (commentText) {
        const commentMsg: Message = {
          id: `msg-${Date.now() + 1}-${Math.random().toString(36).substring(2, 7)}`,
          sender: userName,
          senderImage: userImage,
          text: commentText,
          timestamp: Date.now() + 1,
          type: 'user'
        };
        socketRef.current.emit('send-server-message', {
          serverId: target.targetId,
          channelId: target.channelId,
          message: commentMsg
        });
        setServerMessages(prev => {
          const sMap = prev[target.targetId] || {};
          const cMsgs = sMap[target.channelId!] || [];
          return {
            ...prev,
            [target.targetId]: {
              ...sMap,
              [target.channelId!]: [...cMsgs, commentMsg]
            }
          };
        });
      }
    } else if (target.type === 'group' && socketRef.current) {
      socketRef.current.emit('send-group-chat-message', {
        groupId: target.targetId,
        message: forwardedMsg
      });
      setDmMessages(prev => ({
        ...prev,
        [target.displayName]: [...(prev[target.displayName] || []), forwardedMsg]
      }));
      if (commentText) {
        const commentMsg: Message = {
          id: `msg-${Date.now() + 1}-${Math.random().toString(36).substring(2, 7)}`,
          sender: userName,
          senderImage: userImage,
          text: commentText,
          timestamp: Date.now() + 1,
          type: 'user'
        };
        socketRef.current.emit('send-group-chat-message', {
          groupId: target.targetId,
          message: commentMsg
        });
        setDmMessages(prev => ({
          ...prev,
          [target.displayName]: [...(prev[target.displayName] || []), commentMsg]
        }));
      }
    } else if (target.type === 'dm' && socketRef.current) {
      socketRef.current.emit('send-dm-message', {
        receiver: target.targetId,
        message: forwardedMsg
      });
      setDmMessages(prev => ({
        ...prev,
        [target.targetId]: [...(prev[target.targetId] || []), forwardedMsg]
      }));
      if (commentText) {
        const commentMsg: Message = {
          id: `msg-${Date.now() + 1}-${Math.random().toString(36).substring(2, 7)}`,
          sender: userName,
          senderImage: userImage,
          text: commentText,
          timestamp: Date.now() + 1,
          type: 'user'
        };
        socketRef.current.emit('send-dm-message', {
          receiver: target.targetId,
          message: commentMsg
        });
        setDmMessages(prev => ({
          ...prev,
          [target.targetId]: [...(prev[target.targetId] || []), commentMsg]
        }));
      }
    }

    showToast(`Forwarded message to ${target.displayName}`, 'success');
  };

  useEffect(() => {
    const handleGlobalContextMenu = (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      if (!target) return;

      const inputTarget = target.closest('input, textarea') as HTMLInputElement | HTMLTextAreaElement | null;
      if (inputTarget) {
        const type = inputTarget.type || 'text';
        if (['text', 'search', 'url', 'tel', 'email', 'password', 'number'].includes(type) || inputTarget.tagName === 'TEXTAREA') {
          e.preventDefault();
          inputContextMenuTargetRef.current = inputTarget;
          const hasSelection = inputTarget.selectionStart !== null && inputTarget.selectionEnd !== null && inputTarget.selectionStart !== inputTarget.selectionEnd;
          const isPassword = inputTarget.type === 'password';
          const hasText = (inputTarget.value || '').length > 0;
          setInputContextMenu({
            x: e.clientX,
            y: e.clientY,
            hasSelection,
            isPassword,
            hasText
          });
          return;
        }
      }

      // If user has text selected in the document, allow the native browser context menu (Copy, etc.)
      const docSelection = window.getSelection()?.toString();
      if (docSelection && docSelection.trim().length > 0) {
        return;
      }

      e.preventDefault();
    };
    document.addEventListener('contextmenu', handleGlobalContextMenu);

    return () => {
      document.removeEventListener('contextmenu', handleGlobalContextMenu);
    };
  }, [setInputContextMenu]);
  
  const fetchPresets = useCallback(async () => {
    setIsPresetsLoading(true);
    try {
      const res = await apiFetch('/api/presets');
      if (res.ok) {
        const data = await res.json();
        setPresets(data);
      }
    } catch (err) {
      console.error('Failed to fetch presets:', err);
    } finally {
      setIsPresetsLoading(false);
    }
  }, []);

  const savePreset = async (name: string, isPublic: boolean) => {
    const newPreset = {
      id: generateId(),
      name,
      config: {
        customTheme,
        customThemeColor,
        accentColor,
        fontSize,
        isDarkMode
      },
      isPublic
    };

    try {
      const res = await apiFetch('/api/presets', {
        method: 'POST',
        body: JSON.stringify(newPreset)
      });
      if (res.ok) {
        alert('Preset saved successfully!');
        fetchPresets();
      } else {
        alert('Failed to save preset.');
      }
    } catch (err) {
      console.error('Failed to save preset:', err);
    }
  };

  const deletePreset = async (id: string) => {
    try {
      const res = await apiFetch(`/api/presets/${id}`, {
        method: 'DELETE'
      });
      if (res.ok) {
        fetchPresets();
      }
    } catch (err) {
      console.error('Failed to delete preset:', err);
    }
  };

  const applyPreset = async (preset: Preset) => {
    setCustomTheme(preset.config.customTheme as any);
    setCustomThemeColor(preset.config.customThemeColor);
    setAccentColor(preset.config.accentColor);
    setFontSize(preset.config.fontSize);
    setIsDarkMode(preset.config.isDarkMode);

    if (preset.isPublic) {
      apiFetch('/api/presets/download', {
        method: 'POST',
        body: JSON.stringify({ presetId: preset.id })
      }).catch(console.error);
    }
  };

  const handleUserContextMenu = useCallback((e: React.MouseEvent, userName: string) => {
    e.preventDefault();
    e.stopPropagation();
    
    let x = e.clientX;
    let y = e.clientY;
    
    if (x + 260 > window.innerWidth) x = window.innerWidth - 260;
    if (y + 450 > window.innerHeight) y = Math.max(16, window.innerHeight - 480);

    const userImage = getTargetImage(userName);

    setUserContextMenu({ x, y, userName, userImage });
  }, []);
  const [serverToLeave, setServerToLeave] = useState<Server | null>(null);
  const [isLeaveModalOpen, setIsLeaveModalOpen] = useState(false);
  const [openFolders, setOpenFolders] = useState<string[]>([]);
  const [folderSettings, setFolderSettings] = useState<Server | null>(null);
