  serverMarketplaceSettings,
  setServerMarketplaceSettings,
  serverAutoModEnabled,
  setServerAutoModEnabled,
  serverCustomBlockedWords,
  setServerCustomBlockedWords,
  newBlockedWordInput,
  setNewBlockedWordInput,
  onSave,
  isDarkMode,
  isOwner,
  onDeleteServer,
  onLeaveServer,
  onReorderChannels,
  onEditChannel,
  onUnban,
  setCropTarget,
  setCropImageSrc,
  setIsCropModalOpen,
  onUpdateServer,
  userName,
  userAge,
