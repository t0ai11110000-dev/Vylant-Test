const StatusIndicator = ({ status, size = "sm" }: { status: UserStatus, size?: "xs" | "sm" | "md" }) => {
  const sizeClass = size === "xs" ? "w-2.5 h-2.5" : size === "sm" ? "w-4 h-4" : "w-5 h-5";
  const iconSize = size === "xs" ? 8 : size === "sm" ? 10 : 12;

  switch (status) {
    case 'online':
      return (
        <div className={`${sizeClass} bg-emerald-500 border-2 border-vylant-navy rounded-full flex items-center justify-center shadow-[0_0_10px_rgba(16,185,129,0.5)]`} />
      );
    case 'idle':
      return (
        <div className={`${sizeClass} bg-amber-400 border-2 border-vylant-navy rounded-full flex items-center justify-center shadow-[0_0_10px_rgba(251,191,36,0.5)]`}>
          {size !== 'xs' && <div className="w-1.5 h-1.5 rounded-full bg-vylant-navy" />}
        </div>
      );
    case 'dnd':
      return (
        <div className={`${sizeClass} bg-red-500 border-2 border-vylant-navy rounded-full flex items-center justify-center shadow-[0_0_10px_rgba(239,68,68,0.5)]`}>
          <X size={iconSize} className="text-white" strokeWidth={3} />
        </div>
      );
    case 'invisible':
      return (
        <div className={`${sizeClass} bg-slate-500 border-2 border-vylant-navy rounded-full flex items-center justify-center shadow-[0_0_10px_rgba(100,116,139,0.5)]`}>
          <Ghost size={iconSize} className="text-white" />
        </div>
      );
    case 'offline':
      return (
        <div className={`${sizeClass} bg-slate-600 border-2 border-vylant-navy rounded-full flex items-center justify-center`} />
      );
    default:
      return null;
  }
};

const RenderSupporterBadge = ({ user, size = 10 }: { user?: User; size?: number }) => {
  if (!user || !user.isPremium) return null;
  const badgeId = user.preferences?.supporterBadge || 'crown';
  if (badgeId === 'none' || badgeId === 'hidden' || user.preferences?.hideSupporterBadge) return null;
  
  let label = "Vylant Supporter";
  let icon = <Crown size={size} className="fill-amber-400/20 animate-pulse text-amber-400" />;
  let badgeStyle = "bg-amber-500/10 text-amber-500 border border-amber-500/20";
  
  if (badgeId === 'sparkle') {
    label = "Supporter Supernova";
    icon = <Sparkles size={size} className="animate-pulse text-cyan-400 fill-cyan-400/10" />;
    badgeStyle = "bg-cyan-500/10 text-cyan-400 border border-cyan-500/20";
  } else if (badgeId === 'diamond') {
    label = "Supporter Diamond";
    icon = <Gem size={size} className="text-pink-400 fill-pink-400/10" />;
    badgeStyle = "bg-pink-500/10 text-pink-400 border border-pink-500/20";
  } else if (badgeId === 'shield') {
    label = "Elite Supporter";
    icon = <Shield size={size} className="text-emerald-400 fill-emerald-400/10" />;
    badgeStyle = "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20";
  } else if (badgeId === 'fire') {
    label = "Fired Up Supporter";
    icon = <Flame size={size} className="text-orange-400 fill-orange-400/10" />;
    badgeStyle = "bg-orange-500/10 text-orange-400 border border-orange-500/20";
  } else if (badgeId === 'heart') {
    label = "Heart Supporter";
    icon = <Heart size={size} className="text-rose-400 fill-rose-400/10 animate-pulse" />;
    badgeStyle = "bg-rose-500/10 text-rose-400 border border-rose-500/20";
  }
  
  return (
    <span 
      className={`inline-flex items-center gap-0.5 px-1 py-0.5 rounded text-[8px] tracking-normal font-mono normal-case ${badgeStyle} shrink-0`} 
      title={label}
    >
      {icon}
      <span>Supporter</span>
    </span>
  );
};

const ImageCropperModal = ({ 
  isOpen, 
  onClose, 
  imageSrc, 
  onSave, 
  isDarkMode,
  cropShape = 'round'
}: { 
  isOpen: boolean, 
  onClose: () => void, 
  imageSrc: string | null, 
  onSave: (croppedImage: string) => void,
  isDarkMode: boolean,
  cropShape?: 'round' | 'rect'
}) => {
  const [crop, setCrop] = useState({ x: 0, y: 0 });
  const [zoom, setZoom] = useState(1);
  const [rotation, setRotation] = useState(0);
  const [croppedAreaPixels, setCroppedAreaPixels] = useState<any>(null);
  const [isProcessing, setIsProcessing] = useState(false);

  if (!isOpen || !imageSrc) return null;

  const isGif = imageSrc.startsWith('data:image/gif') || imageSrc.toLowerCase().endsWith('.gif');

  return createPortal(
    <AnimatePresence>
      <div className="fixed inset-0 z-[99999] flex items-center justify-center p-4">
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          onClick={onClose}
          className="absolute inset-0 bg-black/80 backdrop-blur-sm"
        />
        <motion.div
          initial={{ opacity: 0, scale: 0.95 }}
          animate={{ opacity: 1, scale: 1 }}
          exit={{ opacity: 0, scale: 0.95 }}
          className={`relative w-full max-w-2xl rounded-3xl overflow-hidden shadow-2xl border flex flex-col ${
            isDarkMode ? 'bg-slate-900 border-white/10 text-white' : 'bg-white border-slate-200 text-slate-900'
          }`}
        >
          <div className="p-4 border-b border-white/10 flex justify-between items-center">
            <h2 className="text-lg font-bold">Adjust {isGif ? 'GIF' : 'Image'}</h2>
            <button onClick={onClose} className="p-2 hover:bg-white/10 rounded-full transition-colors">
              <X size={20} />
            </button>
          </div>
          <div className="relative h-[400px] w-full bg-black">
            <Cropper
              image={imageSrc}
              crop={crop}
              zoom={zoom}
              rotation={rotation}
              aspect={1}
              cropShape={cropShape}
              onCropChange={setCrop}
              onZoomChange={setZoom}
              onRotationChange={setRotation}
              onCropComplete={(croppedArea, croppedAreaPixels) => setCroppedAreaPixels(croppedAreaPixels)}
            />
            {isProcessing && (
              <div className="absolute inset-0 bg-black/60 backdrop-blur-sm flex flex-col items-center justify-center z-10">
                <Loader2 className="animate-spin text-vylant-blue mb-4" size={48} />
                <p className="text-white font-bold text-lg">Processing {isGif ? 'GIF' : 'Image'}...</p>
                <p className="text-white/60 text-sm mt-2">This may take a few moments for GIFs</p>
              </div>
            )}
          </div>
          <div className="p-6 flex flex-col gap-4">
            <div className="flex items-center gap-4">
              <span className="text-sm font-medium w-16">Zoom</span>
              <DebouncedRangeInput 
                min={1} 
                max={3} 
                step={0.1} 
                value={zoom} 
                onChange={setZoom} 
                className="flex-1 accent-vylant-blue"
              />
            </div>
            <div className="flex items-center gap-4">
              <span className="text-sm font-medium w-16">Rotate</span>
              <DebouncedRangeInput 
                min={0} 
                max={360} 
                step={1} 
                value={rotation} 
                onChange={setRotation} 
                className="flex-1 accent-vylant-blue"
              />
            </div>
            <div className="flex justify-end gap-3 mt-4">
              <button 
                onClick={onClose}
                disabled={isProcessing}
                className={`px-6 py-2 rounded-xl font-semibold transition-colors ${
                  isDarkMode ? 'hover:bg-white/10 text-white/60 hover:text-white' : 'hover:bg-slate-100 text-slate-500 hover:text-slate-900'
                } disabled:opacity-50`}
              >
                Cancel
              </button>
              <button 
                onClick={async () => {
                  setIsProcessing(true);
                  try {
                    let croppedImage;
                    if (isGif) {
                      croppedImage = await getCroppedGif(imageSrc, croppedAreaPixels, rotation);
                    } else {
                      croppedImage = await getCroppedImg(imageSrc, croppedAreaPixels, rotation);
                    }
                    
                    if (croppedImage) {
                      onSave(croppedImage);
                    }
                  } catch (e) {
                    console.error(e);
                  } finally {
                    setIsProcessing(false);
                  }
                }}
                disabled={isProcessing}
                className="px-6 py-2 bg-vylant-blue text-white rounded-xl font-bold shadow-lg shadow-vylant-blue/20 hover:scale-105 active:scale-95 transition-all disabled:opacity-50 disabled:hover:scale-100 flex items-center gap-2"
              >
                {isProcessing && <Loader2 size={18} className="animate-spin" />}
                {isProcessing ? 'Processing...' : 'Save Image'}
              </button>
            </div>
          </div>
        </motion.div>
      </div>
    </AnimatePresence>,
    document.body
  );
};

const Badge = ({ count, isDarkMode = true, position = '-top-1 -right-1' }: { count: number, isDarkMode?: boolean, position?: string }) => {
  if (count <= 0) return null;
  return (
    <div className={`absolute ${position} bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full border-2 ${isDarkMode ? 'border-[#171e33]' : 'border-white'} min-w-[18px] flex items-center justify-center z-10 pointer-events-none`}>
      {count > 10 ? '10+' : count}
    </div>
  );
};

const CreateChannelModal = ({ 
  isOpen, 
  onClose, 
  onCreate, 
  type, 
  setType, 
  name, 
  setName, 
  isDarkMode,
  isLoading
}: { 
  isOpen: boolean, 
  onClose: () => void, 
  onCreate: () => void, 
  type: 'text' | 'voice' | 'category', 
  setType: (type: 'text' | 'voice' | 'category') => void, 
  name: string, 
  setName: (name: string) => void, 
  isDarkMode: boolean,
  isLoading?: boolean
}) => {
  if (!isOpen) return null;

  return createPortal(
    <div className="fixed inset-0 z-[100] flex items-center justify-center p-4">
      <motion.div 
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        exit={{ opacity: 0 }}
        onClick={onClose}
        className="absolute inset-0 bg-black/60 backdrop-blur-sm"
      />
      <motion.div 
        initial={{ scale: 0.9, opacity: 0, y: 20 }}
        animate={{ scale: 1, opacity: 1, y: 0 }}
        className={`relative w-full max-w-md rounded-3xl p-4 md:p-8 shadow-2xl ${
          isDarkMode ? 'bg-[#14151a] border border-white/10' : 'bg-white'
        }`}
      >
        <div className="flex justify-between items-center mb-6">
          <h2 className={`text-2xl font-bold ${isDarkMode ? 'text-white' : 'text-slate-900'}`}>
            Create {type === 'category' ? 'Category' : 'Channel'}
          </h2>
          <button onClick={onClose} className={`p-2 rounded-full transition-colors ${isDarkMode ? 'hover:bg-white/10 text-white/60' : 'hover:bg-slate-100 text-slate-400'}`}>
            <X size={20} />
          </button>
        </div>

        <div className="space-y-6">
          <div>
            <label className={`block text-xs font-bold uppercase tracking-widest mb-3 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>
              Type
            </label>
            <div className="grid grid-cols-3 gap-3">
              {[
                { id: 'text', label: 'Text', icon: Hash },
                { id: 'voice', label: 'Voice', icon: Volume2 },
                { id: 'category', label: 'Category', icon: LayoutGrid }
              ].map((t) => (
                <button
                  key={t.id}
                  onClick={() => setType(t.id as any)}
                  className={`flex flex-col items-center gap-2 p-4 rounded-2xl border-2 transition-all ${
                    type === t.id 
                      ? 'border-vylant-blue bg-vylant-blue/10 text-vylant-blue' 
                      : isDarkMode ? 'border-white/5 bg-white/5 text-white/40 hover:border-white/20' : 'border-slate-100 bg-slate-50 text-slate-400 hover:border-slate-200'
                  }`}
                >
                  <t.icon size={24} />
                  <span className="text-xs font-bold uppercase tracking-wider">{t.label}</span>
                </button>
              ))}
            </div>
          </div>

          <div>
            <label className={`block text-xs font-bold uppercase tracking-widest mb-3 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>
              {type === 'category' ? 'Category Name' : 'Channel Name'}
            </label>
            <div className="relative">
              <div className="absolute left-4 top-1/2 -translate-y-1/2 text-vylant-blue">
                {type === 'text' ? null : type === 'voice' ? <Volume2 size={18} /> : <LayoutGrid size={18} />}
              </div>
              <input 
                autoFocus
                type="text"
                value={name}
                onChange={(e) => setName(e.target.value)}
                placeholder={type === 'category' ? "New Category" : "new-channel"}
                className={`w-full pl-12 pr-4 py-4 rounded-2xl outline-none transition-all ${
                  isDarkMode 
                    ? 'bg-white/5 border border-white/10 text-white focus:border-vylant-blue/50 focus:bg-white/10' 
                    : 'bg-slate-50 border border-slate-200 text-slate-900 focus:border-vylant-blue/50 focus:bg-white'
                }`}
              />
            </div>
          </div>

          <button 
            onClick={onCreate}
            disabled={!name.trim() || isLoading}
            className="w-full py-4 rounded-2xl bg-vylant-blue text-white font-bold shadow-lg shadow-vylant-blue/20 hover:scale-[1.02] active:scale-[0.98] transition-all disabled:opacity-50 disabled:hover:scale-100 flex items-center justify-center gap-2"
          >
            {isLoading && <Loader2 size={18} className="animate-spin" />}
            Create {type === 'category' ? 'Category' : 'Channel'}
          </button>
        </div>
      </motion.div>
    </div>,
    document.body
  );
};

const CategorySettingsModal = ({
  isOpen,
  onClose,
  category,
  onSave,
  onDelete,
  isDarkMode,
  serverMembers
}: {
  isOpen: boolean;
  onClose: () => void;
  category: Category;
  onSave: (updatedCategory: Category) => void;
  onDelete: (id: string) => void;
  isDarkMode: boolean;
  serverMembers: User[];
}) => {
  const [name, setName] = useState(category?.name || '');
  const [viewPermissions, setViewPermissions] = useState<string[]>(category?.permissions?.view || []);
  const [messagePermissions, setMessagePermissions] = useState<string[]>(category?.permissions?.message || []);

  useEffect(() => {
    if (category) {
      setName(category.name);
      setViewPermissions(category.permissions?.view || []);
      setMessagePermissions(category.permissions?.message || []);
    }
  }, [category]);

  if (!isOpen || !category) return null;

  const togglePermission = (type: 'view' | 'message', userId: string) => {
    if (type === 'view') {
      setViewPermissions(prev => prev.includes(userId) ? prev.filter(id => id !== userId) : [...prev, userId]);
    } else {
      setMessagePermissions(prev => prev.includes(userId) ? prev.filter(id => id !== userId) : [...prev, userId]);
    }
  };

  return createPortal(
    <div className="fixed inset-0 z-[110] flex items-center justify-center p-4">
      <motion.div 
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        exit={{ opacity: 0 }}
        onClick={onClose}
        className="absolute inset-0 bg-black/60 backdrop-blur-sm"
      />
      <motion.div 
        initial={{ scale: 0.9, opacity: 0, y: 20 }}
        animate={{ scale: 1, opacity: 1, y: 0 }}
        className={`relative w-full max-w-2xl rounded-3xl overflow-hidden shadow-2xl flex flex-col h-[600px] ${
          isDarkMode ? 'bg-[#14151a] border border-white/10' : 'bg-white'
        }`}
      >
        <div className="flex justify-between items-center p-6 border-b border-white/5">
          <h2 className={`text-xl font-bold ${isDarkMode ? 'text-white' : 'text-slate-900'}`}>
            Category Settings — {category.name}
          </h2>
          <button onClick={onClose} className={`p-2 rounded-full transition-colors ${isDarkMode ? 'hover:bg-white/10 text-white/60' : 'hover:bg-slate-100 text-slate-400'}`}>
            <X size={20} />
          </button>
        </div>

        <div className="flex-1 overflow-y-auto p-6 space-y-8">
          <div>
            <label className={`block text-xs font-bold uppercase tracking-widest mb-3 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>
              Category Name
            </label>
            <input 
              type="text"
              value={name}
              onChange={(e) => setName(e.target.value)}
              className={`w-full px-4 py-3 rounded-xl outline-none transition-all ${
                isDarkMode 
                  ? 'bg-white/5 border border-white/10 text-white focus:border-vylant-blue/50' 
                  : 'bg-slate-50 border border-slate-200 text-slate-900 focus:border-vylant-blue/50'
              }`}
            />
          </div>

          <div>
            <label className={`block text-xs font-bold uppercase tracking-widest mb-3 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>
              Category Permissions
            </label>
            <p className={`text-sm mb-4 ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>
              These permissions will apply to all channels in this category unless overridden by channel-specific settings.
            </p>
            
            <div className={`rounded-2xl border overflow-hidden ${isDarkMode ? 'border-white/5 bg-white/5' : 'border-slate-100 bg-slate-50'}`}>
              <table className="w-full text-left border-collapse">
                <thead>
                  <tr className={`border-b ${isDarkMode ? 'border-white/5' : 'border-slate-100'}`}>
                    <th className={`p-4 text-[10px] font-bold uppercase tracking-widest ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Member</th>
                    <th className={`p-4 text-[10px] font-bold uppercase tracking-widest text-center ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>View</th>
                    <th className={`p-4 text-[10px] font-bold uppercase tracking-widest text-center ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Message</th>
                  </tr>
                </thead>
                <tbody>
                  {serverMembers.map(member => (
                    <tr key={member.id} className={`border-b last:border-0 ${isDarkMode ? 'border-white/5' : 'border-slate-100'}`}>
                      <td className="p-4">
                        <div className="flex items-center gap-3">
                          <img src={member.image} alt={member.name} className="w-8 h-8 rounded-lg object-cover" />
                          <span className={`text-sm font-medium ${isDarkMode ? 'text-white' : 'text-slate-900'}`}>{member.name}</span>
                        </div>
                      </td>
                      <td className="p-4 text-center">
                        <button 
                          onClick={() => togglePermission('view', member.id)}
                          className={`p-2 rounded-lg transition-all ${
                            viewPermissions.includes(member.id)
                              ? 'bg-vylant-blue text-white'
                              : isDarkMode ? 'bg-white/5 text-white/20 hover:text-white/40' : 'bg-slate-200 text-slate-400 hover:text-slate-600'
                          }`}
                        >
                          <Eye size={16} />
                        </button>
                      </td>
                      <td className="p-4 text-center">
                        <button 
                          onClick={() => togglePermission('message', member.id)}
                          className={`p-2 rounded-lg transition-all ${
                            messagePermissions.includes(member.id)
                              ? 'bg-vylant-blue text-white'
                              : isDarkMode ? 'bg-white/5 text-white/20 hover:text-white/40' : 'bg-slate-200 text-slate-400 hover:text-slate-600'
                          }`}
                        >
                          <MessageSquare size={16} />
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div className={`p-6 border-t flex items-center justify-between ${isDarkMode ? 'border-white/5 bg-white/5' : 'border-slate-100 bg-slate-50'}`}>
          <button 
            onClick={() => onDelete(category.id)}
            className="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-bold text-red-500 hover:bg-red-500/10 transition-colors"
          >
            <Trash2 size={18} />
            Delete Category
          </button>
          <div className="flex gap-3">
            <button 
              onClick={onClose}
              className={`px-6 py-2 rounded-xl text-sm font-bold transition-colors ${
                isDarkMode ? 'text-white/60 hover:text-white hover:bg-white/5' : 'text-slate-500 hover:text-slate-900 hover:bg-slate-100'
              }`}
            >
              Cancel
            </button>
            <button 
              onClick={() => onSave({ ...category, name, permissions: { view: viewPermissions, message: messagePermissions } })}
              className="px-6 py-2 rounded-xl text-sm font-bold bg-vylant-blue text-white shadow-lg shadow-vylant-blue/20 hover:scale-[1.02] active:scale-[0.98] transition-all"
            >
              Save Changes
            </button>
          </div>
        </div>
      </motion.div>
    </div>,
    document.body
  );
};

const ChannelSettingsModal = ({
  isOpen,
  onClose,
  channel,
  server,
  categories,
  onSave,
  onDelete,
  isDarkMode,
  serverMembers
}: {
  isOpen: boolean;
  onClose: () => void;
  channel: Channel | null;
  server: Server | null;
  categories: Category[];
  onSave: (updatedChannel: Channel) => void;
  onDelete: (id: string) => void;
  isDarkMode: boolean;
  serverMembers: User[];
}) => {
  const [name, setName] = useState(channel?.name || '');
  const [categoryId, setCategoryId] = useState<string | undefined>(channel?.categoryId);
  const [viewPermissions, setViewPermissions] = useState<string[]>(channel?.permissions?.view || []);
  const [messagePermissions, setMessagePermissions] = useState<string[]>(channel?.permissions?.message || []);
  const [connectPermissions, setConnectPermissions] = useState<string[]>(channel?.permissions?.connect || []);

  useEffect(() => {
    if (channel) {
      setName(channel.name);
      setCategoryId(channel.categoryId);
      setViewPermissions(channel.permissions?.view || []);
      setMessagePermissions(channel.permissions?.message || []);
      setConnectPermissions(channel.permissions?.connect || []);
    }
  }, [channel]);

  if (!isOpen || !channel || !server) return null;

  const togglePermission = (type: 'view' | 'message' | 'connect', userId: string) => {
    if (type === 'view') {
      setViewPermissions(prev => prev.includes(userId) ? prev.filter(id => id !== userId) : [...prev, userId]);
    } else if (type === 'message') {
      setMessagePermissions(prev => prev.includes(userId) ? prev.filter(id => id !== userId) : [...prev, userId]);
    } else {
      setConnectPermissions(prev => prev.includes(userId) ? prev.filter(id => id !== userId) : [...prev, userId]);
    }
  };

  return createPortal(
    <div className="fixed inset-0 z-[110] flex items-center justify-center p-4">
      <motion.div 
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        exit={{ opacity: 0 }}
        onClick={onClose}
        className="absolute inset-0 bg-black/60 backdrop-blur-sm"
      />
      <motion.div 
        initial={{ scale: 0.9, opacity: 0, y: 20 }}
        animate={{ scale: 1, opacity: 1, y: 0 }}
        className={`relative w-full max-w-2xl rounded-3xl overflow-hidden shadow-2xl flex flex-col h-[600px] ${
          isDarkMode ? 'bg-[#14151a] border border-white/10' : 'bg-white'
        }`}
      >
        <div className="flex justify-between items-center p-6 border-b border-white/5">
          <h2 className={`text-xl font-bold ${isDarkMode ? 'text-white' : 'text-slate-900'}`}>
            Channel Settings — #{channel.name}
          </h2>
          <button onClick={onClose} className={`p-2 rounded-full transition-colors ${isDarkMode ? 'hover:bg-white/10 text-white/60' : 'hover:bg-slate-100 text-slate-400'}`}>
            <X size={20} />
          </button>
        </div>

        <div className="flex-1 overflow-y-auto p-6 space-y-8">
          <div className="grid grid-cols-2 gap-6">
            <div>
              <label className={`block text-xs font-bold uppercase tracking-widest mb-3 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>
                Channel Name
              </label>
              <input 
                type="text"
                value={name}
                onChange={(e) => setName(e.target.value)}
                className={`w-full px-4 py-3 rounded-xl outline-none transition-all ${
                  isDarkMode 
                    ? 'bg-white/5 border border-white/10 text-white focus:border-vylant-blue/50' 
                    : 'bg-slate-50 border border-slate-200 text-slate-900 focus:border-vylant-blue/50'
                }`}
              />
            </div>
            <div>
              <label className={`block text-xs font-bold uppercase tracking-widest mb-3 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>
                Category
              </label>
              <select 
                value={categoryId || ''}
                onChange={(e) => setCategoryId(e.target.value || undefined)}
                className={`w-full px-4 py-3 rounded-xl outline-none transition-all appearance-none ${
                  isDarkMode 
                    ? 'bg-white/5 border border-white/10 text-white focus:border-vylant-blue/50' 
                    : 'bg-slate-50 border border-slate-200 text-slate-900 focus:border-vylant-blue/50'
                }`}
              >
                <option value="">No Category</option>
                {categories.map(cat => (
                  <option key={cat.id} value={cat.id}>{cat.name}</option>
                ))}
              </select>
            </div>
          </div>

          <div>
            <label className={`block text-xs font-bold uppercase tracking-widest mb-3 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>
              Permissions
            </label>
            <p className={`text-sm mb-4 ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>
              Manage who can view, message, or connect in this channel. If no one is selected, everyone can access.
            </p>
            
            <div className={`rounded-2xl border overflow-hidden ${isDarkMode ? 'border-white/5 bg-white/5' : 'border-slate-100 bg-slate-50'}`}>
              <table className="w-full text-left border-collapse">
                <thead>
                  <tr className={`border-b ${isDarkMode ? 'border-white/5' : 'border-slate-100'}`}>
                    <th className={`p-4 text-[10px] font-bold uppercase tracking-widest ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Member</th>
                    <th className={`p-4 text-[10px] font-bold uppercase tracking-widest text-center ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>View</th>
                    <th className={`p-4 text-[10px] font-bold uppercase tracking-widest text-center ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Message</th>
                    {channel.type === 'voice' && (
                      <th className={`p-4 text-[10px] font-bold uppercase tracking-widest text-center ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Connect</th>
                    )}
                  </tr>
                </thead>
                <tbody>
                  {serverMembers.map(member => (
                    <tr key={member.id} className={`border-b last:border-0 ${isDarkMode ? 'border-white/5' : 'border-slate-100'}`}>
                      <td className="p-4">
                        <div className="flex items-center gap-3">
                          <img src={member.image} alt={member.name} className="w-8 h-8 rounded-lg object-cover" />
                          <span className={`text-sm font-medium ${isDarkMode ? 'text-white' : 'text-slate-900'}`}>{member.name}</span>
                        </div>
                      </td>
                      <td className="p-4 text-center">
                        <button 
                          onClick={() => togglePermission('view', member.id)}
                          className={`p-2 rounded-lg transition-all ${
                            viewPermissions.includes(member.id)
                              ? 'bg-vylant-blue text-white'
                              : isDarkMode ? 'bg-white/5 text-white/20 hover:text-white/40' : 'bg-slate-200 text-slate-400 hover:text-slate-600'
                          }`}
                        >
                          <Eye size={16} />
                        </button>
                      </td>
                      <td className="p-4 text-center">
                        <button 
                          onClick={() => togglePermission('message', member.id)}
                          className={`p-2 rounded-lg transition-all ${
                            messagePermissions.includes(member.id)
                              ? 'bg-vylant-blue text-white'
                              : isDarkMode ? 'bg-white/5 text-white/20 hover:text-white/40' : 'bg-slate-200 text-slate-400 hover:text-slate-600'
                          }`}
                        >
                          <MessageSquare size={16} />
                        </button>
                      </td>
                      {channel.type === 'voice' && (
                        <td className="p-4 text-center">
                          <button 
                            onClick={() => togglePermission('connect', member.id)}
                            className={`p-2 rounded-lg transition-all ${
                              connectPermissions.includes(member.id)
                                ? 'bg-vylant-blue text-white'
                                : isDarkMode ? 'bg-white/5 text-white/20 hover:text-white/40' : 'bg-slate-200 text-slate-400 hover:text-slate-600'
                            }`}
                          >
                            <Volume2 size={16} />
                          </button>
                        </td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div className={`p-6 border-t flex items-center justify-between ${isDarkMode ? 'border-white/5 bg-white/5' : 'border-slate-100 bg-slate-50'}`}>
          <button 
            onClick={() => onDelete(channel.id)}
            className="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-bold text-red-500 hover:bg-red-500/10 transition-colors"
          >
            <Trash2 size={18} />
            Delete Channel
          </button>
          <div className="flex gap-3">
            <button 
              onClick={onClose}
              className={`px-6 py-2 rounded-xl text-sm font-bold transition-colors ${
                isDarkMode ? 'text-white/60 hover:text-white hover:bg-white/5' : 'text-slate-500 hover:text-slate-900 hover:bg-slate-100'
              }`}
            >
              Cancel
            </button>
            <button 
              onClick={() => onSave({ ...channel, name, categoryId, permissions: { view: viewPermissions, message: messagePermissions, connect: connectPermissions } })}
              className="px-6 py-2 rounded-xl text-sm font-bold bg-vylant-blue text-white shadow-lg shadow-vylant-blue/20 hover:scale-[1.02] active:scale-[0.98] transition-all"
            >
              Save Changes
            </button>
          </div>
        </div>
      </motion.div>
    </div>,
    document.body
  );
};

const SidebarIcon = ({ id, icon: Icon, label, active = false, expanded = false, isDarkMode = true, onClick, unreadCount = 0 }: { id?: string, icon: any, label: string, active?: boolean, expanded?: boolean, isDarkMode?: boolean, onClick?: () => void, unreadCount?: number }) => {
  const [hovered, setHovered] = useState(false);
  const [rect, setRect] = useState<DOMRect | null>(null);
  const [showTooltip, setShowTooltip] = useState(false);
  const timeoutRef = useRef<NodeJS.Timeout | null>(null);
  const ref = useRef<HTMLDivElement>(null);

  const handleMouseEnter = () => {
    setHovered(true);
    if (ref.current) setRect(ref.current.getBoundingClientRect());
    
    if (timeoutRef.current) clearTimeout(timeoutRef.current);
    const delay = expanded ? 1200 : 100;
    timeoutRef.current = setTimeout(() => {
      setShowTooltip(true);
    }, delay);
  };

  const handleMouseLeave = () => {
    setHovered(false);
    setShowTooltip(false);
    if (timeoutRef.current) clearTimeout(timeoutRef.current);
  };

  return (
    <motion.div 
      id={id}
      ref={ref}
      onClick={onClick}
      onMouseEnter={handleMouseEnter}
      onMouseLeave={handleMouseLeave}
      whileHover={{ scale: 1.02 }}
      whileTap={{ scale: 0.98 }}
      className={`relative flex items-center gap-4 p-3 rounded-2xl cursor-pointer transition-all duration-300 group w-full ${
        expanded ? '' : 'justify-center'
      } ${
        active 
          ? 'bg-vylant-blue/20 text-vylant-blue shadow-[0_0_15px_rgba(0,210,255,0.3)]' 
          : isDarkMode ? 'text-white/50 hover:text-white hover:bg-white/5' : 'text-slate-400 hover:text-slate-900 hover:bg-slate-100'
      }`}
    >
      <div className="flex-shrink-0 relative">
        <Icon size={24} />
        {unreadCount > 0 && <Badge count={unreadCount} isDarkMode={isDarkMode} position="-top-1.5 -right-1.5" />}
      </div>
      <AnimatePresence mode="wait">
        {expanded && (
          <motion.div
            initial={{ opacity: 0, x: -10 }}
            animate={{ opacity: 1, x: 0 }}
            exit={{ opacity: 0, x: -10 }}
            transition={{ duration: 0.2 }}
            className="flex-1 min-w-0 relative flex items-center justify-between"
          >
            <span className="block font-medium whitespace-nowrap overflow-hidden text-ellipsis">
              {label}
            </span>
          </motion.div>
        )}
      </AnimatePresence>

      {showTooltip && rect && createPortal(
        <motion.div 
          initial={{ opacity: 0, x: -10, scale: 0.95 }}
          animate={{ opacity: 1, x: 0, scale: 1 }}
          style={{ 
            top: rect.top + rect.height / 2, 
            left: rect.right + 12, 
            transform: 'translateY(-50%)' 
          }} 
          className={`fixed z-[9999] px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap shadow-xl border pointer-events-none transition-opacity duration-200 ${
            isDarkMode ? 'bg-vylant-navy/95 border-white/10 text-white shadow-black/50' : 'bg-white/95 border-slate-200 text-slate-900 shadow-slate-200/50'
          }`}
        >
          {label}
          <div className={`absolute left-0 top-1/2 -translate-x-full -translate-y-1/2 border-8 border-transparent ${isDarkMode ? 'border-r-vylant-navy/95' : 'border-r-white/95'}`} />
        </motion.div>,
        document.body
      )}
    </motion.div>
  );
};

const MobileNavBar = ({ 
  activeView, 
  setActiveView, 
  isDarkMode, 
  unreadCount, 
  onChatClick,
  tabOrder = ['home', 'discover', 'friends', 'messages'],
  setTabOrder,
  friendRequestsCount = 0
}: { 
  activeView: string; 
  setActiveView: (v: string) => void; 
  isDarkMode: boolean; 
  unreadCount: number; 
  onChatClick: () => void;
  tabOrder?: string[];
  setTabOrder?: React.Dispatch<React.SetStateAction<string[]>>;
  friendRequestsCount?: number;
}) => {
  const tabMap: Record<string, { id: string; icon: any; label: string }> = {
    home: { id: 'home', icon: Home, label: 'Home' },
    discover: { id: 'discover', icon: Compass, label: 'Discover' },
    friends: { id: 'friends', icon: Users, label: 'Friends' },
    messages: { id: 'messages', icon: MessageSquare, label: 'Chat' },
  };

  const normalizedOrder = useMemo(() => {
    const valid = ['home', 'discover', 'friends', 'messages'];
    const current = Array.isArray(tabOrder) && tabOrder.length > 0 ? tabOrder : valid;
    const filtered = current.filter(id => valid.includes(id));
    valid.forEach(id => {
      if (!filtered.includes(id)) filtered.push(id);
    });
    return filtered;
  }, [tabOrder]);

  const [localOrder, setLocalOrder] = useState<string[]>(normalizedOrder);
  const [draggingTabId, setDraggingTabId] = useState<string | null>(null);
  
  const navRef = useRef<HTMLDivElement>(null);
  const holdTimerRef = useRef<NodeJS.Timeout | null>(null);
  const touchStartPosRef = useRef<{ x: number; y: number } | null>(null);
  const isDraggingRef = useRef<boolean>(false);
  const hasDraggedRef = useRef<boolean>(false);
  const activeTabRef = useRef<string | null>(null);
  const orderRef = useRef<string[]>(localOrder);
  orderRef.current = localOrder;

  useEffect(() => {
    setLocalOrder(normalizedOrder);
  }, [normalizedOrder]);

  const startHold = (tabId: string, clientX: number, clientY: number) => {
    touchStartPosRef.current = { x: clientX, y: clientY };
    activeTabRef.current = tabId;
    hasDraggedRef.current = false;
    isDraggingRef.current = false;

    if (holdTimerRef.current) clearTimeout(holdTimerRef.current);
    holdTimerRef.current = setTimeout(() => {
      isDraggingRef.current = true;
      hasDraggedRef.current = true;
      setDraggingTabId(tabId);
      if (typeof navigator !== 'undefined' && navigator.vibrate) {
        try {
          navigator.vibrate([30, 20, 30]);
        } catch (e) {}
      }
    }, 280);
  };

  const moveHold = (clientX: number, clientY: number, e?: any) => {
    if (!touchStartPosRef.current) return;

    const dx = clientX - touchStartPosRef.current.x;
    const dy = clientY - touchStartPosRef.current.y;

    if (!isDraggingRef.current) {
      if (Math.hypot(dx, dy) > 10) {
        if (holdTimerRef.current) {
          clearTimeout(holdTimerRef.current);
          holdTimerRef.current = null;
        }
      }
      return;
    }

    if (e && e.cancelable) {
      e.preventDefault();
    }

    if (!navRef.current || !activeTabRef.current) return;

    const rect = navRef.current.getBoundingClientRect();
    const relX = clientX - rect.left;
    const clampedX = Math.max(0, Math.min(rect.width, relX));
    const count = orderRef.current.length;
    const slotWidth = rect.width / count;
    const targetIndex = Math.min(count - 1, Math.max(0, Math.floor(clampedX / slotWidth)));

    const currentIndex = orderRef.current.indexOf(activeTabRef.current);
    if (currentIndex !== -1 && targetIndex !== currentIndex) {
      const newOrder = [...orderRef.current];
      newOrder.splice(currentIndex, 1);
      newOrder.splice(targetIndex, 0, activeTabRef.current);
      orderRef.current = newOrder;
      setLocalOrder(newOrder);
      if (setTabOrder) setTabOrder(newOrder);
      try {
        localStorage.setItem('vylant-tab-order', JSON.stringify(newOrder));
      } catch (err) {}
      if (typeof navigator !== 'undefined' && navigator.vibrate) {
        try {
          navigator.vibrate(15);
        } catch (e) {}
      }
    }
  };

  const endHold = () => {
    if (holdTimerRef.current) {
      clearTimeout(holdTimerRef.current);
      holdTimerRef.current = null;
    }

    if (isDraggingRef.current) {
      isDraggingRef.current = false;
      setDraggingTabId(null);
      if (typeof navigator !== 'undefined' && navigator.vibrate) {
        try {
          navigator.vibrate(25);
        } catch (e) {}
      }
      if (setTabOrder) setTabOrder(orderRef.current);
      try {
        localStorage.setItem('vylant-tab-order', JSON.stringify(orderRef.current));
      } catch (err) {}

      setTimeout(() => {
        hasDraggedRef.current = false;
        activeTabRef.current = null;
        touchStartPosRef.current = null;
      }, 250);
    } else {
      activeTabRef.current = null;
      touchStartPosRef.current = null;
    }
  };

  useEffect(() => {
    const handleGlobalPointerMove = (e: PointerEvent) => {
      if (isDraggingRef.current && touchStartPosRef.current) {
        moveHold(e.clientX, e.clientY, e);
      }
    };
    const handleGlobalPointerUp = () => {
      if (isDraggingRef.current || holdTimerRef.current) {
        endHold();
      }
    };

    window.addEventListener('pointermove', handleGlobalPointerMove, { passive: false });
    window.addEventListener('pointerup', handleGlobalPointerUp);
    window.addEventListener('pointercancel', handleGlobalPointerUp);

    return () => {
      window.removeEventListener('pointermove', handleGlobalPointerMove);
      window.removeEventListener('pointerup', handleGlobalPointerUp);
      window.removeEventListener('pointercancel', handleGlobalPointerUp);
      if (holdTimerRef.current) clearTimeout(holdTimerRef.current);
    };
  }, []);

  return (
    <div 
      id="vylant-mobile-nav" 
      ref={navRef}
      className={`md:hidden fixed bottom-0 left-0 right-0 nav-h border-t z-[200] flex items-center justify-around px-2 safe-area-bottom select-none ${
        isDarkMode ? 'bg-vylant-navy border-white/10' : 'bg-white border-slate-200 shadow-[0_-4px_15px_rgba(0,0,0,0.08)]'
      }`}
    >
      <AnimatePresence>
        {draggingTabId && (
          <motion.div
            initial={{ opacity: 0, y: 8, scale: 0.9 }}
            animate={{ opacity: 1, y: 0, scale: 1 }}
            exit={{ opacity: 0, y: 8, scale: 0.9 }}
            className={`absolute -top-11 left-1/2 -translate-x-1/2 px-3.5 py-1.5 rounded-full text-[11px] font-bold tracking-wide uppercase border shadow-xl flex items-center gap-2 pointer-events-none z-[250] ${
              isDarkMode 
                ? 'bg-slate-900/95 border-vylant-blue/60 text-vylant-blue shadow-[0_4px_20px_rgba(0,210,255,0.3)]' 
                : 'bg-white/95 border-vylant-blue/50 text-vylant-blue shadow-lg'
            }`}
          >
            <GripHorizontal size={14} className="animate-pulse text-vylant-blue" />
            <span>Drag to move {tabMap[draggingTabId]?.label || 'icon'}</span>
          </motion.div>
        )}
      </AnimatePresence>

      {localOrder.map((tabId) => {
        const tab = tabMap[tabId];
        if (!tab) return null;
        const Icon = tab.icon;
        const isActive = activeView === tab.id;
        const isBeingDragged = draggingTabId === tab.id;
        const unread = tab.id === 'messages' ? unreadCount : tab.id === 'friends' ? (friendRequestsCount || 0) : 0;

        return (
          <motion.div
            key={tab.id}
            layout
            transition={{ type: 'spring', damping: 25, stiffness: 350 }}
            className={`relative flex items-center justify-center flex-1 h-full select-none touch-none ${
              isBeingDragged ? 'z-50' : 'z-10'
            }`}
            onTouchStart={(e) => {
              if (e.touches.length === 1) {
                startHold(tab.id, e.touches[0].clientX, e.touches[0].clientY);
              }
            }}
            onTouchMove={(e) => {
              if (e.touches.length === 1) {
                moveHold(e.touches[0].clientX, e.touches[0].clientY, e);
              }
            }}
            onTouchEnd={endHold}
            onTouchCancel={endHold}
            onPointerDown={(e) => {
              if (e.pointerType === 'mouse' && e.button !== 0) return;
              startHold(tab.id, e.clientX, e.clientY);
            }}
          >
            <button
              type="button"
              onClick={() => {
                if (hasDraggedRef.current) return;
                if (tab.id === 'messages') {
                  onChatClick();
                } else {
                  setActiveView(tab.id as any);
                }
              }}
              className={`group relative flex flex-col items-center justify-center w-full h-full gap-1 transition-all duration-200 outline-none ${
                isBeingDragged 
                  ? 'scale-115 -translate-y-2 cursor-grabbing' 
                  : draggingTabId ? 'opacity-40 scale-95' : 'active:scale-90 cursor-pointer'
              }`}
            >
              <div className={`p-1.5 rounded-xl transition-all duration-300 relative ${
                isBeingDragged
                  ? 'bg-vylant-blue text-vylant-navy ring-4 ring-vylant-blue/40 shadow-[0_0_25px_rgba(0,210,255,0.7)]'
                  : isActive 
                    ? (isDarkMode ? 'bg-vylant-blue text-vylant-navy shadow-[0_0_15px_rgba(0,210,255,0.4)]' : 'bg-vylant-blue text-white shadow-[0_0_15px_rgba(0,210,255,0.3)]') 
                    : (isDarkMode ? 'text-white/40 group-hover:text-white/60' : 'text-slate-400 group-hover:text-slate-600')
              }`}>
                <Icon size={20} />
                {isBeingDragged && (
                  <span className="absolute -top-1 -right-1 flex h-2.5 w-2.5">
                    <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                    <span className="relative inline-flex rounded-full h-2.5 w-2.5 bg-cyan-300"></span>
                  </span>
                )}
              </div>
              <span className={`text-[9px] font-bold uppercase tracking-[0.1em] transition-colors duration-300 ${
                isBeingDragged
                  ? 'text-vylant-blue scale-105 font-extrabold'
                  : isActive ? 'text-vylant-blue' : (isDarkMode ? 'text-white/30' : 'text-slate-400')
              }`}>
                {tab.label}
              </span>
              {unread > 0 && !isBeingDragged && (
                <span className="absolute top-2 right-4 w-4 h-4 rounded-full bg-red-500 text-white text-[10px] flex items-center justify-center font-bold border-2 border-[#0f1115] md:border-transparent">
                  {unread > 9 ? '9+' : unread}
                </span>
              )}
            </button>
          </motion.div>
        );
      })}
    </div>
  );
};

interface ServerIconProps {
  server: Server;
  expanded?: boolean;
  isDarkMode?: boolean;
  active?: boolean;
  dragControls?: any;
  onClick?: () => void;
  onMoreClick?: (e: React.MouseEvent) => void;
  isOwner?: boolean;
  unreadCount?: number;
  onlineCount?: number;
  onContextMenu?: (e: React.MouseEvent) => void;
  isMuted?: boolean;
}

const ServerIcon = React.memo(({ server, expanded = false, isDarkMode = true, active = false, dragControls, onClick, onMoreClick, isOwner = false, unreadCount = 0, onlineCount = 0, onContextMenu, isMuted = false }: ServerIconProps) => {
  const [hovered, setHovered] = useState(false);
  const [rect, setRect] = useState<DOMRect | null>(null);
  const [showTooltip, setShowTooltip] = useState(false);
  const timeoutRef = useRef<NodeJS.Timeout | null>(null);
  const ref = useRef<HTMLDivElement>(null);

  const handleMouseEnter = () => {
    setHovered(true);
    if (ref.current) setRect(ref.current.getBoundingClientRect());
    
    if (timeoutRef.current) clearTimeout(timeoutRef.current);
    const delay = expanded ? 1200 : 100;
    timeoutRef.current = setTimeout(() => {
      setShowTooltip(true);
    }, delay);
  };

  const handleMouseLeave = () => {
    setHovered(false);
    setShowTooltip(false);
    if (timeoutRef.current) clearTimeout(timeoutRef.current);
  };

  return (
    <div 
      ref={ref}
      onClick={onClick}
      onContextMenu={onContextMenu}
      onMouseEnter={handleMouseEnter}
      onMouseLeave={handleMouseLeave}
      className={`relative flex items-center gap-4 p-2 rounded-2xl cursor-pointer transition-all duration-300 group w-full ${
        expanded ? '' : 'justify-center'
      } ${
        active 
          ? (isDarkMode ? 'bg-white/10' : 'bg-slate-200') 
          : (isDarkMode ? 'hover:bg-white/5' : 'hover:bg-slate-100')
      }`}
    >
      <div className={`absolute left-0 w-1 bg-vylant-blue rounded-r-full transition-all duration-300 ${
        active ? 'h-8 opacity-100' : 'h-0 opacity-0 group-hover:h-4 group-hover:opacity-50'
      }`} />
      <div className={`w-10 h-10 rounded-xl ${server.image ? '' : server.color} flex items-center justify-center text-white font-bold shadow-lg flex-shrink-0 group-hover:rounded-lg transition-all duration-300 overflow-hidden relative`}>
        {server.image ? (
          <img draggable="false" onDragStart={(e) => e.preventDefault()} src={server.image} alt={server.name} className="w-full h-full object-cover" referrerPolicy="no-referrer" />
        ) : server.isFolder && server.servers && server.servers.length > 0 ? (
          <div className="grid grid-cols-2 gap-0.5 p-1 w-full h-full bg-black/20">
            {server.servers.slice(0, 4).map((s) => (
              <div key={s.id} className={`w-full h-full rounded-sm ${s.image ? '' : s.color} overflow-hidden flex items-center justify-center`}>
                {s.image ? <img draggable="false" onDragStart={(e) => e.preventDefault()} src={s.image} className="w-full h-full object-cover" referrerPolicy="no-referrer" /> : <span className="text-[8px]">{s.initials}</span>}
              </div>
            ))}
          </div>
        ) : (
          <span className="text-xs">{server.initials}</span>
        )}
        {unreadCount > 0 && <Badge count={unreadCount} isDarkMode={isDarkMode} position="-top-1 -right-1" />}
        {isMuted && unreadCount === 0 && (
          <div className="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 bg-black/70 rounded-full flex items-center justify-center border border-white/20 shadow" title="Muted Server">
            <BellOff size={8} className="text-white/70" />
          </div>
        )}
      </div>
      <AnimatePresence mode="wait">
        {expanded && (
          <motion.div
            initial={{ opacity: 0, x: -10 }}
            animate={{ opacity: 1, x: 0 }}
            exit={{ opacity: 0, x: -10 }}
            transition={{ duration: 0.2 }}
            className="flex-1 min-w-0 relative flex items-center justify-between"
          >
            <div className="flex-1 min-w-0 relative flex flex-col justify-center">
              <span className={`flex items-center gap-1 font-medium min-w-0 ${isDarkMode ? 'text-white/70 group-hover:text-white' : 'text-slate-600 group-hover:text-slate-900'}`}>
                <span className="truncate">{server.name}</span>
                {server.verified && <BadgeCheck size={14} className="text-vylant-blue fill-vylant-blue/10 flex-shrink-0 ml-1 overflow-visible" />}
                {isMuted && <BellOff size={13} className="text-white/40 shrink-0 ml-1" title="Server Muted" />}
              </span>
              {!server.isFolder && (
                <span className={`text-[10px] font-bold ${isDarkMode ? 'text-white/20' : 'text-slate-400'}`}>
                  {onlineCount} Online
                </span>
              )}
            </div>
          </motion.div>
        )}
      </AnimatePresence>
      {expanded && (
        <div 
          onClick={(e) => {
            if (onMoreClick) {
              e.stopPropagation();
              onMoreClick(e);
            }
          }}
          className={`opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0 cursor-pointer hover:text-white`}
        >
          <MoreHorizontal size={16} className={isDarkMode ? 'text-white/20 hover:text-white' : 'text-slate-300 hover:text-slate-600'} />
        </div>
      )}
      
      {showTooltip && rect && createPortal(
        <motion.div 
          initial={{ opacity: 0, x: -10, scale: 0.95 }}
          animate={{ opacity: 1, x: 0, scale: 1 }}
          style={{ 
            top: rect.top + rect.height / 2, 
            left: rect.right + 12, 
            transform: 'translateY(-50%)' 
          }} 
          className={`fixed z-[9999] px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap shadow-xl border pointer-events-none transition-opacity duration-200 ${
            isDarkMode ? 'bg-vylant-navy/95 border-white/10 text-white shadow-black/50' : 'bg-white/95 border-slate-200 text-slate-900 shadow-slate-200/50'
          }`}
        >
          <div className="flex items-center gap-2">
            {server.name}
            {server.verified && <BadgeCheck size={12} className="text-vylant-blue fill-vylant-blue/10" />}
            {isMuted && <span className="text-[10px] text-white/50 flex items-center gap-0.5"><BellOff size={10} /> Muted</span>}
          </div>
          <div className={`absolute left-0 top-1/2 -translate-x-full -translate-y-1/2 border-8 border-transparent ${isDarkMode ? 'border-r-vylant-navy/95' : 'border-r-white/95'}`} />
        </motion.div>,
        document.body
      )}
    </div>
  );
}, (prevProps, nextProps) => {
  return (
    prevProps.server.id === nextProps.server.id &&
    prevProps.server.name === nextProps.server.name &&
    prevProps.server.image === nextProps.server.image &&
    prevProps.server.color === nextProps.server.color &&
    prevProps.server.initials === nextProps.server.initials &&
    prevProps.expanded === nextProps.expanded &&
    prevProps.isDarkMode === nextProps.isDarkMode &&
    prevProps.active === nextProps.active &&
    prevProps.isOwner === nextProps.isOwner &&
    prevProps.unreadCount === nextProps.unreadCount &&
    prevProps.isMuted === nextProps.isMuted
  );
});



const handleDownloadMedia = async (url: string, filename: string = 'vylant-media') => {
  if (!url) return;
  try {
    if (url.startsWith('data:') || url.startsWith('blob:')) {
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      return;
    }

    const response = await fetch(url);
    if (!response.ok) throw new Error('Fetch failed');
    const blob = await response.blob();
    
    let ext = '';
    const type = blob.type.toLowerCase();
    if (type.includes('png')) ext = '.png';
    else if (type.includes('jpeg') || type.includes('jpg')) ext = '.jpg';
    else if (type.includes('gif')) ext = '.gif';
    else if (type.includes('webp')) ext = '.webp';
    else if (type.includes('mp4')) ext = '.mp4';
    else if (type.includes('webm')) ext = '.webm';
    else if (type.includes('mov') || type.includes('quicktime')) ext = '.mov';
    
    const finalFilename = filename.includes('.') ? filename : `${filename}${ext || ''}`;
    
    const blobUrl = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = blobUrl;
    a.download = finalFilename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(blobUrl), 2000);
  } catch (err) {
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }
};

const FullScreenImageViewer = ({ 
  url, 
  onClose,
  isDarkMode 
}: { 
  url: string, 
  onClose: () => void,
  isDarkMode: boolean
}) => {
  const isVideo = url.match(/\.(mp4|webm|ogg|mov)(\?.*)?$/i) || url.startsWith('data:video/') || url.startsWith('blob:');
  return createPortal(
    <AnimatePresence mode="wait">
      <motion.div
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        exit={{ opacity: 0 }}
        onClick={onClose}
        className="fixed inset-0 z-[9999] flex items-center justify-center bg-black/95 backdrop-blur-xl p-4 md:p-10 cursor-zoom-out"
      >
        <motion.div
          initial={{ scale: 0.9, opacity: 0, y: 20 }}
          animate={{ scale: 1, opacity: 1, y: 0 }}
          exit={{ scale: 0.9, opacity: 0, y: 20 }}
          transition={{ type: 'spring', damping: 25, stiffness: 300 }}
          onClick={(e) => e.stopPropagation()}
          className="relative max-w-[95vw] max-h-[90vh] group cursor-default"
        >
          {isVideo ? (
            <video 
              src={url} 
              controls 
              autoPlay 
              className="max-w-full max-h-[90vh] object-contain rounded-2xl shadow-[0_40px_100px_rgba(0,0,0,1)] border border-white/10" 
              referrerPolicy="no-referrer"
            />
          ) : (
            <img 
              src={url} 
              alt="Full screen viewer" 
              className="max-w-full max-h-[90vh] object-contain rounded-2xl shadow-[0_40px_100px_rgba(0,0,0,1)] border border-white/10"
              referrerPolicy="no-referrer"
            />
          )}
          
          <div className="absolute -top-14 right-2 md:right-0 flex items-center gap-3">
            <button
              onClick={(e) => {
                e.stopPropagation();
                handleDownloadMedia(url, isVideo ? 'vylant-video' : 'vylant-image');
              }}
              className="p-3 bg-white/5 hover:bg-white/10 backdrop-blur-2xl rounded-2xl border border-white/10 text-white transition-all hover:scale-110 active:scale-95 group flex items-center gap-2 font-bold text-xs"
              title="Download Media"
            >
              <Download size={20} className="group-hover:text-emerald-400 transition-colors" />
              <span className="hidden sm:inline">Download</span>
            </button>
             <a 
              href={url} 
              target="_blank" 
              rel="noopener noreferrer"
              className="p-3 bg-white/5 hover:bg-white/10 backdrop-blur-2xl rounded-2xl border border-white/10 text-white transition-all hover:scale-110 active:scale-95 group"
              title="Open Original"
            >
              <ExternalLink size={20} className="group-hover:text-vylant-blue transition-colors" />
            </a>
            <button 
              onClick={onClose}
              className="p-3 bg-vylant-blue text-vylant-navy rounded-2xl shadow-xl hover:scale-110 active:scale-90 transition-all font-bold group"
              title="Close Viewer"
            >
              <X size={20} strokeWidth={3} />
            </button>
          </div>

          <div className="absolute -bottom-10 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity">
            <p className="text-[10px] font-black uppercase tracking-[0.4em] text-white/30 italic">Secure Media Stream / HD</p>
          </div>
        </motion.div>
      </motion.div>
    </AnimatePresence>,
    document.body
  );
};



const VoiceMessagePlayer: React.FC<{ 
  audioSrc: string, 
  duration: number, 
  isDarkMode: boolean,
  isOther: boolean 
}> = ({ audioSrc, duration, isDarkMode, isOther }) => {
  const [isPlaying, setIsPlaying] = useState(false);
  const [currentTime, setCurrentTime] = useState(0);
  const audioRef = useRef<HTMLAudioElement | null>(null);
  const progressIntervalRef = useRef<NodeJS.Timeout | null>(null);

  const togglePlay = () => {
    if (audioRef.current) {
      if (isPlaying) {
        audioRef.current.pause();
      } else {
        audioRef.current.play();
      }
      setIsPlaying(!isPlaying);
    }
  };

  useEffect(() => {
    if (isPlaying) {
      progressIntervalRef.current = setInterval(() => {
        if (audioRef.current) {
          setCurrentTime(audioRef.current.currentTime);
        }
      }, 100);
    } else {
      if (progressIntervalRef.current) clearInterval(progressIntervalRef.current);
    }
    return () => {
      if (progressIntervalRef.current) clearInterval(progressIntervalRef.current);
    };
  }, [isPlaying]);

  const handleEnded = () => {
    setIsPlaying(false);
    setCurrentTime(0);
  };

  const formatTime = (time: number) => {
    const mins = Math.floor(time / 60);
    const secs = Math.floor(time % 60);
    return `${mins}:${secs.toString().padStart(2, '0')}`;
  };

  return (
    <div className={`flex items-center gap-3 py-2 px-1 min-w-[200px] sm:min-w-[240px]`}>
      <audio 
        ref={audioRef} 
        src={audioSrc} 
        onEnded={handleEnded} 
        onTimeUpdate={() => audioRef.current && setCurrentTime(audioRef.current.currentTime)}
      />
      
      <button 
        onClick={togglePlay}
        className={`w-10 h-10 rounded-full flex items-center justify-center shrink-0 transition-transform hover:scale-105 active:scale-95 ${
          isOther 
            ? (isDarkMode ? 'bg-vylant-blue text-vylant-navy' : 'bg-vylant-blue text-white')
            : (isDarkMode ? 'bg-white/20 text-white' : 'bg-white text-vylant-blue shadow-sm')
        }`}
      >
        {isPlaying ? <Pause size={20} fill="currentColor" /> : <Play size={20} fill="currentColor" className="ml-0.5" />}
      </button>

      <div className="flex-1 flex flex-col gap-1.5">
        <div className="flex items-center gap-1 h-6">
          {[...Array(20)].map((_, i) => {
            const progress = (currentTime / (duration || 1)) * 20;
            const isActive = i < progress;
            return (
              <motion.div
                key={i}
                initial={{ height: 4 }}
                animate={{ 
                  height: isPlaying ? [4, Math.random() * 16 + 4, 4] : 4,
                  opacity: isActive ? 1 : 0.3
                }}
                transition={{ 
                  repeat: isPlaying ? Infinity : 0, 
                  duration: 0.5 + Math.random() * 0.5,
                  delay: i * 0.05
                }}
                className={`w-1 rounded-full ${isOther ? (isDarkMode ? 'bg-vylant-blue' : 'bg-vylant-blue') : (isDarkMode ? 'bg-white' : 'bg-vylant-blue')}`}
              />
            );
          })}
        </div>
        <div className="flex justify-between items-center text-[10px] font-mono opacity-60">
          <span>{formatTime(currentTime)}</span>
          <span>{formatTime(duration)}</span>
        </div>
      </div>
    </div>
  );
};


