const findServer = (servers: Server[], id: string | null): Server | undefined => {
  if (!id) return undefined;
  for (const s of servers) {
    if (s.id === id) return s;
    if (s.isFolder && s.servers) {
      const found = s.servers.find(sub => sub.id === id);
      if (found) return found;
    }
  }
  return undefined;
};

const hasPermission = (server: Server, userId: string, permission: keyof Role['permissions']): boolean => {
  if (server.ownerId === userId) return true;
  const userRoles = server.memberRoles?.[userId] || [];
  const roles = server.roles?.filter(r => userRoles.includes(r.id)) || [];

  // Administrators and managers bypass specific checks and have all permissions
  const hasAdminPrivilege = roles.some(r => 
    r.permissions.editSettings === true || 
    r.permissions.manageRoles === true || 
    r.permissions.manageChannels === true
  );
  if (hasAdminPrivilege) return true;

  // Star Messages is a personal bookmark action available to all server members.
  if (permission === 'starMessages') {
    return true;
  }

  return roles.some(r => r.permissions[permission] === true);
};

const getMemberHighestRole = (server: Server, userId: string): Role | null => {
  const userRoles = server.memberRoles?.[userId] || [];
  if (userRoles.length === 0) return null;
  const roles = (server.roles || [])
    .filter(r => userRoles.includes(r.id))
    .sort((a, b) => a.position - b.position);
  return roles[0] || null;
};

const getMemberColor = (server: Server, userId: string, isDarkMode: boolean): string => {
  const highestRole = getMemberHighestRole(server, userId);
  if (highestRole) {
    if ((highestRole.color === '#ffffff' || highestRole.color.toLowerCase() === 'white') && !isDarkMode) {
      return '#0f172a';
    }
    return highestRole.color;
  }
  return isDarkMode ? '#ffffff' : '#0f172a';
};

