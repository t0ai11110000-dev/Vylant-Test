                  : 'bg-white border-slate-200 text-slate-900'
              }`}
            >
              <h2 className="text-xl font-bold mb-4">Close DM with '{dmToDelete.name}'</h2>
              <p className={`text-sm mb-8 ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
                Are you sure you want to close this direct message? The message history will still be saved if you start a new chat later.
              </p>

              <div className="flex items-center justify-end gap-3">
                <button
                  onClick={() => setDmToDelete(null)}
                  className={`px-4 py-2 rounded-xl text-sm font-semibold transition-all ${
                    isDarkMode ? 'text-white/60 hover:text-white hover:bg-white/5' : 'text-slate-500 hover:text-slate-900 hover:bg-slate-50'
                  }`}
                >
                  Cancel
                </button>
                <button
                  onClick={confirmDeleteDM}
                  className="px-6 py-2 bg-red-500 text-white rounded-xl text-sm font-bold shadow-lg shadow-red-500/20 transition-all hover:bg-red-600 active:scale-95"
                >
                  Close DM
                </button>
              </div>
            </motion.div>
          </div>
        )}
      </AnimatePresence>

      {/* Kick Confirmation Modal */}
      <AnimatePresence>
        {kickConfirm && (
          <div className="fixed inset-0 z-[220] flex items-center justify-center p-4">
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              onClick={() => setKickConfirm(null)}
              className="absolute inset-0 bg-black/60 backdrop-blur-sm"
            />
            <motion.div
              initial={{ opacity: 0, scale: 0.9, y: 20 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.9, y: 20 }}
              className={`relative w-full max-w-sm p-6 rounded-3xl shadow-2xl border ${
