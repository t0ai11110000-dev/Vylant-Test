                              <div className="flex gap-2">
                                <input 
                                  type="text"
                                  placeholder="https://example.com/sound.mp3"
                                  value={currentUserObj?.preferences?.customSounds?.globalMessageSound || ''}
                                  onChange={async (e) => {
                                    const updatedPrefs = {
                                      ...(currentUserObj?.preferences || {}),
                                      customSounds: {
                                        ...(currentUserObj?.preferences?.customSounds || {}),
                                        globalMessageSound: e.target.value
                                      }
                                    };
                                    setVylantUsers(prev => prev.map(u => u.name === userName ? { ...u, preferences: updatedPrefs } : u));
                                    await apiFetch('/api/profile/update', { method: 'POST', body: JSON.stringify({ preferences: updatedPrefs }) });
                                  }}
                                  className={`flex-1 min-w-0 px-3 py-2 text-sm rounded-xl border focus:outline-none focus:ring-2 focus:ring-vylant-blue/40 transition-shadow ${isDarkMode ? 'bg-black/20 border-white/10 text-white placeholder:text-white/20' : 'bg-white border-slate-200 text-slate-800 placeholder:text-slate-400'}`}
                                />
                                <label className={`flex items-center justify-center px-4 rounded-xl font-bold text-xs uppercase tracking-wider cursor-pointer transition-all ${isDarkMode ? 'bg-white/10 hover:bg-white/20 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-900'}`}>
                                  <input 
                                    type="file" 
                                    accept="audio/*" 
                                    className="hidden" 
                                    onChange={async (e) => {
                                      const file = e.target.files?.[0];
                                      if (file) {
                                        const url = await uploadFile(file);
                                        if (url) {
                                          const updatedPrefs = {
                                            ...(currentUserObj?.preferences || {}),
                                            customSounds: {
                                              ...(currentUserObj?.preferences?.customSounds || {}),
                                              globalMessageSound: url
                                            }
                                          };
                                          setVylantUsers(prev => prev.map(u => u.name === userName ? { ...u, preferences: updatedPrefs } : u));
                                          await apiFetch('/api/profile/update', { method: 'POST', body: JSON.stringify({ preferences: updatedPrefs }) });
                                        }
                                      }
                                      e.target.value = '';
                                    }}
                                  />
                                  Upload
                                </label>
                                <button
                                  type="button"
                                  onClick={() => {
                                    const url = currentUserObj?.preferences?.customSounds?.globalMessageSound;
                                    if (url) {
