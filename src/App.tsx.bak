              initial={{ opacity: 0, scale: 0.95, y: 15 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.95, y: 15 }}
              className="relative w-full max-w-lg rounded-3xl shadow-2xl border overflow-hidden bg-slate-950 border-white/10 text-white font-sans text-left"
            >
              {/* Stripe simulated header */}
              <div className="bg-[#635bff] p-6 text-white relative flex flex-col gap-1 text-left">
                <div className="absolute right-4 top-4">
                  <button 
                    onClick={() => setIsSimulatedStripeModalOpen(false)}
                    className="p-1 rounded-full hover:bg-white/20 transition-colors"
                  >
                    <X size={18} />
                  </button>
                </div>
                <div className="text-[10px] uppercase tracking-widest font-extrabold opacity-75">Stripe Interactive Sandbox</div>
                <h2 className="text-2xl font-black tracking-tight flex items-center gap-2">
                  <Zap size={22} className="text-amber-400 fill-amber-400/20" />
                  Stripe Checkout
                </h2>
                <p className="text-xs opacity-90 mt-1 font-medium">Testing Vylant Support Subscription in Developer Environments</p>
              </div>

              <div className="p-6 space-y-6 text-left">
                <div className="space-y-2">
                  <div className="text-xs uppercase tracking-widest text-slate-400 font-extrabold">Order Summary</div>
                  <div className="p-4 rounded-2xl bg-white/[0.03] border border-white/5 flex items-center justify-between">
                    <div>
                      <div className="font-bold text-sm">Vylant Premium Subscription</div>
                      <div className="text-xs text-slate-400 mt-0.5">Recurring Monthly Support</div>
                    </div>
                    <div className="text-right">
                      <div className="text-lg font-black text-[#635bff]">$2.99 USD</div>
                      <div className="text-[11px] text-slate-400 mt-0.5">per month</div>
                    </div>
                  </div>
                </div>

                <div className="space-y-4">
                  <div className="text-xs uppercase tracking-widest text-slate-400 font-extrabold">Simulated Payment Details</div>
                  
                  <div className="space-y-3 p-4 rounded-2xl bg-white/[0.02] border border-white/5">
                    <div>
                      <label className="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1">Card number</label>
                      <input 
                        type="text" 
                        disabled 
                        value="4242 •••• •••• 4242" 
                        className="w-full bg-slate-900 border border-white/10 p-2.5 rounded-xl text-sm font-mono text-slate-300"
                        referrerPolicy="no-referrer"
                      />
                    </div>

                    <div className="grid grid-cols-2 gap-3">
                      <div>
                        <label className="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1">Expiration</label>
                        <input 
                          type="text" 
                          disabled 
                          value="12 / 28" 
                          className="w-full bg-slate-900 border border-white/10 p-2.5 rounded-xl text-sm font-mono text-slate-300"
                          referrerPolicy="no-referrer"
                        />
                      </div>
                      <div>
                        <label className="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1">CVC</label>
                        <input 
                          type="text" 
                          disabled 
                          value="123" 
                          className="w-full bg-slate-900 border border-white/10 p-2.5 rounded-xl text-sm font-mono text-slate-300"
                          referrerPolicy="no-referrer"
                        />
                      </div>
                    </div>
                  </div>
                </div>

                <div className="p-3 bg-amber-500/10 border border-amber-500/20 text-amber-500 rounded-2xl text-xs flex items-start gap-2.5 leading-relaxed">
                  <Star size={14} className="shrink-0 mt-0.5 fill-amber-500/10 text-amber-500" />
                  <div>
                    No live credentials? No problem! This sandbox perfectly imitates Stripe's secure webhook and checkout APIs. Click <strong>Authorize payment</strong> below to test Premium features immediately.
                  </div>
                </div>

                <div className="grid grid-cols-2 gap-4 pt-2">
                  <button
                    onClick={() => {
                      setIsSimulatedStripeModalOpen(false);
                    }}
                    className="w-full py-3 bg-white/5 hover:bg-white/10 border border-white/10 rounded-2xl font-bold text-sm transition-all text-slate-300 text-center"
                  >
                    Cancel
                  </button>
                  <button
                    onClick={async () => {
                      try {
                        const res = await apiFetch('/api/stripe/simulate-payment');
                        const data = await res.json();
                        if (data.success) {
                          setIsSimulatedStripeModalOpen(false);
                          setSuccessModalData({
                            title: "Simulated Payment Approved!",
                            message: "Vylant Premium has been unlocked successfully. Enjoy exclusive badges & custom server themes!",
                            iconType: 'success'
                          });
                          
                          // Instantly update local profile in vylantUsers
                          setVylantUsers(prev => prev.map(u => u.name === userName ? { ...u, isPremium: true } : u));
                          
                          // Refetch users list
                          try {
                            const usersRes = await apiFetch(`/api/users?requestingUser=${encodeURIComponent(userName)}`);
                            if (usersRes.ok) {
                              const users = await usersRes.json();
                              setVylantUsers(users);
                            }
                          } catch (err) {
                            console.error("Failed to refetch users:", err);
                          }

                          // Emit socket update status to broadcast isPremium to others
                          if (socketRef.current) {
                            socketRef.current.emit("update-status", {
                              userName,
                              status: userStatus,
                              customStatus: customStatus
                            });
                          }
                        } else {
                          setSuccessModalData({
                            title: "Simulation Error",
                            message: "Simulation returned an error: " + (data.error || "unknown"),
                            iconType: "cancel"
                          });
                        }
                      } catch (err: any) {
                        setSuccessModalData({
                          title: "Request Failed",
                          message: "Simulation request failed: " + err.message,
                          iconType: "cancel"
                        });
                      }
                    }}
                    className="w-full py-3 bg-[#635bff] hover:bg-[#7a73ff] rounded-2xl font-bold text-sm shadow-xl shadow-[#635bff]/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2"
                  >
                    <Check size={16} />
                    Authorize Payment
                  </button>
                </div>
              </div>
            </motion.div>
          </div>
        )}
      </AnimatePresence>

      {/* Add Friend Modal */}
