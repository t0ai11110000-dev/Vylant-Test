                              <Sparkles size={16} /> User-Specific Overrides
                            </h3>
                            <p className={`text-xs ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>Assign custom sounds for specific friends.</p>
                          </div>

                          <div className="space-y-4">
                            {friends.filter(f => !f.isBot).map(friendObj => {
                              const friendId = friendObj.id;
                              const overrides = currentUserObj?.preferences?.customSounds?.userOverrides?.[friendId] || {};
                              
                              return (
                                <div key={friendId} className={`p-4 rounded-2xl border ${isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'}`}>
                                  <div className="flex items-center gap-3 mb-4 border-b pb-3 border-slate-200 dark:border-white/10">
                                    <img src={friendObj.image || getRandomAvatar(friendObj.name)} className="w-8 h-8 rounded-full border border-slate-200 dark:border-white/10" />
                                    <h4 className="font-bold text-sm">{friendObj.name}</h4>
                                  </div>
                                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div>
                                      <span className="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1.5">Call Sound</span>
                                      <div className="flex gap-2">
                                        <input 
                                          type="text"
                                          placeholder="Default"
                                          value={overrides.callSound || ''}
                                          onChange={async (e) => {
                                            const currentOverrides = currentUserObj?.preferences?.customSounds?.userOverrides || {};
                                            const updatedPrefs = {
                                              ...(currentUserObj?.preferences || {}),
                                              customSounds: {
                                                ...(currentUserObj?.preferences?.customSounds || {}),
                                                userOverrides: {
                                                  ...currentOverrides,
                                                  [friendId]: { ...currentOverrides[friendId], callSound: e.target.value }
                                                }
                                              }
                                            };
                                            setVylantUsers(prev => prev.map(u => u.name === userName ? { ...u, preferences: updatedPrefs } : u));
                                            await apiFetch('/api/profile/update', { method: 'POST', body: JSON.stringify({ preferences: updatedPrefs }) });
                                          }}
                                          className={`flex-1 min-w-0 px-3 py-1.5 text-xs rounded-lg border focus:outline-none focus:ring-2 focus:ring-amber-500/40 transition-shadow ${isDarkMode ? 'bg-black/20 border-white/10 text-white placeholder:text-white/20' : 'bg-white border-slate-200 text-slate-800 placeholder:text-slate-400'}`}
                                        />
                                        <label className={`flex items-center justify-center px-3 rounded-lg font-bold text-[10px] uppercase tracking-wider cursor-pointer transition-all ${isDarkMode ? 'bg-white/10 hover:bg-white/20 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-900'}`}>
                                          <input 
                                            type="file" 
                                            accept="audio/*" 
                                            className="hidden" 
                                            onChange={async (e) => {
                                              const file = e.target.files?.[0];
                                              if (file) {
                                                const url = await uploadFile(file);
                                                if (url) {
                                                  const currentOverrides = currentUserObj?.preferences?.customSounds?.userOverrides || {};
                                                  const updatedPrefs = {
                                                    ...(currentUserObj?.preferences || {}),
                                                    customSounds: {
                                                      ...(currentUserObj?.preferences?.customSounds || {}),
                                                      userOverrides: {
                                                        ...currentOverrides,
                                                        [friendId]: { ...currentOverrides[friendId], callSound: url }
                                                      }
                                                    }
                                                  };
                                                  setVylantUsers(prev => prev.map(u => u.name === userName ? { ...u, preferences: updatedPrefs } : u));
                                                  await apiFetch('/api/profile/update', { method: 'POST', body: JSON.stringify({ preferences: updatedPrefs }) });
                                                }
                                              }
                                              e.target.value = '';
                                            }}
                                          />
                                          Upload
                                        </label>
                                        <button
                                          type="button"
                                          onClick={() => {
                                            const url = overrides.callSound;
                                            if (url) {
                                              handlePlayPreviewAudio(url);
                                            }
                                          }}
                                          className={`p-1.5 px-2 rounded-lg flex items-center justify-center transition-all ${isDarkMode ? 'bg-white/10 hover:bg-white/20 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-900'}`}
                                          title="Preview Audio"
                                        >
                                          <Play size={14} />
                                        </button>
                                      </div>
                                    </div>
                                    <div>
                                      <span className="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1.5">Message Sound</span>
                                      <div className="flex gap-2">
                                        <input 
                                          type="text"
                                          placeholder="Default"
                                          value={overrides.messageSound || ''}
                                          onChange={async (e) => {
                                            const currentOverrides = currentUserObj?.preferences?.customSounds?.userOverrides || {};
                                            const updatedPrefs = {
                                              ...(currentUserObj?.preferences || {}),
                                              customSounds: {
                                                ...(currentUserObj?.preferences?.customSounds || {}),
                                                userOverrides: {
                                                  ...currentOverrides,
                                                  [friendId]: { ...currentOverrides[friendId], messageSound: e.target.value }
                                                }
                                              }
                                            };
                                            setVylantUsers(prev => prev.map(u => u.name === userName ? { ...u, preferences: updatedPrefs } : u));
                                            await apiFetch('/api/profile/update', { method: 'POST', body: JSON.stringify({ preferences: updatedPrefs }) });
                                          }}
                                          className={`flex-1 min-w-0 px-3 py-1.5 text-xs rounded-lg border focus:outline-none focus:ring-2 focus:ring-amber-500/40 transition-shadow ${isDarkMode ? 'bg-black/20 border-white/10 text-white placeholder:text-white/20' : 'bg-white border-slate-200 text-slate-800 placeholder:text-slate-400'}`}
                                        />
                                        <label className={`flex items-center justify-center px-3 rounded-lg font-bold text-[10px] uppercase tracking-wider cursor-pointer transition-all ${isDarkMode ? 'bg-white/10 hover:bg-white/20 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-900'}`}>
                                          <input 
                                            type="file" 
                                            accept="audio/*" 
                                            className="hidden" 
                                            onChange={async (e) => {
                                              const file = e.target.files?.[0];
                                              if (file) {
                                                const url = await uploadFile(file);
                                                if (url) {
                                                  const currentOverrides = currentUserObj?.preferences?.customSounds?.userOverrides || {};
                                                  const updatedPrefs = {
                                                    ...(currentUserObj?.preferences || {}),
                                                    customSounds: {
                                                      ...(currentUserObj?.preferences?.customSounds || {}),
                                                      userOverrides: {
                                                        ...currentOverrides,
                                                        [friendId]: { ...currentOverrides[friendId], messageSound: url }
                                                      }
                                                    }
                                                  };
                                                  setVylantUsers(prev => prev.map(u => u.name === userName ? { ...u, preferences: updatedPrefs } : u));
                                                  await apiFetch('/api/profile/update', { method: 'POST', body: JSON.stringify({ preferences: updatedPrefs }) });
                                                }
                                              }
                                              e.target.value = '';
                                            }}
                                          />
                                          Upload
                                        </label>
                                        <button
                                          type="button"
                                          onClick={() => {
                                            const url = overrides.messageSound;
                                            if (url) {
                                              handlePlayPreviewAudio(url);
                                            }
                                          }}
                                          className={`p-1.5 px-2 rounded-lg flex items-center justify-center transition-all ${isDarkMode ? 'bg-white/10 hover:bg-white/20 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-900'}`}
                                          title="Preview Audio"
                                        >
                                          <Play size={14} />
                                        </button>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              );
                            })}
                            {friends.filter(f => !f.isBot).length === 0 && (
                              <div className={`p-6 text-center rounded-2xl border border-dashed ${isDarkMode ? 'border-white/10 text-white/40' : 'border-slate-200 text-slate-400'}`}>
                                <p className="text-xs">Add friends to set user-specific notification sounds.</p>
                              </div>
                            )}
                          </div>
                        </div>
                      )}

                      {supporterActiveTab === 'server_themes' && (
                        <div className="space-y-6">
                          <div className={`p-5 rounded-2xl border ${isDarkMode ? 'bg-gradient-to-r from-amber-500/10 to-transparent border-amber-500/20' : 'bg-gradient-to-r from-amber-100 to-transparent border-amber-200'}`}>
                            <div className="flex items-center gap-2 mb-2">
                              <Sparkles size={16} className="text-amber-500" />
                              <h3 className="font-bold text-sm uppercase tracking-widest text-amber-500">Custom App Theme Color</h3>
                            </div>
                            <p className={`text-xs mb-4 ${isDarkMode ? 'text-white/60' : 'text-slate-600'}`}>
                              Pick a truly custom color for your entire Vylant app background and accents.
                            </p>
                            <label className={`relative flex items-center justify-between p-3 rounded-xl border cursor-pointer hover:scale-[1.02] active:scale-[0.98] transition-all ${customTheme === 'custom' ? 'border-amber-500 ring-1 ring-amber-500/50 bg-amber-500/5' : (isDarkMode ? 'border-white/10 bg-black/20' : 'border-slate-200 bg-white')}`}>
                              <div className="flex items-center gap-3">
                                <div className="w-8 h-8 rounded-full border border-slate-200 dark:border-white/20 shadow-inner" style={{ backgroundColor: customThemeColor }} />
                                <div>
                                  <div className="text-sm font-bold">Pick Color</div>
                                  <div className="text-[10px] text-slate-400 font-mono uppercase">{customThemeColor}</div>
                                </div>
                              </div>
                              {customTheme === 'custom' && <div className="text-[10px] uppercase font-bold text-amber-500">Active</div>}
                              <input 
                                type="color" 
                                value={customThemeColor} 
                                onChange={(e) => {
                                  setCustomThemeColor(e.target.value);
                                  setCustomTheme('custom');
                                }} 
                                onInput={(e) => {
                                  const color = (e.target as HTMLInputElement).value;
                                  if (customTheme === 'custom' || customTheme === 'default') {
                                    const root = document.documentElement;
                                    root.style.setProperty('--bg-primary', color);
                                    root.style.setProperty('--bg-gradient', `radial-gradient(circle at top center, ${color}cc 0%, ${color} 100%)`);
                                  }
                                }}
                                className="absolute inset-0 w-full h-full opacity-0 cursor-pointer" 
                              />
                            </label>
                          </div>

                          <div className="border-t border-slate-200 dark:border-white/10 pt-4" />
                          
                          <div>
                            <h3 className="font-bold text-sm uppercase tracking-widest text-vylant-blue flex items-center gap-2 mb-1">
                              <Compass size={16} />
                              Server Ambient Themes
                            </h3>
                            <p className={`text-xs mb-4 ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>As a supporter, you can apply rich ambient atmospheric effects and accent glows to any servers you manage!</p>
                          </div>
                          
                          {myManagedServers.length === 0 ? (
                            <div className={`p-8 text-center rounded-2xl border border-dashed ${isDarkMode ? 'border-white/10 text-white/40' : 'border-slate-200 text-slate-400'}`}>
                              <p className="text-sm font-bold">No administrating servers found.</p>
                              <p className="text-xs mt-1">You must create a server or gain the 'Edit Server Settings' permission to customize themes!</p>
                            </div>
                          ) : (
                            <div className="space-y-6">
                              {myManagedServers.map(srv => {
                                const activeThemeId = srv.customAssets?.themeId || 'default';
                                return (
                                  <div key={srv.id} className={`p-4 rounded-2xl border ${isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'}`}>
                                    <h4 className="font-bold text-sm text-vylant-blue flex items-center gap-2 mb-4">
                                      <img src={srv.image || getRandomAvatar(srv.name)} className="w-6 h-6 rounded-lg object-cover" />
                                      <span>{srv.name} Settings</span>
                                    </h4>

                                    <div className="grid grid-cols-2 gap-3">
                                      {themePresets.map(preset => (
                                        <button
                                          type="button"
                                          key={preset.id}
                                          onClick={() => {
                                            const updatedCustomAssets = {
                                              ...(srv.customAssets || {}),
                                              themeId: preset.id
                                            };
                                            handleUpdateServer(srv.id, { customAssets: updatedCustomAssets });
                                          }}
                                          className={`p-3 rounded-2xl border text-left transition-all hover:scale-[1.02] active:scale-[0.98] flex flex-col gap-2 ${
                                            activeThemeId === preset.id
                                              ? 'border-amber-500/50 bg-amber-500/5'
                                              : (isDarkMode ? 'border-white/5 bg-[#0b0f19]' : 'border-slate-200 bg-white')
                                          }`}
                                        >
                                          <div className={`h-12 w-full rounded-lg border ${preset.bg} flex items-center justify-center p-1`}>
                                            <div className="text-[10px] font-extrabold uppercase font-mono tracking-widest text-center text-white/80">Preview</div>
                                          </div>
                                          <div className="px-1">
                                            <div className="font-bold text-xs truncate flex items-center gap-1.5">
                                              <span>{preset.name}</span>
                                              {activeThemeId === preset.id && <div className="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping" />}
                                            </div>
                                            <p className="text-[9px] text-slate-400 line-clamp-1 mt-0.5">{preset.desc}</p>
                                          </div>
                                        </button>
                                      ))}
                                    </div>
                                  </div>
                                );
                              })}
                            </div>
                          )}
                        </div>
                      )}

                      {supporterActiveTab === 'game_textures' && (
                        <MinigameTexturesEditor 
                          isDarkMode={isDarkMode}
                          isPremium={isPremium}
                          onUnlockSupporter={() => setSupporterActiveTab('subscription')}
                          activeConfig={activeMinigameTexture}
                          onSaveConfig={(newConfig) => {
                            setActiveMinigameTexture(newConfig);
                            localStorage.setItem('vylant_active_minigame_texture', JSON.stringify(newConfig));
                          }}
                        />
                      )}

                      {supporterActiveTab === 'custom_emojis' && (
                        <div className="space-y-6">
                          <div className={`p-4 rounded-2xl border ${isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'}`}>
                            <div className="flex items-center justify-between gap-3 mb-2">
                              <h3 className="text-sm font-bold uppercase tracking-widest text-amber-400 flex items-center gap-2">
                                <Sparkles size={16} />
                                Custom Server Emojis
                              </h3>
                              <span className={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full border ${
                                isDarkMode ? 'bg-amber-500/10 text-amber-400 border-amber-500/30' : 'bg-amber-50 text-amber-700 border-amber-200'
                              }`}>
                                Supporter Perk
                              </span>
                            </div>
                            <p className="text-xs text-slate-400 leading-relaxed mb-4">
                              Supporters have exclusive access to react with custom server emojis across all Direct Messages and servers, and use them anywhere in chat!
                            </p>

                            {allRawEmojis.length === 0 ? (
                              <div className={`p-6 rounded-xl border text-center ${isDarkMode ? 'bg-white/[0.02] border-white/5' : 'bg-white border-slate-200'}`}>
                                <Smile size={32} className="mx-auto mb-2 text-slate-500 opacity-50" />
                                <p className="text-xs font-semibold mb-1">No Custom Emojis Uploaded Yet</p>
                                <p className="text-[11px] text-slate-400 max-w-sm mx-auto mb-3">
                                  Server admins can upload custom emojis in Server Settings {`>`} Emojis. Once uploaded, you can use and react with them everywhere!
                                </p>
                              </div>
                            ) : (
                              <div>
                                <div className="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-3 flex items-center justify-between">
                                  <span>Available Server Emojis ({allRawEmojis.length})</span>
                                  <span className="text-[10px] lowercase opacity-70">click to copy shortcode</span>
                                </div>
                                <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5 max-h-[300px] overflow-y-auto pr-1">
                                  {allRawEmojis.map((emoji: any) => {
                                    const emojiName = (emoji.names && emoji.names[0]) || emoji.name || 'emoji';
                                    const emojiUrl = emoji.imgUrl || emoji.url;
                                    const code = `<:${emojiName}:${emoji.id}>`;
                                    return (
                                      <button
                                        key={emoji.id || emojiName}
                                        type="button"
                                        onClick={() => {
                                          navigator.clipboard.writeText(code);
                                          setToast({ message: `Copied :${emojiName}: shortcode!`, type: 'success' });
                                        }}
                                        className={`p-2.5 rounded-xl border flex items-center gap-2.5 transition-all text-left group ${
                                          isDarkMode 
                                            ? 'bg-white/5 border-white/10 hover:bg-white/10 hover:border-amber-500/40' 
                                            : 'bg-white border-slate-200 hover:border-amber-500/40 shadow-sm'
                                        }`}
                                      >
                                        <div className="w-8 h-8 rounded-lg bg-black/20 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                                          <img src={emojiUrl} alt={emojiName} className="w-6 h-6 object-contain" />
                                        </div>
                                        <div className="min-w-0 flex-1">
                                          <p className="text-xs font-bold truncate">:{emojiName}:</p>
                                          <p className="text-[9px] text-slate-400 truncate opacity-75">Click to copy</p>
                                        </div>
                                      </button>
                                    );
                                  })}
                                </div>
                              </div>
                            )}
                          </div>

                          <div className="flex gap-3">
                            <button
                              type="button"
                              onClick={() => {
                                setIsSupporterPanelOpen(false);
                                if (activeServer) {
                                  setIsEditServerModalOpen(true);
                                } else {
                                  alert("Open any server to manage and upload custom emojis in Server Settings!");
                                }
                              }}
                              className="flex-1 py-3 bg-amber-500 hover:bg-amber-600 text-black font-bold rounded-xl text-xs uppercase tracking-wider transition-all hover:scale-105 active:scale-95 text-center shadow-lg shadow-amber-500/20"
                            >
                              Upload Server Emojis
                            </button>
                            <button
                              type="button"
                              onClick={() => setIsSupporterPanelOpen(false)}
                              className={`flex-1 py-3 rounded-xl font-bold text-xs uppercase tracking-wider text-center border ${
                                isDarkMode ? 'border-white/10 text-white hover:bg-white/5' : 'border-slate-200 text-slate-800 hover:bg-slate-50'
                              }`}
                            >
                              Done
                            </button>
                          </div>
                        </div>
                      )}

                      {supporterActiveTab === 'subscription' && (
                        <div className="space-y-6">
                          {!isPremium ? (
                            <div className={`p-6 rounded-2xl border text-center ${isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'}`}>
                              <CreditCard size={32} className="mx-auto text-slate-400 mb-3 animate-bounce" />
                              <h3 className="text-sm font-bold uppercase tracking-widest text-slate-300 mb-2">No Active Subscription</h3>
                              <p className={`text-xs mb-4 ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>
                                Unlock exquisite supporter badges, server custom themes, bespoke custom emoji slots, and premium chat capabilities!
                              </p>
                              <button 
                                onClick={() => {
                                  setIsSupporterPanelOpen(false);
                                  setIsSupportModalOpen(true);
                                }}
                                className="px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-black font-black text-xs uppercase tracking-wider rounded-xl hover:scale-105 active:scale-95 transition-all"
                              >
                                View Perks & Unlock
                              </button>
                            </div>
                          ) : (() => {
                            const details = currentUserObj?.preferences?.subscriptionDetails;
                            const autoRenew = details?.autoRenew !== false;
                            const subDate = details?.subscribedAt 
                              ? new Date(details.subscribedAt) 
                              : new Date();
                            const expDate = details?.expiresAt 
                              ? new Date(details.expiresAt) 
                              : new Date(subDate.getTime() + 30 * 24 * 60 * 60 * 1000);

                            return (
                              <div className="space-y-5 text-left">
                                <div className={`p-5 rounded-2xl border relative overflow-hidden backdrop-blur-md ${
                                  isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'
                                }`}>
                                  <div className="absolute top-0 right-0 p-4 opacity-5 pointer-events-none">
                                    <CreditCard size={120} className="text-white" />
                                  </div>
                                  
                                  <div className="flex items-center gap-3 mb-4">
                                    <div className="p-2.5 rounded-xl bg-amber-500/10 text-amber-500 border border-amber-500/20">
                                      <Sparkles size={20} className="animate-pulse" />
                                    </div>
                                    <div>
                                      <h3 className="text-sm font-bold uppercase tracking-widest text-amber-500">Vylant Premium</h3>
                                      <p className={`text-[11px] ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Active monthly subscription • $2.99</p>
                                    </div>
                                  </div>

                                  <div className="grid grid-cols-2 gap-4 border-t border-white/5 pt-4">
                                    <div>
                                      <p className="text-[10px] uppercase tracking-wider text-slate-400 font-bold mb-0.5">Subscribed On</p>
                                      <p className="text-xs font-semibold">
                                        {subDate.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}
                                      </p>
                                    </div>
                                    <div>
                                      <p className="text-[10px] uppercase tracking-wider text-slate-400 font-bold mb-0.5">
                                        {autoRenew ? 'Next Renewal' : 'Expiration Date'}
                                      </p>
                                      <p className="text-xs font-semibold">
                                        {expDate.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}
                                      </p>
                                    </div>
                                  </div>
                                </div>

                                {/* Auto-renew Switch Card */}
                                <div className={`p-4 rounded-2xl border flex items-center justify-between gap-4 ${
                                  isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'
                                }`}>
                                  <div className="space-y-1">
                                    <h4 className="text-xs font-bold uppercase tracking-wider">Subscription Auto-Renew</h4>
                                    <p className="text-[10px] text-slate-400 leading-relaxed">
                                      {autoRenew 
                                        ? "Keep auto-renew enabled to maintain continuous access to exclusive custom server atmospheric themes, animated badges & custom emojis." 
                                        : "Auto-renew is disabled. Your premium perks will turn off at the end of the current billing cycle."
                                      }
                                    </p>
                                  </div>

                                  <button
                                    type="button"
                                    disabled={isTogglingRenew}
                                    onClick={() => handleToggleAutoRenew(autoRenew)}
                                    className={`relative w-12 h-6 rounded-full p-0.5 transition-colors duration-200 focus:outline-none flex items-center shrink-0 ${
                                      isTogglingRenew ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer'
                                    } ${autoRenew ? 'bg-emerald-500' : 'bg-slate-600'}`}
                                  >
                                    <motion.div
                                      layout
                                      transition={{ type: 'spring', stiffness: 500, damping: 30 }}
                                      className="w-5 h-5 rounded-full bg-white shadow-lg pointer-events-none"
                                      animate={{ x: autoRenew ? 24 : 0 }}
                                    />
                                  </button>
                                </div>

                                {/* Invoice History Card */}
                                <div className={`p-4 rounded-2xl border ${
                                  isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'
                                }`}>
                                  <div className="flex items-center gap-2 mb-3">
                                    <FileText size={14} className="text-slate-400" />
                                    <h4 className="text-xs font-bold uppercase tracking-wider">Payment History</h4>
                                  </div>
                                  
                                  {isInvoicesLoading ? (
                                    <div className="flex items-center justify-center py-4">
                                      <Loader2 size={16} className="animate-spin text-slate-400" />
                                    </div>
                                  ) : invoices.length === 0 ? (
                                    <p className="text-[10px] text-slate-500 text-center py-2">No invoices found for this subscription.</p>
                                  ) : (
                                    <div className="space-y-2 max-h-32 overflow-y-auto pr-1">
                                      {invoices.map((inv) => (
                                        <div key={inv.id} className={`flex items-center justify-between p-2.5 rounded-xl border ${
                                          isDarkMode ? 'bg-black/20 border-white/5' : 'bg-white border-slate-100'
                                        }`}>
                                          <div>
                                            <p className="text-[11px] font-semibold">
                                              {new Date(inv.date).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })}
                                            </p>
                                            <p className={`text-[9px] uppercase tracking-wider font-bold ${
                                              inv.status === 'paid' ? 'text-emerald-500' : 'text-slate-400'
                                            }`}>
                                              {inv.status}
                                            </p>
                                          </div>
                                          <div className="flex items-center gap-3">
                                            <span className="text-xs font-bold">${(inv.amount / 100).toFixed(2)}</span>
                                            {inv.pdfUrl ? (
                                              <a href={inv.pdfUrl} target="_blank" rel="noopener noreferrer" className={`p-1.5 rounded-lg transition-colors ${
                                                isDarkMode ? 'bg-white/10 hover:bg-white/20' : 'bg-slate-100 hover:bg-slate-200'
                                              }`}>
                                                <Download size={12} />
                                              </a>
                                            ) : (
                                              <div className="p-1.5 rounded-lg opacity-30 cursor-not-allowed">
                                                <Download size={12} />
                                              </div>
                                            )}
                                          </div>
                                        </div>
                                      ))}
                                    </div>
                                  )}
                                </div>

                                {/* Destructive Actions Card */}
                                <div className={`p-4 rounded-2xl border ${
                                  isDarkMode ? 'bg-red-500/5 border-red-500/10' : 'bg-red-50/50 border-red-200'
                                }`}>
                                  <h4 className="text-xs font-bold text-red-500 uppercase tracking-widest mb-1">Cancel Subscription</h4>
                                  <p className="text-[10px] text-slate-400 leading-relaxed mb-3">
                                    Cancelling your subscription immediately removes your Premium status, hiding supporter badges, locked custom emojis slots and disabling premium gradients. <strong className="text-red-400 block mt-1.5 font-bold">Please note: You will not be refunded for the current month's subscription.</strong>
                                  </p>
                                  <button
                                    type="button"
                                    disabled={isCancellingSubscription}
                                    onClick={handleCancelSubscription}
                                    className="w-full sm:w-auto px-4 py-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 hover:text-red-300 font-bold text-[10px] uppercase tracking-wider rounded-xl transition-all border border-red-500/10 hover:border-red-500/20"
                                  >
                                    {isCancellingSubscription ? (
                                      <div className="flex items-center gap-1.5 justify-center">
                                        <RefreshCw size={10} className="animate-spin" />
                                        Cancelling...
                                      </div>
                                    ) : "Cancel Subscription"}
                                  </button>
                                </div>

                                <div className="flex gap-3 pt-2">
                                  <button
                                    type="button"
                                    onClick={() => setIsSupporterPanelOpen(false)}
                                    className={`w-full py-3 rounded-xl font-bold text-xs uppercase tracking-wider text-center border ${
                                      isDarkMode ? 'border-white/10 text-white hover:bg-white/5' : 'border-slate-200 text-slate-800 hover:bg-slate-50'
                                    }`}
                                  >
                                    Done
                                  </button>
                                </div>
                              </div>
                            );
                          })()}
                        </div>
                      )}
                    </div>
                  </div>
                  </>
                );
              })()}
            </motion.div>
          </div>
        )}
      </AnimatePresence>

      {/* Simulated Stripe Checkout Modal */}
      <AnimatePresence>
        {isSimulatedStripeModalOpen && (
