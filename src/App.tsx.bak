const DebouncedColorInput = memo(({ value, onChange, onInput, className }: { value: string, onChange: (val: string) => void, onInput?: (val: string) => void, className?: string }) => {
  const [localValue, setLocalValue] = useState(value);
  const timerRef = useRef<NodeJS.Timeout | null>(null);

  useEffect(() => {
    setLocalValue(value);
  }, [value]);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const newVal = e.target.value;
    setLocalValue(newVal);
    
    // Immediate feedback via onInput (e.g. for CSS variables)
    if (onInput) {
      onInput(newVal);
    }
    
    if (timerRef.current) clearTimeout(timerRef.current);
    timerRef.current = setTimeout(() => {
      onChange(newVal);
    }, 150); // Increased debounce for smoother App re-renders
  };

  return (
    <input 
      type="color" 
      value={localValue} 
      onChange={handleChange} 
      className={className} 
    />
  );
});

const DebouncedRangeInput = memo(({ value, min, max, step = 1, onChange, className, onInput }: { value: number, min: number | string, max: number | string, step?: number | string, onChange: (val: number) => void, className?: string, onInput?: (val: number) => void }) => {
  const [localValue, setLocalValue] = useState(value);
  const timerRef = useRef<NodeJS.Timeout | null>(null);

  useEffect(() => {
    setLocalValue(value);
  }, [value]);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const newVal = parseFloat(e.target.value);
    setLocalValue(newVal);
    
    if (onInput) onInput(newVal);
    
    if (timerRef.current) clearTimeout(timerRef.current);
    timerRef.current = setTimeout(() => {
      onChange(newVal);
    }, 50);
  };

  return (
    <input 
      type="range" 
      min={min} 
      max={max} 
      step={step}
      value={localValue} 
      onChange={handleChange} 
      className={className} 
    />
  );
});

interface RemoteVideoProps {
  stream: MediaStream;
  handleToggleFullScreen: (videoElement: HTMLVideoElement | null) => void;
  label: string;
  isSpeaking?: boolean;
}

const RemoteVideo: React.FC<RemoteVideoProps> = ({ stream, handleToggleFullScreen, label, isSpeaking }) => {
  const videoRef = useRef<HTMLVideoElement>(null);
  
  useEffect(() => {
    if (videoRef.current && videoRef.current.srcObject !== stream) {
      videoRef.current.srcObject = stream;
      // Ensure the video plays when stream is set
      const playVideo = async () => {
        try {
          if (videoRef.current) {
            await videoRef.current.play();
          }
        } catch (err) {
          console.warn("Video play interrupted or failed:", err);
        }
      };
      playVideo();
    }
  }, [stream]);

  return (
    <div className={`relative w-full h-full group bg-black/20 rounded-2xl overflow-hidden border transition-colors duration-300 ${isSpeaking ? 'border-emerald-500 shadow-[0_0_15px_rgba(16,185,129,0.3)]' : 'border-white/5'}`}>
       <video 
         ref={videoRef}
         autoPlay 
         muted
         playsInline 
         onDoubleClick={(e) => {
           e.stopPropagation();
           handleToggleFullScreen(videoRef.current);
         }}
         className="w-full h-full object-contain pointer-events-auto"
       />
       <div className="absolute top-2 right-2 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity z-10">
         <button
           onClick={(e) => {
             e.stopPropagation();
             handleToggleFullScreen(videoRef.current);
           }}
           className="p-1.5 bg-black/60 hover:bg-black/80 rounded-lg text-white backdrop-blur-sm shadow-md transition-colors"
           title="Full Screen"
         >
           <Maximize size={14} />
         </button>
       </div>
       <div className="absolute top-2 left-2 px-1.5 py-0.5 rounded bg-black/60 text-[9px] font-bold text-white/80 backdrop-blur-sm z-10">
         {label}
       </div>

    </div>
  );
};

interface RemoteAudioProps {
  stream: MediaStream;
  isDeafened: boolean;
  selectedOutputDevice: string;
  volume?: number;
}

const RemoteAudio: React.FC<RemoteAudioProps> = ({ stream, isDeafened, selectedOutputDevice, volume = 1 }) => {
  const audioRef = useRef<HTMLAudioElement>(null);

  useEffect(() => {
    if (!audioRef.current || !stream) return;
    
    if (audioRef.current.srcObject !== stream) {
      console.log(`RemoteAudio: Setting srcObject for ${stream.id}`, { tracks: stream.getTracks().map(t => ({ kind: t.kind, enabled: t.enabled, state: t.readyState })) });
      audioRef.current.srcObject = stream;
    }

    // Direct element volume control is more reliable than AudioContext
    // which often gets blocked by browser auto-play policies until user interaction.
    if (audioRef.current) {
      try {
        const clampedVolume = Math.max(0, Math.min(1, isDeafened ? 0 : volume));
        audioRef.current.volume = clampedVolume;
      } catch (err) {
        console.error("Failed to set audio volume:", err);
      }
    }
    audioRef.current.muted = isDeafened;
    
    // Attempt to play explicitly (though autoPlay usually handles this for srcObject)
    const playAudio = () => {
      audioRef.current?.play().catch(e => {
        console.warn("Failed to play remote audio element:", e);
        // Retry on document click as a fallback gesture
        const retry = () => {
          audioRef.current?.play().catch(() => {});
          document.removeEventListener('click', retry);
        };
        document.addEventListener('click', retry);
      });
    };

    // Give it a small delay to ensure stream tracks are fully ready
    const timeout = setTimeout(playAudio, 100);
    return () => clearTimeout(timeout);
  }, [stream, isDeafened, volume]);

  useEffect(() => {
    if (audioRef.current && (audioRef.current as any).setSinkId && selectedOutputDevice) {
      (audioRef.current as any).setSinkId(selectedOutputDevice === 'default' ? '' : selectedOutputDevice).catch(() => {});
    }
  }, [selectedOutputDevice]);

  return <audio ref={audioRef} autoPlay playsInline style={{ display: 'none' }} />;
};
