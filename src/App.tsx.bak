                  : 'bg-white border-slate-200 text-slate-900'
              }`}
            >
              <h2 className="text-xl font-bold mb-4">Kick '{kickConfirm.memberName}'</h2>
              <p className={`text-sm mb-8 ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
                Are you sure you want to kick <span className="font-bold text-white/80">{kickConfirm.memberName}</span> from the server? They will be able to rejoin with an invite.
              </p>

              <div className="flex items-center justify-end gap-3">
                <button
                  onClick={() => setKickConfirm(null)}
                  className={`px-4 py-2 rounded-xl text-sm font-semibold transition-all ${
                    isDarkMode ? 'text-white/60 hover:text-white hover:bg-white/5' : 'text-slate-500 hover:text-slate-900 hover:bg-slate-50'
                  }`}
                >
                  Cancel
                </button>
                <button
                  onClick={() => {
                    handleKickServerMember(kickConfirm.serverId, kickConfirm.memberId);
