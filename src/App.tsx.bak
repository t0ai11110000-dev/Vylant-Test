  gameOverlay: boolean, setGameOverlay: (v: boolean) => void,
  connectedDevices: any[], setConnectedDevices: React.Dispatch<React.SetStateAction<any[]>>,
  keybinds: any[], setKeybinds: React.Dispatch<React.SetStateAction<any[]>>,
  dmSortMode?: 'recent' | 'unread',
  setDmSortMode?: (v: 'recent' | 'unread') => void,
  isTranslationEnabled: boolean, setIsTranslationEnabled: (v: boolean) => void,
  targetLanguage: string, setTargetLanguage: (v: string) => void,
  showOriginalMessage: boolean, setShowOriginalMessage: (v: boolean) => void,
  setIsChangePasswordModalOpen: (v: boolean) => void,
  onReset: () => void,
  setIsBugReportModalOpen: (v: boolean) => void,
  accountCreatedAt: Date,
  blockedUsers: {id: string, name: string, image: string}[],
  setBlockedUsers: React.Dispatch<React.SetStateAction<{id: string, name: string, image: string}[]>>,
  audioInputs: MediaDeviceInfo[],
  audioOutputs: MediaDeviceInfo[],
  videoInputs: MediaDeviceInfo[],
  selectedInputDevice: string,
  setSelectedInputDevice: (v: string) => void,
  selectedOutputDevice: string,
  setSelectedOutputDevice: (v: string) => void,
  selectedVideoDevice: string,
  setSelectedVideoDevice: (v: string) => void,
  refreshDevices: () => Promise<void>,
  fetchConnectedSessions: () => Promise<void>,
  logoutAllSessions: () => Promise<void>,
  currentSocketId: string | null,
  isTestMicEnabled: boolean,
  setIsTestMicEnabled: (v: boolean) => void,
  onLogout: () => void,
  handleUnblockUser: (user: {id: string, name: string, image: string}) => Promise<void>,
  onRequestData: () => void,
  isMobile: boolean,
  onAddStory?: () => void,
  onStatusUpdate?: (status: UserStatus, custom?: string) => void,
  presets: Preset[],
  fetchPresets: () => Promise<void>,
  savePreset: (name: string, isPublic: boolean) => Promise<void>,
  deletePreset: (id: string) => Promise<void>,
  applyPreset: (preset: Preset) => Promise<void>,
  isPresetsLoading: boolean,
  onSwitchAccountClick?: () => void,
  onDownloadAppClick?: (platform?: PlatformId) => void,
  onOpenBotStudio?: () => void
}) => {
  const [editingField, setEditingField] = useState<string | null>(null);
  const [tempValue, setTempValue] = useState('');
  const [isSavingPreset, setIsSavingPreset] = useState(false);
  const [presetName, setPresetName] = useState('');
  const [presetIsPublic, setPresetIsPublic] = useState(false);
  const [presetToDelete, setPresetToDelete] = useState<Preset | null>(null);
  const [emailChangeStep, setEmailChangeStep] = useState<'send' | 'verify' | 'new-email'>('send');
  const [emailChangeCode, setEmailChangeCode] = useState('');
  const [isEmailLoading, setIsEmailLoading] = useState(false);
  const [emailError, setEmailError] = useState<string | null>(null);
  const [isStatusDropdownOpen, setIsStatusDropdownOpen] = useState(false);
  const [mobileSettingsView, setMobileSettingsView] = useState<'list' | 'tab'>('list');
  const [settingsSearchQuery, setSettingsSearchQuery] = useState('');
  const [isLogoutConfirmationOpen, setIsLogoutConfirmationOpen] = useState(false);
  const [isResetConfirmationOpen, setIsResetConfirmationOpen] = useState(false);
  const [showResetFeedback, setShowResetFeedback] = useState(false);
  const [trustedList, setTrustedList] = useState<string[]>(() => getTrustedDomains());
  const [newDomainInput, setNewDomainInput] = useState('');
  const [isAddingKeybind, setIsAddingKeybind] = useState(false);
  const [newKeybindAction, setNewKeybindAction] = useState('Toggle Dark Mode');
  const [newKeybindKey, setNewKeybindKey] = useState('Ctrl + Shift + D');
  const [cacheClearedFeedback, setCacheClearedFeedback] = useState(false);
  const [languageFeedback, setLanguageFeedback] = useState<string | null>(null);
  const [desktopNotifFeedback, setDesktopNotifFeedback] = useState<string | null>(null);

  const playTestSound = () => {
    try {
      const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioCtx) return;
      const ctx = new AudioCtx();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(587.33, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.15);
      const vol = Math.max(0, Math.min(1, (masterVolume || 100) / 100));
      gain.gain.setValueAtTime(vol * 0.3, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.3);
    } catch (err) {
      console.error(err);
    }
  };

  const testTTS = () => {
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
      const text = "Testing Vylant Text to Speech sound setting.";
      const u = new SpeechSynthesisUtterance(text);
      u.volume = Math.max(0, Math.min(1, (masterVolume || 100) / 100));
      window.speechSynthesis.speak(u);
    }
  };

  const handleDesktopNotifToggle = (val: boolean) => {
    setDesktopNotifications(val);
    if (val && 'Notification' in window) {
      if (Notification.permission === 'granted') {
        setDesktopNotifFeedback('Desktop notifications are enabled!');
        setTimeout(() => setDesktopNotifFeedback(null), 3500);
        try {
          new Notification('Vylant', { body: 'Desktop notifications are active!' });
        } catch(e) {}
      } else if (Notification.permission !== 'denied') {
        Notification.requestPermission().then(perm => {
          if (perm === 'granted') {
            setDesktopNotifFeedback('Desktop notifications granted!');
            setTimeout(() => setDesktopNotifFeedback(null), 3500);
            try {
              new Notification('Vylant', { body: 'Desktop notifications are active!' });
            } catch(e) {}
          } else {
            setDesktopNotifFeedback('Notification permission denied by browser.');
            setTimeout(() => setDesktopNotifFeedback(null), 3500);
          }
        });
      }
    }
  };

  const handleClearCache = () => {
    try {
      const keysToKeep = ['vylant_auth', 'vylant_user', 'vylant_recentDMs'];
      for (let i = localStorage.length - 1; i >= 0; i--) {
        const key = localStorage.key(i);
        if (key && !keysToKeep.some(k => key.startsWith(k))) {
          if (key.includes('cache') || key.includes('temp') || key.includes('draft')) {
            localStorage.removeItem(key);
          }
        }
      }
      sessionStorage.clear();
      setCacheClearedFeedback(true);
      setTimeout(() => setCacheClearedFeedback(false), 3000);
    } catch (e) {
      console.error(e);
    }
  };

  const handleAddDomain = () => {
    if (newDomainInput.trim()) {
      const updated = addTrustedDomain(newDomainInput);
      setTrustedList(updated);
      setNewDomainInput('');
    }
  };

  const fileInputRef = useRef<HTMLInputElement>(null);
  const statusDropdownRef = useRef<HTMLDivElement>(null);
  const mobileStatusRef = useRef<HTMLDivElement>(null);
  const lastOpenedRef = useRef<boolean>(false);

  const handleSendEmailCode = async () => {
    setIsEmailLoading(true);
    setEmailError(null);
    try {
      const response = await apiFetch('/api/settings/email/send-code', {
        method: 'POST'
      });
      const data = await response.json();
      if (response.ok) {
        if (data.needsVerification) {
          setEmailChangeStep('verify');
        } else {
          setEmailChangeStep('new-email');
          setTempValue('');
        }
      } else {
        setEmailError(data.error || 'Failed to send code');
      }
    } catch (err) {
      setEmailError('Connection error');
    } finally {
      setIsEmailLoading(false);
    }
  };

  const handleVerifyEmailCode = async () => {
    setIsEmailLoading(true);
    setEmailError(null);
    try {
      const response = await apiFetch('/api/settings/email/verify-code', {
        method: 'POST',
        body: JSON.stringify({ code: emailChangeCode })
      });
      if (response.ok) {
        setEmailChangeStep('new-email');
        setTempValue('');
      } else {
        const data = await response.json();
        setEmailError(data.error || 'Invalid code');
      }
    } catch (err) {
      setEmailError('Connection error');
    } finally {
      setIsEmailLoading(false);
    }
  };

  const handleFinalEmailUpdate = async () => {
    if (!tempValue.trim().includes('@')) {
      setEmailError('Please enter a valid email address.');
      return;
    }
    setIsEmailLoading(true);
    setEmailError(null);
    try {
      const response = await apiFetch('/api/settings/email/update', {
        method: 'POST',
        body: JSON.stringify({ newEmail: tempValue })
      });
      const data = await response.json();
      if (response.ok) {
        setUserEmail(data.email);
        setEditingField(null);
        setEmailChangeStep('send');
        setEmailChangeCode('');
      } else {
        setEmailError(data.error || 'Update failed');
      }
    } catch (err) {
      setEmailError('Connection error');
    } finally {
      setIsEmailLoading(false);
    }
  };

  useEffect(() => {
    if (activeTab === 'presets') {
      fetchPresets();
    }
  }, [activeTab, fetchPresets]);

  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      const isOutsideDesktop = statusDropdownRef.current && !statusDropdownRef.current.contains(event.target as Node);
      const isOutsideMobile = mobileStatusRef.current && !mobileStatusRef.current.contains(event.target as Node);
      if (isOutsideDesktop && isOutsideMobile) {
        setIsStatusDropdownOpen(false);
      }
    };
    document.removeEventListener('mousedown', handleClickOutside);
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  useEffect(() => {
    if (isOpen && !lastOpenedRef.current) {
      console.log('SettingsModal opening, setting tab to:', initialTab && initialTab !== 'overview' ? initialTab : 'my-account');
      if (initialTab && initialTab !== 'overview') {
        setActiveTab(initialTab);
        setMobileSettingsView('tab');
      } else {
        if (isMobile) {
          setMobileSettingsView('list');
        } else {
          setActiveTab('my-account');
          setMobileSettingsView('tab');
        }
      }
      setEditingField(null);
      setTempValue('');
    }
    lastOpenedRef.current = isOpen;
  }, [initialTab, isOpen, isMobile, setActiveTab]);

  useEffect(() => {
    setEditingField(null);
    setTempValue('');
    if (activeTab === 'devices') {
      fetchConnectedSessions();
    }
  }, [activeTab, fetchConnectedSessions]);

  const handleImageUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onloadend = () => {
        setCropTarget('profile');
        setCropImageSrc(reader.result as string);
        setIsCropModalOpen(true);
        e.target.value = '';
      };
      reader.readAsDataURL(file);
    }
  };

  const handleLogout = () => {
    setIsLogoutConfirmationOpen(true);
  };

  const confirmLogout = async () => {
    onLogout();
    setIsLogoutConfirmationOpen(false);
  };

  const handleConfirmReset = () => {
    onReset();
    setShowResetFeedback(true);
    setTimeout(() => setShowResetFeedback(false), 3000);
  };

    if (mode === 'simple') {
    return (
      <>
        <AnimatePresence>
        {isOpen && (
          <div className="fixed inset-0 z-[300] flex items-center justify-center p-4">
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              onClick={onClose}
              className="absolute inset-0 bg-black/60 backdrop-blur-sm"
            />
            <motion.div
              initial={{ opacity: 0, scale: 0.9, y: 20 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.9, y: 20 }}
              className={`relative w-full max-w-2xl max-h-[90vh] overflow-y-auto p-4 md:p-8 rounded-3xl shadow-2xl border transition-colors duration-500 ${
                isDarkMode ? 'bg-vylant-navy border-white/10 text-white' : 'bg-white border-slate-200 text-slate-900'
              }`}
              style={{ 
                background: isDarkMode ? 'var(--bg-gradient)' : undefined,
                borderColor: isDarkMode ? 'var(--accent-glow)' : undefined
              }}
            >
              <AnimatePresence>
                {showResetFeedback && (
                  <motion.div 
                    initial={{ opacity: 0, y: -20, scale: 0.9 }}
                    animate={{ opacity: 1, y: 0, scale: 1 }}
                    exit={{ opacity: 0, y: -20, scale: 0.9 }}
                    className="absolute top-4 left-1/2 -translate-x-1/2 z-50 bg-emerald-500 text-white px-6 py-2 rounded-full font-bold shadow-xl flex items-center gap-2"
                  >
                    <Check size={16} />
                    <span>Settings Reset Successfully</span>
                  </motion.div>
                )}
              </AnimatePresence>
              <div className="flex justify-between items-center mb-8">
                <h2 className="text-2xl font-bold">User Settings</h2>
                <div className="flex items-center gap-2">
                  <button 
                    onClick={() => setIsResetConfirmationOpen(true)}
                    title="Reset to Defaults"
                    className={`p-2 rounded-full transition-colors text-vylant-blue ${isDarkMode ? 'hover:bg-white/10' : 'hover:bg-slate-100'}`}
                  >
                    <RefreshCw size={20} />
                  </button>
                  <button onClick={onClose} className={`p-2 rounded-full transition-colors ${isDarkMode ? 'hover:bg-white/10' : 'hover:bg-slate-100'}`}>
                    <X size={24} />
                  </button>
                </div>
              </div>

              <div className="space-y-8">
                {/* Profile Section */}
                <section>
                  <h3 className={`text-sm font-bold uppercase tracking-widest mb-4 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Profile</h3>
                  <div className="flex items-center gap-6">
                    <div className="flex flex-col items-center gap-3">
                      <div className="relative group cursor-pointer" onClick={() => fileInputRef.current?.click()}>
                        <img src={userImage} className="w-24 h-24 rounded-full object-cover border-4 border-vylant-blue/30" referrerPolicy="no-referrer" />
                        <div className="absolute inset-0 bg-black/40 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                          <Camera className="text-white" size={24} />
                        </div>
                        <input 
                          type="file" 
                          ref={fileInputRef} 
                          onChange={handleImageUpload} 
                          className="hidden" 
                          accept="image/*"
                        />
                      </div>
                      <button 
                        onClick={() => setUserImage(DEFAULT_AVATARS[Math.floor(Math.random() * DEFAULT_AVATARS.length)])}
                        disabled={DEFAULT_AVATARS.includes(userImage)}
                        className={`px-3 py-1.5 rounded-lg font-bold text-xs transition-all ${
                          DEFAULT_AVATARS.includes(userImage)
                            ? 'opacity-50 cursor-not-allowed ' + (isDarkMode ? 'bg-white/5 text-white/50' : 'bg-slate-100 text-slate-400')
                            : (isDarkMode ? 'bg-white/10 hover:bg-white/20 text-white' : 'bg-slate-200 hover:bg-slate-300 text-slate-900')
                        }`}
                      >
                        Reset Avatar
                      </button>
                    </div>
                    <div className="flex-1">
                      <label className={`block text-xs font-medium mb-2 ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>Display Name</label>
                      <input 
                        type="text" 
                        value={userName} 
                        onChange={(e) => setUserName(e.target.value)}
                        maxLength={50}
                        className={`w-full px-4 py-3 rounded-xl border transition-all ${
                          isDarkMode 
                            ? 'bg-white/5 border-white/10 focus:border-vylant-blue outline-none' 
                            : 'bg-slate-50 border-slate-200 focus:border-vylant-blue outline-none'
                        }`}
                      />
                    </div>
                  </div>
                </section>

                {/* Appearance Section */}
                <section>
                  <h3 className={`text-sm font-bold uppercase tracking-widest mb-4 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Accent & Font</h3>
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
                    {/* Accent Color */}
                    <div>
                      <label className={`block text-xs font-medium mb-3 ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>Accent Color</label>
                      <div className="flex flex-wrap gap-3 items-center">
                        {['#00d2ff', '#ff00d2', '#00ff8c', '#ff8c00', '#8c00ff', '#ff4444'].map(color => (
                          <button
                            key={color}
                            onClick={() => setAccentColor(color)}
                            className={`w-10 h-10 rounded-full border-2 transition-transform hover:scale-110 ${accentColor === color ? 'border-white scale-110' : 'border-transparent'}`}
                            style={{ backgroundColor: color }}
                          />
                        ))}
                        <DebouncedColorInput 
                          value={accentColor} 
                          onChange={setAccentColor}
                          className="w-10 h-10 rounded-full border-none cursor-pointer bg-transparent"
                        />
                      </div>
                    </div>

                    {/* Font Size */}
                    <div>
                      <label className={`block text-xs font-medium mb-3 ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>Font Size ({fontSize}px)</label>
                      <DebouncedRangeInput 
                        min={12} 
                        max={24} 
                        value={fontSize} 
                        onChange={setFontSize}
                        className="w-full accent-vylant-blue"
                      />
                      <div className="flex justify-between text-[10px] mt-1 opacity-40">
                        <span>Small</span>
                        <span>Large</span>
                      </div>
                    </div>
                  </div>
                </section>

                {/* Story Ring Section */}
                <section>
                  <h3 className={`text-sm font-bold uppercase tracking-widest mb-4 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Story Ring Color</h3>
                  <div className="flex flex-wrap gap-3">
                    {[
                      { id: 'bg-gradient-to-tr from-cyan-400 to-blue-600', label: 'Ocean Blue', class: 'bg-gradient-to-tr from-cyan-400 to-blue-600' },
                      { id: 'bg-gradient-to-tr from-emerald-400 to-teal-600', label: 'Forest', class: 'bg-gradient-to-tr from-emerald-400 to-teal-600' },
                      { id: 'bg-gradient-to-tr from-rose-400 to-orange-500', label: 'Sunset', class: 'bg-gradient-to-tr from-rose-400 to-orange-500' },
                      { id: 'bg-gradient-to-tr from-amber-400 to-red-500', label: 'Fire', class: 'bg-gradient-to-tr from-amber-400 to-red-500' },
                      { id: 'bg-gradient-to-tr from-fuchsia-500 to-purple-600', label: 'Neon', class: 'bg-gradient-to-tr from-fuchsia-500 to-purple-600' },
                      { id: 'bg-gradient-to-tr from-yellow-400 via-red-500 to-purple-500', label: 'Instagram', class: 'bg-gradient-to-tr from-yellow-400 via-red-500 to-purple-500' },
                      { id: 'bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500', label: 'Cosmic', class: 'bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500' },
                      { id: 'bg-gradient-to-tr from-slate-800 to-indigo-900', label: 'Midnight', class: 'bg-gradient-to-tr from-slate-800 to-indigo-900' },
                    ].map(ring => (
                      <button
                        key={ring.id}
                        onClick={() => setStoryRingColor(ring.id)}
                        title={ring.label}
                        className={`w-10 h-10 rounded-full border-2 transition-transform hover:scale-110 ${storyRingColor === ring.id ? 'border-white scale-110' : 'border-transparent'} ${ring.class}`}
                      />
                    ))}
                  </div>
                </section>

                {/* Themes Section */}
                <section>
                  <h3 className={`text-sm font-bold uppercase tracking-widest mb-4 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Theme Preset</h3>
                  <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                    {[
                      { id: 'default', label: 'Vylant', bg: 'bg-[#171e33]' },
                      { id: 'light', label: 'Light', bg: 'bg-[#ffffff]' },
                      { id: 'midnight', label: 'Midnight', bg: 'bg-[#000000]' },
                      { id: 'forest', label: 'Forest', bg: 'bg-[#0a1e0a]' },
                      { id: 'sunset', label: 'Sunset', bg: 'bg-[#1e0a0a]' },
                      { id: 'ocean', label: 'Ocean', bg: 'bg-[#0a192f]' },
                      { id: 'berry', label: 'Berry', bg: 'bg-[#1f0d1f]' },
                      { id: 'desert', label: 'Desert', bg: 'bg-[#1a1410]' },
                      { id: 'slate', label: 'Slate', bg: 'bg-[#0f172a]' },
                      { id: 'glass', label: 'Glass', bg: 'bg-white/10 backdrop-blur-md bg-gradient-to-br from-white/10 to-transparent' }
                    ].map(theme => (
                      <button
                        key={theme.id}
                        onClick={() => {
                          setCustomTheme(theme.id);
                        }}
                        className={`p-4 rounded-2xl border-2 transition-all text-center relative ${
                          customTheme === theme.id 
                            ? 'border-vylant-blue bg-vylant-blue/10' 
                            : isDarkMode ? 'border-white/5 hover:border-white/20 bg-white/5' : 'border-slate-200 hover:border-slate-300 bg-slate-50'
                        }`}
                      >
                        <div className={`w-full h-12 rounded-lg mb-2 ${theme.bg} border border-slate-200 dark:border-white/10`} />
                        <span className="text-xs font-bold">{theme.label}</span>
                      </button>
                    ))}
                  </div>
                </section>
              </div>

              <div className="mt-12 flex justify-between items-center flex-wrap gap-2">
                <button
                  onClick={() => setIsBugReportModalOpen(true)}
                  className={`flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm transition-all text-red-500 hover:bg-red-500/10`}
                >
                  <AlertTriangle size={18} />
                  <span>Bug Report</span>
                </button>

                <div className="flex items-center gap-2">
                  <button
                    onClick={() => {
                      if (onDownloadAppClick) onDownloadAppClick(detectUserPlatform());
                    }}
                    className="flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm transition-all text-vylant-blue hover:bg-vylant-blue/10"
                  >
                    <Download size={18} />
                    <span>{getPlatformDownloadLabel(detectUserPlatform())}</span>
                  </button>

                  <button
                    onClick={() => {
                      if (onSwitchAccountClick) onSwitchAccountClick();
                    }}
                    className="flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm transition-all text-vylant-blue hover:bg-vylant-blue/10"
                  >
                    <ArrowLeftRight size={18} />
                    <span>Switch Account</span>
                  </button>
                </div>

                <button
                  onClick={handleLogout}
                  className="flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm transition-all text-red-500 hover:bg-red-500/10"
                >
                  <LogOut size={18} />
                  <span>Log Out</span>
                </button>
              </div>
            </motion.div>
          </div>
        )}
      </AnimatePresence>
      <ResetConfirmationModal 
        isOpen={isResetConfirmationOpen} 
        onClose={() => setIsResetConfirmationOpen(false)} 
        onConfirm={handleConfirmReset} 
        isDarkMode={isDarkMode} 
      />
      <LogoutConfirmationModal 
        isOpen={isLogoutConfirmationOpen} 
        onClose={() => setIsLogoutConfirmationOpen(false)} 
        onConfirm={confirmLogout} 
        isDarkMode={isDarkMode} 
      />
    </>
  );
}

  return (
    <>
      <AnimatePresence>
      {isOpen && (
        <div className={`fixed inset-0 z-[300] flex items-center justify-center ${isMobile ? 'p-0' : 'p-4'}`}>
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            onClick={onClose}
            className="absolute inset-0 bg-black/60 backdrop-blur-sm"
          />
            <motion.div
              initial={isMobile ? { y: '100%' } : { opacity: 0, scale: 0.95, y: 20 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={isMobile ? { y: '100%' } : { opacity: 0, scale: 0.95, y: 20 }}
              transition={{ type: 'spring', damping: 25, stiffness: 300 }}
              id="vylant-settings-modal"
              className={`relative w-full ${isMobile ? 'h-[100dvh] rounded-none safe-area-pt safe-area-bottom' : 'max-w-5xl h-[85vh] rounded-3xl'} flex flex-col md:flex-row shadow-2xl overflow-hidden border ${
                isDarkMode ? 'bg-[#0f111a] border-white/10 text-white' : 'bg-white border-slate-200 text-slate-900'
              }`}
              style={{ 
                background: isDarkMode ? 'var(--bg-gradient)' : undefined,
                borderColor: isDarkMode ? 'var(--accent-glow)' : undefined,
                colorScheme: isDarkMode ? 'dark' : 'light'
              }}
            >
              <AnimatePresence>
                {showResetFeedback && (
                  <motion.div 
                    initial={{ opacity: 0, y: -20, scale: 0.9 }}
                    animate={{ opacity: 1, y: 0, scale: 1 }}
                    exit={{ opacity: 0, y: -20, scale: 0.9 }}
                    className="absolute top-4 left-1/2 -translate-x-1/2 z-50 bg-emerald-500 text-white px-6 py-2 rounded-full font-bold shadow-xl flex items-center gap-2"
                  >
                    <Check size={16} />
                    <span>Settings Reset Successfully</span>
                  </motion.div>
                )}
              </AnimatePresence>
              {/* Sidebar / Menu List */}
              <div 
                id="vylant-settings-sidebar" 
                className={`${isMobile ? (mobileSettingsView === 'list' ? 'w-full' : 'hidden') : 'w-64'} flex flex-col p-6 overflow-y-auto border-r ${isDarkMode ? 'bg-vylant-navy border-white/10' : 'bg-slate-50 border-slate-100'}`}
              >
                {!isMobile && <SectionHeader isDarkMode={isDarkMode}>User Settings</SectionHeader>}
                {isMobile && (
                  <div className="mb-6 flex items-center justify-between">
                    <h2 className="text-3xl font-black tracking-tighter">Settings</h2>
                    <button onClick={onClose} className={`p-2 rounded-full transition-colors ${isDarkMode ? 'bg-white/5 hover:bg-white/10' : 'bg-slate-100 hover:bg-slate-200'}`}>
                      <X size={24} />
                    </button>
                  </div>
                )}
                
                {isMobile && (
                  <div 
                    className={`p-4 rounded-[2rem] border mb-6 transition-all ${isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-100 border-slate-200'}`}
                  >
                    <div className="flex flex-col gap-4">
                      <div className="flex items-center gap-4">
                        <div className="relative">
                          <img src={userImage} className="w-14 h-14 rounded-full border-2 border-vylant-blue/30" />
                          <div className="absolute -bottom-1 -right-1 scale-110">
                            <StatusIndicator status={userStatus} size="sm" />
                          </div>
                        </div>
                        <div className="min-w-0">
                          <h3 className="font-bold text-lg leading-none mb-1 truncate">{userName}</h3>
                          <div className="flex flex-col gap-1">
                            <p className="text-xs opacity-40 truncate">@{(userName || '').toLowerCase().replace(/\s+/g, '')}</p>
                            {customStatus && userStatus !== 'offline' && (
                              <div className="flex items-center gap-2 mt-1">
                                <span className="text-[8px] px-1.5 py-0.5 rounded bg-vylant-blue/10 text-vylant-blue font-bold uppercase tracking-wider shrink-0">Status</span>
                                <p className="text-[10px] italic opacity-60 truncate">{customStatus}</p>
                              </div>
                            )}
                          </div>
                        </div>
                      </div>
                      
                      <div className="flex flex-col gap-3">
                        {onAddStory && (
                          <button
                            onClick={(e) => { e.stopPropagation(); onAddStory(); }}
                            className={`w-full py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all border ${
                              isDarkMode 
                                ? 'bg-vylant-blue/20 hover:bg-vylant-blue/30 text-vylant-blue border-vylant-blue/30' 
                                : 'bg-vylant-blue/10 hover:bg-vylant-blue/20 text-vylant-blue border-vylant-blue/20'
                            }`}
                          >
                            Add Story
                          </button>
                        )}
                        
                        {/* Mobile Status Row */}
                        <div className="w-full">
                          <div className="relative" ref={mobileStatusRef}>
                            <button
                              onClick={(e) => { 
                                e.stopPropagation(); 
                                setIsStatusDropdownOpen(!isStatusDropdownOpen); 
                              }}
                              className={`w-full flex items-center justify-between px-4 py-2.5 rounded-xl border text-xs font-bold transition-all ${
                                isDarkMode ? 'bg-white/5 border-white/10' : 'bg-white border-slate-200'
                              }`}
                            >
                              <div className="flex items-center gap-3">
                                <StatusIndicator status={userStatus} size="xs" />
                                <span className="capitalize">{userStatus === 'idle' ? 'Away' : (userStatus === 'dnd' ? 'Do Not Disturb' : userStatus)}</span>
                              </div>
                              <ChevronDown size={14} className="opacity-40" />
                            </button>
                            
                            <AnimatePresence>
                              {isStatusDropdownOpen && (
                                <motion.div
                                  initial={{ opacity: 0, y: 5, scale: 0.95 }}
                                  animate={{ opacity: 1, y: 0, scale: 1 }}
                                  exit={{ opacity: 0, y: 5, scale: 0.95 }}
                                  className={`absolute top-full left-0 mt-2 w-48 rounded-2xl p-2 z-[1000] shadow-2xl border ${
                                    isDarkMode ? 'bg-slate-900 border-white/10 text-white' : 'bg-white border-slate-200 text-slate-900'
                                  }`}
                                  onClick={(e) => e.stopPropagation()}
                                >
                                  {[
                                    { id: 'online', label: 'Online' },
                                    { id: 'idle', label: 'Away' },
                                    { id: 'dnd', label: 'Do Not Disturb' },
                                    { id: 'invisible', label: 'Invisible' }
                                  ].map((status) => (
                                    <button
                                      key={status.id}
                                      onClick={() => {
                                        setUserStatus(status.id as UserStatus);
                                        onStatusUpdate?.(status.id as UserStatus, customStatus);
                                        setIsStatusDropdownOpen(false);
                                      }}
                                      className={`w-full flex items-center gap-3 p-2 rounded-xl transition-all ${
                                        isDarkMode ? 'hover:bg-white/5' : 'hover:bg-slate-50'
                                      }`}
                                    >
                                      <StatusIndicator status={status.id as UserStatus} />
                                      <span className="text-xs font-medium">{status.label}</span>
                                    </button>
                                  ))}
                                </motion.div>
                              )}
                            </AnimatePresence>
                          </div>
                        </div>

                        <div className="relative">
                          <input 
                            type="text"
                            value={customStatus}
                            onClick={(e) => e.stopPropagation()}
                            onChange={(e) => {
                              setCustomStatus(e.target.value);
                              onStatusUpdate?.(userStatus, e.target.value);
                            }}
                            placeholder="Set custom status..."
                            maxLength={100}
                            className={`w-full px-4 py-2.5 rounded-xl text-sm border transition-all ${
                              isDarkMode 
                                ? 'bg-black/20 border-white/10 focus:border-vylant-blue outline-none' 
                                : 'bg-white border-slate-200 focus:border-vylant-blue outline-none'
                            }`}
                          />
                          <Smile size={18} className="absolute right-4 top-1/2 -translate-y-1/2 opacity-30 pointer-events-none" />
                        </div>
                      </div>
                    </div>
                  </div>
                )}
                
                <div className="relative mb-6">
                  <input
                    type="text"
                    placeholder="Search settings..."
                    value={settingsSearchQuery}
                    onChange={(e) => setSettingsSearchQuery(e.target.value)}
                    className={`w-full px-4 py-2.5 pl-10 rounded-xl text-sm border transition-all ${
                      isDarkMode 
                        ? 'bg-black/20 border-white/10 focus:border-vylant-blue text-white placeholder-white/40 outline-none' 
                        : 'bg-white border-slate-200 focus:border-vylant-blue text-slate-900 placeholder-slate-400 outline-none'
                    }`}
                  />
                  <Search size={16} className={`absolute left-3.5 top-1/2 -translate-y-1/2 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`} />
                  {settingsSearchQuery && (
                    <button
                      onClick={() => setSettingsSearchQuery('')}
                      className={`absolute right-3.5 top-1/2 -translate-y-1/2 ${isDarkMode ? 'text-white/40 hover:text-white' : 'text-slate-400 hover:text-slate-900'}`}
                    >
                      <X size={14} />
                    </button>
                  )}
                </div>

                {[
                  {
                    header: 'Account',
                    items: [
                      { id: 'my-account', label: 'My Account', icon: User },
                      { id: 'profile', label: 'Profile', icon: Camera }
                    ]
                  },
                  {
                    header: 'Security & Safety',
                    items: [
                      { id: 'privacy', label: 'Data & Privacy', icon: Shield },
                      { id: 'blocked-users', label: 'Blocked Users', icon: Ban },
                      { id: 'devices', label: 'Devices Connected', icon: Monitor }
                    ]
                  },
                  {
                    header: 'App Settings',
                    items: [
                      { id: 'appearance', label: 'Appearance', icon: Sun },
                      { id: 'presets', label: 'Presets', icon: LayoutGrid },
                      { id: 'notifications', label: 'Notifications', icon: Bell },
                      { id: 'sound', label: 'Sound', icon: Volume2 },
                      { id: 'voice-video', label: 'Voice & Video', icon: Video },
                      { id: 'chat', label: 'Chat', icon: MessageSquare },
                      { id: 'translate', label: 'Translate', icon: Globe },
                      { id: 'keybinds', label: 'Keybinds', icon: Keyboard },
                      { id: 'language', label: 'Language', icon: Globe },
                      { id: 'advanced', label: 'Advanced', icon: Terminal }
                    ]
                  },
                  {
                    header: 'Developer',
                    items: [
                      { id: 'bots', label: 'Bot Studio & Apps', icon: Bot }
                    ]
                  }
                ].map((section) => {
                  const filteredItems = section.items.filter(item => 
                    item.label.toLowerCase().includes(settingsSearchQuery.toLowerCase())
                  );

                  if (filteredItems.length === 0) return null;

                  return (
                    <React.Fragment key={section.header}>
                      <SectionHeader isDarkMode={isDarkMode}>{section.header}</SectionHeader>
                      {filteredItems.map(item => (
                        <SidebarItem 
                          key={item.id}
                          id={item.id} 
                          label={item.label} 
                          icon={item.icon} 
                          activeTab={activeTab} 
                          isMobile={isMobile} 
                          isDarkMode={isDarkMode} 
                          setActiveTab={setActiveTab} 
                          setMobileSettingsView={setMobileSettingsView} 
                        />
                      ))}
                    </React.Fragment>
                  );
                })}
                
                <div className="mt-8 pt-6 border-t border-white/5 flex flex-col gap-2">
                  <button
                    onClick={() => setIsBugReportModalOpen(true)}
                    className="w-full flex items-center justify-between px-4 py-3 rounded-2xl text-sm font-bold transition-all text-amber-500 hover:bg-amber-500/10"
                  >
                    <div className="flex items-center gap-3">
                      <AlertTriangle size={20} />
                      <span>Bug Report</span>
                    </div>
                    <ChevronRight size={16} className="opacity-20" />
                  </button>
                  <button
                    onClick={() => {
                      if (onDownloadAppClick) onDownloadAppClick(detectUserPlatform());
                    }}
                    className="w-full flex items-center justify-between px-4 py-3 rounded-2xl text-sm font-bold transition-all text-vylant-blue hover:bg-vylant-blue/10"
                  >
                    <div className="flex items-center gap-3">
                      <Download size={20} />
                      <span>{getPlatformDownloadLabel(detectUserPlatform())}</span>
                    </div>
                    <ChevronRight size={16} className="opacity-20" />
                  </button>
                  <button
                    onClick={() => {
                      if (onSwitchAccountClick) onSwitchAccountClick();
                    }}
                    className="w-full flex items-center justify-between px-4 py-3 rounded-2xl text-sm font-bold transition-all text-vylant-blue hover:bg-vylant-blue/10"
                  >
                    <div className="flex items-center gap-3">
                      <ArrowLeftRight size={20} />
                      <span>Switch Account</span>
                    </div>
                    <ChevronRight size={16} className="opacity-20" />
                  </button>
                  <button
                    onClick={handleLogout}
                    className="w-full flex items-center justify-between px-4 py-3 rounded-2xl text-sm font-bold transition-all text-red-500 hover:bg-red-500/10"
                  >
                    <div className="flex items-center gap-3">
                      <LogOut size={20} />
                      <span>Log Out</span>
                    </div>
                    <ChevronRight size={16} className="opacity-20" />
                  </button>
                </div>
              </div>

              {/* Content Area */}
              <div className={`flex-1 flex flex-col overflow-hidden ${isMobile && mobileSettingsView === 'list' ? 'hidden' : ''}`}>
                <div className={`flex items-center ${isMobile ? 'px-4 py-4 border-b border-white/5' : 'p-4 md:p-8 pb-0'} transition-all`}>
                  {isMobile && (
                    <button 
                      onClick={() => setMobileSettingsView('list')}
                      className={`mr-3 p-2 rounded-full transition-colors ${isDarkMode ? 'hover:bg-white/10' : 'hover:bg-slate-100'}`}
                    >
                      <ArrowLeft size={24} />
                    </button>
                  )}
                  <h2 className={`${isMobile ? 'text-lg' : 'text-2xl'} font-bold flex-1`}>
                    {activeTab === 'my-account' && 'My Account'}
                    {activeTab === 'profile' && 'User Profile'}
                    {activeTab === 'privacy' && 'Data & Privacy'}
                    {activeTab === 'blocked-users' && 'Blocked Users'}
                    {activeTab === 'devices' && 'Devices Connected'}
                    {activeTab === 'appearance' && 'Appearance'}
                    {activeTab === 'notifications' && 'Notifications'}
                    {activeTab === 'sound' && 'Sound Settings'}
                    {activeTab === 'voice-video' && 'Voice & Video'}
                    {activeTab === 'chat' && 'Chat Settings'}
                    {activeTab === 'keybinds' && 'Keybinds'}
                    {activeTab === 'language' && 'Language'}
                    {activeTab === 'presets' && 'Presets Library'}
                    {activeTab === 'advanced' && 'Advanced Mode'}
                  </h2>
                  {!isMobile && (
                    <div className="flex items-center gap-2">
                      <button 
                        onClick={() => setIsResetConfirmationOpen(true)}
                        title="Reset all settings to default"
                        className={`p-2 rounded-full transition-colors text-vylant-blue ${isDarkMode ? 'hover:bg-white/10' : 'hover:bg-slate-100'}`}
                      >
                        <RefreshCw size={20} />
                      </button>
                      <button onClick={onClose} className={`p-2 rounded-full transition-colors ${isDarkMode ? 'hover:bg-white/10' : 'hover:bg-slate-100'}`}>
                        <X size={24} />
                      </button>
                    </div>
                  )}
                </div>

                <div className={`flex-1 overflow-y-auto ${isMobile ? 'p-6' : 'p-4 md:p-8 pt-6'}`}>
                {activeTab === 'my-account' && (
                  <div className="space-y-8">
                    <div className={`p-4 md:p-6 rounded-2xl border ${isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'}`}>
                      <div className="flex flex-col md:flex-row md:items-center gap-6 mb-8">
                        <div className="flex items-center gap-4">
                          <div className="relative shrink-0 group cursor-pointer" onClick={() => setIsStatusDropdownOpen(!isStatusDropdownOpen)} ref={statusDropdownRef}>
                            <img src={userImage} className="w-16 h-16 md:w-20 md:h-20 rounded-full object-cover border-4 border-vylant-blue/30 transition-transform group-hover:scale-105" referrerPolicy="no-referrer" />
                            <div className="absolute -bottom-1 -right-1 scale-125">
                              <StatusIndicator status={userStatus} size="md" />
                            </div>
                            
                            <AnimatePresence>
                              {isStatusDropdownOpen && (
                                <motion.div
                                  initial={{ opacity: 0, y: 5, scale: 0.95 }}
                                  animate={{ opacity: 1, y: 0, scale: 1 }}
                                  exit={{ opacity: 0, y: 5, scale: 0.95 }}
                                  className={`absolute top-full left-0 mt-2 w-48 rounded-2xl p-2 z-[1000] shadow-2xl border ${
                                    isDarkMode ? 'bg-slate-900 border-white/10' : 'bg-white border-slate-200'
                                  }`}
                                  onClick={(e) => e.stopPropagation()}
                                >
                                  {[
                                    { id: 'online', label: 'Online' },
                                    { id: 'idle', label: 'Away' },
                                    { id: 'dnd', label: 'Do Not Disturb' },
                                    { id: 'invisible', label: 'Invisible' }
                                  ].map((status) => (
                                    <button
                                      key={status.id}
                                      onClick={() => {
                                        setUserStatus(status.id as UserStatus);
                                        onStatusUpdate?.(status.id as UserStatus, customStatus);
                                        setIsStatusDropdownOpen(false);
                                      }}
                                      className={`w-full flex items-center gap-3 p-2 rounded-xl transition-all ${
                                        isDarkMode ? 'hover:bg-white/5' : 'hover:bg-slate-50'
                                      }`}
                                    >
                                      <StatusIndicator status={status.id as UserStatus} />
                                      <span className={`text-xs font-medium ${isDarkMode ? 'text-white/80' : 'text-slate-700'}`}>
                                        {status.label}
                                      </span>
                                    </button>
                                  ))}
                                </motion.div>
                              )}
                            </AnimatePresence>
                          </div>
                          <div className="min-w-0">
                            <h3 className="text-xl font-bold truncate">{userName}</h3>
                            <div className="flex flex-col gap-1">
                              <p className="text-sm opacity-40">Member since {accountCreatedAt.toLocaleDateString(undefined, { month: 'long', day: 'numeric', year: 'numeric' })}</p>
                              {customStatus && (
                                <div className="flex items-center gap-2">
                                  <span className="text-[10px] px-1.5 py-0.5 rounded bg-vylant-blue/10 text-vylant-blue font-bold uppercase tracking-wider">Status</span>
                                  <p className="text-xs italic opacity-60 truncate max-w-[200px]">{customStatus}</p>
                                </div>
                              )}
                            </div>
                          </div>
                        </div>
                        
                        <div className="flex flex-wrap items-center gap-2 md:ml-auto">
                          <button 
                            onClick={() => setUserImage(DEFAULT_AVATARS[Math.floor(Math.random() * DEFAULT_AVATARS.length)])}
                            disabled={DEFAULT_AVATARS.includes(userImage)}
                            className={`flex-1 md:flex-none px-4 py-2 rounded-lg font-bold text-sm transition-all ${
                              DEFAULT_AVATARS.includes(userImage)
                                ? 'opacity-50 cursor-not-allowed ' + (isDarkMode ? 'bg-white/5 text-white/50' : 'bg-slate-100 text-slate-400')
                                : (isDarkMode ? 'bg-white/10 hover:bg-white/20 text-white' : 'bg-slate-200 hover:bg-slate-300 text-slate-900')
                            }`}
                          >
                            Reset Avatar
                          </button>
                          <button 
                            onClick={() => setActiveTab('profile')}
                            className="flex-1 md:flex-none px-4 py-2 bg-vylant-blue text-vylant-navy rounded-lg font-bold text-sm hover:scale-105 transition-all active:scale-95 whitespace-nowrap"
                          >
                            Edit User Profile
                          </button>
                        </div>
                      </div>
                      <div className="space-y-4">
                        <div className="flex justify-between items-center py-3 border-b border-white/5">
                          <div>
                            <p className="text-[10px] font-bold uppercase opacity-40">Username</p>
                            {editingField === 'username' ? (
                              <input value={tempValue} onChange={(e) => setTempValue(e.target.value)} className="bg-transparent border-b border-vylant-blue outline-none text-sm" />
                            ) : (
                              <p className="text-sm">{userName}</p>
                            )}
                          </div>
                          <button onClick={() => { if (editingField === 'username') { setUserName(tempValue); setEditingField(null); } else { setTempValue(userName); setEditingField('username'); } }} className={`text-xs font-bold text-vylant-blue`}>{editingField === 'username' ? 'Save' : 'Edit'}</button>
                        </div>
                        <div className="flex justify-between items-center py-3 border-b border-white/5">
                          <div className="flex-1">
                            <p className="text-[10px] font-bold uppercase opacity-40">Email</p>
                            {editingField === 'email' ? (
                              <div className="mt-2 space-y-3">
                                {emailChangeStep === 'send' && (
                                  <div className="space-y-2">
                                    <p className="text-xs opacity-60">Verification code will be sent to: <span className="text-white font-bold">{userEmail}</span></p>
                                    <button 
                                      onClick={handleSendEmailCode}
                                      disabled={isEmailLoading}
                                      className="px-4 py-2 bg-vylant-blue text-vylant-navy rounded font-bold text-xs disabled:opacity-50"
                                    >
                                      {isEmailLoading ? 'Sending...' : 'Send Verification Code'}
                                    </button>
                                  </div>
                                )}
                                {emailChangeStep === 'verify' && (
                                  <div className="space-y-2">
                                    <p className="text-xs opacity-60">Enter the code sent to your current email:</p>
                                    <input 
                                      value={emailChangeCode} 
                                      onChange={(e) => setEmailChangeCode(e.target.value.replace(/\D/g, '').slice(0, 6))}
                                      placeholder="123456"
                                      className="w-full bg-white/5 border border-white/10 rounded px-3 py-2 outline-none text-sm placeholder:opacity-20" 
                                    />
                                    <button 
                                      onClick={handleVerifyEmailCode}
                                      disabled={isEmailLoading}
                                      className="w-full px-4 py-2 bg-vylant-blue text-vylant-navy rounded font-bold text-xs disabled:opacity-50"
                                    >
                                      {isEmailLoading ? 'Verifying...' : 'Verify Code'}
                                    </button>
                                  </div>
                                )}
                                {emailChangeStep === 'new-email' && (
                                  <div className="space-y-2">
                                    <p className="text-xs opacity-60">{userEmail.includes('@') ? 'Verification successful!' : 'Enter your new email address:'}</p>
                                    <input 
                                      value={tempValue} 
                                      onChange={(e) => setTempValue(e.target.value)} 
                                      placeholder="new-email@example.com"
                                      className="w-full bg-white/5 border border-white/10 rounded px-3 py-2 outline-none text-sm" 
                                    />
                                    <button 
                                      onClick={handleFinalEmailUpdate}
                                      disabled={isEmailLoading}
                                      className="w-full px-4 py-2 bg-vylant-blue text-vylant-navy rounded font-bold text-xs disabled:opacity-50"
                                    >
                                      {isEmailLoading ? 'Saving...' : 'Save New Email'}
                                    </button>
                                  </div>
                                )}
                                {emailError && <p className="text-[10px] text-red-400 font-bold">{emailError}</p>}
                              </div>
                            ) : (
                              <p className="text-sm">{streamerMode ? 'Hidden (Streamer Mode)' : userEmail}</p>
                            )}
                          </div>
                          <button 
                            onClick={() => { 
                              if (editingField === 'email') { 
                                setEditingField(null); 
                                setEmailChangeStep('send');
                                setEmailChangeCode('');
                                setEmailError(null);
                              } else { 
                                setTempValue(userEmail); 
                                setEditingField('email'); 
                                setEmailChangeStep('send');
                              } 
                            }} 
                            className={`text-xs font-bold text-vylant-blue self-start mt-1`}
                          >
                            {editingField === 'email' ? 'Cancel' : (userEmail.includes('@') ? 'Edit' : 'Add')}
                          </button>
                        </div>
                        <div className="flex justify-between items-center py-3 border-b border-white/5">
                          <div>
                            <p className="text-[10px] font-bold uppercase opacity-40">Phone Number</p>
                            {editingField === 'phone' ? (
                              <input 
                                type="text"
                                value={tempValue} 
                                onChange={(e) => setTempValue(e.target.value.replace(/[^0-9]/g, ''))} 
                                className="bg-transparent border-b border-vylant-blue outline-none text-sm" 
                              />
                            ) : (
                              <p className="text-sm">{userPhone || 'You haven\'t added a phone number yet.'}</p>
                            )}
                          </div>
                          <button onClick={() => { if (editingField === 'phone') { setUserPhone(tempValue); setEditingField(null); } else { setTempValue(userPhone); setEditingField('phone'); } }} className={`text-xs font-bold text-vylant-blue`}>{editingField === 'phone' ? 'Save' : (userPhone ? 'Edit' : 'Add')}</button>
                        </div>
                        <div className="flex justify-between items-center py-3 border-b border-white/5">
                          <div className="flex-1 mr-4">
                            <p className="text-[10px] font-bold uppercase opacity-40">Custom Status</p>
                            {editingField === 'customStatus' ? (
                              <input 
                                type="text"
                                value={tempValue} 
                                onChange={(e) => setTempValue(e.target.value)} 
                                placeholder="What's on your mind?"
                                maxLength={100}
                                className="w-full bg-transparent border-b border-vylant-blue outline-none text-sm" 
                              />
                            ) : (
                              <p className="text-sm italic">{customStatus || 'Set a custom status...'}</p>
                            )}
                          </div>
                          <button onClick={() => { 
                            if (editingField === 'customStatus') { 
                              setCustomStatus(tempValue); 
                              onStatusUpdate?.(userStatus, tempValue);
                              setEditingField(null); 
                            } else { 
                              setTempValue(customStatus); 
                              setEditingField('customStatus'); 
                            } 
                          }} className={`text-xs font-bold text-vylant-blue`}>{editingField === 'customStatus' ? 'Save' : (customStatus ? 'Edit' : 'Set')}</button>
                        </div>
                        <div className="flex justify-between items-center py-3">
                          <div>
                            <p className="text-[10px] font-bold uppercase opacity-40">Birthday</p>
                            <p className="text-sm">{userBirthDate ? new Date(userBirthDate).toLocaleDateString(undefined, { month: 'long', day: 'numeric', year: 'numeric' }) : 'Not set'}</p>
                          </div>
                          <div className="text-[10px] bg-white/10 px-2 py-1 rounded opacity-40">LOCKED</div>
                        </div>
                      </div>
                    </div>
                    
                    <div className="space-y-4">
                      <h3 className="text-sm font-bold uppercase tracking-widest opacity-40">Password and Authentication</h3>
                      <button 
                        onClick={() => setIsChangePasswordModalOpen(true)}
                        className="px-4 py-2 bg-vylant-blue text-vylant-navy rounded-lg font-bold text-sm hover:scale-105 transition-all active:scale-95"
                      >
                        Change Password
                      </button>
                      <Toggle label="Two-Factor Authentication" description="Protect your account with an extra layer of security." checked={twoFactorEnabled} onChange={setTwoFactorEnabled} />
                    </div>
                  </div>
                )}

                {activeTab === 'profile' && (
                  <div className="space-y-8">
                    <section>
                      <h3 className={`text-sm font-bold uppercase tracking-widest mb-4 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Profile Customization</h3>
                      <div className="flex items-center gap-6">
                        <div className="flex flex-col items-center gap-3">
                          <div className="relative group cursor-pointer" onClick={() => fileInputRef.current?.click()}>
                            <img src={userImage} className="w-24 h-24 rounded-full object-cover border-4 border-vylant-blue/30" referrerPolicy="no-referrer" />
                            <div className="absolute inset-0 bg-black/40 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                              <Camera className="text-white" size={24} />
                            </div>
                            <input 
                              type="file" 
                              ref={fileInputRef} 
                              onChange={(e) => {
                                const file = e.target.files?.[0];
                                if (file) {
                                  const reader = new FileReader();
                                  reader.onloadend = () => {
                                    setCropImageSrc(reader.result as string);
                                    setCropTarget('profile');
                                    setIsCropModalOpen(true);
                                    e.target.value = '';
                                  };
                                  reader.readAsDataURL(file);
                                }
                              }} 
                              className="hidden" 
                              accept="image/*" 
                            />
                          </div>
                          <button
                            onClick={() => setUserImage(DEFAULT_AVATARS[Math.floor(Math.random() * DEFAULT_AVATARS.length)])}
                            disabled={DEFAULT_AVATARS.includes(userImage)}
                            className={`px-3 py-1.5 rounded-lg font-bold text-xs transition-all ${
                              DEFAULT_AVATARS.includes(userImage)
                                ? 'opacity-50 cursor-not-allowed ' + (isDarkMode ? 'bg-white/5 text-white/50' : 'bg-slate-100 text-slate-400')
                                : (isDarkMode ? 'bg-white/10 hover:bg-white/20 text-white' : 'bg-slate-200 hover:bg-slate-300 text-slate-900')
                            }`}
                          >
                            Reset Avatar
                          </button>
                          {onAddStory && (
                            <button
                              onClick={onAddStory}
                              className={`px-3 py-1.5 rounded-lg text-xs font-bold uppercase tracking-wider transition-all mt-1 ${
                                isDarkMode 
                                  ? 'bg-vylant-blue/20 hover:bg-vylant-blue/30 text-vylant-blue' 
                                  : 'bg-vylant-blue/10 hover:bg-vylant-blue/20 text-vylant-blue'
                              }`}
                            >
                              Add Story
                            </button>
                          )}
                        </div>
                        <div className="flex-1">
                          <label className={`block text-xs font-medium mb-2 ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>Display Name</label>
                          <input 
                            type="text" 
                            value={userName} 
                            onChange={(e) => setUserName(e.target.value)}
                            maxLength={50}
                            className={`w-full px-4 py-3 rounded-xl border transition-all ${
                              isDarkMode ? 'bg-white/5 border-white/10 focus:border-vylant-blue outline-none' : 'bg-slate-50 border-slate-200 focus:border-vylant-blue outline-none'
                            }`}
                          />
                        </div>
                      </div>
                      <div className="mt-8">
                        <label className={`block text-xs font-medium mb-4 ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>Accent Color</label>
                        <div className="flex items-center gap-3">
                          {['#00d2ff', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899'].map(color => (
                            <button
                              key={color}
                              onClick={() => setAccentColor(color)}
                              className={`w-8 h-8 rounded-full transition-transform ${accentColor === color ? 'scale-125 ring-2 ring-white/50' : 'hover:scale-110'}`}
                              style={{ backgroundColor: color }}
                            />
                          ))}
                          <DebouncedColorInput 
                            value={accentColor} 
                            onChange={setAccentColor}
                            className="w-8 h-8 rounded-full border-none cursor-pointer bg-transparent"
                          />
                        </div>
                      </div>

                      <div className="mt-8">
                        <label className={`block text-xs font-medium mb-4 ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>Story Ring Color</label>
                        <div className="flex flex-wrap gap-3">
                          {[
                            { id: 'bg-gradient-to-tr from-cyan-400 to-blue-600', label: 'Ocean Blue', class: 'bg-gradient-to-tr from-cyan-400 to-blue-600' },
                            { id: 'bg-gradient-to-tr from-emerald-400 to-teal-600', label: 'Forest', class: 'bg-gradient-to-tr from-emerald-400 to-teal-600' },
                            { id: 'bg-gradient-to-tr from-rose-400 to-orange-500', label: 'Sunset', class: 'bg-gradient-to-tr from-rose-400 to-orange-500' },
                            { id: 'bg-gradient-to-tr from-amber-400 to-red-500', label: 'Fire', class: 'bg-gradient-to-tr from-amber-400 to-red-500' },
                            { id: 'bg-gradient-to-tr from-fuchsia-500 to-purple-600', label: 'Neon', class: 'bg-gradient-to-tr from-fuchsia-500 to-purple-600' },
                          ].map(ring => (
                            <button
                              key={ring.id}
                              onClick={() => setStoryRingColor(ring.id)}
                              title={ring.label}
                              className={`w-8 h-8 rounded-full border-2 transition-transform hover:scale-110 ${storyRingColor === ring.id ? 'border-white scale-110' : 'border-transparent'} ${ring.class}`}
                            />
                          ))}
                        </div>
                      </div>

                      <div className="mt-8">
                        <label className={`block text-xs font-medium mb-4 ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>Font Size ({fontSize}px)</label>
                        <DebouncedRangeInput 
                          min={12} 
                          max={24} 
                          value={fontSize} 
                          onChange={setFontSize}
                          className="w-full accent-vylant-blue"
                        />
                      </div>
                    </section>
                  </div>
                )}

                {activeTab === 'privacy' && (
                  <div className="space-y-6">
                    <Toggle label="Allow direct messages from users who arent your friends" description="If disabled, only your friends will be able to send you direct messages." checked={allowDirectMessages} onChange={setAllowDirectMessages} />
                    <Toggle label="Allow friend incoming friend requests" description="If off, you may send friend requests to others but you are not able to receive them." checked={allowIncomingFriendRequests} onChange={setAllowIncomingFriendRequests} />
                    <Toggle label="Allow data collection for analytics" description="We use this data to improve the Vylant experience." checked={allowDataCollection} onChange={setAllowDataCollection} />
                    <div className="pt-6 border-t border-white/5">
                      <h3 className="text-sm font-bold mb-2">Story Privacy</h3>
                      <p className="text-xs opacity-40 mb-4">Control who can view your stories.</p>
                      <div className="flex gap-2">
                        {['everyone', 'friends', 'custom'].map(option => (
                          <button
                            key={option}
                            onClick={() => setStoryPrivacy(option as any)}
                            className={`px-4 py-2 rounded-lg font-bold text-sm transition-all ${
                              storyPrivacy === option
                                ? 'bg-vylant-blue text-vylant-navy'
                                : isDarkMode ? 'bg-white/10 hover:bg-white/20' : 'bg-slate-100 hover:bg-slate-200'
                            }`}
                          >
                            {option.charAt(0).toUpperCase() + option.slice(1)}
                          </button>
                        ))}
                      </div>
                    </div>
                    <div className="pt-6 border-t border-white/5">
                      <h3 className="text-sm font-bold mb-2">Request My Data</h3>
                      <p className="text-xs opacity-40 mb-4">You can request a copy of all the data we have collected about you.</p>
                      <button onClick={onRequestData} className={`px-4 py-2 rounded-lg font-bold text-sm ${isDarkMode ? 'bg-white/10 hover:bg-white/20' : 'bg-slate-100 hover:bg-slate-200'}`}>Request Data</button>
                    </div>
                  </div>
                )}

                {activeTab === 'blocked-users' && (
                  <div className="space-y-6">
                    <p className="text-sm opacity-60 mb-6">These users are blocked and cannot send you direct messages or friend requests.</p>
                    {blockedUsers.length === 0 ? (
                      <div className="flex flex-col items-center justify-center py-12 text-center">
                        <div className={`w-16 h-16 rounded-full flex items-center justify-center mb-4 ${isDarkMode ? 'bg-white/5 text-white/20' : 'bg-slate-100 text-slate-400'}`}>
                          <Ban size={32} />
                        </div>
                        <h3 className="text-lg font-bold mb-2">No Blocked Users</h3>
                        <p className="text-sm opacity-60 max-w-sm">You haven't blocked anyone yet. When you block someone, they will appear here.</p>
                      </div>
                    ) : (
                      <div className="space-y-2">
                        {blockedUsers.map((user) => (
                          <div key={user.id} className={`flex items-center justify-between p-4 rounded-2xl border ${isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'}`}>
                            <div className="flex items-center gap-4">
                              <img src={user.image} alt={user.name} className="w-12 h-12 rounded-full object-cover" referrerPolicy="no-referrer" />
                              <h4 className="font-bold">{user.name}</h4>
                            </div>
                            <button
                              onClick={() => handleUnblockUser(user)}
                              className="px-4 py-2 rounded-xl text-sm font-bold bg-vylant-blue text-white shadow-lg shadow-vylant-blue/20 transition-all hover:scale-105 active:scale-95"
                            >
                              Unblock
                            </button>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                )}

                {activeTab === 'devices' && (
                  <div className="space-y-4">
                    <div className="flex items-center justify-between mb-2">
                       <p className="text-sm opacity-60">Here are all the devices currently logged into your Vylant account.</p>
                       <div className="flex gap-2">
                         <button 
                           onClick={fetchConnectedSessions}
                           className={`p-2 rounded-xl transition-all ${isDarkMode ? 'bg-white/5 hover:bg-white/10 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'}`}
                           title="Refresh Sessions"
                         >
                           <RefreshCw size={14} />
                         </button>
                         <button 
                           onClick={() => {
                             if (confirm('Are you sure you want to log out of ALL other sessions?')) {
                               logoutAllSessions();
                             }
                           }}
                           className="px-4 py-2 rounded-xl text-xs font-bold bg-red-500/10 text-red-500 hover:bg-red-500/20 transition-all"
                         >
                           Logout All
                         </button>
                       </div>
                    </div>
                    
                    <div className="space-y-3">
                      {connectedDevices.map((device) => (
                        <div key={device.id} className={`flex items-center gap-4 p-4 rounded-2xl border transition-all ${isDarkMode ? 'bg-white/5 border-white/10 hover:bg-white/[0.08]' : 'bg-slate-50 border-slate-200 hover:bg-slate-100'}`}>
                          <div className={`p-3 rounded-xl ${isDarkMode ? 'bg-white/5' : 'bg-white shadow-sm'}`}>
                            {device.deviceName?.includes('iPhone') || device.deviceName?.includes('Android') ? <Smartphone size={24} className="text-vylant-blue" /> : <Monitor size={24} className="text-vylant-blue" />}
                          </div>
                          <div className="flex-1 min-w-0">
                            <div className="flex items-center gap-2">
                              <h4 className="font-bold text-sm truncate">{device.deviceName} • {device.browser}</h4>
                              {device.isCurrent && (
                                <span className="px-2 py-0.5 rounded-full bg-green-500/10 text-green-500 text-[10px] font-bold uppercase tracking-wider">Current</span>
                              )}
                            </div>
                            <p className="text-xs opacity-40 truncate">
                              {device.location} {device.ip && `(${device.ip})`} • 
                              {device.id === currentSocketId ? ' Active Now' : ` Last seen ${new Date(device.lastActive).toLocaleDateString()}`}
                            </p>
                          </div>
                          {!device.isCurrent && (
                            <button 
                              onClick={async () => {
                                try {
                                  await apiFetch('/api/logout-session', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ sessionId: device.id })
                                  });
                                  fetchConnectedSessions();
                                } catch (e) {
                                  console.error('Failed to logout session:', e);
                                }
                              }}
                              className={`p-2 rounded-lg text-xs font-bold transition-all ${isDarkMode ? 'text-red-400 hover:bg-red-400/10' : 'text-red-500 hover:bg-red-500/10'}`}
                            >
                              Revoke
                            </button>
                          )}
                        </div>
                      ))}
                    </div>

                    <div className={`p-4 rounded-2xl border ${isDarkMode ? 'bg-amber-500/5 border-amber-500/10 text-amber-200/60' : 'bg-amber-50 border-amber-200 text-amber-700'} text-xs leading-relaxed`}>
                      <div className="flex items-start gap-2">
                        <Activity size={14} className="mt-0.5" />
                        <p>If you see a device or location you don't recognize, we recommend changing your password immediately to secure your account.</p>
                      </div>
                    </div>
                  </div>
                )}

                {activeTab === 'appearance' && (
                  <div className="space-y-8">
                    {/* Global Reset Button */}
                    <div className={`p-6 rounded-3xl border transition-all ${isDarkMode ? 'bg-vylant-blue/10 border-vylant-blue/30 shadow-[0_0_50px_-12px_rgba(37,99,235,0.2)]' : 'bg-vylant-blue/5 border-vylant-blue/20 shadow-sm'}`}>
                      <div className="flex flex-col md:flex-row items-center justify-between gap-6">
                        <div>
                          <h3 className="text-xl font-bold mb-1">Appearance Reset</h3>
                          <p className="text-sm opacity-60 max-w-md">Restore the original Vylant look. This reverts your accent color, story ring, font size, and theme to their defaults.</p>
                        </div>
                        <button 
                          onClick={() => setIsResetConfirmationOpen(true)}
                          className="flex items-center gap-3 px-8 py-4 rounded-2xl font-bold bg-vylant-blue text-white hover:scale-105 hover:shadow-xl hover:shadow-vylant-blue/30 active:scale-95 transition-all"
                        >
                          <RefreshCw size={20} />
                          <span>Reset to Default</span>
                        </button>
                      </div>
                    </div>

                    <section>
                      <h3 className={`text-sm font-bold uppercase tracking-widest mb-4 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Accent Color</h3>
                      <div className="flex flex-wrap gap-3 items-center">
                        {['#00d2ff', '#ff00d2', '#00ff8c', '#ff8c00', '#8c00ff', '#ff4444'].map(color => (
                          <button
                            key={color}
                            onClick={() => setAccentColor(color)}
                            className={`w-10 h-10 rounded-full border-2 transition-transform hover:scale-110 ${accentColor === color ? 'border-white scale-110' : 'border-transparent'}`}
                            style={{ backgroundColor: color }}
                          />
                        ))}
                        <DebouncedColorInput value={accentColor} onChange={setAccentColor} className="w-10 h-10 rounded-full border-none cursor-pointer bg-transparent" />
                      </div>
                    </section>

                    <section>
                      <h3 className={`text-sm font-bold uppercase tracking-widest mb-4 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Story Ring Color</h3>
                      <div className="flex flex-wrap gap-3">
                        {[
                          { id: 'bg-gradient-to-tr from-cyan-400 to-blue-600', label: 'Ocean Blue', class: 'bg-gradient-to-tr from-cyan-400 to-blue-600' },
                          { id: 'bg-gradient-to-tr from-emerald-400 to-teal-600', label: 'Forest', class: 'bg-gradient-to-tr from-emerald-400 to-teal-600' },
                          { id: 'bg-gradient-to-tr from-rose-400 to-orange-500', label: 'Sunset', class: 'bg-gradient-to-tr from-rose-400 to-orange-500' },
                          { id: 'bg-gradient-to-tr from-amber-400 to-red-500', label: 'Fire', class: 'bg-gradient-to-tr from-amber-400 to-red-500' },
                          { id: 'bg-gradient-to-tr from-fuchsia-500 to-purple-600', label: 'Neon', class: 'bg-gradient-to-tr from-fuchsia-500 to-purple-600' },
                          { id: 'bg-gradient-to-tr from-yellow-400 via-red-500 to-purple-500', label: 'Instagram', class: 'bg-gradient-to-tr from-yellow-400 via-red-500 to-purple-500' },
                          { id: 'bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500', label: 'Cosmic', class: 'bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500' },
                          { id: 'bg-gradient-to-tr from-slate-800 to-indigo-900', label: 'Midnight', class: 'bg-gradient-to-tr from-slate-800 to-indigo-900' },
                        ].map(ring => (
                          <button
                            key={ring.id}
                            onClick={() => setStoryRingColor(ring.id)}
                            title={ring.label}
                            className={`w-10 h-10 rounded-full border-2 transition-transform hover:scale-110 ${storyRingColor === ring.id ? 'border-white scale-110' : 'border-transparent'} ${ring.class}`}
                          />
                        ))}
                      </div>
                    </section>

                    <section>
                      <h3 className={`text-sm font-bold uppercase tracking-widest mb-4 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Font Size ({fontSize}px)</h3>
                      <DebouncedRangeInput min={12} max={24} value={fontSize} onChange={setFontSize} className="w-full accent-vylant-blue" />
                      <div className="flex justify-between text-[10px] mt-1 opacity-40"><span>Small</span><span>Large</span></div>
                    </section>

                    <section>
                      <h3 className={`text-sm font-bold uppercase tracking-widest mb-4 ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>Theme Preset</h3>
                      <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                        {[
                          { id: 'default', label: 'Vylant', bg: 'bg-[#171e33]' },
                          { id: 'light', label: 'Light', bg: 'bg-[#ffffff]' },
                          { id: 'midnight', label: 'Midnight', bg: 'bg-[#000000]' },
                          { id: 'forest', label: 'Forest', bg: 'bg-[#0a1e0a]' },
                          { id: 'sunset', label: 'Sunset', bg: 'bg-[#1e0a0a]' },
                          { id: 'ocean', label: 'Ocean', bg: 'bg-[#0a192f]' },
                          { id: 'berry', label: 'Berry', bg: 'bg-[#1f0d1f]' },
                          { id: 'desert', label: 'Desert', bg: 'bg-[#1a1410]' },
                          { id: 'slate', label: 'Slate', bg: 'bg-[#0f172a]' },
                          { id: 'glass', label: 'Glass', bg: 'bg-white/10 backdrop-blur-md bg-gradient-to-br from-white/10 to-transparent' },
                          { id: 'custom', label: 'Custom', isCustom: true }
                        ].map(theme => (
                          <button
                            key={theme.id}
                            onClick={() => { setCustomTheme(theme.id); }}
                            className={`p-4 rounded-2xl border-2 transition-all text-center relative ${
                              customTheme === theme.id ? 'border-vylant-blue bg-vylant-blue/10' : isDarkMode ? 'border-white/5 hover:border-white/20 bg-white/5' : 'border-slate-200 hover:border-slate-300 bg-slate-50'
                            }`}
                          >
                            {theme.isCustom ? (
                              <div className="w-full h-12 rounded-lg mb-2 border border-slate-200 dark:border-white/10 relative" style={{ backgroundColor: customThemeColor }}>
                                <DebouncedColorInput value={customThemeColor} onChange={(val) => {
                                  setCustomThemeColor(val);
                                  setCustomTheme('custom');
                                }} onInput={(color) => {
                                  if (customTheme === 'custom' || customTheme === 'default') {
                                    const root = document.documentElement;
                                    root.style.setProperty('--bg-primary', color);
                                    root.style.setProperty('--bg-gradient', `radial-gradient(circle at top center, ${color}cc 0%, ${color} 100%)`);
                                  }
                                }} className="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
                              </div>
                            ) : (
                              <div className={`w-full h-12 rounded-lg mb-2 ${theme.bg} border border-slate-200 dark:border-white/10`} />
                            )}
                            <span className="text-xs font-bold">{theme.label}</span>
                          </button>
                        ))}
                      </div>
                    </section>
                  </div>
                )}

                {activeTab === 'notifications' && (
                  <div className="space-y-6">
                    <Toggle 
                      label="Enable Desktop Notifications" 
                      description="Receive desktop alerts when new messages or mentions arrive."
                      checked={desktopNotifications} 
                      onChange={handleDesktopNotifToggle} 
                    />
                    <Toggle label="Enable Sound Notifications" description="Play a notification sound for incoming messages." checked={soundNotifications} onChange={setSoundNotifications} />
                    <Toggle label="Enable Email Notifications" description="Receive summary digest emails for offline activity." checked={emailNotifications} onChange={setEmailNotifications} />
                    <Toggle label="Notify me about new friends" description="Get notified when someone accepts your friend request." checked={friendNotifications} onChange={setFriendNotifications} />
                    
                    <div className="pt-4 border-t border-white/5 flex items-center justify-between">
                      <div>
                        <h4 className="text-sm font-bold">Test Notification Alert</h4>
                        <p className="text-xs opacity-50">Send a test desktop popup notification to verify browser permissions.</p>
                      </div>
                      <button
                        onClick={() => handleDesktopNotifToggle(true)}
                        className={`px-4 py-2 rounded-xl text-xs font-bold transition-all ${isDarkMode ? 'bg-white/10 hover:bg-white/20 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-800'}`}
                      >
                        Send Test Alert
                      </button>
                    </div>

                    {desktopNotifFeedback && (
                      <motion.div initial={{ opacity: 0, y: -5 }} animate={{ opacity: 1, y: 0 }} className="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-400 font-bold flex items-center gap-2">
                        <Check size={14} />
                        <span>{desktopNotifFeedback}</span>
                      </motion.div>
                    )}
                  </div>
                )}

                {activeTab === 'sound' && (
                  <div className="space-y-6">
                    <div>
                      <div className="flex items-center justify-between mb-2">
                        <label className="block text-xs font-bold uppercase opacity-40">Master Volume ({masterVolume}%)</label>
                        <button
                          onClick={playTestSound}
                          className="text-xs font-bold text-vylant-blue hover:underline flex items-center gap-1 cursor-pointer"
                        >
                          <Volume2 size={14} />
                          <span>Test Sound</span>
                        </button>
                      </div>
                      <DebouncedRangeInput min={0} max={100} value={masterVolume} onChange={setMasterVolume} className="w-full accent-vylant-blue" />
                    </div>
                    <Toggle label="Sound Effects" description="Play sounds for messages, mentions, and other events." checked={soundEffectsEnabled} onChange={setSoundEffectsEnabled} />
                    
                    <div className="space-y-3">
                      <Toggle label="Text-to-Speech" description="Read out incoming messages automatically." checked={ttsEnabled} onChange={setTtsEnabled} />
                      {ttsEnabled && (
                        <div className="flex justify-end">
                          <button
                            onClick={testTTS}
                            className={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 ${isDarkMode ? 'bg-white/10 hover:bg-white/20' : 'bg-slate-100 hover:bg-slate-200'}`}
                          >
                            <Volume2 size={12} />
                            Test Voice Reading
                          </button>
                        </div>
                      )}
                    </div>
                  </div>
                )}

                {activeTab === 'voice-video' && (
                  <div className="space-y-6">
                    <div className="grid grid-cols-2 gap-6">
                      <div>
                        <label className="block text-xs font-bold uppercase opacity-40 mb-2">Input Device</label>
                        <select 
                          value={selectedInputDevice}
                          onChange={(e) => setSelectedInputDevice(e.target.value)}
                          className={`w-full p-3 rounded-xl border outline-none transition-all focus:ring-2 focus:ring-vylant-blue/50 ${isDarkMode ? 'bg-slate-800 border-white/10 text-white' : 'bg-slate-50 border-slate-200 text-slate-900'}`}
                        >
                          {audioInputs.length > 0 ? (
                            audioInputs.map(device => (
                              <option key={device.deviceId} value={device.deviceId} className={isDarkMode ? 'bg-slate-800 text-white' : 'bg-white text-slate-900'}>
                                {device.label || `Microphone ${device.deviceId.slice(0, 5)}`}
                              </option>
                            ))
                          ) : (
                            <option value="default" className={isDarkMode ? 'bg-slate-800 text-white' : 'bg-white text-slate-900'}>Default Microphone</option>
                          )}
                        </select>
                      </div>
                      <div>
                        <label className="block text-xs font-bold uppercase opacity-40 mb-2">Output Device</label>
                        <select 
                          value={selectedOutputDevice}
                          onChange={(e) => setSelectedOutputDevice(e.target.value)}
                          className={`w-full p-3 rounded-xl border outline-none transition-all focus:ring-2 focus:ring-vylant-blue/50 ${isDarkMode ? 'bg-slate-800 border-white/10 text-white' : 'bg-slate-50 border-slate-200 text-slate-900'}`}
                        >
                          {audioOutputs.length > 0 ? (
                            audioOutputs.map(device => (
                              <option key={device.deviceId} value={device.deviceId} className={isDarkMode ? 'bg-slate-800 text-white' : 'bg-white text-slate-900'}>
                                {device.label || `Speaker ${device.deviceId.slice(0, 5)}`}
                              </option>
                            ))
                          ) : (
                            <option value="default" className={isDarkMode ? 'bg-slate-800 text-white' : 'bg-white text-slate-900'}>Default Speakers</option>
                          )}
                        </select>
                      </div>
                    </div>
                    <div>
                      <label className="block text-xs font-bold uppercase opacity-40 mb-2">Camera</label>
                      <select 
                        value={selectedVideoDevice}
                        onChange={(e) => setSelectedVideoDevice(e.target.value)}
                        className={`w-full p-3 rounded-xl border outline-none transition-all focus:ring-2 focus:ring-vylant-blue/50 ${isDarkMode ? 'bg-slate-800 border-white/10 text-white' : 'bg-slate-50 border-slate-200 text-slate-900'}`}
                      >
                        {videoInputs.length > 0 ? (
                          videoInputs.map(device => (
                            <option key={device.deviceId} value={device.deviceId} className={isDarkMode ? 'bg-slate-800 text-white' : 'bg-white text-slate-900'}>
                              {device.label || `Camera ${device.deviceId.slice(0, 5)}`}
                            </option>
                          ))
                        ) : (
                          <option value="default" className={isDarkMode ? 'bg-slate-800 text-white' : 'bg-white text-slate-900'}>Default Camera</option>
                        )}
                      </select>
                    </div>
                    <div className="flex justify-end">
                      <button 
                        onClick={refreshDevices}
                        className={`flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium transition-all ${isDarkMode ? 'bg-white/5 hover:bg-white/10 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'}`}
                      >
                        <RefreshCw size={14} />
                        Refresh Devices
                      </button>
                    </div>
                    <Toggle label="Echo Cancellation" checked={echoCancellation} onChange={setEchoCancellation} />
                    <Toggle label="Noise Suppression" checked={noiseSuppression} onChange={setNoiseSuppression} />
                    <Toggle label="Automatic Gain Control" checked={automaticGainControl} onChange={setAutomaticGainControl} />
                    <div className="pt-6 border-t border-white/5 space-y-3">
                      <h3 className="text-sm font-bold mb-2">Test Microphone</h3>
                      <button 
                        onClick={() => setIsTestMicEnabled(!isTestMicEnabled)}
                        className={`w-full p-4 rounded-xl font-bold text-sm transition-all cursor-pointer ${
                          isTestMicEnabled 
                            ? 'bg-red-500/10 text-red-500 hover:bg-red-500/20' 
                            : 'bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500/20'
                        }`}
                      >
                        {isTestMicEnabled ? 'Stop Testing' : 'Start Microphone Test'}
                      </button>
                      {isTestMicEnabled && (
                        <motion.div initial={{ opacity: 0, height: 0 }} animate={{ opacity: 1, height: 'auto' }} className="p-4 rounded-xl bg-black/20 border border-white/10 space-y-2">
                          <div className="flex items-center justify-between text-xs font-bold opacity-60">
                            <span>Microphone Input Level</span>
                            <span className="text-emerald-400 animate-pulse">Live</span>
                          </div>
                          <div className="flex items-center gap-1 h-6">
                            {[40, 65, 30, 85, 90, 50, 75, 60, 95, 45, 70, 80, 55, 35, 90, 65, 40, 80].map((h, i) => (
                              <motion.div
                                key={i}
                                animate={{ height: ['20%', `${h}%`, '30%'] }}
                                transition={{ repeat: Infinity, duration: 0.4 + (i % 5) * 0.1, ease: 'easeInOut' }}
                                className="flex-1 bg-gradient-to-t from-vylant-blue to-emerald-400 rounded-full"
                              />
                            ))}
                          </div>
                          <p className="text-[10px] opacity-40 text-center">Speak into your microphone to verify audio input volume.</p>
                        </motion.div>
                      )}
                    </div>
                  </div>
                )}

                {activeTab === 'chat' && (
                  <div className="space-y-6">
                    <Toggle label="Display Images and Videos" description="Show media directly in the chat." checked={displayImagesVideos} onChange={setDisplayImagesVideos} />
                    <Toggle label="Show Link Previews" description="Show a preview of links sent in chat." checked={showLinkPreviews} onChange={setShowLinkPreviews} />
                    <Toggle label="Compact Message View" description="Reduce spacing between messages." checked={compactMessageView} onChange={setCompactMessageView} />
                    <Toggle label="Show Timestamps" checked={showTimestamps} onChange={setShowTimestamps} />

                    {/* Vylant SafeLink Shield Protection Card */}
                    <div className={`p-5 rounded-2xl border space-y-4 ${
                      isDarkMode ? 'bg-transparent border-white/10' : 'bg-transparent border-slate-200'
                    }`}>
                      <div className="flex items-center justify-between gap-3">
                        <div className="flex items-center gap-3">
                          <div className="p-2.5 rounded-xl bg-vylant-blue/10 border border-vylant-blue/30 text-vylant-blue">
                            <Shield size={20} />
                          </div>
                          <div>
                            <h4 className="text-sm font-bold flex items-center gap-2">
                              Vylant SafeLink Shield
                              <span className="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
                                Active Protection
                              </span>
                            </h4>
                            <p className="text-xs opacity-60">
                              Automatically routes and scans links sent in chat for phishing, malware, and lookalike attacks.
                            </p>
                          </div>
                        </div>
                        {setSafeLinkEnabled && (
                          <Toggle 
                            label="" 
                            checked={safeLinkEnabled ?? true} 
                            onChange={setSafeLinkEnabled} 
                          />
                        )}
                      </div>

                      {setStripTrackingEnabled && (
                        <div className="pt-3 border-t border-white/5">
                          <Toggle 
                            label="Privacy URL Sanitizer" 
                            description="Automatically strip tracking tags (utm_source, fbclid, etc.) from links." 
                            checked={stripTrackingEnabled ?? true} 
                            onChange={setStripTrackingEnabled} 
                          />
                        </div>
                      )}

                      {/* Trusted Domains Management */}
                      <div className="pt-3 border-t border-white/5 space-y-2">
                        <div className="flex items-center justify-between">
                          <div>
                            <div className="text-xs font-bold">Trusted Whitelist Domains ({trustedList.length})</div>
                            <div className="text-[11px] opacity-60">Verified domains that bypass manual external confirmation.</div>
                          </div>
                        </div>
                        <div className="flex gap-2">
                          <input
                            type="text"
                            placeholder="e.g. example.com"
                            value={newDomainInput}
                            onChange={(e) => setNewDomainInput(e.target.value)}
                            onKeyDown={(e) => { if (e.key === 'Enter') { e.preventDefault(); handleAddDomain(); } }}
                            className={`flex-1 px-3 py-1.5 rounded-xl border text-xs outline-none ${
                              isDarkMode ? 'bg-white/5 border-white/10 text-white focus:border-vylant-blue' : 'bg-white border-slate-200 text-slate-900 focus:border-vylant-blue'
                            }`}
                          />
                          <button
                            type="button"
                            onClick={handleAddDomain}
                            className="px-3 py-1.5 bg-vylant-blue hover:bg-cyan-400 text-slate-950 font-bold text-xs rounded-xl transition-all"
                          >
                            Add
                          </button>
                        </div>
                        <div className="flex flex-wrap gap-1.5 max-h-28 overflow-y-auto pr-1 pt-1">
                          {trustedList.map(domain => (
                            <span 
                              key={domain} 
                              className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs border ${
                                isDarkMode ? 'bg-white/5 border-white/10 text-white/80' : 'bg-white border-slate-200 text-slate-700'
                              }`}
                            >
                              <span>{domain}</span>
                              <button 
                                type="button"
                                onClick={() => {
                                  const updated = removeTrustedDomain(domain);
                                  setTrustedList(updated);
                                }}
                                className="opacity-40 hover:opacity-100 hover:text-red-400 transition-opacity"
                                title={`Remove ${domain}`}
                              >
                                <X size={12} />
                              </button>
                            </span>
                          ))}
                        </div>
                      </div>
                    </div>
                    {dmSortMode && setDmSortMode && (
                      <div className="space-y-2 pt-4 border-t border-slate-200 dark:border-white/10">
                        <label className="text-sm font-medium opacity-80">Direct Message Sort Order</label>
                        <CustomDropdown 
                          options={['Most Recent', 'Unread First']}
                          value={dmSortMode === 'recent' ? 'Most Recent' : 'Unread First'} 
                          onChange={(val) => setDmSortMode(val === 'Most Recent' ? 'recent' : 'unread')}
                          isDarkMode={isDarkMode}
                        />
                      </div>
                    )}
                  </div>
                )}

                {activeTab === 'translate' && (
                  <div className="space-y-6">
                    <Toggle label="Enable Translation Feature" description="Automatically translate messages sent by others." checked={isTranslationEnabled} onChange={setIsTranslationEnabled} />
                    {isTranslationEnabled && (
                      <div className="space-y-6">
                        <div className="space-y-2">
                          <label className="text-sm font-medium opacity-80">Translate to</label>
                          <CustomDropdown 
                            options={['English', 'Spanish', 'French', 'German', 'Chinese', 'Japanese', 'Korean', 'Russian', 'Portuguese', 'Italian']}
                            value={targetLanguage} 
                            onChange={setTargetLanguage}
                            isDarkMode={isDarkMode}
                          />
                        </div>
                        <Toggle label="Show Original Message" description="Display the original text alongside the translation." checked={showOriginalMessage} onChange={setShowOriginalMessage} />
                      </div>
                    )}
                  </div>
                )}

                {activeTab === 'keybinds' && (
                  <div className="space-y-4">
                    <div className="flex items-center justify-between mb-2">
                      <p className="text-sm opacity-60">Customize your shortcuts for faster navigation.</p>
                      <button 
                        onClick={() => {
                          setKeybinds([
                            { action: 'Mute Microphone', key: 'Ctrl + M' },
                            { action: 'Deafen Audio', key: 'Ctrl + D' },
                            { action: 'Search', key: 'Ctrl + K' },
                            { action: 'Toggle Settings', key: 'Ctrl + /' },
                            { action: 'Toggle Dark Mode', key: 'Ctrl + Shift + D' }
                          ]);
                        }}
                        className="text-xs text-vylant-blue hover:underline font-bold"
                      >
                        Reset to Defaults
                      </button>
                    </div>

                    {keybinds.map((kb: any, index: number) => (
                      <div key={kb.action || index} className={`flex justify-between items-center p-4 rounded-2xl border ${isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'}`}>
                        <span className="text-sm font-medium">{kb.action}</span>
                        <div className="flex items-center gap-2">
                          {editingField === `keybind-${kb.action}` ? (
                            <div 
                              className="bg-transparent border-b border-vylant-blue outline-none text-sm cursor-pointer px-2 py-1"
                              onKeyDown={(e) => {
                                  e.preventDefault();
                                  const newKey = [];
                                  if (e.ctrlKey) newKey.push('Ctrl');
                                  if (e.altKey) newKey.push('Alt');
                                  if (e.shiftKey) newKey.push('Shift');
                                  if (e.key !== 'Control' && e.key !== 'Alt' && e.key !== 'Shift') {
                                      newKey.push(e.key === ' ' ? 'Space' : e.key.length === 1 ? e.key.toUpperCase() : e.key);
                                  }
                                  const keyString = newKey.join(' + ');
                                  if (keyString) {
                                      setKeybinds(keybinds.map(k => k.action === kb.action ? { ...k, key: keyString } : k));
                                      setEditingField(null);
                                  }
                              }}
                              onBlur={() => setEditingField(null)}
                              tabIndex={0}
                              autoFocus
                            >
                              Press shortcut...
                            </div>
                          ) : (
                            <span 
                              onClick={() => { setTempValue(kb.key); setEditingField(`keybind-${kb.action}`); }}
                              className={`px-3 py-1 rounded-lg text-xs font-bold cursor-pointer transition-all hover:scale-105 ${isDarkMode ? 'bg-white/10 hover:bg-white/20' : 'bg-slate-200 hover:bg-slate-300'}`}
                              title="Click to edit keybind"
                            >
                              {kb.key}
                            </span>
                          )}
                          {keybinds.length > 3 && (
                            <button 
                              onClick={() => setKeybinds(keybinds.filter((_, i) => i !== index))}
                              className="p-1 rounded text-red-400 hover:bg-red-400/10 transition-colors cursor-pointer"
                              title="Remove Keybind"
                            >
                              <Trash2 size={14} />
                            </button>
                          )}
                        </div>
                      </div>
                    ))}

                    {!isAddingKeybind ? (
                      <button 
                        onClick={() => setIsAddingKeybind(true)}
                        className="w-full py-3 border-2 border-dashed border-white/10 hover:border-vylant-blue rounded-2xl text-sm font-bold opacity-60 hover:opacity-100 transition-all flex items-center justify-center gap-2 cursor-pointer"
                      >
                        <Plus size={16} />
                        <span>Add a Keybind</span>
                      </button>
                    ) : (
                      <motion.div initial={{ opacity: 0, y: -5 }} animate={{ opacity: 1, y: 0 }} className={`p-4 rounded-2xl border space-y-3 ${isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'}`}>
                        <div className="flex justify-between items-center">
                          <h4 className="text-xs font-bold uppercase tracking-wider">New Custom Shortcut</h4>
                          <button onClick={() => setIsAddingKeybind(false)} className="text-xs opacity-50 hover:opacity-100"><X size={14} /></button>
                        </div>
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                          <div>
                            <label className="text-[10px] font-bold uppercase opacity-40 block mb-1">Action</label>
                            <select
                              value={newKeybindAction}
                              onChange={(e) => setNewKeybindAction(e.target.value)}
                              className={`w-full p-2.5 rounded-xl border text-xs outline-none ${isDarkMode ? 'bg-slate-800 border-white/10 text-white' : 'bg-white border-slate-200 text-slate-900'}`}
                            >
                              <option value="Toggle Dark Mode">Toggle Dark Mode</option>
                              <option value="Toggle Fullscreen">Toggle Fullscreen</option>
                              <option value="Toggle Friends List">Toggle Friends List</option>
                              <option value="Mute Microphone">Mute Microphone</option>
                              <option value="Deafen Audio">Deafen Audio</option>
                              <option value="Search">Search</option>
                              <option value="Toggle Settings">Toggle Settings</option>
                            </select>
                          </div>
                          <div>
                            <label className="text-[10px] font-bold uppercase opacity-40 block mb-1">Shortcut Key</label>
                            <input
                              type="text"
                              value={newKeybindKey}
                              onChange={(e) => setNewKeybindKey(e.target.value)}
                              placeholder="e.g. Ctrl + Shift + D"
                              className={`w-full p-2.5 rounded-xl border text-xs outline-none ${isDarkMode ? 'bg-slate-800 border-white/10 text-white' : 'bg-white border-slate-200 text-slate-900'}`}
                            />
                          </div>
                        </div>
                        <div className="flex justify-end gap-2 pt-2">
                          <button onClick={() => setIsAddingKeybind(false)} className="px-3 py-1.5 rounded-lg text-xs font-bold opacity-60 hover:opacity-100">Cancel</button>
                          <button 
                            onClick={() => {
                              if (newKeybindAction && newKeybindKey) {
                                setKeybinds([...keybinds, { action: newKeybindAction, key: newKeybindKey }]);
                                setIsAddingKeybind(false);
                              }
                            }}
                            className="px-4 py-1.5 rounded-lg text-xs font-bold bg-vylant-blue text-white shadow-md hover:scale-105 active:scale-95 transition-all"
                          >
                            Save Keybind
                          </button>
                        </div>
                      </motion.div>
                    )}
                  </div>
                )}

                {activeTab === 'language' && (
                  <div className="space-y-6">
                    <div>
                      <label className="block text-xs font-bold uppercase opacity-40 mb-2">Language</label>
                      <select 
                        value={appLanguage}
                        onChange={(e) => {
                          setAppLanguage(e.target.value);
                          setLanguageFeedback(`App language changed to ${e.target.value}`);
                          setTimeout(() => setLanguageFeedback(null), 3000);
                        }}
                        className={`w-full p-3 rounded-xl border outline-none cursor-pointer ${isDarkMode ? 'bg-white/5 border-white/10 text-white' : 'bg-slate-50 border-slate-200 text-slate-900'}`}
                      >
                        <option>English (US)</option>
                        <option>Spanish</option>
                        <option>French</option>
                        <option>German</option>
                        <option>Japanese</option>
                        <option>Portuguese</option>
                      </select>
                    </div>

                    {languageFeedback && (
                      <motion.div initial={{ opacity: 0, y: -5 }} animate={{ opacity: 1, y: 0 }} className="p-3 rounded-xl bg-vylant-blue/10 border border-vylant-blue/20 text-xs text-vylant-blue font-bold flex items-center gap-2">
                        <Check size={14} />
                        <span>{languageFeedback}</span>
                      </motion.div>
                    )}
                  </div>
                )}

                {activeTab === 'presets' && (
                  <div className="space-y-8">
                    {/* Header with Save UI */}
                    <div className={`p-6 rounded-3xl border transition-all ${isDarkMode ? 'bg-white/5 border-white/10 shadow-[0_0_50px_-12px_rgba(37,99,235,0.1)]' : 'bg-slate-50 border-slate-200 shadow-sm'}`}>
                      <div className="flex flex-col gap-6">
                        <div className="flex flex-col md:flex-row items-center justify-between gap-4">
                          <div>
                            <h3 className="text-xl font-bold mb-1">Create a New Preset</h3>
                            <p className="text-sm opacity-50">Capture your current theme, colors, and layout settings.</p>
                          </div>
                          {!isSavingPreset && (
                            <button 
                              onClick={() => setIsSavingPreset(true)}
                              className="flex items-center gap-2 px-6 py-3 rounded-2xl bg-vylant-blue text-white font-bold hover:scale-105 active:scale-95 transition-all shadow-lg shadow-vylant-blue/20"
                            >
                              <Plus size={20} />
                              <span>Save Current Config</span>
                            </button>
                          )}
                        </div>

                        {isSavingPreset && (
                          <motion.div 
                            initial={{ opacity: 0, y: -10 }}
                            animate={{ opacity: 1, y: 0 }}
                            className={`p-4 rounded-2xl border ${isDarkMode ? 'bg-white/5 border-white/10' : 'bg-white border-slate-200'}`}
                          >
                            <div className="flex flex-col gap-4">
                              <div className="flex flex-col gap-2">
                                <label className="text-[10px] font-bold uppercase tracking-widest opacity-40 px-1">Preset Name</label>
                                <input 
                                  type="text" 
                                  value={presetName}
                                  onChange={(e) => setPresetName(e.target.value)}
                                  placeholder="e.g. My Cool Midnight Setup"
                                  className={`w-full px-4 py-3 rounded-xl border transition-all ${isDarkMode ? 'bg-black/20 border-white/10 focus:border-vylant-blue outline-none' : 'bg-slate-100 border-slate-200 focus:border-vylant-blue outline-none'}`}
                                  autoFocus
                                />
                              </div>
                              
                              <div className="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5">
                                <div className="flex flex-col">
                                  <span className="text-sm font-bold">Public Sharing</span>
                                  <span className="text-[10px] opacity-40">Allow other users to see and download this preset.</span>
                                </div>
                                <Toggle 
                                  checked={presetIsPublic}
                                  onChange={setPresetIsPublic}
                                />
                              </div>

                              <div className="flex items-center gap-3">
                                <button 
                                  onClick={() => {
                                    setIsSavingPreset(false);
                                    setPresetName('');
                                    setPresetIsPublic(false);
                                  }}
                                  className={`flex-1 py-3 rounded-xl font-bold transition-all ${isDarkMode ? 'bg-white/5 hover:bg-white/10' : 'bg-slate-100 hover:bg-slate-200'}`}
                                >
                                  Cancel
                                </button>
                                <button 
                                  disabled={!presetName.trim()}
                                  onClick={async () => {
                                    if (presetName.trim()) {
                                      await savePreset(presetName, presetIsPublic);
                                      setIsSavingPreset(false);
                                      setPresetName('');
                                      setPresetIsPublic(false);
                                    }
                                  }}
                                  className={`flex-1 py-3 rounded-xl font-bold transition-all bg-vylant-blue text-white disabled:opacity-50 disabled:cursor-not-allowed`}
                                >
                                  Confirm Save
                                </button>
                              </div>
                            </div>
                          </motion.div>
                        )}
                      </div>
                    </div>

                    {/* Presets Grid */}
                    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pb-20">
                      {isPresetsLoading ? (
                        <div className="col-span-full py-20 flex flex-col items-center justify-center opacity-30">
                          <Loader2 size={40} className="animate-spin mb-4" />
                          <p className="font-bold">Loading presets...</p>
                        </div>
                      ) : presets.length === 0 ? (
                        <div className="col-span-full py-20 flex flex-col items-center justify-center opacity-30 border-2 border-dashed rounded-3xl border-white/10">
                          <LayoutGrid size={40} className="mb-4" />
                          <p className="font-bold">No presets found yet. Be the first to create one!</p>
                        </div>
                      ) : (
                        presets.map(preset => (
                          <motion.div 
                            key={preset.id}
                            initial={{ opacity: 0, y: 20 }}
                            animate={{ opacity: 1, y: 0 }}
                            className={`p-5 rounded-3xl border group relative transition-all ${isDarkMode ? 'bg-white/5 border-white/10 hover:border-vylant-blue/30' : 'bg-white border-slate-200 hover:border-vylant-blue/30 shadow-md'}`}
                          >
                            <div className="flex items-start justify-between mb-4">
                              <div className="min-w-0">
                                <h4 className="font-bold truncate text-sm">{preset.name}</h4>
                                <p className="text-[10px] opacity-40">by {preset.creator === userName ? 'You' : preset.creator}</p>
                              </div>
                              <div className="flex items-center gap-1">
                                {preset.isPublic && (
                                  <span className="text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold uppercase tracking-wider">Public</span>
                                )}
                              </div>
                            </div>

                            {/* Theme Preview Box */}
                            <div 
                              className="w-full h-24 rounded-2xl mb-4 border border-white/10 flex items-center justify-center overflow-hidden" 
                              style={{ backgroundColor: preset.config.customThemeColor || '#1a1a1a' }}
                            >
                              <div className="flex flex-col items-center gap-1">
                                <div className="w-8 h-8 rounded-full shadow-lg" style={{ backgroundColor: preset.config.accentColor || '#00d2ff' }}></div>
                                <div className="text-[8px] font-bold opacity-30 uppercase tracking-widest">{preset.config.customTheme}</div>
                              </div>
                            </div>

                            <div className="flex items-center justify-between gap-2">
                              <button 
                                onClick={() => applyPreset(preset)}
                                className={`flex-1 py-2 rounded-xl text-xs font-bold transition-all ${isDarkMode ? 'bg-white/10 hover:bg-vylant-blue hover:text-white' : 'bg-slate-100 hover:bg-vylant-blue hover:text-white'}`}
                              >
                                Apply Preset
                              </button>
                              
                              {preset.creator === userName && (
                                <button 
                                  onClick={() => setPresetToDelete(preset)}
                                  className={`p-2 rounded-xl text-red-500 transition-all ${isDarkMode ? 'hover:bg-red-500/10' : 'hover:bg-red-50'}`}
                                >
                                  <Trash2 size={14} />
                                </button>
                              )}
                            </div>

                            {preset.isPublic && (
                              <div className="absolute top-2 right-2 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-all">
                                 <div className="flex items-center gap-1 text-[9px] font-bold opacity-40 px-2 py-1 rounded bg-black/40">
                                   <Download size={10} />
                                   <span>{preset.downloads || 0}</span>
                                 </div>
                              </div>
                            )}
                          </motion.div>
                        ))
                      )}
                    </div>
                  </div>
                )}
                {activeTab === 'advanced' && (
                  <div className="space-y-6">
                    <Toggle 
                      label="Developer Mode" 
                      description="Expose developer tools and additional IDs for debugging." 
                      checked={isDeveloperMode} 
                      onChange={setIsDeveloperMode} 
                    />
                    <Toggle label="Hardware Acceleration" description="Uses your GPU for smoother animations." checked={hardwareAcceleration} onChange={setHardwareAcceleration} />
                    <Toggle label="Auto-Start Vylant" checked={autoStart} onChange={setAutoStart} />
                    <Toggle label="Streamer Mode" description="Hide personal information when streaming." checked={streamerMode} onChange={setStreamerMode} />
                    <Toggle label="Game Overlay" description="Show Vylant overlay while in-game." checked={gameOverlay} onChange={setGameOverlay} />
                    
                    <div className="pt-6 border-t border-white/5 space-y-3">
                      <h3 className="text-sm font-bold mb-2 text-red-500">Danger Zone</h3>
                      <div className="flex flex-col gap-3">
                        <button 
                          onClick={handleClearCache}
                          className="w-full text-left px-4 py-3 bg-white/5 text-white/60 rounded-xl font-bold text-sm hover:bg-white/10 hover:text-white transition-all border border-white/5 cursor-pointer flex items-center justify-between"
                        >
                          <span>Clear Application Cache</span>
                          <span className="text-xs opacity-50 font-normal">Frees temporary storage</span>
                        </button>

                        {cacheClearedFeedback && (
                          <motion.div initial={{ opacity: 0, y: -5 }} animate={{ opacity: 1, y: 0 }} className="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-400 font-bold flex items-center gap-2">
                            <Check size={14} />
                            <span>Application cache cleared successfully.</span>
                          </motion.div>
                        )}

                        <button 
                          onClick={() => {
                            setIsResetConfirmationOpen(true);
                          }}
                          className="w-full text-left px-4 py-3 bg-red-500/10 text-red-500 rounded-xl font-bold text-sm hover:bg-red-500/20 transition-all border border-red-500/20 cursor-pointer flex items-center justify-between"
                        >
                          <span>Reset All Settings</span>
                          <span className="text-xs opacity-70 font-normal">Restores default preferences</span>
                        </button>
                        <button 
                          onClick={() => {
                            setIsDeleteAccountModalOpen(true);
                          }}
                          className="w-full text-left px-4 py-3 bg-red-500/20 text-red-500 rounded-lg font-bold text-sm hover:bg-red-500/30 transition-all border border-red-500/30"
                        >
                          Delete Account
                        </button>
                      </div>
                    </div>
                  </div>
                )}
                {activeTab === 'bots' && (
                  <div className="space-y-6">
                    <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-white/5">
                      <div>
                        <h2 className={`text-xl font-bold flex items-center gap-2.5 ${isDarkMode ? 'text-white' : 'text-slate-900'}`}>
                          <div className="w-8 h-8 rounded-xl bg-cyan-500/20 border border-cyan-500/30 flex items-center justify-center text-cyan-400">
                            <Bot size={18} />
                          </div>
                          Bot Developer Studio
                        </h2>
                        <p className={`text-xs mt-1 ${isDarkMode ? 'text-white/50' : 'text-slate-500'}`}>
                          Create custom bots with secure tokens, automated triggers, commands, and Gemini AI.
                        </p>
                      </div>
                      <button
                        onClick={() => {
                          onClose();
                          if (onOpenBotStudio) onOpenBotStudio();
                        }}
                        className="px-4 py-2.5 bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white rounded-xl text-xs font-bold transition-all shadow-lg shadow-cyan-500/20 flex items-center justify-center gap-2 cursor-pointer"
                      >
                        <Bot size={15} />
                        Launch Bot Studio
                      </button>
                    </div>

                    <div className={`p-6 rounded-2xl border ${isDarkMode ? 'bg-white/[0.02] border-white/5' : 'bg-slate-50 border-slate-200'} space-y-5`}>
                      <div className="flex items-start gap-4">
                        <div className="w-12 h-12 rounded-2xl bg-gradient-to-br from-cyan-500/20 to-blue-600/20 border border-cyan-500/30 flex items-center justify-center shrink-0">
                          <Bot size={26} className="text-cyan-400" />
                        </div>
                        <div>
                          <h3 className={`text-sm font-bold ${isDarkMode ? 'text-white' : 'text-slate-900'}`}>
                            Be the Developer of Your Own Bot
                          </h3>
                          <p className={`text-xs mt-1.5 leading-relaxed ${isDarkMode ? 'text-white/60' : 'text-slate-600'}`}>
                            Every Vylant member can build and publish bots for their servers. Design your bot's name, custom avatar, banner, and unique authentication token. Equip it with prefix commands, automatic keyword triggers, and Gemini generative AI responses.
                          </p>
                        </div>
                      </div>

                      <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
                        <div className={`p-4 rounded-xl border ${isDarkMode ? 'bg-black/20 border-white/5' : 'bg-white border-slate-200 shadow-sm'}`}>
                          <div className="flex items-center gap-2 mb-1.5">
                            <span className="text-sm">🔑</span>
                            <span className="text-xs font-bold text-cyan-400">Bot Tokens & API</span>
                          </div>
                          <p className={`text-[11px] ${isDarkMode ? 'text-white/50' : 'text-slate-500'}`}>
                            Generate and regenerate cryptographically secure bot tokens for HTTP messaging and test dispatching.
                          </p>
                        </div>

                        <div className={`p-4 rounded-xl border ${isDarkMode ? 'bg-black/20 border-white/5' : 'bg-white border-slate-200 shadow-sm'}`}>
                          <div className="flex items-center gap-2 mb-1.5">
                            <span className="text-sm">⚡</span>
                            <span className="text-xs font-bold text-emerald-400">Custom Commands</span>
                          </div>
                          <p className={`text-[11px] ${isDarkMode ? 'text-white/50' : 'text-slate-500'}`}>
                            Define custom prefixes (like <code className="text-emerald-400">!</code>) with dynamic placeholder variables ({'{user}'}, {'{channel}'}).
                          </p>
                        </div>

                        <div className={`p-4 rounded-xl border ${isDarkMode ? 'bg-black/20 border-white/5' : 'bg-white border-slate-200 shadow-sm'}`}>
                          <div className="flex items-center gap-2 mb-1.5">
                            <span className="text-sm">🧠</span>
                            <span className="text-xs font-bold text-purple-400">Gemini AI Brain</span>
                          </div>
                          <p className={`text-[11px] ${isDarkMode ? 'text-white/50' : 'text-slate-500'}`}>
                            Give your bot autonomous intelligence with system prompts, personality traits, and markdown responses.
                          </p>
                        </div>
                      </div>

                      <div className="pt-2 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-white/5">
                        <span className={`text-xs ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>
                          Need help getting started? Check out the interactive sandbox and documentation inside Bot Studio.
                        </span>
                        <button
                          onClick={() => {
                            onClose();
                            if (onOpenBotStudio) onOpenBotStudio();
                          }}
                          className="w-full sm:w-auto px-5 py-2.5 bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 cursor-pointer"
                        >
                          <Bot size={15} />
                          Open Bot Studio
                        </button>
                      </div>
                    </div>
                  </div>
                )}
              </div>

              <div className="p-4 md:p-8 pt-0 flex justify-end">
              </div>
            </div>
          </motion.div>
        </div>
      )}
      </AnimatePresence>
      <ResetConfirmationModal 
        isOpen={isResetConfirmationOpen} 
        onClose={() => setIsResetConfirmationOpen(false)} 
        onConfirm={handleConfirmReset} 
        isDarkMode={isDarkMode} 
      />
      <LogoutConfirmationModal 
        isOpen={isLogoutConfirmationOpen} 
        onClose={() => setIsLogoutConfirmationOpen(false)} 
        onConfirm={confirmLogout} 
        isDarkMode={isDarkMode} 
      />
      <DeletePresetModal
        isOpen={!!presetToDelete}
        onClose={() => setPresetToDelete(null)}
        onConfirm={() => deletePreset(presetToDelete!.id)}
        presetName={presetToDelete?.name || ''}
        isDarkMode={isDarkMode}
      />
    </>
  );
};

const ActivityItem = ({ icon: Icon, text, colorClass = "text-vylant-blue", isDarkMode = true }: { icon: any, text: string, colorClass?: string, isDarkMode?: boolean }) => (
  <div className={`flex items-center gap-3 p-3 rounded-xl transition-colors cursor-pointer group ${isDarkMode ? 'hover:bg-white/5' : 'hover:bg-slate-100'}`}>
    <div className={`p-2 rounded-lg bg-white/5 group-hover:bg-white/10 transition-colors ${colorClass}`}>
      <Icon size={18} />
    </div>
    <span className={`text-xs transition-colors leading-tight ${isDarkMode ? 'text-white/70 group-hover:text-white' : 'text-slate-600 group-hover:text-slate-900'}`}>
      {text}
    </span>
  </div>
);

const StoryPreviewModal = ({
  isOpen,
  onClose,
  storyData,
  onConfirm,
  storyPrivacy,
  setStoryPrivacy,
  isDarkMode,
  friends
}: {
  isOpen: boolean;
  onClose: () => void;
  storyData: string | null;
  onConfirm: (privacy: 'everyone' | 'friends' | 'custom', customFriends?: string[], expirationMs?: number, bakedImage?: string) => void;
  storyPrivacy: 'everyone' | 'friends' | 'custom';
  setStoryPrivacy: (v: 'everyone' | 'friends' | 'custom') => void;
  isDarkMode: boolean;
  friends: any[];
}) => {
  const [customFriends, setCustomFriends] = useState<string[]>([]);
  const [expiration, setExpiration] = useState<number>(24 * 60 * 60 * 1000); // Default 24h
  const [textOverlays, setTextOverlays] = useState<any[]>([]);
  const [editingTextId, setEditingTextId] = useState<string | null>(null);
  const [currentText, setCurrentText] = useState('');
  const [currentColor, setCurrentColor] = useState('#ffffff');
  const [currentBgStyle, setCurrentBgStyle] = useState<'none' | 'solid' | 'glass'>('none');
  const [showOptions, setShowOptions] = useState(false);
  const [isBaking, setIsBaking] = useState(false);
  const [imageOffset, setImageOffset] = useState({ x: 0, y: 0 });
  const [imageScale, setImageScale] = useState(1);
  const [isSnappingEnabled, setIsSnappingEnabled] = useState(false);
  const [isFitMode, setIsFitMode] = useState(false);
  const [imgAspectRatio, setImgAspectRatio] = useState<number | null>(null);
  const previewContainerRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    if (isOpen) {
      setImageOffset({ x: 0, y: 0 });
      setImageScale(1);
      setShowOptions(false);
      setIsSnappingEnabled(false);
      setIsFitMode(false);
      setImgAspectRatio(null);
    }
  }, [isOpen, storyData]);

  const colors = ['#ffffff', '#000000', '#ff0000', '#00ff00', '#0000ff', '#ffff00', '#ff00ff', '#00ffff', '#ff9900', '#9900ff'];

  const addText = () => {
    const id = Math.random().toString(36).substr(2, 9);
    const newOverlay = {
      id,
      text: '',
      x: 50,
      y: 50,
      color: '#ffffff',
      fontSize: 24,
      backgroundColor: 'transparent',
      bgStyle: 'none'
    };
    setTextOverlays([...textOverlays, newOverlay]);
    setEditingTextId(id);
    setCurrentText('');
    setCurrentColor('#ffffff');
    setCurrentBgStyle('none');
  };

  const handleTextSubmit = () => {
    if (!editingTextId) return;
    if (currentText.trim() === '') {
      setTextOverlays(textOverlays.filter(o => o.id !== editingTextId));
    } else {
      setTextOverlays(textOverlays.map(o => o.id === editingTextId ? { 
        ...o, 
        text: currentText, 
        color: currentColor,
        bgStyle: currentBgStyle,
        backgroundColor: currentBgStyle === 'solid' ? (currentColor === '#ffffff' ? '#000000' : '#ffffff') : (currentBgStyle === 'glass' ? 'rgba(0,0,0,0.5)' : 'transparent')
      } : o));
    }
    setEditingTextId(null);
  };

  const bakeAndConfirm = async () => {
    if (!storyData) return;
    setIsBaking(true);
    
    const baked = await new Promise<string>((resolve) => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        // Use a fixed high resolution for the story
        const targetWidth = 1080;
        const targetHeight = 1920;
        canvas.width = targetWidth;
        canvas.height = targetHeight;
        const ctx = canvas.getContext('2d');
        if (!ctx) { resolve(storyData); return; }

        // Fill background (black)
        ctx.fillStyle = '#000000';
        ctx.fillRect(0, 0, targetWidth, targetHeight);

        // Draw image centered
        const imgRatio = img.width / img.height;
        const canvasRatio = targetWidth / targetHeight;
        let drawW, drawH, drawX, drawY;

        if (isFitMode) {
          // Fit mode (contain)
          if (imgRatio > canvasRatio) {
            drawW = targetWidth;
            drawH = targetWidth / imgRatio;
          } else {
            drawH = targetHeight;
            drawW = targetHeight * imgRatio;
          }
        } else {
          // Fill mode (cover)
          if (imgRatio > canvasRatio) {
            drawH = targetHeight;
            drawW = targetHeight * imgRatio;
          } else {
            drawW = targetWidth;
            drawH = targetWidth / imgRatio;
          }
        }

        // Apply scale
        const finalW = drawW * imageScale;
        const finalH = drawH * imageScale;
        
        // Apply user offset (scaled to canvas)
        const rect = previewContainerRef.current?.getBoundingClientRect();
        const scaleX = targetWidth / (rect?.width || 1);
        const scaleY = targetHeight / (rect?.height || 1);
        
        drawX = (targetWidth - finalW) / 2 + (imageOffset.x * scaleX);
        drawY = (targetHeight - finalH) / 2 + (imageOffset.y * scaleY);
        
        ctx.drawImage(img, drawX, drawY, finalW, finalH);

        // Draw overlays
        textOverlays.forEach(o => {
          const fontSize = (o.fontSize / 100) * targetHeight;
          ctx.font = `bold ${fontSize}px sans-serif`;
          const metrics = ctx.measureText(o.text);
          const textW = metrics.width;
          const textH = fontSize;

          const x = (o.x / 100) * targetWidth;
          const y = (o.y / 100) * targetHeight;

          ctx.save();
          ctx.translate(x, y);

          if (o.bgStyle !== 'none') {
            ctx.fillStyle = o.backgroundColor;
            const padding = fontSize * 0.2;
            ctx.roundRect(-textW/2 - padding, -textH * 0.8 - padding, textW + padding * 2, textH + padding * 2, padding);
            ctx.fill();
          }

          ctx.fillStyle = o.color;
          ctx.textAlign = 'center';
          ctx.fillText(o.text, 0, 0);
          ctx.restore();
        });

        resolve(canvas.toDataURL('image/jpeg', 0.85));
      };
      img.src = storyData;
    });

    setIsBaking(false);
    onConfirm(storyPrivacy, customFriends, expiration, baked);
  };

  if (!isOpen || !storyData) return null;
  return (
    <div className="fixed inset-0 z-[9999] flex items-center justify-center p-4">
      <motion.div
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        exit={{ opacity: 0 }}
        onClick={onClose}
        className="absolute inset-0 bg-black/90 backdrop-blur-md"
      />
      
      <motion.div 
        initial={{ opacity: 0, scale: 0.9, y: 20 }}
        animate={{ opacity: 1, scale: 1, y: 0 }}
        exit={{ opacity: 0, scale: 0.9, y: 20 }}
        className={`relative w-full max-w-2xl flex flex-col md:flex-row gap-4 md:gap-6 p-4 md:p-6 rounded-[24px] md:rounded-[32px] shadow-2xl overflow-y-auto md:overflow-visible max-h-[90vh] md:max-h-none ${isDarkMode ? 'bg-slate-900 text-white' : 'bg-white text-slate-900'}`}
        onClick={(e) => e.stopPropagation()}
      >
        {/* Story Preview Area */}
        <div className="relative flex-1 aspect-[9/16] bg-black rounded-2xl md:rounded-3xl overflow-hidden shadow-inner group min-h-[300px] md:min-h-0" ref={previewContainerRef}>
          <div className="absolute inset-0 flex items-center justify-center pointer-events-none">
            <motion.img 
              onLoad={(e) => {
                const img = e.currentTarget;
                setImgAspectRatio(img.naturalWidth / img.naturalHeight);
              }}
              drag
              dragMomentum={false}
              onDragEnd={(_, info) => {
                let newX = imageOffset.x + info.offset.x;
                let newY = imageOffset.y + info.offset.y;

                if (isSnappingEnabled) {
                  const threshold = 30; // Snap threshold in pixels
                  if (Math.abs(newX) < threshold) newX = 0;
                  if (Math.abs(newY) < threshold) newY = 0;
                }

                setImageOffset({ x: newX, y: newY });
              }}
              src={storyData} 
              alt="Story Preview" 
              className="max-w-none max-h-none opacity-80 cursor-grab active:cursor-grabbing pointer-events-auto" 
              style={{ 
                width: imgAspectRatio ? (isFitMode ? (imgAspectRatio > 9/16 ? '100%' : 'auto') : (imgAspectRatio > 9/16 ? 'auto' : '100%')) : '100%',
                height: imgAspectRatio ? (isFitMode ? (imgAspectRatio > 9/16 ? 'auto' : '100%') : (imgAspectRatio > 9/16 ? '100%' : 'auto')) : '100%',
                minWidth: isFitMode ? '0' : '100%',
                minHeight: isFitMode ? '0' : '100%',
                objectFit: isFitMode ? 'contain' : 'cover',
                x: imageOffset.x,
                y: imageOffset.y,
                scale: imageScale
              }}
            />
          </div>
          
          {/* Overlays */}
          {textOverlays.map(o => (
            <motion.div
              key={o.id}
              drag
              dragMomentum={false}
              onDragEnd={(_, info) => {
                if (previewContainerRef.current) {
                  const rect = previewContainerRef.current.getBoundingClientRect();
                  const newX = ((o.x / 100 * rect.width + info.offset.x) / rect.width) * 100;
                  const newY = ((o.y / 100 * rect.height + info.offset.y) / rect.height) * 100;
                  setTextOverlays(textOverlays.map(item => item.id === o.id ? { ...item, x: newX, y: newY } : item));
                }
              }}
              dragElastic={0}
              style={{
                position: 'absolute',
                left: `${o.x}%`,
                top: `${o.y}%`,
                transform: 'translate(-50%, -50%)',
                color: o.color,
                fontSize: `${o.fontSize}px`,
                fontWeight: 'bold',
                padding: '4px 12px',
                borderRadius: '8px',
                backgroundColor: o.backgroundColor,
                cursor: 'move',
                userSelect: 'none',
                whiteSpace: 'nowrap',
                zIndex: editingTextId === o.id ? 100 : 10
              }}
              onDoubleClick={() => {
                setEditingTextId(o.id);
                setCurrentText(o.text);
                setCurrentColor(o.color);
                setCurrentBgStyle(o.bgStyle);
              }}
            >
              {o.text}
            </motion.div>
          ))}

          {/* Text Input Overlay */}
          <AnimatePresence>
            {editingTextId && (
              <motion.div 
                initial={{ opacity: 0 }}
                animate={{ opacity: 1 }}
                exit={{ opacity: 0 }}
                className="absolute inset-0 z-[100] bg-black/80 flex flex-col items-center justify-center p-6 backdrop-blur-sm"
              >
                <div className="w-full max-w-[90%] md:max-w-sm flex flex-col items-center gap-4 md:gap-6">
                  <div className="flex flex-col items-center gap-3 md:gap-4 w-full">
                    <button 
                      onClick={() => setShowOptions(!showOptions)}
                      className="flex items-center gap-2 px-4 py-2 bg-white/10 rounded-full text-white text-xs font-bold hover:bg-white/20 transition-all"
                    >
                      {showOptions ? <ChevronUp size={14} /> : <ChevronDown size={14} />}
                      {showOptions ? 'Hide Options' : 'Show Options'}
                    </button>

                    <AnimatePresence>
                      {showOptions && (
                        <motion.div 
                          initial={{ height: 0, opacity: 0 }}
                          animate={{ height: 'auto', opacity: 1 }}
                          exit={{ height: 0, opacity: 0 }}
                          className="flex flex-col items-center gap-4 w-full overflow-hidden"
                        >
                          <div className="flex gap-2 overflow-x-auto max-w-full p-2 no-scrollbar">
                            {colors.map(c => (
                              <button 
                                key={c}
                                onClick={() => setCurrentColor(c)}
                                className={`w-8 h-8 md:w-10 md:h-10 rounded-full border-2 transition-all hover:scale-110 ${currentColor === c ? 'scale-125 border-white shadow-lg shadow-white/20' : 'border-transparent opacity-60 hover:opacity-100'}`}
                                style={{ backgroundColor: c }}
                              />
                            ))}
                          </div>

                          <div className="flex gap-1 md:gap-2 p-1 bg-white/10 rounded-xl md:rounded-2xl backdrop-blur-md">
                            {[
                              { id: 'none', label: 'None' },
                              { id: 'solid', label: 'Solid' },
                              { id: 'glass', label: 'Glass' }
                            ].map(style => (
                              <button 
                                key={style.id}
                                onClick={() => setCurrentBgStyle(style.id as any)}
                                className={`px-4 md:px-6 py-1.5 md:py-2 rounded-lg md:rounded-xl text-xs md:text-sm font-bold transition-all ${currentBgStyle === style.id ? 'bg-white text-black shadow-lg' : 'text-white hover:bg-white/10'}`}
                              >
                                {style.label}
                              </button>
                            ))}
                          </div>
                        </motion.div>
                      )}
                    </AnimatePresence>
                  </div>

                  <input 
                    autoFocus
                    type="text"
                    value={currentText}
                    onChange={(e) => setCurrentText(e.target.value)}
                    onKeyDown={(e) => e.key === 'Enter' && handleTextSubmit()}
                    className="w-full text-center bg-transparent border-none outline-none text-2xl md:text-4xl font-black placeholder:text-white/20"
                    placeholder="Type something..."
                    style={{ 
                      color: currentColor,
                      backgroundColor: currentBgStyle === 'solid' ? (currentColor === '#ffffff' ? '#000000' : '#ffffff') : (currentBgStyle === 'glass' ? 'rgba(0,0,0,0.5)' : 'transparent'),
                      padding: '12px 24px',
                      borderRadius: '16px'
                    }}
                  />
                  
                  <div className="flex gap-3 md:gap-4 w-full">
                    <button 
                      onClick={() => setEditingTextId(null)}
                      className="flex-1 py-3 md:py-4 bg-white/10 text-white rounded-xl md:rounded-2xl font-bold hover:bg-white/20 transition-all text-sm md:text-base"
                    >
                      Cancel
                    </button>
                    <button 
                      onClick={handleTextSubmit}
                      className="flex-[2] py-3 md:py-4 bg-white text-black rounded-xl md:rounded-2xl font-bold hover:scale-[1.02] active:scale-[0.98] transition-all shadow-xl shadow-white/10 text-sm md:text-base"
                    >
                      Add Text
                    </button>
                  </div>
                </div>
              </motion.div>
            )}
          </AnimatePresence>

          {/* Editing Controls */}
          {!editingTextId && (
            <div className="absolute top-4 right-4 flex flex-col gap-2">
              <button 
                onClick={addText}
                className="p-3 rounded-full bg-black/40 text-white hover:bg-black/60 backdrop-blur-md transition-all"
                title="Add Text"
              >
                <Type size={24} />
              </button>
              <button 
                onClick={() => setIsFitMode(!isFitMode)}
                className={`p-3 rounded-full backdrop-blur-md transition-all ${isFitMode ? 'bg-vylant-blue text-vylant-navy' : 'bg-black/40 text-white hover:bg-black/60'}`}
                title={isFitMode ? "Switch to Fill" : "Switch to Fit"}
              >
                <Maximize size={24} />
              </button>
              <button 
                onClick={() => setIsSnappingEnabled(!isSnappingEnabled)}
                className={`p-3 rounded-full backdrop-blur-md transition-all ${isSnappingEnabled ? 'bg-vylant-blue text-vylant-navy' : 'bg-black/40 text-white hover:bg-black/60'}`}
                title={isSnappingEnabled ? "Disable Snapping" : "Enable Snapping"}
              >
                <Magnet size={24} />
              </button>
              <div className="flex flex-col items-center bg-black/40 rounded-full p-1 backdrop-blur-md">
                <button 
                  onClick={() => setImageScale(prev => Math.min(prev + 0.1, 3))}
                  className="p-2 text-white hover:bg-white/10 rounded-full transition-all"
                  title="Zoom In"
                >
                  <Plus size={20} />
                </button>
                <div className="h-px w-4 bg-white/20" />
                <button 
                  onClick={() => setImageScale(prev => Math.max(prev - 0.1, 0.5))}
                  className="p-2 text-white hover:bg-white/10 rounded-full transition-all"
                  title="Zoom Out"
                >
                  <Minus size={20} />
                </button>
              </div>
            </div>
          )}
        </div>

        {/* Settings Area */}
        <div className="w-full md:w-64 lg:w-72 flex flex-col gap-4 md:gap-6">
          <div>
            <h2 className="text-2xl md:text-3xl font-black mb-1 md:mb-2 tracking-tight">Post Story</h2>
            <p className="text-xs md:text-sm opacity-60">Customize your story before sharing it with your friends</p>
          </div>

          <div className="flex-1 space-y-4 md:space-y-6">
            <div>
              <label className="block text-[10px] font-black uppercase tracking-[0.2em] mb-2 md:mb-3 opacity-40">Duration</label>
              <div className="grid grid-cols-3 gap-2 md:gap-3">
                {[
                  { label: '1m', value: 60 * 1000 },
                  { label: '1h', value: 60 * 60 * 1000 },
                  { label: '24h', value: 24 * 60 * 60 * 1000 }
                ].map(option => (
                  <button
                    key={option.label}
                    onClick={() => setExpiration(option.value)}
                    className={`py-2 md:py-3 rounded-xl md:rounded-2xl font-black text-[10px] md:text-xs transition-all border-2 ${
                      expiration === option.value
                        ? 'bg-vylant-blue border-vylant-blue text-vylant-navy shadow-lg shadow-vylant-blue/20'
                        : isDarkMode ? 'bg-white/5 border-white/5 hover:border-white/20' : 'bg-slate-100 border-slate-100 hover:border-slate-200'
                    }`}
                  >
                    {option.label}
                  </button>
                ))}
              </div>
            </div>

            <div>
              <label className="block text-[10px] font-black uppercase tracking-[0.2em] mb-2 md:mb-3 opacity-40">Privacy</label>
              <div className="grid grid-cols-3 gap-2 md:gap-3">
                {['everyone', 'friends', 'custom'].map(option => (
                  <button
                    key={option}
                    onClick={() => setStoryPrivacy(option as any)}
                    className={`py-2 md:py-3 rounded-xl md:rounded-2xl font-black text-[10px] md:text-xs transition-all border-2 ${
                      storyPrivacy === option
                        ? 'bg-vylant-blue border-vylant-blue text-vylant-navy shadow-lg shadow-vylant-blue/20'
                        : isDarkMode ? 'bg-white/5 border-white/5 hover:border-white/20' : 'bg-slate-100 border-slate-100 hover:border-slate-200'
                    }`}
                  >
                    {option.charAt(0).toUpperCase() + option.slice(1)}
                  </button>
                ))}
              </div>
            </div>
            
            {storyPrivacy === 'custom' && (
              <div className="animate-in fade-in slide-in-from-top-4 duration-500">
                <label className="block text-[10px] font-black uppercase tracking-[0.2em] mb-2 md:mb-3 opacity-40">Select Friends</label>
                <div className={`max-h-32 md:max-h-40 overflow-y-auto rounded-2xl md:rounded-3xl border p-2 md:p-3 space-y-1 ${
                  isDarkMode ? 'bg-white/5 border-white/10' : 'bg-slate-50 border-slate-200'
                }`}>
                  {friends.filter(f => !f.isBot).map(friend => (
                    <button
                      key={friend.id}
                      onClick={() => {
                        if (customFriends.includes(friend.id)) {
                          setCustomFriends(prev => prev.filter(id => id !== friend.id));
                        } else {
                          setCustomFriends(prev => [...prev, friend.id]);
                        }
                      }}
                      className={`w-full flex items-center gap-2 md:gap-3 p-1.5 md:p-2 rounded-lg md:rounded-xl transition-all ${
                        customFriends.includes(friend.id)
                          ? (isDarkMode ? 'bg-vylant-blue/20 text-vylant-blue' : 'bg-vylant-blue/10 text-vylant-navy')
                          : 'hover:bg-black/5'
                      }`}
                    >
                      <img src={friend.image} alt="" className="w-6 h-6 md:w-8 md:h-8 rounded-full object-cover" />
                      <span className="flex-1 text-left font-bold text-xs md:text-sm">{friend.name}</span>
                      <div className={`w-4 h-4 md:w-5 md:h-5 rounded-full border-2 flex items-center justify-center transition-all ${
                        customFriends.includes(friend.id)
                          ? 'bg-vylant-blue border-vylant-blue'
                          : 'border-black/10'
                      }`}>
                        {customFriends.includes(friend.id) && <Check size={10} className="text-vylant-navy" />}
                      </div>
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>

          <div className="pt-4 md:pt-6 border-t border-black/5 flex gap-2 md:gap-3">
            <button
              onClick={onClose}
              className={`flex-1 py-3 md:py-4 rounded-xl md:rounded-2xl font-black text-xs md:text-sm transition-all ${
                isDarkMode ? 'bg-white/5 hover:bg-white/10' : 'bg-slate-100 hover:bg-slate-200'
              }`}
            >
              Cancel
            </button>
            <button
              onClick={bakeAndConfirm}
              disabled={isBaking || (storyPrivacy === 'custom' && customFriends.length === 0)}
              className="flex-[2] py-3 md:py-4 bg-vylant-blue text-vylant-navy rounded-xl md:rounded-2xl font-black text-xs md:text-sm hover:scale-[1.02] active:scale-[0.98] transition-all shadow-xl shadow-vylant-blue/20 disabled:opacity-50 disabled:scale-100"
            >
              {isBaking ? 'Processing...' : 'Share Story'}
            </button>
          </div>
        </div>
      </motion.div>
    </div>
  );
};

const DMItem: React.FC<{ name: string, message: string, image: string, status?: string, customStatus?: string, isDarkMode?: boolean, onClick?: () => void, onDelete?: () => void, active?: boolean, unreadCount?: number, onContextMenu?: (e: React.MouseEvent) => void, isSpeaking?: boolean, isMarketplace?: boolean }> = ({ name, message, image, status = 'offline', customStatus, isDarkMode = true, onClick, onDelete, active = false, unreadCount = 0, onContextMenu, isSpeaking = false, isMarketplace = false }) => (
  <div 
    onClick={onClick}
    onContextMenu={onContextMenu}
    className={`relative flex items-center gap-3 p-3 rounded-xl transition-all cursor-pointer group ${
      active 
        ? (isDarkMode ? 'bg-white/10' : 'bg-slate-200') 
        : (isDarkMode ? 'hover:bg-white/5' : 'hover:bg-slate-100')
    } ${isSpeaking ? 'ring-2 ring-emerald-500/30 transform scale-[1.02]' : ''}`}
  >
    <div className="relative">
      <img src={image} alt={name} className={`w-10 h-10 rounded-full object-cover border transition-all ${isSpeaking ? 'border-emerald-500 ring-2 ring-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.5)]' : 'border-white/10'}`} referrerPolicy="no-referrer" />
      <div className={`absolute bottom-0 right-0 w-3 h-3 border-2 rounded-full ${isDarkMode ? 'border-[#14151a]' : 'border-white'} ${
        status === 'online' ? 'bg-emerald-500' :
        status === 'idle' ? 'bg-amber-400' :
        status === 'dnd' ? 'bg-red-500' :
        'bg-slate-500'
      }`} />
      {unreadCount > 0 && <Badge count={unreadCount} isDarkMode={isDarkMode} />}
    </div>
    <div className="flex-1 min-w-0">
      <div className="flex justify-between items-center gap-1">
        <div className="flex items-center gap-1.5 min-w-0">
          <h4 className={`text-sm font-medium truncate ${isDarkMode ? 'text-white/90' : 'text-slate-900'}`}>{name}</h4>
          {isMarketplace && (
            <span className="px-1.5 py-0.5 rounded-md bg-purple-500/20 text-purple-300 text-[9px] font-extrabold tracking-wider uppercase border border-purple-500/30 flex items-center gap-1 shrink-0">
              <ShoppingBag size={10} /> Marketplace
            </span>
          )}
          {name === 'T0AI Assistant' && (
            <span className="px-1 py-0.5 rounded-full bg-amber-500/10 text-amber-500 text-[6px] font-bold tracking-tighter uppercase border border-amber-500/20">Coming Soon</span>
          )}
          {isSpeaking && (
            <div className="flex items-center gap-1 text-emerald-500 animate-pulse">
              <Mic size={10} />
            </div>
          )}
        </div>
        {unreadCount > 0 && <span className="text-[10px] font-bold text-red-500 shrink-0">New</span>}
      </div>
      <p className={`text-xs truncate ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>{(status !== 'offline' && customStatus) ? customStatus : message}</p>
    </div>
    {onDelete && (
      <button
        onClick={(e) => {
          e.stopPropagation();
          onDelete();
        }}
        className={`absolute right-2 opacity-0 group-hover:opacity-100 p-1.5 rounded-full transition-all ${
          isDarkMode ? 'bg-white/10 hover:bg-red-500/20 text-white/60 hover:text-red-400' : 'bg-slate-200 hover:bg-red-100 text-slate-500 hover:text-red-500'
        }`}
      >
        <X size={14} />
      </button>
    )}
  </div>
);

interface GroupMember {
  name: string;
  status: string;
  image: string;
}

const GroupChatItem: React.FC<{ name: string, message: string, image: string, members: GroupMember[], isDarkMode?: boolean, onClick?: () => void, onLeave?: () => void, active?: boolean, hasActiveCall?: boolean }> = ({ name, message, image, members, isDarkMode = true, onClick, onLeave, active = false, hasActiveCall = false }) => {
  return (
    <div 
      onClick={onClick}
      className={`relative flex items-center gap-3 p-3 rounded-xl transition-colors cursor-pointer group ${
        active 
          ? (isDarkMode ? 'bg-white/10' : 'bg-slate-200') 
          : (isDarkMode ? 'hover:bg-white/5' : 'hover:bg-slate-100')
      }`}
    >
      <div className="relative">
        <img src={image} alt={name} className="w-10 h-10 rounded-full object-cover border border-white/10" referrerPolicy="no-referrer" />
        {hasActiveCall && (
            <div className="absolute -bottom-1 -right-1 w-4 h-4 bg-emerald-500 rounded-full border-2 border-[#09090b] flex items-center justify-center animate-pulse">
                <Phone size={8} className="text-white" />
            </div>
        )}
      </div>
      <div className="flex-1 min-w-0">
        <div className="flex justify-between items-center">
          <h4 className={`text-sm font-medium truncate ${isDarkMode ? 'text-white/90' : 'text-slate-900'}`}>{name}</h4>
        </div>
        <p className={`text-xs truncate ${isDarkMode ? 'text-white/40' : 'text-slate-400'}`}>{message}</p>
      </div>
      
      {onLeave && (
        <button
          onClick={(e) => {
            e.stopPropagation();
            onLeave();
          }}
          className={`absolute right-2 opacity-0 group-hover:opacity-100 p-1.5 rounded-full transition-all ${
            isDarkMode ? 'bg-white/10 hover:bg-red-500/20 text-white/60 hover:text-red-400' : 'bg-slate-200 hover:bg-red-100 text-slate-500 hover:text-red-500'
          }`}
        >
          <X size={14} />
        </button>
      )}
    </div>
  );
};

const generateId = () => Date.now().toString() + '-' + Math.random().toString(36).substring(2, 9);

const SidebarChannelList = React.memo(({ 
  activeServer, 
  channels, 
  categories, 
  onReorderAll,
  onUpdateChannelCategory,
  activeChannel,
  setActiveChannel,
  isDarkMode,
  isOwner,
  collapsedCategories,
  setCollapsedCategories,
  setIsCreateChannelModalOpen,
  setCreateChannelType,
  setSelectedCategoryId,
  handleDeleteCategory,
  setEditingChannel,
  setIsChannelSettingsOpen,
  unreadCounts,
  mentionCounts,
  userName,
  setSelectedProfile,
  canManageChannels,
  canMoveMembers,
  handleUserContextMenu,
  clearUnread,
  setIsMobileChannelSelected,
  setIsMobileChannelListOpen,
  onMoveVoiceMember,
  activeCall,
  userImage,
  isSpeaking,
  accentColor = 'bg-vylant-blue',
  eventCount = 0,
  onChannelContextMenu,
  mutedChannels = [],
  showMemberCount = false,
  showEvents = false,
  totalMembersCount = 0,
  isMobile = false,
  setIsMobileRightPanelOpen,
  setIsServerMembersListOpen,
  hasMarketplace = false,
  marketplaceTitle = 'Marketplace'
}: any) => {
  const [localItems, setLocalItems] = useState<any[]>([]);
  const [draggedItem, setDraggedItem] = useState<any>(null);
  const [draggedVoiceMember, setDraggedVoiceMember] = useState<{ memberName: string, fromChannelId: string } | null>(null);
  const [dragOverInfo, setDragOverInfo] = useState<{id: string, position: 'top'|'bottom'|'center'} | null>(null);

  useEffect(() => {
    if (!draggedItem) {
      const items = [
        ...channels.filter((c: any) => !c.categoryId).sort((a: any, b: any) => (a.order || 0) - (b.order || 0)).map((c: any) => ({ type: 'channel' as const, id: c.id, data: c })),
        ...categories.sort((a: any, b: any) => (a.order || 0) - (b.order || 0)).flatMap((cat: any) => [
          { type: 'category' as const, id: cat.id, data: cat },
          ...channels.filter((c: any) => c.categoryId === cat.id).sort((a: any, b: any) => (a.order || 0) - (b.order || 0)).map((c: any) => ({ type: 'channel' as const, id: c.id, data: c }))
        ])
      ];
      setLocalItems(items);
    }
  }, [channels, categories, draggedItem]);

  const canDragOrManage = canManageChannels || isOwner;

  const handleDragStart = (e: React.DragEvent, item: any) => {
    if (!canDragOrManage) {
      e.preventDefault();
      return;
    }
    setDraggedItem(item);
    e.dataTransfer.effectAllowed = 'move';
  };

  const handleDragOver = (e: React.DragEvent, item: any) => {
    e.preventDefault();
    if (draggedVoiceMember) {
      if (item.type === 'channel' && item.data.type === 'voice') {
        setDragOverInfo({ id: item.id, position: 'center' });
        e.dataTransfer.dropEffect = 'move';
      } else {
        setDragOverInfo(null);
        e.dataTransfer.dropEffect = 'none';
      }
      return;
    }

    if (!draggedItem || draggedItem.id === item.id) return;
    
    // Prevent dragging a category over its own children
    if (draggedItem.type === 'category' && item.type === 'channel' && item.data.categoryId === draggedItem.id) return;
    
    const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
    const y = e.clientY - rect.top;
    const position: 'top' | 'bottom' = y < rect.height / 2 ? 'top' : 'bottom';
    
    setDragOverInfo({ id: item.id, position });
  };

  const handleDrop = (e: React.DragEvent, item: any) => {
    e.preventDefault();
    if (draggedVoiceMember) {
      setDragOverInfo(null);
      if (item.type === 'channel' && item.data.type === 'voice') {
        if (draggedVoiceMember.fromChannelId !== item.data.id && onMoveVoiceMember) {
           onMoveVoiceMember(draggedVoiceMember.memberName, item.data.id);
        }
      }
      setDraggedVoiceMember(null);
      return;
    }

    if (!draggedItem || !dragOverInfo) {
      setDragOverInfo(null);
      setDraggedItem(null);
      return;
    }
    
    const { id: targetId, position } = dragOverInfo;
    setDragOverInfo(null);
    setDraggedItem(null);
    
    if (draggedItem.id === targetId) return;

    let newItems = [...localItems];
    let itemsToMove: any[] = [];
    
    if (draggedItem.type === 'category') {
      const catChannels = localItems.filter(i => i.type === 'channel' && i.data.categoryId === draggedItem.id);
      itemsToMove = [draggedItem, ...catChannels];
    } else {
      itemsToMove = [draggedItem];
    }
    
    newItems = newItems.filter(i => !itemsToMove.some(m => m.id === i.id));
    
    let targetIndex = newItems.findIndex(i => i.id === targetId);
    if (targetIndex === -1) return;
    
    if (position === 'bottom') {
       if (draggedItem.type === 'category' && item.type === 'category') {
          targetIndex += 1;
          while (targetIndex < newItems.length && newItems[targetIndex].type === 'channel' && newItems[targetIndex].data.categoryId === item.id) {
             targetIndex++;
          }
       } else {
          targetIndex += 1;
       }
    }
    
    newItems.splice(targetIndex, 0, ...itemsToMove);
    setLocalItems(newItems);
    onReorderAll(newItems);
  };

  return (
    <div className="flex flex-col gap-1">
      {/* Member Counter above Events tab */}
      {showMemberCount && (
        <div className="px-1.5 mb-1">
          <button
            type="button"
            onClick={() => {
              if (isMobile) {
                if (setIsMobileRightPanelOpen) setIsMobileRightPanelOpen(true);
              } else if (setIsServerMembersListOpen) {
                setIsServerMembersListOpen((prev: boolean) => !prev);
              }
            }}
            className={`w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold select-none transition-all duration-150 border group text-left cursor-pointer ${
              isDarkMode 
                ? 'bg-white/[0.04] hover:bg-white/[0.08] border-white/5 text-white/90 shadow-sm' 
                : 'bg-slate-100/90 hover:bg-slate-200/80 border-slate-200/80 text-slate-800 shadow-sm'
            }`}
            title={`Total Members: ${totalMembersCount.toLocaleString()} (Click to toggle member list)`}
          >
            <div className="flex items-center gap-2.5 min-w-0">
              <div className={`p-1 rounded-lg ${isDarkMode ? 'bg-vylant-blue/15 text-vylant-blue' : 'bg-vylant-blue/10 text-vylant-blue'} shrink-0 group-hover:scale-105 transition-transform`}>
                <Users size={15} />
              </div>
              <span className="text-xs uppercase tracking-wider font-bold truncate">
                Total Members
              </span>
            </div>
            <span className={`text-xs font-extrabold px-2 py-0.5 rounded-full shrink-0 tracking-wider transition-colors ${
              isDarkMode 
                ? 'bg-white/10 text-white group-hover:bg-vylant-blue/20 group-hover:text-vylant-blue' 
                : 'bg-white text-slate-900 border border-slate-200 shadow-xs group-hover:bg-vylant-blue/10 group-hover:text-vylant-blue'
            }`}>
              {totalMembersCount.toLocaleString()}
            </span>
          </button>
        </div>
      )}

      {showEvents && (
        <div className="px-1.5 mb-1.5">
          <button
            onClick={() => {
              setActiveChannel('events');
              if (setIsMobileChannelSelected) setIsMobileChannelSelected(true);
              if (setIsMobileChannelListOpen) setIsMobileChannelListOpen(false);
            }}
            className={`w-full flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold transition-all duration-150 ${
              activeChannel === 'events'
                ? (isDarkMode ? 'bg-white/10 text-white' : 'bg-slate-200 text-slate-900 shadow-sm')
                : (isDarkMode ? 'hover:bg-white/5 text-white/60 hover:text-white' : 'hover:bg-slate-50 text-slate-500 hover:text-slate-900')
            }`}
          >
            <div className={`p-1 rounded-lg ${activeChannel === 'events' ? 'bg-vylant-blue/20 text-vylant-blue' : (isDarkMode ? 'bg-white/5 text-white/70' : 'bg-slate-100 text-slate-600')}`}>
              <Calendar size={15} />
            </div>
            <span className="flex-grow text-left text-xs uppercase tracking-wider font-bold">Events</span>
            {eventCount > 0 && (
              <span className="bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full min-w-[20px] text-center">
                {eventCount}
              </span>
            )}
          </button>
        </div>
      )}

      {hasMarketplace && (
        <div className="px-1.5 mb-1.5">
          <button
            onClick={() => {
              setActiveChannel('marketplace');
              if (setIsMobileChannelSelected) setIsMobileChannelSelected(true);
              if (setIsMobileChannelListOpen) setIsMobileChannelListOpen(false);
            }}
            className={`w-full flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold transition-all duration-150 ${
              activeChannel === 'marketplace'
                ? (isDarkMode ? 'bg-purple-600/25 text-purple-200 border border-purple-500/30 shadow-sm' : 'bg-purple-100 text-purple-900 border border-purple-200 shadow-sm')
                : (isDarkMode ? 'hover:bg-white/5 text-white/60 hover:text-white' : 'hover:bg-slate-50 text-slate-500 hover:text-slate-900')
            }`}
          >
            <div className={`p-1 rounded-lg ${
              activeChannel === 'marketplace'
                ? 'bg-purple-600 text-white shadow-sm' 
                : (isDarkMode ? 'bg-purple-500/10 text-purple-400' : 'bg-purple-50 text-purple-600')
            }`}>
              <ShoppingBag size={15} />
            </div>
            <span className="flex-grow text-left text-xs uppercase tracking-wider font-bold truncate">
              {marketplaceTitle || 'Marketplace'}
            </span>
          </button>
        </div>
      )}

      {localItems.map(item => {
        const isHidden = item.type === 'channel' && item.data.categoryId && collapsedCategories[item.data.categoryId];
        
        if (isHidden) return null;

        const isDragOverTop = dragOverInfo?.id === item.id && dragOverInfo.position === 'top';
        const isDragOverBottom = dragOverInfo?.id === item.id && dragOverInfo.position === 'bottom';
        const isDragOverCenter = dragOverInfo?.id === item.id && dragOverInfo.position === 'center';

        if (item.type === 'category') {
          return (
            <div 
              key={item.id}
              draggable={canDragOrManage}
              onDragStart={(e) => handleDragStart(e, item)}
              onDragOver={(e) => handleDragOver(e, item)}
              onDrop={(e) => handleDrop(e, item)}
              onDragLeave={() => setDragOverInfo(null)}
              className={`mt-4 mb-0.5 relative transition-opacity ${draggedItem?.id === item.id ? 'opacity-50' : ''}`}
            >
              {isDragOverTop && <div className={`absolute -top-1 left-0 right-0 h-0.5 ${accentColor} z-50 rounded-full`} />}
              <div 
                data-category-id={item.data.id}
                className="flex items-center justify-between px-2 group"
              >
                <button 
                  onClick={() => setCollapsedCategories((prev: any) => ({ ...prev, [item.data.id]: !prev[item.data.id] }))}
                  className={`flex items-center gap-1 text-[10px] font-bold uppercase tracking-widest transition-colors ${
                    isDarkMode ? 'text-white/30 hover:text-white/60' : 'text-slate-500 hover:text-slate-700'
                  }`}
                >
                  <ChevronDown 
                    size={12} 
                    className={`transition-transform duration-200 ${collapsedCategories[item.data.id] ? '-rotate-90' : ''}`} 
                  />
                  {item.data.name}
                </button>
                <div className="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                  {isOwner && (
                    <>
                      <button 
                        onClick={() => {
                          setCreateChannelType('text');
                          setSelectedCategoryId(item.data.id);
                          setIsCreateChannelModalOpen(true);
                        }}
                        className={`p-1 rounded-md transition-colors ${isDarkMode ? 'hover:bg-white/10 text-white/40 hover:text-white' : 'hover:bg-slate-100 text-slate-400 hover:text-slate-900'}`}
                      >
                        <Plus size={12} />
                      </button>
                      <button 
                        onClick={() => handleDeleteCategory(item.data.id)}
                        className={`p-1 rounded-md transition-colors ${isDarkMode ? 'hover:bg-red-500/20 text-white/40 hover:text-red-400' : 'hover:bg-red-50 text-slate-400 hover:text-red-500'}`}
                      >
                        <Trash2 size={12} />
                      </button>
                    </>
                  )}
                </div>
              </div>
              {isDragOverBottom && <div className={`absolute -bottom-1 left-0 right-0 h-0.5 ${accentColor} z-50 rounded-full`} />}
            </div>
          );
        } else {
          return (
            <div 
              key={item.id}
              draggable={canDragOrManage}
              onDragStart={(e) => handleDragStart(e, item)}
              onDragOver={(e) => handleDragOver(e, item)}
              onDrop={(e) => handleDrop(e, item)}
              onDragLeave={() => setDragOverInfo(null)}
              className={`group relative transition-opacity ${draggedItem?.id === item.id ? 'opacity-50' : ''}`}
            >
              {isDragOverTop && <div className={`absolute -top-1 left-4 right-0 h-0.5 ${accentColor} z-50 rounded-full`} />}
              <button 
                onClick={() => {
                  setActiveChannel(item.data.id);
                  clearUnread('server', activeServer, item.data.id);
                  if (setIsMobileChannelSelected) setIsMobileChannelSelected(true);
                  if (setIsMobileChannelListOpen) setIsMobileChannelListOpen(false);
                }}
                onContextMenu={(e) => onChannelContextMenu(e, item.data.id, item.data.name)}
                className={`w-full flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium transition-colors ${
                  isDragOverCenter 
                    ? `ring-2 ring-inset ${isDarkMode ? 'ring-white/50 bg-white/10' : 'ring-vylant-blue bg-vylant-blue/10'}`
                    : activeChannel === item.data.id 
                    ? (isDarkMode ? 'bg-white/10 text-white' : 'bg-slate-200 text-slate-900 shadow-sm')
                    : (isDarkMode ? 'hover:bg-white/5 text-white/60 hover:text-white' : 'hover:bg-slate-50 text-slate-500 hover:text-slate-900')
                }`}
              >
                {item.data.type === 'voice' ? (
                  <Volume2 size={16} className={activeChannel === item.data.id ? 'text-vylant-blue' : 'opacity-50'} />
                ) : (
                  activeChannel === item.data.id ? <div className="w-1.5 h-1.5 rounded-full bg-vylant-blue"/> : null
                )}
                <span className={`flex-1 text-left truncate ${
                  (unreadCounts?.servers?.[activeServer]?.[item.data.id] || 0) > 0 ? 'font-bold' : 'font-medium'
                } ${
                  activeChannel === item.data.id 
                    ? (isDarkMode ? 'text-white' : 'text-slate-900') 
                    : (isDarkMode ? 'text-white/60' : 'text-slate-600')
                }`}>{item.data.name}</span>
                {mutedChannels.includes(item.data.id) && (
                  <BellOff size={12} className="text-white/30 shrink-0" />
                )}
                {/* Mentions (Red Circle) */}
                {(mentionCounts?.servers?.[activeServer]?.[item.data.id] || 0) > 0 && (
                  <div className="bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full min-w-[18px] flex items-center justify-center">
                    {(mentionCounts?.servers?.[activeServer]?.[item.data.id] || 0) > 99 ? '99+' : mentionCounts.servers[activeServer][item.data.id]}
                  </div>
                )}
                
                {/* Unread (Outline Circle) */}
                {(unreadCounts?.servers?.[activeServer]?.[item.data.id] || 0) > 0 && (
                  <div className={`text-[10px] font-bold px-1.5 py-0.5 rounded-full min-w-[18px] flex items-center justify-center border ${
                    isDarkMode ? 'bg-transparent text-white border-white' : 'bg-slate-100 text-slate-600 border-slate-300'
                  }`}>
                    {(unreadCounts?.servers?.[activeServer]?.[item.data.id] || 0) > 99 ? '99+' : unreadCounts.servers[activeServer][item.data.id]}
                  </div>
                )}
              </button>
              {isOwner && (
                <button 
                  onClick={(e) => {
                    e.stopPropagation();
                    setEditingChannel(item.data);
                    setIsChannelSettingsOpen(true);
                  }}
                  className={`absolute right-2 top-[5px] p-1.5 rounded-md opacity-0 group-hover:opacity-100 transition-all ${
                    isDarkMode ? 'hover:bg-white/10 text-white/40 hover:text-white' : 'hover:bg-slate-200 text-slate-400 hover:text-slate-900'
                  }`}
                >
                  <Settings size={12} />
                </button>
              )}
              {item.data.type === 'voice' && (
                (() => {
                  const rawVoiceMembers = item.data.voiceMembers || [];
                  const combinedMembers = [
                    ...rawVoiceMembers,
                    ...(activeCall?.type === 'server' && activeCall.targetName === item.data.id ? [{ id: 'me', name: userName, image: userImage, isSpeaking }] : [])
                  ].filter((v, i, a) => a.findIndex(t => t.name === v.name) === i);
                  
                  if (combinedMembers.length === 0) return null;
                  
                  return (
                    <div className="flex flex-col gap-0.5 mt-0.5 ml-[18px] pl-2 border-l-2 border-slate-200 dark:border-white/10">
                      {combinedMembers.map((member: any) => (
                        <div 
                           key={member.id || member.name} 
                           draggable={canMoveMembers}
                           onDragStart={(e) => {
                             if (!canMoveMembers) {
                               e.preventDefault();
                               return;
                             }
                             e.stopPropagation();
                             setDraggedVoiceMember({
                               memberName: member.name,
                               fromChannelId: item.data.id
                             });
                             e.dataTransfer.setData('text/plain', 'voice-member');
                             e.dataTransfer.effectAllowed = 'move';
                           }}
                           onDragEnd={() => setDraggedVoiceMember(null)}
                           className={`flex items-center gap-2 px-2 py-1 rounded-md cursor-pointer transition-colors ${
                              isDarkMode ? 'hover:bg-white/5' : 'hover:bg-slate-100'
                           }`} 
                           onClick={(e) => {
                             e.stopPropagation();
                         setSelectedProfile({ ...member, customStatus: member.status !== 'offline' ? member.customStatus : undefined });
                       }}
                       onContextMenu={(e) => handleUserContextMenu(e, member.name)}
                    >
                       <div className="relative shrink-0">
                         <img 
                           src={member.image} 
                           alt={member.name} 
                           className={`w-6 h-6 rounded-full object-cover ${member.isSpeaking ? 'ring-2 ring-emerald-500' : ''}`} 
                           referrerPolicy="no-referrer" 
                         />
                       </div>
                       <span className={`text-[11px] font-medium truncate ${isDarkMode ? 'text-white/70' : 'text-slate-600'}`}>{member.name}</span>
                    </div>
                  ))}
                    </div>
                  );
                })()
              )}
              {isDragOverBottom && <div className={`absolute -bottom-1 left-4 right-0 h-0.5 ${accentColor} z-50 rounded-full`} />}
            </div>
          );
        }
      })}
    </div>
  );
});

const Toggle = memo(({ label, description, checked, onChange }: { label: string, description?: string, checked: boolean, onChange: (v: boolean) => void }) => (
  <div className="flex items-center justify-between py-4 border-b border-white/5 last:border-none">
    <div className="flex-1 pr-4">
      <h4 className="text-sm font-bold mb-1">{label}</h4>
      {description && <p className="text-xs opacity-40">{description}</p>}
    </div>
    <button 
      onClick={() => onChange(!checked)}
      className={`relative w-11 h-6 rounded-full transition-colors duration-300 ${checked ? 'bg-emerald-500' : 'bg-slate-600'}`}
    >
      <motion.div 
        initial={false}
        animate={{ x: checked ? 24 : 4 }}
        transition={{ type: "spring", stiffness: 500, damping: 30 }}
        className="absolute top-1 w-4 h-4 bg-white rounded-full shadow-sm"
      />
    </button>
  </div>
));


