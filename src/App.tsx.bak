                isDarkMode 
                  ? 'bg-slate-900 border-white/10 text-white' 
                  : 'bg-white border-slate-200 text-slate-900'
              }`}
            >
              <button 
                onClick={() => setIsInviteModalOpen(false)}
                className={`absolute top-4 right-4 p-2 rounded-xl transition-colors ${isDarkMode ? 'hover:bg-white/10' : 'hover:bg-slate-100'}`}
              >
                <X size={18} />
              </button>

              <div className="text-center mb-6">
                <div className="w-16 h-16 rounded-2xl bg-vylant-blue/20 flex items-center justify-center text-vylant-blue mx-auto mb-4">
                  <UserPlus size={32} />
                </div>
                <h2 className="text-xl font-bold">Invite friends to {findServer(servers, inviteModalServerId)?.name}</h2>
              </div>

              <div className="mb-6 border-b pb-5 border-current border-opacity-15 space-y-4">
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div className="flex-1">
                    <label className={`text-[10px] font-bold uppercase tracking-widest mb-1 block ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
                      Link Expiration
                    </label>
                    <select
                      value={inviteExpiry}
                      onChange={(e) => setInviteExpiry(e.target.value)}
                      className={`w-full text-xs p-2.5 rounded-xl border focus:outline-none focus:border-vylant-blue/40 transition-colors ${
                        isDarkMode ? 'bg-black/20 border-white/10 text-white/80' : 'bg-white border-slate-200 text-slate-700'
                      }`}
                    >
                      <option value="never">Never (Forever)</option>
                      <option value="30m">30 Minutes</option>
                      <option value="1h">1 Hour</option>
                      <option value="6h">6 Hours</option>
                      <option value="24h">24 Hours</option>
                    </select>
                  </div>

                  <div className="flex-1">
                    <label className={`text-[10px] font-bold uppercase tracking-widest mb-1 block ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
                      Max Uses
                    </label>
                    <select
                      value={inviteMaxUses}
                      onChange={(e) => setInviteMaxUses(e.target.value)}
                      className={`w-full text-xs p-2.5 rounded-xl border focus:outline-none focus:border-vylant-blue/40 transition-colors ${
                        isDarkMode ? 'bg-black/20 border-white/10 text-white/80' : 'bg-white border-slate-200 text-slate-700'
                      }`}
                    >
                      <option value="unlimited">No Limit (Unlimited)</option>
                      <option value="1">1 Use</option>
                      <option value="5">5 Uses</option>
                      <option value="10">10 Uses</option>
                      <option value="25">25 Uses</option>
                      <option value="50">50 Uses</option>
                      <option value="100">100 Uses</option>
                    </select>
                  </div>
                </div>

                <div>
                  <label className={`text-[10px] font-bold uppercase tracking-widest mb-1.5 block ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
                    Or share a direct link
                  </label>
                  <div className="flex gap-2">
                    <input
                      type="text"
                      readOnly
                      value={modalInviteLink}
                      className={`flex-1 text-xs p-3 rounded-xl border focus:outline-none focus:border-vylant-blue/40 transition-colors ${
                        isDarkMode ? 'bg-black/20 border-white/10 text-white/80' : 'bg-slate-50 border-slate-200 text-slate-700'
                      }`}
                      onClick={(e) => (e.target as HTMLInputElement).select()}
                    />
                    <button
                      onClick={() => {
                        const link = modalInviteLink;
                        navigator.clipboard.writeText(link);
                        setCopiedLink(true);
                        setTimeout(() => setCopiedLink(false), 2000);
                      }}
                      className={`px-4 py-3 rounded-xl font-bold text-xs flex items-center justify-center gap-1.5 transition-all active:scale-95 shrink-0 ${
                        copiedLink 
                          ? 'bg-emerald-500 text-white' 
                          : 'bg-vylant-blue text-white hover:bg-opacity-90 hover:shadow-lg hover:shadow-vylant-blue/20'
                      }`}
                    >
                      {copiedLink ? (
                        <>
                          <Check size={14} />
                          Copied
                        </>
                      ) : (
                        <>
                          <Copy size={14} />
                          Copy
                        </>
                      )}
                    </button>
                    <button
                      onClick={() => {
                        const link = modalInviteAppLink;
                        navigator.clipboard.writeText(link);
                        setCopiedAppLink(true);
                        setTimeout(() => setCopiedAppLink(false), 2000);
                      }}
                      className={`px-3 py-3 rounded-xl font-bold text-xs flex items-center justify-center gap-1.5 transition-all active:scale-95 shrink-0 ${
                        copiedAppLink 
                          ? 'bg-emerald-500 text-white' 
                          : 'bg-white/10 text-white hover:bg-white/20 border border-white/10'
                      }`}
                      title="Copy App Link (vylant://)"
                    >
                      {copiedAppLink ? (
                        <>
                          <Check size={14} />
                          Copied App Link
                        </>
                      ) : (
                        <>
                          <Smartphone size={14} />
                          Copy App Link
                        </>
                      )}
                    </button>
                  </div>
                </div>
                <p className={`text-[9px] mt-2 leading-relaxed ${isDarkMode ? 'text-white/30' : 'text-slate-400'}`}>
                  Anyone with this link can instantly click it to join your server!{" "}
                  {inviteExpiry !== 'never' && (
                    <span className="text-vylant-blue font-bold mr-1">This link will expire in {inviteExpiry === '30m' ? '30 minutes' : inviteExpiry === '1h' ? '1 hour' : inviteExpiry === '6h' ? '6 hours' : '24 hours'}.</span>
                  )}
                  {inviteMaxUses !== 'unlimited' && (
                    <span className="text-vylant-blue font-bold">This link is limited to a maximum of {inviteMaxUses} {parseInt(inviteMaxUses, 10) === 1 ? 'use' : 'uses'}.</span>
                  )}
                </p>
              </div>

              <div className="space-y-4">
                {allUsersInServers.length > 0 ? (
                  <div>
                    <label className={`text-[10px] font-bold uppercase tracking-widest mb-2 block ${isDarkMode ? 'text-white/40' : 'text-slate-500'}`}>
                      Select a user to invite
                    </label>
                    <div className={`max-h-64 overflow-y-auto pr-2 space-y-2`}>
                      {allUsersInServers.map(user => (
                        <div 
                          key={user.id}
                          className={`flex items-center justify-between p-2 rounded-xl border transition-all ${
                            isDarkMode ? 'bg-white/5 border-white/5 hover:bg-white/10' : 'bg-white border-slate-100 hover:bg-slate-50'
                          }`}
                        >
                          <div className="flex items-center gap-3">
                            <img src={user.image} alt={user.name} className="w-8 h-8 rounded-full object-cover" referrerPolicy="no-referrer" />
                            <span className={`text-sm font-bold ${isDarkMode ? 'text-white/90' : 'text-slate-900'}`}>{user.name}</span>
                          </div>
                          <button 
                            onClick={() => !sentInvites.includes(user.name) && handleSendInviteToFriend(user.name, inviteModalServerId!)}
                            disabled={sentInvites.includes(user.name)}
                            className={`px-3 py-1.5 rounded-lg font-bold text-[10px] transition-all ${
                              sentInvites.includes(user.name)
                                ? 'bg-emerald-500/20 text-emerald-500 cursor-default'
                                : 'bg-vylant-blue/20 text-vylant-blue hover:bg-vylant-blue hover:text-white'
                            }`}
                          >
                            {sentInvites.includes(user.name) ? 'Sent' : 'Send'}
                          </button>
                        </div>
                      ))}
                    </div>
                  </div>
                ) : (
                  <div className={`p-4 rounded-2xl border text-center ${isDarkMode ? 'bg-white/5 border-white/5' : 'bg-slate-50 border-slate-100'}`}>
                    <p className={`text-sm ${isDarkMode ? 'text-white/60' : 'text-slate-500'}`}>
                      You don't have any friends to invite yet.
                    </p>
                  </div>
                )}
              </div>
            </motion.div>
          </div>
        )}
      </AnimatePresence>

      {/* Add Server Modal */}
      <AnimatePresence>
        {isAddServerModalOpen && (
          <div className="fixed inset-0 z-[110] flex items-center justify-center p-4">
            <motion.div
