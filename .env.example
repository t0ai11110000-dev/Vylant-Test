# Gemini API Key for AI features (Optional)
GEMINI_API_KEY=

# Server Port
PORT=3000

# JWT Secret for Session Authentication (Change this for production!)
JWT_SECRET=vylant_secret_jwt_key_2026

# SMTP settings for Email Notifications (Verification Codes)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vylant <noreply@vylant.com>
SUPPORT_EMAIL=support@vylant.com

# Stripe API key for Support Us Checkout (Optional for production, but enables live payment checks)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# CORS Origin for frontend (set to your domain in production)
# e.g. https://vylant.com or http://localhost:5173
CORS_ORIGIN=https://vylant.com
